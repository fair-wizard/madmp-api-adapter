# Configuration for the maDMP API console client.
#
# Copy this file to `.env` in this directory (example/madmp-client/.env);
# it is then picked up automatically. Point at any other file with
# --env-file PATH or MADMP_ENV_FILE, which is read on top of it. Real
# environment variables always win over files, and command-line flags win
# over everything.
#
# The adapter's own madmp-api/.env is NOT read: it configures the server
# (MADMP_API_* variables), and its MADMP_API_WIZARD_URL is the URL the
# *server* uses to reach the Wizard, which a client cannot always resolve.
#
# `.env` is gitignored; this template is not - keep real passwords out of it.

# --- maDMP API -------------------------------------------------------------

MADMP_API_URL=http://localhost:8000

# Bearer token forwarded to DSW. Leave unset to log in to the Wizard with
# the credentials below and use the token it returns.
#MADMP_TOKEN=

# --- Wizard (only used to obtain a token) ----------------------------------

WIZARD_URL=http://localhost:3000
WIZARD_EMAIL=albert.einstein@example.com
WIZARD_PASSWORD=password
