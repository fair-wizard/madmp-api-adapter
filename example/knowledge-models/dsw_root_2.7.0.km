1f5-9fa959dead30","d5784d24-0e66-4821-bd62-a711fb6d7a40","f9d84278-b61d-4314-94e9-12644bfa1d00","de23bb94-b727-4907-9a5d-6f8c78c3e432","4baf405e-262e-4f1a-bfdc-fe72fc628650","13a7eeae-09f5-42bf-8e62-b2c1fe1b86f7","a84cdefc-8c41-4949-9353-5916532ad50c","92a10652-3675-48f2-8d50-180a29cec62e","1ae8d7b0-4bcd-4914-aaea-fa389fc056f4","588ad032-56ba-4d52-b29c-6a5b56aa6569"]},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2020-11-11T10:52:07Z","entityUuid":"d5b27482-b598-4b8c-b534-417d4ad27394","parentUuid":"6f6241d9-136c-4770-9d58-8a3f39607052","uuid":"0e98b748-4526-47ea-866a-e446a5c3a9d5"},{"content":{"eventType":"DeleteQuestionEvent"},"createdAt":"2020-11-11T10:52:08Z","entityUuid":"9b3e6391-d5c3-4d82-bf60-342ed2ac1f43","parentUuid":"6be88f7c-f868-460f-bba7-91e1c659adfd","uuid":"2008019d-d0bf-4f6e-a39a-3891b8f8b9eb"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Complicated (binary) file formats tend to change over time, and software may not stay compatible with older versions. Also, some formats (e.g. DOC, XLS) hamper long term usability by making use of patents or being hampered by restrictive licensing. \n\nIdeally a format should be simple, text only, completely described, not restricted by copyrights, and implemented in different software packages."},"title":{"changed":false}},"createdAt":"2020-11-11T10:52:09Z","entityUuid":"ced5a7c2-4034-4763-a1d5-3cb815cdfddb","parentUuid":"b08fe063-33f8-4380-b3a9-ba1e586dedf2","uuid":"ea5d0ded-5d16-4eae-ac0b-315e869d15e6"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","integrationUuid":"f3520558-707e-415a-8878-c7b8d6ccc2fb","questionType":"IntegrationQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":null,"title":"Which \"Minimal Information\" standard will you use?","variables":{"registry":"standards"}},"createdAt":"2020-11-11T10:52:10Z","entityUuid":"e7b6cd51-22a6-4f7a-9ad5-a7234fa436cb","parentUuid":"08bd1365-7f0e-4b78-aeb1-3c0e85e84cb6","uuid":"069f6d0a-1c26-443b-8ab9-bfe3ba2a54f7"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2020-11-11T10:52:11Z","entityUuid":"e7b6cd51-22a6-4f7a-9ad5-a7234fa436cb","parentUuid":"08bd1365-7f0e-4b78-aeb1-3c0e85e84cb6","uuid":"5f1cc070-f616-4a82-a6a2-7547dcabec62"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","integrationUuid":"f3520558-707e-415a-8878-c7b8d6ccc2fb","questionType":"IntegrationQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":"Minimal Information Standard","variables":{"registry":"standards"}},"createdAt":"2020-11-11T10:52:12Z","entityUuid":"f0ca4f37-ef70-452e-b620-434d52fb5924","parentUuid":"e7b6cd51-22a6-4f7a-9ad5-a7234fa436cb","uuid":"6da04baa-4f19-4cd2-a874-224b2c18a792"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Which \"Minimal Information\" standards will you use?"}},"createdAt":"2020-11-11T10:52:13Z","entityUuid":"e7b6cd51-22a6-4f7a-9ad5-a7234fa436cb","parentUuid":"08bd1365-7f0e-4b78-aeb1-3c0e85e84cb6","uuid":"bbef5688-62aa-4a4e-82ec-ec03872a94e7"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"I will only add the metadata that is \"required\" in the standard."},"metricMeasures":{"changed":false}},"createdAt":"2020-11-11T10:52:14Z","entityUuid":"b2ca0d26-7fdd-44f1-b064-bc4cd4c45661","parentUuid":"15573266-7ddf-4c6b-962e-45691d34cf61","uuid":"6499452b-768e-4a6a-9fac-e61b2fb2accc"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Yes, I will add \"optional\" metadata where I can"},"metricMeasures":{"changed":false}},"createdAt":"2020-11-11T10:52:15Z","entityUuid":"cb765913-50c9-482e-bf10-5f5f91d0e473","parentUuid":"15573266-7ddf-4c6b-962e-45691d34cf61","uuid":"8fa26efd-a01a-427a-8f5c-dfedc86813df"},{"content":{"advice":{"changed":true,"value":"Please consider adding metadata items that is available to you. This can be helpful for others that may want to re-use your data for a different purpose.\nIf you collect your metadata on the fly, it is not a lot of work to keep it."},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":false},"metricMeasures":{"changed":false}},"createdAt":"2020-11-11T10:52:16Z","entityUuid":"b2ca0d26-7fdd-44f1-b064-bc4cd4c45661","parentUuid":"15573266-7ddf-4c6b-962e-45691d34cf61","uuid":"a661d228-415a-4784-aa58-73d89a52eca4"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Data corruption or mistakes can happen with large amounts of files or large files. Keeping a *master list* with data checksums can be helpful to prevent expensive mistakes, because it will help detect early when data files are damaged or mixed up. It can also be helpful to keep the list under version control so that all changes are well documented."},"title":{"changed":false}},"createdAt":"2020-11-11T10:52:17Z","entityUuid":"e0759fdc-7ce9-4020-816d-73119f634c7e","parentUuid":"8608d3df-7d7f-4893-8f80-e5297167b213","uuid":"b517eadc-6468-4615-b88e-da9e19bd31e6"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"The FAIR principles ask for the use of FAIR ontologies. It is better when using RDF to make use as much as possible of concepts that are in established and well-maintained ontologies on the internet."},"title":{"changed":true,"value":"Are all the URIs in the RDF resolving to common ontologies?"}},"createdAt":"2020-11-11T10:52:18Z","entityUuid":"3196c225-2842-4766-9768-381fd6ee1e05","parentUuid":"3525f6f9-4c0b-4560-a572-c9fe2e0a0d94","uuid":"2fe095cd-126b-4809-a174-193db44ecb40"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"No, some concepts are internal to the project and we refer to our own ontologies"},"metricMeasures":{"changed":true,"value":[{"measure":0.5,"metricUuid":"a42bded3-a085-45f8-b384-32b4a77c8385","weight":1}]}},"createdAt":"2020-11-11T10:52:19Z","entityUuid":"945aae79-4eed-4115-ac19-d295158a19f6","parentUuid":"3196c225-2842-4766-9768-381fd6ee1e05","uuid":"7b18724d-ba60-4634-939b-20e20bbbf5b5"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No, we made our own ontologies for our work; concepts are not mapped to common ontologies","metricMeasures":[]},"createdAt":"2020-11-11T10:52:20Z","entityUuid":"30a6e365-dbf6-4567-96c3-b7301d0fd0ca","parentUuid":"3196c225-2842-4766-9768-381fd6ee1e05","uuid":"b44d7de1-8fd3-4ea6-953f-608900212fb5"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":true,"value":["30a6e365-dbf6-4567-96c3-b7301d0fd0ca","945aae79-4eed-4115-ac19-d295158a19f6","88f9fb7b-12a9-481a-9239-cbf43206056e"]},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2020-11-11T10:52:21Z","entityUuid":"3196c225-2842-4766-9768-381fd6ee1e05","parentUuid":"3525f6f9-4c0b-4560-a572-c9fe2e0a0d94","uuid":"48e222ac-7444-4875-bcf6-ca219c35cf7a"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":false},"metricMeasures":{"changed":true,"value":[{"measure":0,"metricUuid":"a42bded3-a085-45f8-b384-32b4a77c8385","weight":1}]}},"createdAt":"2020-11-11T10:52:22Z","entityUuid":"30a6e365-dbf6-4567-96c3-b7301d0fd0ca","parentUuid":"3196c225-2842-4766-9768-381fd6ee1e05","uuid":"43ebeeaa-0d7f-40a7-a21b-77b34dddfe99"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Yes, (almost) all our concepts are either from common ontologies, or mapped to common ontologies"},"metricMeasures":{"changed":false}},"createdAt":"2020-11-11T10:52:23Z","entityUuid":"88f9fb7b-12a9-481a-9239-cbf43206056e","parentUuid":"3196c225-2842-4766-9768-381fd6ee1e05","uuid":"53d3ed97-9a6a-4a1d-8b54-4808cfd4c11d"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"No, we exclusively refer to our own ontologies for some classes of objects"},"metricMeasures":{"changed":false}},"createdAt":"2020-11-11T10:52:24Z","entityUuid":"945aae79-4eed-4115-ac19-d295158a19f6","parentUuid":"3196c225-2842-4766-9768-381fd6ee1e05","uuid":"a621b776-779d-4ae8-86ee-6e6ae3ea92ab"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Although there is no world-wide rule for the application of copyright on data sets (copyright only applies to things that require a so-called \"creative step\"), it is wise to check for an explicit permission to use a data set and not to assume that data can be used freely just because you can access it. \nNote that copyright laws explicitly *forbid* the use of a copyrighted work, *except* if you get permission. Such a permission is called a \"licence\". So: if you can not find a licence, you have to assume you can not use the data."},"title":{"changed":false}},"createdAt":"2020-11-11T10:52:25Z","entityUuid":"69999c2c-2710-480e-b8ac-8a8fc6f582e5","parentUuid":"be872000-cb98-442f-999c-ca3ef58dcfe8","uuid":"67f6ece4-b9ef-41ae-8b28-04076bbba2e6"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"Wikipedia on Copyright","referenceType":"URLReference","url":"https://en.wikipedia.org/wiki/Copyright"},"createdAt":"2020-11-11T10:52:26Z","entityUuid":"81667fbe-dd42-4b28-a956-66a31f064e38","parentUuid":"69999c2c-2710-480e-b8ac-8a8fc6f582e5","uuid":"94024693-0041-4c3d-9064-5561b8808321"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Although there is no world-wide rule for the application of copyright on data sets (copyright only applies to things that require a so-called \"creative step\"), it is wise to check for an explicit permission to use a data set and not to assume that data can be used freely just because you can access it. \nNote that copyright laws explicitly *forbid* the use of a copyrighted work, *except* if you get permission. Such a permission is called a \"licence\". So: if you can not find a licence, you have to assume you can not use the data."},"title":{"changed":false}},"createdAt":"2020-11-11T10:52:27Z","entityUuid":"aee03da5-b399-4274-8db4-fac82c6210d3","parentUuid":"fcc51962-08df-4f4c-85ad-6bb932107010","uuid":"65435dde-ccf5-43fc-9e21-055f1f9d0789"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"Wikipedia on Copyright","referenceType":"URLReference","url":"https://en.wikipedia.org/wiki/Copyright"},"createdAt":"2020-11-11T10:52:28Z","entityUuid":"720e0101-8b99-438b-a6e5-8ae9386c7b0c","parentUuid":"aee03da5-b399-4274-8db4-fac82c6210d3","uuid":"191bdd65-918b-43cd-84c0-5da174a7f1a4"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Much of todays data is used in comparison with reference data. You may be comparing your own data with a \"standard set\" which is maintained as a collection by someone else. Or you could be determining differences to a standard (for example in bioinformatics, a genome is often compared with a reference genome to identify genomic variants). If you use reference data, there are several specific issues that you should consider. What are the reference data sets that you will use?"},"title":{"changed":false}},"createdAt":"2020-11-11T10:52:29Z","entityUuid":"fcc51962-08df-4f4c-85ad-6bb932107010","parentUuid":"dac677d4-99f9-4af8-935a-4a1c9c7cdbdf","uuid":"b8b143fc-ba6b-44de-8143-0899c5607df1"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Will any of the data that you will be creating form a reference data set for future research (by others)?\n\nMuch of todays data is used in comparison with reference data. You may be comparing your own data with a \"standard set\" which is maintained as a collection by someone else. Or you could be determining differences to a standard (for example in bioinformatics, a genome is often compared with a reference genome to identify genomic variants). Will you be creating any data that will be reference data for other researchers?"},"title":{"changed":false}},"createdAt":"2020-11-11T10:52:30Z","entityUuid":"588ad032-56ba-4d52-b29c-6a5b56aa6569","parentUuid":"d5b27482-b598-4b8c-b534-417d4ad27394","uuid":"27e17460-7949-48a6-8a45-4513a5cff22a"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"ListQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":"List the ontologies you will be using"},"createdAt":"2020-11-11T10:52:31Z","entityUuid":"9d44b89e-300d-4227-8642-c6b38b8b882d","parentUuid":"3e5ef321-76f3-4c65-a49f-4e03f6a23def","uuid":"ff5e519a-e1c7-44a8-a467-c33ffe6361db"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"ValueQuestion","requiredPhaseUuid":"adc9133d-afcd-4616-9aea-db5f475898a2","tagUuids":[],"text":null,"title":"Name of the ontology","validations":[],"valueType":"StringQuestionValueType"},"createdAt":"2020-11-11T10:52:32Z","entityUuid":"212a7e54-557d-4319-9f57-33148ae80a69","parentUuid":"9d44b89e-300d-4227-8642-c6b38b8b882d","uuid":"ef1e9f0f-0718-4ec5-b2ca-ec61d29b46ff"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":true,"value":"adc9133d-afcd-4616-9aea-db5f475898a2"},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2020-11-11T10:52:33Z","entityUuid":"9d44b89e-300d-4227-8642-c6b38b8b882d","parentUuid":"3e5ef321-76f3-4c65-a49f-4e03f6a23def","uuid":"23cd6043-4717-48a4-91f5-5f920b296a99"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"ValueQuestion","requiredPhaseUuid":"adc9133d-afcd-4616-9aea-db5f475898a2","tagUuids":[],"text":null,"title":"Link to the ontology","validations":[],"valueType":"StringQuestionValueType"},"createdAt":"2020-11-11T10:52:34Z","entityUuid":"6cf69cc9-bd6c-4e51-98a2-817d1d211720","parentUuid":"9d44b89e-300d-4227-8642-c6b38b8b882d","uuid":"4490db92-36fc-4fd1-bdbe-241683df77eb"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":true,"value":["b4d8d8b8-3c8e-4b41-87a4-dbd01e7b7ad9","9832a3a5-e24d-4db1-b48f-4d171c1402ae"]},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2020-11-11T10:52:35Z","entityUuid":"12762d00-f02a-40f7-b175-c7e4c92f5f54","parentUuid":"fcc51962-08df-4f4c-85ad-6bb932107010","uuid":"e18dcc4c-52bd-4f07-9fc0-871e9508f1f1"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"It will be available both from the provider and together with my data","metricMeasures":[]},"createdAt":"2020-11-11T10:52:36Z","entityUuid":"aee14c30-46a4-4a8f-8918-acc98a31043e","parentUuid":"12762d00-f02a-40f7-b175-c7e4c92f5f54","uuid":"fff096ce-3266-49db-b706-6bca963a0b2b"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{