se},"requestBody":{"changed":false},"requestHeaders":{"changed":false},"requestMethod":{"changed":false},"requestUrl":{"changed":true,"value":"https://query.wikidata.org/sparql?query=SELECT DISTINCT ?item ?label WHERE { ?item wdt:P31 ${type} . ?item rdfs:label ?label . ?item schema:description ?description . FILTER contains(lcase(concat(?label, ?description)), lcase('${q}')) FILTER (lang(?label) = 'en') }"},"responseItemTemplate":{"changed":true,"value":"**{{item.label.value}}**"},"responseItemTemplateForSelection":{"changed":false},"responseListField":{"changed":false},"testQ":{"changed":false},"testResponse":{"changed":false},"testVariables":{"changed":false},"variables":{"changed":false}},"createdAt":"2023-06-12T11:31:33Z","entityUuid":"b2ae610d-8dd1-4c4d-bf78-5a3c9f00e5d8","parentUuid":"6f6241d9-136c-4770-9d58-8a3f39607052","uuid":"c580cc09-492a-4b31-a1c8-f320c17fedac"},{"content":{"allowCustomReply":{"changed":false},"annotations":{"changed":false},"eventType":"EditIntegrationEvent","integrationType":"ApiIntegration","name":{"changed":false},"requestAllowEmptySearch":{"changed":false},"requestBody":{"changed":false},"requestHeaders":{"changed":false},"requestMethod":{"changed":false},"requestUrl":{"changed":false},"responseItemTemplate":{"changed":true,"value":"**{{ item.name }}**{% if item.shortname %} ({{ item.shortname }}){% endif %}{% if item.type %} ![](https://img.shields.io/badge/type-{{item.type|replace(\" \", \"%20\")}}-blue){% endif %}\n\n\n{% if item.description %}{{ item.description }}{% endif %}"},"responseItemTemplateForSelection":{"changed":false},"responseListField":{"changed":false},"testQ":{"changed":false},"testResponse":{"changed":false},"testVariables":{"changed":false},"variables":{"changed":false}},"createdAt":"2023-06-12T11:38:54Z","entityUuid":"f3520558-707e-415a-8878-c7b8d6ccc2fb","parentUuid":"6f6241d9-136c-4770-9d58-8a3f39607052","uuid":"86564dbd-e954-43c1-9963-ede435d5d290"},{"content":{"annotations":{"changed":false},"eventType":"E