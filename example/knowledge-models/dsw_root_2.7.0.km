l,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-04-12T09:37:38Z","entityUuid":"dc564f07-ae7b-47f0-bba5-4180ec33bf9e","parentUuid":"a781badf-f7ee-4588-9478-d31470f00c38","uuid":"ebf9d774-b774-45c7-89e8-2a9046401cfe"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"No"},"metricMeasures":{"changed":false}},"createdAt":"2022-04-12T09:37:39Z","entityUuid":"dc564f07-ae7b-47f0-bba5-4180ec33bf9e","parentUuid":"a781badf-f7ee-4588-9478-d31470f00c38","uuid":"19550ed7-b6bd-4389-91f5-db2613bbcc02"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-04-12T09:37:43Z","entityUuid":"f971efd1-b0a5-4bc5-829d-148ef9362d37","parentUuid":"a781badf-f7ee-4588-9478-d31470f00c38","uuid":"f4fc1c22-3efa-4d61-af5e-a6d12b2240c2"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2022-04-12T09:38:16Z","entityUuid":"e5762c40-7b10-4915-89f8-c71180049f13","parentUuid":"a781badf-f7ee-4588-9478-d31470f00c38","uuid":"9ced16cf-1b8f-4dd5-a516-c06010a5a1f8"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"RDMkit on Toxicology"},"referenceType":"URLReference","url":{"changed":true,"value":"https://rdmkit.elixir-europe.org/toxicology_data"}},"createdAt":"2022-04-12T09:38:33Z","entityUuid":"e5762c40-7b10-4915-89f8-c71180049f13","parentUuid":"a781badf-f7ee-4588-9478-d31470f00c38","uuid":"965bfe5c-7df9-4759-a009-cdb9d612eabf"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Will you need existing data in a technical data field"}},"createdAt":"2022-04-12T09:38:50Z","entityUuid":"d4191666-21f3-4875-8426-d12a3aa1ffce","parentUuid":"07f599c3-592c-479b-906c-36478ae792b9","uuid":"1d9e453f-9237-4d55-b8f1-e35a37b459d7"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2022-04-12T09:39:48Z","entityUuid":"190f7e34-c4f1-41c0-98e9-1f556b5b37b0","parentUuid":"f971efd1-b0a5-4bc5-829d-148ef9362d37","uuid":"176cf9c8-dbc4-4845-afeb-28ef4bb0c1bb"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Do you need existing data for ecotoxicology research?"}},"createdAt":"2022-04-12T09:40:03Z","entityUuid":"190f7e34-c4f1-41c0-98e9-1f556b5b37b0","parentUuid":"f971efd1-b0a5-4bc5-829d-148ef9362d37","uuid":"41e7464d-ba35-4f1f-944a-80da5b3569ee"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-04-12T09:40:10Z","entityUuid":"21b12b09-9ab6-4ec4-92ab-132a87bb8f10","parentUuid":"190f7e34-c4f1-41c0-98e9-1f556b5b37b0","uuid":"03db8ef2-10c1-4b6e-877e-76520fe6bc02"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"No"},"metricMeasures":{"changed":false}},"createdAt":"2022-04-12T09:40:12Z","entityUuid":"21b12b09-9ab6-4ec4-92ab-132a87bb8f10","parentUuid":"190f7e34-c4f1-41c0-98e9-1f556b5b37b0","uuid":"46d5124a-ea29-49e1-bebf-92a73c304380"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-04-12T09:40:20Z"