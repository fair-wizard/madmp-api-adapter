nged":true,"value":"adc9133d-afcd-4616-9aea-db5f475898a2"},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2019-06-09T16:43:57Z","entityUuid":"87b45400-169d-424d-8e71-d2034618dab5","parentUuid":"1ae8d7b0-4bcd-4914-aaea-fa389fc056f4","uuid":"9ce4f731-7a84-42ab-8f8a-1f90da13929e"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":true,"value":"adc9133d-afcd-4616-9aea-db5f475898a2"},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2019-06-09T16:43:58Z","entityUuid":"3effd452-f0ae-4c25-b971-2b5762889ca4","parentUuid":"1ae8d7b0-4bcd-4914-aaea-fa389fc056f4","uuid":"77bdc243-913e-4a03-8868-fd783254a567"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":true,"value":"b101f2d0-2476-452d-aa8d-95a41a02b52c"},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2019-06-09T16:43:59Z","entityUuid":"9b3e6391-d5c3-4d82-bf60-342ed2ac1f43","parentUuid":"6be88f7c-f868-460f-bba7-91e1c659adfd","uuid":"e260d696-6262-4506-b0c0-42eda467662f"}],"forkOfPackageId":null,"id":"dsw:root:1.1.0","kmId":"root","language":"en","license":"Apache-2.0","mergeCheckpointPackageId":null,"metamodelVersion":20,"name":"Common DSW Knowledge Model","nonEditable":false,"organizationId":"dsw","phase":"DeprecatedKnowledgeModelPackagePhase","previousPackageId":"dsw:root:1.0.3","readme":"# Common DSW Knowledge Model\n\nCommon DSW Knowledge Model deals with questions that a researcher should answer in order to create a Data Stewardship Plan, as well as other related questionnaire data. It originated from mindmap made by Rob Hooft.\n\n## Changelog\n\n### 1.1.0\n\n* Adding phases to questions (first draft) according to [ds-km@a6713d1](https://github.com/ds-wizard/ds-km/commit/a6713d1a4b9758bea63b3f7c56af5bd4f500d949) and [ds-km@1123211](https://github.com/ds-wizard/ds-km/commit/1123211bb5af43df8ef435039a2923f48e3e981c)\n\nPrior to this version, all questions were assigned with phase 2 - *Before submitting the DMP*. \n\n### 1.0.3\n\n* Fix: Removing extra question mark for a question (8018e15f-6c7e-433a-8686-ae0d695c7fc7) in chapter 5 according to: [ds-km@1123211](https://github.com/ds-wizard/ds-km/commit/1123211bb5af43df8ef435039a2923f48e3e981c)\n\n### 1.0.2\n\n* Fix: Adding some explanation to the list item questions (f5fef09d-ade5-4019-b089-f05bd89c34bc and b642c31d-a512-4ca7-8743-a2e0254006fa) in chapter 3 according to: [ds-km@96e28f4](https://github.com/ds-wizard/ds-km/commit/96e28f478d5dc6b59d384b5127f012dc2fe5f287)\n\n### 1.0.1\n\n* Fix: Adding forgotten question mark to end of question (39e0cc7c-17fe-4991-88d8-1280c3fe7923) in chapter 1 according to: [ds-km@644a373](https://github.com/ds-wizard/ds-km/commit/644a373685dc4ac15b76e86667a90151ca9c70ca)\n\n### 1.0.0\n\n* Initial version transformed from the previous DS-KM GitHub repository up to [ds-km@8442837](https://github.com/ds-wizard/ds-km/commit/8442837dbe3ff899b09e7d8d3fc1107e935a876f)","version":"1.1.0"},{"createdAt":"2019-06-09T17:52:45.087Z","description":"DSW Knowledge Model originated from mindmap made by Rob Hooft","events":[{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"ValueQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":"Describe how everyone in the project will be naming files and folders, and what folder structure you will use.","title":"Describe your SOP (Standard Operating Procedure) for file naming","validations":[],"valueType":"TextQuestionValueType"},"createdAt":"2019-06-09T17:52:45Z","entityUuid":"9ff389f0-2236-48cf-880c-040ea1bb0d2f","parentUuid":"8b13234e-879b-4221-be12-4df24e6de00e","uuid":"273f0af2-3cbc-4683-be1b-e0422ae3ba0c"}],"forkOfPackageId":null,"id":"dsw:root:1.2.0","kmId":"root","language":"en","license":"Apache-2.0","mergeCheckpointPackageId":null,"metamodelVersion":20,"name":"Common DSW Knowledge Model","nonEditable":false,"organizationId":"dsw","phase":"DeprecatedKnowledgeModelPackagePhase","previousPackageId":"dsw:root:1.1.0","readme":"# Common DSW Knowledge Model\n\nCommon DSW Knowledge Model deals with questions that a researcher should answer in order to create a Data Stewardship Plan, as well as other related questionnaire data. It originated from mindmap made by Rob Hooft.\n\n## Changelog\n\n### 1.2.0\n\n* Adding file naming SOP description question (9ff389f0-2236-48cf-880c-040ea1bb0d2f) to chapter 2 according to [ds-km@d879be0]https://github.com/ds-wizard/ds-km/commit/d879be0fa9d0808868396c649d03c4d783ac6742)\n\n### 1.1.0\n\n* Adding phases to questions (first draft) according to [ds-km@a6713d1](https://github.com/ds-wizard/ds-km/commit/a6713d1a4b9758bea63b3f7c56af5bd4f500d949) and [ds-km@1123211](https://github.com/ds-wizard/ds-km/commit/1123211bb5af43df8ef435039a2923f48e3e981c)\n\nPrior to this version, all questions were assigned with phase 2 - *Before submitting the DMP*. \n\n### 1.0.3\n\n* Fix: Removing extra question mark for a question (8018e15f-6c7e-433a-8686-ae0d695c7fc7) in chapter 5 according to: [ds-km@1123211](https://github.com/ds-wizard/ds-km/commit/1123211bb5af43df8ef435039a2923f48e3e981c)\n\n### 1.0.2\n\n* Fix: Adding some explanation to the list item questions (f5fef09d-ade5-4019-b089-f05bd89c34bc and b642c31d-a512-4ca7-8743-a2e0254006fa) in chapter 3 according to: [ds-km@96e28f4](https://github.com/ds-wizard/ds-km/commit/96e28f478d5dc6b59d384b5127f012dc2fe5f287)\n\n### 1.0.1\n\n* Fix: Adding forgotten question mark to end of question (39e0cc7c-17fe-4991-88d8-1280c3fe7923) in chapter 1 according to: [ds-km@644a373](https://github.com/ds-wizard/ds-km/commit/644a373685dc4ac15b76e86667a90151ca9c70ca)\n\n### 1.0.0\n\n* Initial version transformed from the previous DS-KM GitHub repository up to [ds-km@8442837](https://github.com/ds-wizard/ds-km/commit/8442837dbe3ff899b09e7d8d3fc1107e935a876f)","version":"1.2.0"},{"createdAt":"2019-06-10T16:38:51.763Z","description":"DSW Knowledge Model originated from mindmap made by Rob Hooft","events":[{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"ValueQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":null,"title":"Reference data:","validations":[],"valueType":"StringQuestionValueType"},"createdAt":"2019-06-10T16:38:52Z","entityUuid":"93988527-5bff-4125-8834-3750e9a28683","parentUuid":"fcc51962-08df-4f4c-85ad-6bb932107010","uuid":"af731dc4-0682-49d4-9678-71b274b711b3"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":true,"value":["93988527-5bff-4125-8834-3750e9a28683","9ac2713c-6aa1-4884-a93f-2ac727d00567","7b8c75c0-8d5c-4fde-9898-ded8b91f7f1f","10b6548c-21cd-44c8-a8de-47415e7b012e","12762d00-f02a-40f7-b175-c7e4c92f5f54"]},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2019-06-10T16:38:53Z","entityUuid":"fcc51962-08df-4f4c-85ad-6bb932107010","parentUuid":"dac677d4-99f9-4af8-935a-4a1c9c7cdbdf","uuid":"327b1b60-73b3-4893-863b-c9d360aba5e8"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"ValueQuestion","requiredPhaseUuid":"b101f2d0-2476-452d-aa8d-95a41a02b52c","tagUuids":[],"text":null,"title":"Non-reference data set:","validations":[],"valueType":"StringQuestionValueType"},"createdAt":"2019-06-10T16:38:54Z","entityUuid":"44120979-2840-4522-8297-df13f7fd1e3a","parentUuid":"be872000-cb98-442f-999c-ca3ef58dcfe8","uuid":"