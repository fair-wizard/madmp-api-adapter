Type":"AddAnswerEvent","label":"No","metricMeasures":[{"measure":0,"metricUuid":"0feac7e6-add4-4723-abae-be5ce7864c63","weight":1}]},"createdAt":"2018-10-01T00:04:18Z","entityUuid":"dc7c7529-58c6-4414-84cc-7a19325cb73b","parentUuid":"b7d9008e-9691-44f0-a026-0f63d808db39","uuid":"79463815-101f-4d5f-98ae-3860ae59a18c"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[{"measure":1,"metricUuid":"0feac7e6-add4-4723-abae-be5ce7864c63","weight":1}]},"createdAt":"2018-10-01T00:04:19Z","entityUuid":"d748ea2b-bbe7-4b05-82e2-bee5e10e8441","parentUuid":"b7d9008e-9691-44f0-a026-0f63d808db39","uuid":"3a62d56e-738b-4c6f-a4fa-cfc7d92e2cad"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":null,"title":"Has it been established who can ask for a restore during the project?"},"createdAt":"2018-10-01T00:04:20Z","entityUuid":"47559455-2969-41f4-aee8-e9ce558ab2f0","parentUuid":"d748ea2b-bbe7-4b05-82e2-bee5e10e8441","uuid":"a7ae4ba8-5d59-4bb6-8398-dfb895ce3acf"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[{"measure":0,"metricUuid":"0feac7e6-add4-4723-abae-be5ce7864c63","weight":1}]},"createdAt":"2018-10-01T00:04:21Z","entityUuid":"0591c012-e567-4383-b39f-22b0abfe0847","parentUuid":"47559455-2969-41f4-aee8-e9ce558ab2f0","uuid":"6bcd2019-20cf-48c1-ab62-f642e36c0b38"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[{"measure":1,"metricUuid":"0feac7e6-add4-4723-abae-be5ce7864c63","weight":1}]},"createdAt":"2018-10-01T00:04:22Z","entityUuid":"c406aebf-a807-4bda-bcdf-5066d0b1c17b","parentUuid":"47559455-2969-41f4-aee8-e9ce558ab2f0","uuid":"d106668f-33cc-4939-a148-8ff425903c7f"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":null,"title":"If the data is voluminous, will the project be able to cope with the time needed for a restore?"},"createdAt":"2018-10-01T00:04:23Z","entityUuid":"3d837696-3a99-4362-86a3-f460dd878b75","parentUuid":"d748ea2b-bbe7-4b05-82e2-bee5e10e8441","uuid":"a69749f0-3cca-43cf-af5c-ade68f417c6f"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[{"measure":0,"metricUuid":"0feac7e6-add4-4723-abae-be5ce7864c63","weight":1}]},"createdAt":"2018-10-01T00:04:24Z","entityUuid":"acf31ff1-9d81-4671-89fb-fa4c60c5845a","parentUuid":"3d837696-3a99-4362-86a3-f460dd878b75","uuid":"6d518489-3477-446e-ab11-1f7984a8c563"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[{"measure":1,"metricUuid":"0feac7e6-add4-4723-abae-be5ce7864c63","weight":1}]},"createdAt":"2018-10-01T00:04:25Z","entityUuid":"dfb89c83-afc2-481e-895c-bff5468d6daf","parentUuid":"3d837696-3a99-4362-86a3-f460dd878b75","uuid":"caa9762f-08b2-40ad-88f2-78224cbf22c9"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":null,"title":"Has authority over the data been arranged for when the project is finished (potentially long ago)? Is there a data access committee?"},"createdAt":"2018-10-01T00:04:26Z","entityUuid":"feb954c1-c38e-4615-addd-4c714a06809a","parentUuid":"d748ea2b-bbe7-4b05-82e2-bee5e10e8441","uuid":"9a44ab53-5a44-4ad3-bebd-956aa15c2d27"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[{"measure":0,"metricUuid":"0feac7e6-add4-4723-abae-be5ce7864c63","weight":1}]},"createdAt":"2018-10-01T00:04:27Z","entityUuid":"79bf552f-4230-4026-9976-984ecdb8d889","parentUuid":"feb954c1-c38e-4615-addd-4c714a06809a","uuid":"55fea53f-97fa-4169-9683-bb028c0a13d5"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[{"measure":1,"metricUuid":"0feac7e6-add4-4723-abae-be5ce7864c63","weight":1}]},"createdAt":"2018-10-01T00:04:28Z","entityUuid":"aad68118-2159-4871-8d35-aeab6e66314e","parentUuid":"feb954c1-c38e-4615-addd-4c714a06809a","uuid":"0589b868-ad17-4ac7-a712-b115f3eca05b"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":null,"title":"Has it been established how long the archived data need to be kept? For each of the different parts of the archive (raw data / results)?"},"createdAt":"2018-10-01T00:04:29Z","entityUuid":"2dd94cbc-42f3-4077-b6da-83e0275290c5","parentUuid":"e81599af-4519-4987-b74e-9545428ed0e3","uuid":"d01bccf1-fe13-4227-8eb3-bb8a230253b1"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","referenceType":"ResourcePageReference","resourcePageUuid":null},"createdAt":"2018-10-01T00:04:30Z","entityUuid":"e6d881c0-a80c-45b7-9d62-eca9330af09f","parentUuid":"2dd94cbc-42f3-4077-b6da-83e0275290c5","uuid":"22f5721e-a0cb-489c-b36d-82d79186407e"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[{"measure":0,"metricUuid":"0feac7e6-add4-4723-abae-be5ce7864c63","weight":1}]},"createdAt":"2018-10-01T00:04:31Z","entityUuid":"1d8e9897-3713-4480-98ba-9b1c71f41eaf","parentUuid":"2dd94cbc-42f3-4077-b6da-83e0275290c5","uuid":"204ee0e2-1e94-469b-b0a4-46f85ae980de"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[{"measure":1,"metricUuid":"0feac7e6-add4-4723-abae-be5ce7864c63","weight":1}]},"createdAt":"2018-10-01T00:04:32Z","entityUuid":"07fdfbfb-9c7c-4e9c-83fa-bccf85094fb6","parentUuid":"2dd94cbc-42f3-4077-b6da-83e0275290c5","uuid":"d319efb9-0fe1-410a-bc5d-61cd04a2c0a5"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":"See also all questions about keeping metadata and data formats. Make sure the metadata is kept close to the data in the archive, and that community supported data formats are used for all long term archiving.","title":"Will the data still be understandable after a long time?"},"createdAt":"2018-10-01T00:04:33Z","entityUuid":"e23201aa-df56-4ade-9406-baa1fb6b1c0c","parentUuid":"e81599af-4519-4987-b74e-9545428ed0e3","uuid":"e914c17c-0152-4104-9505-ab91d4a30aeb"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","referenceType":"ResourcePageReference","resourcePageUuid":null},"createdAt":"2018-10-01T00:04:34Z","entityUuid":"00cf7418-99f5-494b-b77a-bc34a1ce77c5","parentUuid":"e23201aa-df56-4ade-9406-baa1fb6b1c0c","uuid":"a45c6128-b618-4d8b-a871-5ecb44b27e8c"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[{"measure":0,"metricUuid":"0bafe0c2-a8f2-4c74-80c8-dbf3a5b8e9b7","weight":1}]},"createdAt":"2018-10-01T00:04:35Z","entityUuid":"2e2460d5-5233-434b-9229-7cd775cb13b2","parentUuid":"e23201aa-df56-4ade-9406-baa1fb6b1c0c","uuid":"3bc5ea25-6b95-4738-8d43-88667075572b"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[{"measure":1,"metricUuid":"0bafe0c2-a8f2-4c74-80c8-dbf3a5b8e9b7","weight":1}]},"createdAt":"2018-10-01T00:04:36Z","entityUuid":"31de7c36-5d2c-469a-82b8-af870cb3560c","parentUuid":"e23201aa-df56-4ade-9406-baa1fb6b1c0c","uuid":"f2188cb0-6a3e-4b45-9261-a0d6682c079c"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":null,"title":"Will you need a shared working space to work with your data?"},"createdAt":"2018-10-01T00:04:37Z","entityUuid":"72099c46-16e7-47a2-a320-cc768b7085fe","parentUuid":"b1df3c74-0b1f-4574-81c4-4cc2d780c1af","uuid":"d8484982-17f3-4e0d-b3b2-6bef9a6fe859"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[]},"createdAt":"2018-10-01T00:04:38Z","entityUuid":"1d6ba101-fd62-43c8-ab53-76bc31847f58","parentUuid":"72099c46-16e7-47a2-a320-cc768b7085fe","uuid":"5c223767-17a5-40d0-8b2c-4e62ed580097"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":null,"title":"Are data all project members store adequately backed up and traceable?"},"createdAt":"2018-10-01T00:04:39Z","entityUuid":"c1e83bdf-5914-44c2-8414-0a4e7fbaf272","parentUuid":"1d6ba101-fd62-43c8-ab53-76bc31847f58","uuid":"1ee9b1bf-d3bd-4341-8030-da64a2c18e07"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[{"measure":0,"metricUuid":"8845fe2b-79df-4138-baea-3a035bf5e249","weight":1}]},"createdAt":"2018-10-01T00:04:40Z","entityUuid":"0c93a407-b04a-4c89-a8e4-299a4d77c21e","parentUuid":"c1e83bdf-5914-44c2-8414-0a4e7fbaf272","uuid":"f9191cf2-662d-467b-8499-21f4ee038b56"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes, protected against both equipment failure and human error","metricMeasures":[{"measure":1,"metricUuid":"8845fe2b-79df-4138-baea-3a035bf5e249","weight":1}]},"createdAt":"2018-10-01T00:04:41Z","entityUuid":"ec92df2d-f6db-4cc8-8317-ae24ab4fa08a","parentUuid":"c1e83bdf-5914-44c2-8414-0a4e7fbaf272","uuid":"d9af9ffb-99e0-4716-85d0-4a1f642f34b0"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[]},"createdAt":"2018-10-01T00:04:42Z","entityUuid":"e7324e1a-bfcb-4f2b-855a-35701dfb1ad5","parentUuid":"72099c46-16e7-47a2-a320-cc768b7085fe","uuid":"91e2b443-2bce-49a5-a728-dcab3ef7cd5a"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":"There are several questions regarding the dynamics of the data in the working area, who works with it, the software that is run on it, etc.","title":"How will you work with your data?"},"createdAt":"2018-10-01T00:04:43Z","entityUuid":"df36fb68-131c-4f31-a42b-684abf523bbc","parentUuid":"e7324e1a-bfcb-4f2b-855a-35701dfb1ad5","uuid":"8bf13cec-a764-4fd1-81da-78815a3bc6b7"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Explore","metricMeasures":[]},"createdAt":"2018-10-01T00:04:44Z","entityUuid":"5af813b7-cb41-4eb9-afe7-ca364771b74e","parentUuid":"df36fb68-131c-4f31-a42b-684abf523bbc","uuid":"016c0515-aed5-4f4f-a7dd-ebcd6e74063d"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"ValueQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":"When making the work space, it helps to know whether you expect to work with very many small files, a few very large files, whether you will use a (SQL) database to store most of the data. Maybe your data is suitable for a system like Hadoop? Such information can be collected here.","title":"What kind of data will you have in your work space?","validations":[],"valueType":"TextQuestionValueType"},"createdAt":"2018-10-01T00:04:45Z","entityUuid":"73bfcfcf-a619-4f6a-a901-2e8ce01d039a","parentUuid":"5af813b7-cb41-4eb9-afe7-ca364771b74e","uuid":"d64ed222-9d70-4396-b1c8-f4a245534ee5"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":"If you have large volumes of data that are intensely and repeatedly used by the computing work flow, it may be needed to keep the storage in the same place as where the computing takes place.","title":"Do you need the work space to be close to the compute capacity?"},"createdAt":"2018-10-01T00:04:46Z","entityUuid":"f6e66f4f-7b11-420f-a4b6-5fc972bc66d9","parentUuid":"5af813b7-cb41-4eb9-afe7-ca364771b74e","uuid":"3f01aed8-742f-4372-9c66-9eb2f3864aed"},{"content":{"annotations":[],"description":"Compute capacity planning","eventType":"AddReferenceEvent","referenceType":"CrossReference","targetUuid":"e87ef779-2c4b-4c0d-a1f1-821290123a3c"},"createdAt":"2018-10-01T00:04:47Z","entityUuid":"83081d6a-7e18-4ccf-97cd-f89193e73382","parentUuid":"f6e66f4f-7b11-420f-a4b6-5fc972bc66d9","uuid":"70ac3a78-ed85-42cc-9b18-09d50eb24c26"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","referenceType":"ResourcePageReference","resourcePageUuid":null},"createdAt":"2018-10-01T00:04:48Z","entityUuid":"cec4d69c-0a8b-4e0c-98c7-309d0c57d692","parentUuid":"f6e66f4f-7b11-420f-a4b6-5fc972bc66d9","uuid":"82782fb1-95b0-404a-9ebe-fd9bcf23db50"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[]},"createdAt":"2018-10-01T00:04:49Z","entityUuid":"12f3cb44-db3c-4ea8-b4fb-2834a11da6a7","parentUuid":"f6e66f4f-7b11-420f-a4b6-5fc972bc66d9","uuid":"4e7bc067-d142-4d32-a390-0e27b8bdd48e"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[]},"createdAt":"2018-10-01T00:04:50Z","entityUuid":"4cf287dd-6a24-4768-93b4-dd4a7767afb8","parentUuid":"f6e66f4f-7b11-420f-a4b6-5fc972bc66d9","uuid":"c9e91d8f-54bc-43ab-b980-68b85619b8c9"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":"Archival and working with data have different requirements. You want archived information to be in a form that others could read and in a format that is also understandable in a number of years. When working with the data, you need to be able to address it efficiently. If the two differ, you need to plan for conversions.","title":"Will you be working with your data in another form than the way it will be archived?"},"createdAt":"2018-10-01T00:04:51Z","entityUuid":"50f9d580-3e62-434b-81ff-86daed56aca8","parentUuid":"5af813b7-cb41-4eb9-afe7-ca364771b74e","uuid":"b2e764ba-04d3-417e-92bc-b24dfaacedd6"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No, data format will be archived in the same way we work with it","metricMeasures":[]},"createdAt":"2018-10-01T00:04:52Z","entityUuid":"df08a7fa-61af-418f-9eb8-965ba50efcc8","parentUuid":"50f9d580-3e62-434b-81ff-86daed56aca8","uuid":"c5353f0a-f7c8-409c-a8a8-0103eb8a00c0"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes, archival will require a conversion step","metricMeasures":[]},"createdAt":"2018-10-01T00:04:53Z","entityUuid":"02b8d129-3300-47cb-811a-e86a40c5d8bd","parentUuid":"50f9d580-3e62-434b-81ff-86daed56aca8","uuid":"1d10d5a6-b44d-470c-8a97-bbc2cd3acf3f"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":"To perform capacity planning, it is important to know what the need for storage capacity at the beginning and the end of the project will be.","title":"How does the storage need change over time?"},"createdAt":"2018-10-01T00:04:54Z","entityUuid":"4ee4d67d-62c5-47f0-a741-f2629b65cf8a","parentUuid":"5af813b7-cb41-4eb9-afe7-ca364771b74e","uuid":"e4fbdbae-8136-4e37-8f62-f9d7bc163238"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Storage needs will be the same during the whole project","metricMeasures":[]},"createdAt":"2018-10-01T00:04:55Z","entityUuid":"eef277cb-1032-401e-b242-e74afde575dc","parentUuid":"4ee4d67d-62c5-47f0-a741-f2629b65cf8a","uuid":"c20c29f9-653a-43f9-a382-d576413316f6"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Storage needs are large at the beginning and will be reduced later","metricMeasures":[]},"createdAt":"2018-10-01T00:04:56Z","entityUuid":"014d23a8-93a8-4fd2-ba1c-8656177f37b2","parentUuid":"4ee4d67d-62c5-47f0-a741-f2629b65cf8a","uuid":"e651c4de-f8c0-4e40-aedf-50db01be1baf"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Storage needs are small at the beginning and will grow later","metricMeasures":[]},"createdAt":"2018-10-01T00:04:57Z","entityUuid":"ab40db7f-ea89-4830-b507-4f2f08a9453e","parentUuid":"4ee4d67d-62c5-47f0-a741-f2629b65cf8a","uuid":"72d3f433-f0d2-486a-b3b8-7c3f05ec63c6"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Storage needs are largest in the middle of the project","metricMeasures":[]},"createdAt":"2018-10-01T00:04:58Z","entityUuid":"51a8248e-8659-47fd-a8e3-112eed64f65b","parentUuid":"4ee4d67d-62c5-47f0-a741-f2629b65cf8a","uuid":"cc425610-7ad1-42b4-a3ad-181874720096"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Explore","metricMeasures":[]},"createdAt":"2018-10-01T00:04:59Z","entityUuid":"aca843cd-e38e-4174-8ce1-477c2b405fdf","parentUuid":"4ee4d67d-62c5-47f0-a741-f2629b65cf8a","uuid":"9e85d340-8db4-4335-884b-2cfb22c7d41e"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":null,"title":"When will your raw data become available?"},"createdAt":"2018-10-01T00:05:00Z","entityUuid":"8526a988-9561-42c6-8af4-7c96aa4c536d","parentUuid":"aca843cd-e38e-4174-8ce1-477c2b405fdf","uuid":"66c3b2b5-2e21-4283-a101-121e81f6996e"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Raw data will come in right at the start","metricMeasures":[]},"createdAt":"2018-10-01T00:05:01Z","entityUuid":"adfc7ca3-c8e3-465b-8eb2-4327b8780684","parentUuid":"8526a988-9561-42c6-8af4-7c96aa4c536d","uuid":"2fbfcc19-dd80-4d31-9706-f28a2fc4bd61"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Raw data will come in during the project","metricMeasures":[]},"createdAt":"2018-10-01T00:05:02Z","entityUuid":"19755f9d-8ec2-4fd9-8bdf-b25d5889d7ee","parentUuid":"8526a988-9561-42c6-8af4-7c96aa4c536d","uuid":"91765e73-d823-4a27-babb-31372cbf99cd"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":"Sometimes the raw data is relatively large, and it pays of to clean it quickly.","title":"How much of the raw data do you need to keep in the work space?"},"createdAt":"2018-10-01T00:05:03Z","entityUuid":"01cd836b-915e-4751-b543-b326bf812594","parentUuid":"aca843cd-e38e-4174-8ce1-477c2b405fdf","uuid":"1bf49c9f-38a5-4a21-a656-f23acb9d7445"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Raw data will need to stay in the work space","metricMeasures":[]},"createdAt":"2018-10-01T00:05:04Z","entityUuid":"fe62c9a0-a621-46b6-bc42-881d0c3d8719","parentUuid":"01cd836b-915e-4751-b543-b326bf812594","uuid":"211d111c-d401-47ea-ba47-91fbc6d0aafd"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Raw data can be cleaned out or archived quickly","metricMeasures":[]},"createdAt":"2018-10-01T00:05:05Z","entityUuid":"aad7d438-a8af-4462-9728-77e2493bcacc","parentUuid":"01cd836b-915e-4751-b543-b326bf812594","uuid":"fe2a08ae-6720-476f-a008-5fbe523ae365"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":null,"title":"Do your raw data need to be archived?"},"createdAt":"2018-10-01T00:05:06Z","entityUuid":"ba381732-f499-419f-8744-e13807af83e3","parentUuid":"aad7d438-a8af-4462-9728-77e2493bcacc","uuid":"4ec8b6c2-1f0e-4970-b25e-3a9a8350c8fe"},{"content":{"annotations":[],"description":"Timing archival of raw data","eventType":"AddReferenceEvent","referenceType":"CrossReference","targetUuid":"7f8ff791-8593-4e00-93f9-e31c5dff5ffb"},"createdAt":"2018-10-01T00:05:07Z","entityUuid":"e4e53d85-6774-4472-b7cb-0f9eaad04a15","parentUuid":"ba381732-f499-419f-8744-e13807af83e3","uuid":"91ca034c-260e-434b-9948-fe662a599b40"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No, it is also stored elsewhere can be recovered easily","metricMeasures":[]},"createdAt":"2018-10-01T00:05:08Z","entityUuid":"904859c4-b9bf-44b6-9a64-933e489089e6","parentUuid":"ba381732-f499-419f-8744-e13807af83e3","uuid":"7cdd679b-24bf-42c5-8ffd-faf3365e5a72"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No, it can be remeasured easily and more cheaply than archiving","metricMeasures":[]},"createdAt":"2018-10-01T00:05:09Z","entityUuid":"e4da5030-9de8-4fe9-81d9-28a75edc09d9","parentUuid":"ba381732-f499-419f-8744-e13807af83e3","uuid":"512c4e95-0c12-45b4-9aff-ab70577e58c6"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[]},"createdAt":"2018-10-01T00:05:10Z","entityUuid":"44cad909-ea78-454b-aede-794503da9401","parentUuid":"ba381732-f499-419f-8744-e13807af83e3","uuid":"e237656c-19dc-49d3-9af4-20e25ff56db0"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Raw data do not form a major part of the storage needs","metricMeasures":[]},"createdAt":"2018-10-01T00:05:11Z","entityUuid":"93555e7b-d17c-4341-9ad9-9f2f833a3193","parentUuid":"01cd836b-915e-4751-b543-b326bf812594","uuid":"d3896387-76de-4a5d-ba42-8220a5834ace"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Raw data will only be loaded in the work space on demand from the primary archives","metricMeasures":[]},"createdAt":"2018-10-01T00:05:12Z","entityUuid":"0ddd0082-eae1-4c48-ba4a-30912f0643e7","parentUuid":"01cd836b-915e-4751-b543-b326bf812594","uuid":"2905cf31-4504-4535-8633-61c09c545625"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":null,"title":"Did you plan how much intermediate data you will get during analysis and how long each step needs to be kept?"},"createdAt":"2018-10-01T00:05:13Z","entityUuid":"c0944ac9-f286-48f2-b864-4641d0fcdd55","parentUuid":"aca843cd-e38e-4174-8ce1-477c2b405fdf","uuid":"ce654e1a-7785-4a12-bdcc-82faf6a327bb"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"The volume of intermediate data will not be significant","metricMeasures":[]},"createdAt":"2018-10-01T00:05:14Z","entityUuid":"96b1aa0f-56db-4613-b424-3fe33349386b","parentUuid":"c0944ac9-f286-48f2-b864-4641d0fcdd55","uuid":"81b28269-009d-41e7-9203-1b0d19363df9"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"A large volume of intermediate data will be in the work space","metricMeasures":[]},"createdAt":"2018-10-01T00:05:15Z","entityUuid":"9a0cfd22-adce-46e6-b7ec-8ed581ac95be","parentUuid":"c0944ac9-f286-48f2-b864-4641d0fcdd55","uuid":"0bf4394e-4528-4cf0-b1a9-559fec87cc82"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":"If the intermediate results are in your main work space, a restore in case of a problem could take much more time. It may be faster to recover it by re-running computations","title":"Is it possible to store intermediate temporary data on a separate (scratch) area that is not backed up?"},"createdAt":"2018-10-01T00:05:16Z","entityUuid":"deb647ec-a001-4370-87b8-a5b1e2479f87","parentUuid":"9a0cfd22-adce-46e6-b7ec-8ed581ac95be","uuid":"ada5f2ce-9b1d-4a01-977b-dfc92043bc27"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"We will use the main work space for temporary data","metricMeasures":[]},"createdAt":"2018-10-01T00:05:17Z","entityUuid":"55bab6f7-6ab9-4eb7-ae2b-1947cce2da84","parentUuid":"deb647ec-a001-4370-87b8-a5b1e2479f87","uuid":"2b033891-5f09-45b8-9f6b-3849feef9e4a"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"We can offload intermediate results to a scratch area that is not backed up","metricMeasures":[]},"createdAt":"2018-10-01T00:05:18Z","entityUuid":"5cbefa56-bc0c-4704-a9a4-3535ec513057","parentUuid":"deb647ec-a001-4370-87b8-a5b1e2479f87","uuid":"797ec48b-c58f-4e25-8ade-7bbb124191ac"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":null,"title":"Are you sure you will not need a backup of the data stored on the scratch file systems (any scratch you use)?"},"createdAt":"2018-10-01T00:05:19Z","entityUuid":"3a076e83-73b0-4cdd-bb71-c5d41469a191","parentUuid":"5cbefa56-bc0c-4704-a9a4-3535ec513057","uuid":"1f3a224d-7dfa-46b4-bd25-5bddca083ca4"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"How CSC restored 850 million temporary files","referenceType":"URLReference","url":"https://www.csc.fi/web/blog/post/-/blogs/the-largest-unplanned-outage-in-years-and-how-we-survived-it"},"createdAt":"2018-10-01T00:05:20Z","entityUuid":"94544b24-90e3-4d95-a0c0-bfed45cbdac9","parentUuid":"3a076e83-73b0-4cdd-bb71-c5d41469a191","uuid":"f6db9e21-0150-4935-8e49-230c5ffaedc4"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[]},"createdAt":"2018-10-01T00:05:21Z","entityUuid":"fe80319d-f761-49ac-9faf-d4c5a9b349da","parentUuid":"3a076e83-73b0-4cdd-bb71-c5d41469a191","uuid":"8259dfb5-ba04-49e0-91ed-76ebd463301a"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[]},"createdAt":"2018-10-01T00:05:22Z","entityUuid":"f4bf87cf-f5e6-4f06-adcf-0dcf9bb37e2a","parentUuid":"3a076e83-73b0-4cdd-bb71-c5d41469a191","uuid":"aa641c39-4622-4c41-a0cc-9ba4e2443c34"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":"Consider storing only the workflow parameters if the data itself could be reproduced quickly","title":"Will you have different versions of intermediate data that need to be kept?"},"createdAt":"2018-10-01T00:05:23Z","entityUuid":"89f78871-68bd-4190-9ee7-57ec3b4c2356","parentUuid":"aca843cd-e38e-4174-8ce1-477c2b405fdf","uuid":"f168749a-60a7-41b6-b3fc-63c07e3835d1"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[]},"createdAt":"2018-10-01T00:05:24Z","entityUuid":"28452352-0aea-43ee-9b22-f0131d7eba51","parentUuid":"89f78871-68bd-4190-9ee7-57ec3b4c2356","uuid":"098f193c-bb68-4d05-9d6a-c50cb2662a81"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[]},"createdAt":"2018-10-01T00:05:25Z","entityUuid":"ee686b11-0a50-4845-baae-d3ed3b3f5fcc","parentUuid":"89f78871-68bd-4190-9ee7-57ec3b4c2356","uuid":"d862bbad-9fde-42b1-853c-c7d0ab29b2e4"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":"Usually, data sets will be archived if it is unlikely you need them in the short term, but it would be hard to create them again, and/or they are essential for reproducing your work. Archival storage of large volumes can be significantly cheaper than keeping it in the working area for an extensive period.","title":"Will you need to temporarily archive data sets (e.g. to tape)?"},"createdAt":"2018-10-01T00:05:26Z","entityUuid":"50a9c060-91e9-4e34-8cb2-2d41fa493f9e","parentUuid":"5af813b7-cb41-4eb9-afe7-ca364771b74e","uuid":"ceddb4e9-a59b-41d9-a16f-fb7fb906527d"},{"content":{"annotations":[],"description":"Data archive setup","eventType":"AddReferenceEvent","referenceType":"CrossReference","targetUuid":"d5784d24-0e66-4821-bd62-a711fb6d7a40"},"createdAt":"2018-10-01T00:05:27Z","entityUuid":"1fa0cc82-65e6-492f-b982-19ea2636ed95","parentUuid":"50a9c060-91e9-4e34-8cb2-2d41fa493f9e","uuid":"254b0de8-e191-4d40-9831-34e74ce11329"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[]},"createdAt":"2018-10-01T00:05:28Z","entityUuid":"09ac9b88-4350-441b-97f4-5f85ced2ddf2","parentUuid":"50a9c060-91e9-4e34-8cb2-2d41fa493f9e","uuid":"055839ca-f1b7-4ce9-8ca6-21ad9728d792"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[]},"createdAt":"2018-10-01T00:05:29Z","entityUuid":"9797dc5a-afc9-418e-a456-0d555a52424a","parentUuid":"50a9c060-91e9-4e34-8cb2-2d41fa493f9e","uuid":"990acb5c-f908-46da-91fd-d8339bee6880"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":null,"title":"How will your first data come in?"},"createdAt":"2018-10-01T00:05:30Z","entityUuid":"f4065e54-d27a-45de-be4c-10384feacd0d","parentUuid":"5af813b7-cb41-4eb9-afe7-ca364771b74e","uuid":"12341b35-8532-4e03-8313-97fe861d5ec4"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No special planning is needed for the initial data","metricMeasures":[]},"createdAt":"2018-10-01T00:05:31Z","entityUuid":"2271d2cd-de50-460b-85a1-dddf9d28776c","parentUuid":"f4065e54-d27a-45de-be4c-10384feacd0d","uuid":"d62b1c6a-f372-413e-b40d-f94a10cfc21c"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Initial data will need to be made available through a local network copy","metricMeasures":[]},"createdAt":"2018-10-01T00:05:32Z","entityUuid":"9ad1d4fd-997d-45a8-8cc4-f594a8e4fdf8","parentUuid":"f4065e54-d27a-45de-be4c-10384feacd0d","uuid":"775f5776-530c-4f6a-8d2d-88e127b670a3"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"We will need a high-speed network connection to copy the initial data","metricMeasures":[]},"createdAt":"2018-10-01T00:05:33Z