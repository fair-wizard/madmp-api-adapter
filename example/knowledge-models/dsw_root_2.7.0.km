fb3-8052-49ee-aa34-89d205b8e192","parentUuid":"a1b486ba-1b7e-456c-ab5a-c5f950c0325d","uuid":"487af395-ecac-49af-9dfb-e61160ff4888"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2022-02-28T14:43:31Z","entityUuid":"c7496ece-4535-4f5d-bcf7-7845989906e9","parentUuid":"7dd7320e-41dd-43b9-b6aa-7622eaa34679","uuid":"76e46c38-8e0d-4472-b028-a248981f268e"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["4fa6f10d-b593-4b00-84cf-00d7f916147f"]},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":true,"value":"TextQuestionValueType"}},"createdAt":"2022-02-28T14:43:32Z","entityUuid":"c7496ece-4535-4f5d-bcf7-7845989906e9","parentUuid":"7dd7320e-41dd-43b9-b6aa-7622eaa34679","uuid":"5e3a0a6a-c2a7-4d7b-901f-229e51b8807a"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2022-02-28T14:43:33Z","entityUuid":"b7997cb8-4e3f-4df2-9996-4e581c7610fb","parentUuid":"7dd7320e-41dd-43b9-b6aa-7622eaa34679","uuid":"b85fd7cc-82b0-4dbb-a50c-9fff9d3d97eb"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["4fa6f10d-b593-4b00-84cf-00d7f916147f"]},"text":{"changed":true,"value":"[Article 6](https://gdpr-info.eu/art-6-gdpr/) (1) lists under what conditions the processing is considered lawful. Of these, **Consent** or **Public** interest are relevant when it comes to research. You should determine what legal basis (or bases) you have for processing the personal data in your project. \n\nTraditionally, *consent* has been the basis for processing personal data for research, but under the GDPR there cannot be an imbalance between the processor and the data subject for it to be considered to be freely given. In some countries the use of *consent* as the legal basis for processing by universities for research purposes is therefore not recommended. In those cases, public interest should probably be your legal basis. Note that if your legal basis for processing is consent, [a number of requirements](https://gdpr-info.eu/issues/consent/) exists for the consent to be considered valid under the GDPR. Consents given before the GDPR might not live up to this. \n\nAlso note that even if *public interest* is the legal basis, other laws and research ethics standards might still require you to have consent from the subjects for performing the research.\n\nPlease consult with the Data Protection Officer of your organisation on which legal basis to apply to your data."},"title":{"changed":true,"value":"What is the legal basis for processing the personal data? State cohort/dataset for each type of legal basis"}},"createdAt":"2022-02-28T14:43:34Z","entityUuid":"b7997cb8-4e3f-4df2-9996-4e581c7610fb","parentUuid":"7dd7320e-41dd-43b9-b6aa-7622eaa34679","uuid":"1aa9bfdf-232a-4640-86c9-4373ec421c61"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2022-02-28T14:43:35Z","entityUuid":"7475fb3f-8186-44f5-a811-6261461d60ca","parentUuid":"b7997cb8-4e3f-4df2-9996-4e581c7610fb","uuid":"1a182c6c-19d8-4d0a-a990-a22e65570e2d"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["4fa6f10d-b593-4b00-84cf-00d7f916147f"]},"text":{"changed":false},"title":{"changed":true,"value":"Select legal basis:"}},"createdAt":"2022-02-28T14:43:36Z","entityUuid":"7475fb3f-8186-44f5-a811-6261461d60ca","parentUuid":"b7997cb8-4e3f-4df2-9996-4e581c7610fb","uuid":"981e0805-c946-410c-a41a-b9ad808ec466"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-02-28T14:43:37Z","entityUuid":"599793f4-6309-463e-ad72-9e907ffa9f9a","parentUuid":"7475fb3f-8186-44f5-a811-6261461d60ca","uuid":"4d67415e-a6a8-46f9-9cb2-56c623903794"},{"content":{"advice":{"changed":true,"value":"Processing is necessary for the performance of a task carried out in the public interest under EU or national legislation. "},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Public interest"},"metricMeasures":{"changed":false}},"createdAt":"2022-02-28T14:43:38Z","entityUuid":"599793f4-6309-463e-ad72-9e907ffa9f9a","parentUuid":"7475fb3f-8186-44f5-a811-6261461d60ca","uuid":"5cee4f72-b15f-46e7-8f38-95b78d0704f7"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2022-02-28T14:43:39Z","entityUuid":"f4ee9037-72cc-44f4-b142-06ffe7a75208","parentUuid":"599793f4-6309-463e-ad72-9e907ffa9f9a","uuid":"0a4eb84c-96d9-47c7-afa0-1d87251e1f35"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["4fa6f10d-b593-4b00-84cf-00d7f916147f"]},"text":{"changed":false},"title":{"changed":true,"value":"Dataset(s)"},"validations":{"changed":false},"valueType":{"changed":true,"value":"StringQuestionValueType"}},"createdAt