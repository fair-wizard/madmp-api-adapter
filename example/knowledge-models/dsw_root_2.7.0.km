ue":"FAIRCookBook on licensing"},"referenceType":"URLReference","url":{"changed":true,"value":"https://w3id.org/faircookbook/FCB032"}},"createdAt":"2023-04-17T05:10:56Z","entityUuid":"f4b4c1a4-95df-4803-a601-2ac1843d0658","parentUuid":"3d89e23d-ff5c-45da-97a8-169ad8c39be6","uuid":"ad4ea0da-038b-42a1-8215-6e0bc6f431bc"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2023-04-17T05:25:10Z","entityUuid":"250662f3-6a33-4dbf-8fb4-abb91be3314b","parentUuid":"36938ca8-e22d-47a6-8859-a52f536101c5","uuid":"19d248c8-e263-4e59-b155-52cc04226434"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"FAIRCookBook on Software Licensing"},"referenceType":"URLReference","url":{"changed":true,"value":"https://w3id.org/faircookbook/FCB033"}},"createdAt":"2023-04-17T05:25:34Z","entityUuid":"250662f3-6a33-4dbf-8fb4-abb91be3314b","parentUuid":"36938ca8-e22d-47a6-8859-a52f536101c5","uuid":"787408fd-8c2a-4ce4-b33c-476017ef5756"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Open Source licenses give a series of permissions (and guarantees) to users of your software. There are a number of different open source licenses to choose from."},"title":{"changed":true,"value":"Will you be adding an open-source license?"}},"createdAt":"2023-04-17T05:28:14Z","entityUuid":"36938ca8-e22d-47a6-8859-a52f536101c5","parentUuid":"1ae8d7b0-4bcd-4914-aaea-fa389fc056f4","uuid":"6c1ce85f-4ca9-4e97-b3ee-cdfd8e6b8c17"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2023-04-17T05:30:24Z","entityUuid":"6c277217-8bc7-4768-94e2-be019571c94b","parentUuid":"13af8c24-3e2d-452c-8e5e-e6ab972a43fd","uuid":"413f23c8-837a-4114-af3c-dbb3c1f18107"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"FAIRCookBook on Data Licenses"},"referenceType":"URLReference","url":{"changed":true,"value":"https://w3id.org/faircookbook/FCB034"}},"createdAt":"2023-04-17T05:30:42Z","entityUuid":"6c277217-8bc7-4768-94e2-be019571c94b","parentUuid":"13af8c24-3e2d-452c-8e5e-e6ab972a43fd","uuid":"d21718e1-d49a-47e1-b5bc-a2b951015563"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2023-04-17T05:31:09Z","entityUuid":"dea35444-c8b4-4282-be9c-72e8092d01ed","parentUuid":"13af8c24-3e2d-452c-8e5e-e6ab972a43fd","uuid":"b432e7ea-6552-4407-a3de-516aeb11bc02"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"FAIRCookBook on Licensing"},"referenceType":"URLReference","url":{"changed":true,"value":"https://w3id.org/faircookbook/FCB032"}},"createdAt":"2023-04-17T05:31:19Z","entityUuid":"dea35444-c8b4-4282-be9c-72e8092d01ed","parentUuid":"13af8c24-3e2d-452c-8e5e-e6ab972a43fd","uuid":"90c1aa95-3ec6-485f-9fa8-0cea24232909"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"It is important to think early about ownership and permissions. Who will have the authority to decide later about the use of the reference data? Will a single person or single organisation be responsible for this?\n\nPlease note as well that many kinds of data can not be \"owned\"; you can only have copyrights on specific data collections, and those data base rights are not as universal as creative rights on other works."},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2023-04-17T05:36:00Z","entityUuid":"9f081091-0810-4f12-be7f-0a22ee928a14","parentUuid":"bdf55011-db06-4f4a-b26f-ebbbe029da04","uuid":"52bd646d-5621-42d8-a45a-aeefa07a20f4"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2023-04-17T05:38:28Z","entityUuid":"7c4f4af7-abaf-481c-b1c5-ab43b5b82c2c","parentUuid":"63b6e695-2371-412c-bed3-f13e157da0b4","uuid":"6d0f94cf-0b14-4b7b-b681-e9a60cf502a6"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"FAIRCookBook on permitted uses of data"},"referenceType":"URLReference","url":{"changed":true,"value":"https://w3id.org/faircookbook/FCB035"}},"createdAt":"2023-04-17T05:39:02Z","entityUuid":"7c4f4af7-abaf-481c-b1c5-ab43b5b82c2c","parentUuid":"63b6e695-2371-412c-bed3-f13e157da0b4","uuid":"23ba589a-d4d6-437d-b058-3826d33a156f"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2023-04-17T05:40:59Z","entityUuid":"7abea09a-913f-431e-9c4d-5bbcf2cf7c07","parentUuid":"106df534-f590-416b-8e4a-846edbdc4325","uuid":"56720a27-9e8b-4db8-9b49-5bce6628c473"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"FAIRCookBook on Provenance information"},"referenceType":"URLReference","url":{"changed":true,"value":"https://w3id.org/faircookbook/FCB036"}},"createdAt":"2023-04-17T05:41:34Z","entityUuid":"7abea09a-913f-431e-9c4d-5bbcf2cf7c07","parentUuid":"106df534-f590-416b-8e4a-846edbdc4325","uuid":"7c5a83ed-fe4f-41b7-abfa-f3a340ba5771"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":true,"value":["7abea09a-913f-431e-9c4d-5bbcf2cf7c07","074d97c3-b83f-4bc8-b17c-bebaa22a0c4c"]},"require