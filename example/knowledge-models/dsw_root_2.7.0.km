"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["3c7bdc90-8ed3-4b34-90ec-7945d14cc443","fd4637a2-a117-460a-a7fa-c03760c42629","87bb2042-8e3c-4733-ba1e-84509d7b1cf4"]},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2023-07-26T13:33:08Z","entityUuid":"c70e49f9-09e4-456a-814b-bbaa8fde887c","parentUuid":"7828d3a0-29bf-450e-aee9-473457a225fd","uuid":"6cb22a6a-5d64-45e3-8a61-4e98b7f0bde1"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["3c7bdc90-8ed3-4b34-90ec-7945d14cc443","87bb2042-8e3c-4733-ba1e-84509d7b1cf4"]},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2023-07-26T13:33:13Z","entityUuid":"f99b1723-c8e4-44b9-af22-f66955eda1e2","parentUuid":"8d1b07a7-f177-41f5-9532-05536223a8d6","uuid":"a9f40372-3720-4aa4-b20c-fb4a57fd1ffa"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["3c7bdc90-8ed3-4b34-90ec-7945d14cc443","87bb2042-8e3c-4733-ba1e-84509d7b1cf4"]},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2023-07-26T13:33:18Z","entityUuid":"05655914-e1f4-4578-a7d4-bae17579fce8","parentUuid":"facde7e9-8711-4ced-a6f8-5fbacf929381","uuid":"229a46fc-1935-44b1-adf6-c0a1a389fed9"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids"