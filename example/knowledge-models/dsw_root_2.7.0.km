e47f5915fcae"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Experts in the project, with our own equipment","metricMeasures":[]},"createdAt":"2018-10-01T00:07:43Z","entityUuid":"44ef09a4-5a78-439d-9fb4-940d3d84bfab","parentUuid":"ee59664e-4026-4796-a42a-e8003df6dadf","uuid":"9778190f-3f09-4d05-8284-248d3074517d"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Experts in the project, at a specialized infrastructure","metricMeasures":[]},"createdAt":"2018-10-01T00:07:44Z","entityUuid":"eb0b9a82-0379-47c3-967f-b35b40129af2","parentUuid":"ee59664e-4026-4796-a42a-e8003df6dadf","uuid":"9b14363c-5ff9-46bb-87c4-c2e6d6b169f7"},{"content":{"advice":"consider making them partner in the project","annotations":[],"eventType":"AddAnswerEvent","label":"External party","metricMeasures":[]},"createdAt":"2018-10-01T00:07:45Z","entityUuid":"f2784b7e-b0ed-4973-9d68-954c5c24e8bb","parentUuid":"ee59664e-4026-4796-a42a-e8003df6dadf","uuid":"4803fa64-3412-4b0b-8622-cebb9834fd04"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":null,"title":"Has formal ownership of the data been established?"},"createdAt":"2018-10-01T00:07:46Z","entityUuid":"aa27852a-00f4-44a4-a85c-0e0fd3ac20d1","parentUuid":"f2784b7e-b0ed-4973-9d68-954c5c24e8bb","uuid":"910b7ed1-ac9f-4773-99c4-874fcd5c3e5f"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"The party measuring the data owns it","metricMeasures":[]},"createdAt":"2018-10-01T00:07:47Z","entityUuid":"786edd0d-ae07-489c-b078-423c18e02043","parentUuid":"aa27852a-00f4-44a4-a85c-0e0fd3ac20d1","uuid":"8be378bf-5feb-4710-88cc-168460cd991a"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"The project partners acquire full ownership","metricMeasures":[]},"createdAt":"2018-10-01T00:07:48Z","entityUuid":"306f7ef4-97fd-47b0-84de-f192cb94ea3a","parentUuid":"aa27852a-00f4-44a4-a85c-0e0fd3ac20d1","uuid":"00301eea-0b55-4279-b3ed-f7ce1c9bcdea"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"We have made other arrangements","metricMeasures":[]},"createdAt":"2018-10-01T00:07:49Z","entityUuid":"399245d4-7988-461c-b940-ee813a1c99b1","parentUuid":"aa27852a-00f4-44a4-a85c-0e0fd3ac20d1","uuid":"01987a3d-b10f-4825-a8e6-43039616b44e"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"ValueQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":null,"title":"What other arrangements?","validations":[],"valueType":"TextQuestionValueType"},"createdAt":"2018-10-01T00:07:50Z","entityUuid":"227f056a-ada1-473b-af71-bb63d48b4940","parentUuid":"399245d4-7988-461c-b940-ee813a1c99b1","uuid":"908f1542-0194-4a2b-ba1c-9834f5dace9c"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":null,"title":"Has responsibility for long term safe keeping of the raw data been established? Who will deal with data publication?"},"createdAt":"2018-10-01T00:07:51Z","entityUuid":"f0a474ac-21b5-4b6a-9fd5-b9c3f8882055","parentUuid":"f2784b7e-b0ed-4973-9d68-954c5c24e8bb","uuid":"1351d6f9-5a1f-4f49-8166-2512a156490c"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"The measuring party will publish it after a fixed embargo period","metricMeasures":[]},"createdAt":"2018-10-01T00:07:52Z","entityUuid":"b10cd3bf-ecd6-4fa1-a9c4-d8d974de714c","parentUuid":"f0a474ac-21b5-4b6a-9fd5-b9c3f8882055","uuid":"bda9af92-e374-4b1a-b8b7-6b776b90fd85"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"The measuring party will publish it when the project tells them to","metricMeasures":[]},"createdAt":"2018-10-01T00:07:53Z","entityUuid":"a3393cc1-3393-45ba-ba91-e447bf755eb7","parentUuid":"f0a474ac-21b5-4b6a-9fd5-b9c3f8882055","uuid":"ce250485-c197-43f1-bb7b-8e5142f814ae"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"The measuring party will delete the data, the project partners will deal with data publication","metricMeasures":[]},"createdAt":"2018-10-01T00:07:54Z","entityUuid":"350fa8cc-ecc8-40cc-a50e-1d87405970b1","parentUuid":"f0a474ac-21b5-4b6a-9fd5-b9c3f8882055","uuid":"553af970-72f6-48f7-ab6a-1c0c9da0abea"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"We have made other arrangements","metricMeasures":[]},"createdAt":"2018-10-01T00:07:55Z","entityUuid":"8197cf1c-999a-43ae-9e29-bb5d0452052b","parentUuid":"f0a474ac-21b5-4b6a-9fd5-b9c3f8882055","uuid":"7b952a7f-fe51-4665-a365-d97f709d3969"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"ValueQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":null,"title":"What other arrangements?","validations":[],"valueType":"TextQuestionValueType"},"createdAt":"2018-10-01T00:07:56Z","entityUuid":"e576471a-40dd-453d-ba59-d3f4e1c30cc4","parentUuid":"8197cf1c-999a-43ae-9e29-bb5d0452052b","uuid":"fd0376d2-cab8-4759-a1c5-8ed7df790f18"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":"If the technology is very much under development, you may want to come back later to understand exactly how the measurements have been made. Is the measurement equipment and protocol sufficiently standard that you will be able to explain how it is done or refer to a standard explanation?","title":"Is the equipment completely standard and well described?"},"createdAt":"2018-10-01T00:07:57Z","entityUuid":"bce52f7f-2256-4afc-9801-2e4da8111470","parentUuid":"f5fef09d-ade5-4019-b089-f05bd89c34bc","uuid":"82ef72d6-3ec4-429a-b015-9fc7bcba1619"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Very well described and known","metricMeasures":[]},"createdAt":"2018-10-01T00:07:58Z","entityUuid":"cba473be-2489-4387-8877-ce49cf95a304","parentUuid":"bce52f7f-2256-4afc-9801-2e4da8111470","uuid":"c2e0952e-f09b-4bdd-8302-8032ce79a8a6"},{"content":{"advice":"Take pictures of the instruments for documentation, and keep copies of any documentation.","annotations":[],"eventType":"AddAnswerEvent","label":"Less well described or not completely standard","metricMeasures":[]},"createdAt":"2018-10-01T00:07:59Z","entityUuid":"526db9ec-a5a1-4431-9cc3-751fc6625217","parentUuid":"bce52f7f-2256-4afc-9801-2e4da8111470","uuid":"967c601a-9482-412e-8a43-a6905b3aae75"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":"Where does the data come from? And who will need it? Sometimes the raw data is measured somewhere else than where the primary processing is taking place. In such cases the ingestion or transport of the primary data may take special planning. You also need to make sure that data is secure and that data integrity is guaranteed.","title":"Is special care needed to get the raw data ready for processing?"},"createdAt":"2018-10-01T00:08:00Z","entityUuid":"28b99b8e-3a0c-45c5-8d2b-b778a7d43323","parentUuid":"f5fef09d-ade5-4019-b089-f05bd89c34bc","uuid":"00bec7b6-d6bf-4deb-89b0-483876045820"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No, this is all fine","metricMeasures":[]},"createdAt":"2018-10-01T00:08:01Z","entityUuid":"b541e78e-3300-4e7d-ac36-93d7b5ebf031","parentUuid":"28b99b8e-3a0c-45c5-8d2b-b778a7d43323","uuid":"35e6b7fe-a916-45de-b296-f6ea4eada8df"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes, lets explore this","metricMeasures":[]},"createdAt":"2018-10-01T00:08:02Z","entityUuid":"065a500b-53c0-487f-9096-00fd6f7234a6","parentUuid":"28b99b8e-3a0c-45c5-8d2b-b778a7d43323","uuid":"dd99ddf7-e8bb-41f0-aca8-a192ef6e7575"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":"Has the storage and transport format of the primary data been established between the people responsible for the measurement and the people responsible for the processing?","title":"Is the data format established?"},"createdAt":"2018-10-01T00:08:03Z","entityUuid":"2c5fd209-1ff5-4c34-b6e4-2bf1228e97de","parentUuid":"065a500b-53c0-487f-9096-00fd6f7234a6","uuid":"70618c7b-764b-407b-981b-4d6d64c38ec4"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[{"measure":0,"metricUuid":"8845fe2b-79df-4138-baea-3a035bf5e249","weight":1}]},"createdAt":"2018-10-01T00:08:04Z","entityUuid":"856438ef-024b-4e82-b8ba-0010beb39f61","parentUuid":"2c5fd209-1ff5-4c34-b6e4-2bf1228e97de","uuid":"92e30fbb-06fe-42d8-b19b-8e3939c96ed4"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[{"measure":1,"metricUuid":"8845fe2b-79df-4138-baea-3a035bf5e249","weight":1}]},"createdAt":"2018-10-01T00:08:05Z","entityUuid":"abc6b715-2d2b-4ee8-81c5-ac2c55d1cac2","parentUuid":"2c5fd209-1ff5-4c34-b6e4-2bf1228e97de","uuid":"64839f5a-730a-46f0-ac58-f892c8fd94b9"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":null,"title":"How will the raw data be transported?"},"createdAt":"2018-10-01T00:08:06Z","entityUuid":"2e8d6e55-36ea-46eb-a921-65e550bce5dc","parentUuid":"065a500b-53c0-487f-9096-00fd6f7234a6","uuid":"d8bda828-0fbc-467a-886d-0b052d792fb1"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No transport is needed, analysis is done where it is obtained","metricMeasures":[]},"createdAt":"2018-10-01T00:08:07Z","entityUuid":"489c3813-c010-4197-b54a-41e742aa8f35","parentUuid":"2e8d6e55-36ea-46eb-a921-65e550bce5dc","uuid":"f308e789-0e08-4520-aa0e-bea374730212"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"On physical media","metricMeasures":[]},"createdAt":"2018-10-01T00:08:08Z","entityUuid":"8c9c3d59-cd51-4303-9202-519e30998e1a","parentUuid":"2e8d6e55-36ea-46eb-a921-65e550bce5dc","uuid":"9e4aa3fb-204d-4ba1-99aa-8e631ce190b0"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":"Has time been reserved on any tape/disk reading and writing stations?","title":"Is sufficient writing and reading capacity available for the physical media?"},"createdAt":"2018-10-01T00:08:09Z","entityUuid":"31da89a7-4d04-4345-a414-ea1226377df7","parentUuid":"8c9c3d59-cd51-4303-9202-519e30998e1a","uuid":"b11c119d-1a6e-4ea5-bc9a-31401ae417e2"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes, has been taken care of","metricMeasures":[]},"createdAt":"2018-10-01T00:08:10Z","entityUuid":"be674d81-cadb-470a-acf9-7365175b533d","parentUuid":"31da89a7-4d04-4345-a414-ea1226377df7","uuid":"2fa3687c-79ff-4bc4-b103-04181dff5bb8"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Via the network","metricMeasures":[]},"createdAt":"2018-10-01T00:08:11Z","entityUuid":"ca02196a-aae3-42aa-b6cb-aeb1b86f752a","parentUuid":"2e8d6e55-36ea-46eb-a921-65e550bce5dc","uuid":"9f8d53b5-9efc-47b5-8f5b-46e9ec958346"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":"Can the volume of data be accommodated by the standard network connection? Has a special network connection (e.g. light path) that is needed been reserved?","title":"Is sufficient network capacity available?"},"createdAt":"2018-10-01T00:08:12Z","entityUuid":"3d942d91-39a2-4d2f-a27a-6fe57deb87ff","parentUuid":"ca02196a-aae3-42aa-b6cb-aeb1b86f752a","uuid":"365178bd-4b4f-4509-9ce9-b22a49a8663b"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes, has been taken care of","metricMeasures":[]},"createdAt":"2018-10-01T00:08:13Z","entityUuid":"44dfd6cb-b3ce-41a4-bca8-9689be8df67c","parentUuid":"3d942d91-39a2-4d2f-a27a-6fe57deb87ff","uuid":"9aa11aca-fdf9-4cba-9ce1-6305883735af"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":"Do you have any means of identifying whether the raw data has been transferred error free and has not been tampered with?","title":"Is data integrity guaranteed during this stage?"},"createdAt":"2018-10-01T00:08:14Z","entityUuid":"129f74a4-dc91-4cc7-aee3-b384c8ea30dd","parentUuid":"065a500b-53c0-487f-9096-00fd6f7234a6","uuid":"a2631798-2e79-40fe-b320-12695dc65df3"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[{"measure":0,"metricUuid":"0feac7e6-add4-4723-abae-be5ce7864c63","weight":1}]},"createdAt":"2018-10-01T00:08:15Z","entityUuid":"faafb22b-bebe-4dc1-adf7-2d398d5d52de","parentUuid":"129f74a4-dc91-4cc7-aee3-b384c8ea30dd","uuid":"ec1fc9dc-e0ad-455e-9561-f80d5afca6a0"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[{"measure":1,"metricUuid":"0feac7e6-add4-4723-abae-be5ce7864c63","weight":1}]},"createdAt":"2018-10-01T00:08:16Z","entityUuid":"5935eebc-017c-4b4c-b44f-02ba0e614eca","parentUuid":"129f74a4-dc91-4cc7-aee3-b384c8ea30dd","uuid":"e6f35733-4563-4e60-9286-cd03b269bc95"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":"Are the raw data encrypted or otherwise protected from theft or leaks at either site or during transport? You could e.g. use a light path or a virtual private network if you transport the data over the net.","title":"Is data security guaranteed during this stage?"},"createdAt":"2018-10-01T00:08:17Z","entityUuid":"0ebd660b-364a-4357-9044-c4dc0293a9ba","parentUuid":"065a500b-53c0-487f-9096-00fd6f7234a6","uuid":"4a97581b-6705-4c18-8cfe-a2e904aa3504"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No, not needed","metricMeasures":[]},"createdAt":"2018-10-01T00:08:18Z","entityUuid":"c30318bd-f2ca-4328-ae27-a14870916543","parentUuid":"0ebd660b-364a-4357-9044-c4dc0293a9ba","uuid":"84bd5b1e-b855-4a99-adca-a3e9a9fc8326"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[]},"createdAt":"2018-10-01T00:08:19Z","entityUuid":"a87f2a11-94c5-43cf-acc4-30dc54a1a41b","parentUuid":"0ebd660b-364a-4357-9044-c4dc0293a9ba","uuid":"70938c1e-c2d3-466d-9d5e-cd44ce548da5"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":"Does the data you collect contain non-equipment captured data such as questionnaires, case report forms, electronic patient records?","title":"Do you have any non-equipment data capture?"},"createdAt":"2018-10-01T00:08:20Z","entityUuid":"f038bd46-ee4e-4f53-b7ea-482381c2c855","parentUuid":"c4eda690-066f-495a-8c29-8e8a258ac487","uuid":"085953d1-2d2f-4a18-8f9c-9f9a78036964"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","referenceType":"ResourcePageReference","resourcePageUuid":null},"createdAt":"2018-10-01T00:08:21Z","entityUuid":"a338b156-3c43-4b26-8b10-bc6e485b80b5","parentUuid":"f038bd46-ee4e-4f53-b7ea-482381c2c855","uuid":"323e3b7b-fb70-49b4-901a-5f8dfeac56ec"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[]},"createdAt":"2018-10-01T00:08:22Z","entityUuid":"514befe5-76b0-4e4e-bdf5-2bc164e38d7f","parentUuid":"f038bd46-ee4e-4f53-b7ea-482381c2c855","uuid":"7e683ee7-10ea-4e22-abb1-c72cb5ee6986"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[]},"createdAt":"2018-10-01T00:08:23Z","entityUuid":"4fd89b13-f33c-4858-8b25-ab6da271efc6","parentUuid":"f038bd46-ee4e-4f53-b7ea-482381c2c855","uuid":"6e062de0-0657-4c24-b214-b89ab141f7eb"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":null,"title":"Will you be collecting questionnaires?"},"createdAt":"2018-10-01T00:08:24Z","entityUuid":"85079340-7b80-4dc7-86ae-cc5f599ec737","parentUuid":"4fd89b13-f33c-4858-8b25-ab6da271efc6","uuid":"c83bde97-36a3-43f7-989e-771e2b929953"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[]},"createdAt":"2018-10-01T00:08:25Z","entityUuid":"000f21de-fdf6-4c9d-9bfb-847db544613b","parentUuid":"85079340-7b80-4dc7-86ae-cc5f599ec737","uuid":"a5c235a1-b1a4-42cc-964c-fe96979fa134"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[]},"createdAt":"2018-10-01T00:08:26Z","entityUuid":"81baba8e-d43c-48f9-b39a-c0adfad08f64","parentUuid":"85079340-7b80-4dc7-86ae-cc5f599ec737","uuid":"1ee59930-867e-4cb1-98a0-fd78a9707986"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":null,"title":"Will you be collecting case report forms?"},"createdAt":"2018-10-01T00:08:27Z","entityUuid":"36a5ed1e-ecd5-4b86-a719-f1196e376a52","parentUuid":"4fd89b13-f33c-4858-8b25-ab6da271efc6","uuid":"a43fa13f-66dc-4cab-9a1b-30dc130e30ff"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","referenceType":"ResourcePageReference","resourcePageUuid":n