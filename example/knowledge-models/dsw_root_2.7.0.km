da3b-4d5f-446c-a50a-b876668c2360","parentUuid":"948b5fd8-c1bd-457d-8f81-ea2fd093f541","uuid":"5717b3fa-157e-4010-a277-287ed3aed187"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Our Workflow System documents provenance","metricMeasures":[]},"createdAt":"2020-11-11T10:50:43Z","entityUuid":"ea0a8fca-3561-47b2-8615-8c699028f504","parentUuid":"948b5fd8-c1bd-457d-8f81-ea2fd093f541","uuid":"fadcdd77-3e73-4228-9551-57e40a0639cc"},{"content":{"eventType":"DeleteAnswerEvent"},"createdAt":"2020-11-11T10:50:44Z","entityUuid":"ea0a8fca-3561-47b2-8615-8c699028f504","parentUuid":"948b5fd8-c1bd-457d-8f81-ea2fd093f541","uuid":"0ab9151a-2250-486d-b51c-3fd4b992be98"},{"content":{"eventType":"DeleteQuestionEvent"},"createdAt":"2020-11-11T10:50:45Z","entityUuid":"daa06d1a-6314-4c6d-93a8-69954c7f5c54","parentUuid":"6d18bfff-0f53-469b-934e-9806dda9d4fb","uuid":"c6c1b8f8-6d19-4ed0-a31d-64aeabb38511"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Data analysis is normally done step-by-step. It is essential to make sure all steps are properly documented, otherwise results will not be reproducible. Re-users of the data also need this information to decide whether the data can be used for their purpose."},"title":{"changed":true,"value":"How will you be keeping track of the \"provenance\" of the data?"}},"createdAt":"2020-11-11T10:50:46Z","entityUuid":"948b5fd8-c1bd-457d-8f81-ea2fd093f541","parentUuid":"6d18bfff-0f53-469b-934e-9806dda9d4fb","uuid":"6dc82faf-ab8c-4a6e-977c-0342b8146c14"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":"Some workflow systems automatically keep track of which steps were done in data analysis and what options were selected. This can help document the data for reproducibility.","title":"Will you use a workflow system that automatically keeps track of the steps in the analysis?"},"createdAt":"2020-11-11T10:50:47Z","entityUuid":"91a7c75c-6f0e-4bae-b3f3-1890feaae9b2","parentUuid":"6d18bfff-0f53-469b-934e-9806dda9d4fb","uuid":"1eb6929f-e4cc-4174-943b-5a2f57c235d0"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[]},"createdAt":"2020-11-11T10:50:48Z","entityUuid":"fdb89e4f-f108-4d4f-9145-07e255137d85","parentUuid":"91a7c75c-6f0e-4bae-b3f3-1890feaae9b2","uuid":"f154d7c9-f31d-4612-bf76-92a9b8f0b794"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[]},"createdAt":"2020-11-11T10:50:49Z","entityUuid":"e9568fd5-1fe0-41d5-a46d-30b2d2668e12","parentUuid":"91a7c75c-6f0e-4bae-b3f3-1890feaae9b2","uuid":"ccca1b36-3da9-48bc-b0c1-5b25fd697a1d"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":true,"value":"1796fa3c-9f53-475f-89ff-c66a0453c42e"},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2020-11-11T10:50:50Z","entityUuid":"91a7c75c-6f0e-4bae-b3f3-1890feaae9b2","parentUuid":"6d18bfff-0f53-469b-934e-9806dda9d4fb","uuid":"1ae1b06a-8127-47a1-bff7-6c4c02674d9f"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":false},"metricMeasures":{"changed":true,"value":[{"measure":0,"metricUuid":"0bafe0c2-a8f2-4c74-80c8-dbf3a5b8e9b7","weight":1}]}},"createdAt":"2020-11-11T10:50:51Z","entityUuid":"fdb89e4f-f108-4d4f-9145-07e255137d85","parentUuid":"91a7c75c-6f0e-4bae-b3f3-1890feaae9b2","uuid":"56d5c9fc-a7ce-46b2-998b-a0aca77b9e41"},{