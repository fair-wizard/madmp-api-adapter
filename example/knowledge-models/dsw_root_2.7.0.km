anged":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"FAIRCookbook on creating checksum files"},"referenceType":"URLReference","url":{"changed":false}},"createdAt":"2023-06-12T11:52:25Z","entityUuid":"b0955b59-a0a1-47ef-9850-348bc9f2d1ee","parentUuid":"e0759fdc-7ce9-4020-816d-73119f634c7e","uuid":"a3665717-556a-426b-9805-da2c60610d92"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"FAIRCookbook on making Workflows FAIR"},"referenceType":"URLReference","url":{"changed":false}},"createdAt":"2023-06-12T11:52:36Z","entityUuid":"0d83c012-eb25-4078-a5e2-139fe6b31cb7","parentUuid":"730bf055-5e8e-4837-992c-d8a071855b4f","uuid":"068ea120-8f0d-4ec9-8dc0-8fc34378c69e"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"FAIRCookbook on Interlinking data using mappings"},"referenceType":"URLReference","url":{"changed":false}},"createdAt":"2023-06-12T11:52:45Z","entityUuid":"412739e0-2dd4-475d-b4aa-0c5cb2e3d3bc","parentUuid":"109ed7ea-ef1d-4719-b2b4-eb4f7202c65c","uuid":"e042f12a-d5ee-4587-98b4-c9a9504fcf15"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"FAIRCookbook on selecting an ontology lookup service"},"referenceType":"URLReference","url":{"changed":false}},"createdAt":"2023-06-12T11:52:50Z","entityUuid":"bc1a7f76-a2e4-426b-a360-48ea0a6cce80","parentUuid":"f67e1539-5c7d-4df7-8259-e4f2edfa2685","uuid":"2644b9bf-3d31-41fd-9494-7328381dbcf9"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"FAIRCookbook on depositing to a generic repository like Zenodo"},"referenceType":"URLReference","url":{"changed":false}},"createdAt":"2023-06-12T11:52:55Z","entityUuid":"b07291f6-fc6d-4e05-8d72-0a41ea5fa6ba","parentUuid":"80a682bd-8a5c-4a52-935d-680509838a4e","uuid":"b0522999-f013-4629-9a2f-4ce15ff1559b"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"FAIRCookbook on licensing"},"referenceType":"URLReference","url":{"changed":false}},"createdAt":"2023-06-12T11:53:01Z","entityUuid":"f4b4c1a4-95df-4803-a601-2ac1843d0658","parentUuid":"3d89e23d-ff5c-45da-97a8-169ad8c39be6","uuid":"dcebeb96-0f73-4304-90ad-8a27454b9d9a"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"FAIRCookbook on creating resolvable identifiers"},"referenceType":"URLReference","url":{"changed":false}},"createdAt":"2023-06-12T11:53:06Z","entityUuid":"b0f4ce3b-4dcd-467f-92e1-07c4f97004b7","parentUuid":"d21fdb06-22bf-418e-aa40-dc5ef1485f56","uuid":"7c67aae5-4982-4735-9517-a55c072da798"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"FAIRCookbook on Software Licensing"},"referenceType":"URLReference","url":{"changed":false}},"createdAt":"2023-06-12T11:53:17Z","entityUuid":"250662f3-6a33-4dbf-8fb4-abb91be3314b","parentUuid":"36938ca8-e22d-47a6-8859-a52f536101c5","uuid":"542dcf49-ba69-4b29-9034-16be90d97ec3"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"FAIRCookbook on Data Licenses"},"referenceType":"URLReference","url":{"changed":false}},"createdAt":"2023-06-12T11:53:23Z","entityUuid":"6c277217-8bc7-4768-94e2-be019571c94b","parentUuid":"13af8c24-3e2d-452c-8e5e-e6ab972a43fd","uuid":"a0419761-98f4-467c-8e70-3b41ee3f31c2"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"FAIRCookbook on Licensing"},"referenceType":"URLReference","url":{"changed":false}},"createdAt":"2023-06-12T11:53:27Z","entityUuid":"dea35444-c8b4-4282-be9c-72e8092d01ed","parentUuid":"13af8c24-3e2d-452c-8e5e-e6ab972a43fd","uuid":"65193ead-2565-4868-a146-fe2bde210dd7"},{"content":{"annotations":{"changed":false},"description":{"changed":true,"value":"Some data stewardship issues already need to be addressed during the creation of a proposal for a research project. For example these could be questions that can have a significant impact on the budget or timeline of a project. Only such questions are labeled as \"desirable\" in this phase.\n"},"eventType":"EditPhaseEvent","title":{"changed":false}},"createdAt":"2023-06-14T08:21:35Z","entityUuid":"b101f2d0-2476-452d-aa8d-95a41a02b52c","parentUuid":"6f6241d9-136c-4770-9d58-8a3f39607052","uuid":"334182c5-cdfc-4974-bc18-59eb8a42be06"},{"content":{"annotations":{"changed":false},"description":{"changed":true,"value":"In many research projects, the finished data management plan is one of the early deliverables. Questions that should be addressed in those early months of the project are highlighted as desirable when this phase is selected."},"eventType":"EditPhaseEvent","title":{"changed":false}},"createdAt":"2023-06-14T08:21:48Z","entityUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","parentUuid":"6f6241d9-136c-4770-9d58-8a3f39607052","uuid":"3e5cfd58-7ed6-46a5-ab6a-3736e64847d9"},{"content":{"annotations":{"changed":false},"description":{"changed":true,"value":"When a project rounds up, this means that all data has found its final spots. In this phase, questions that document the final state of affairs will be labeled as desirable.\n"},"eventType":"EditPhaseEvent","title":{"changed":false}},"createdAt":"2023-06-14T08:22:09Z","entityUuid":"adc9133d-afcd-4616-9aea-db5f475898a2","parentUuid":"6f6241d9-136c-4770-9d58-8a3f39607052","uuid":"e53bfbdd-04b6-424e-8eea-eaaa66e864d3"},{"content":{"annotations":{"changed":false},"description":{"changed":true,"value":"After a project is finished, the team conducts a comprehensive project review to evaluate its overall success and identify areas for future improvement and followup. Relevant feedback is gathered from stakeholders, and the team is finalizing reports and archiving project documentation. Finally, lessons learned are being documented for future reference. Questions relevant for these processes will be labeled as desirable in this phase."},"eventType":"EditPhaseEvent","title":{"changed":false}},"createdAt":"2023-06-14T08:25:07Z","entityUuid":"1ace0fc6-a949-495f-a32e-e948f3f6bed1","parentUuid":"6f6241d9-136c-4770-9d58-8a3f39607052","uuid":"d9306ec4-1b0c-4740-9650-70ac82840638"}],"forkOfPackageId":null,"id":"dsw:root:2.6.0","kmId":"root","language":"en","license":"Apache-2.0","mergeCheckpointPackageId":null,"metamodelVersion":20,"name":"Common DSW Knowledge Model","nonEditable":false,"organizationId":"dsw","phase":"ReleasedKnowledgeModelPackagePhase","previousPackageId":"dsw:root:2.5.0","readme":"# Common DSW Knowledge Model\n\nCommon DSW Knowledge Model deals with questions that a researcher should answer in order to create a Data Stewardship Plan, as well as other related questionnaire data.\n\n## Contributors\n\n* **Rob Hooft** <[rob.hooft@health-ri.nl](mailto:rob.hooft@health-ri.nl)>\n  * ORCID: [0000-0001-6825-9439](https://orcid.org/0000-0001-6825-9439)\n  * GitHub: [@rwwh](https://github.com/rwwh)\n* **Marek Suchánek** <[marek.suchanek@ds-wizard.org](mailto:marek.suchanek@ds-wizard.org)>\n  * ORCID: [0000-0001-7525-9218](https://orcid.org/0000-0001-7525-9218)\n  * GitHub: [@MarekSuchanek](https://github.com/MarekSuchanek)\n\n## Acknowledgements\n\n* Several versions of this KM (between 2.3 and 2.5) were made during workshop with various participants as part of the ELIXIR-CONVERGE project\n* The initial knowledge model has been made based on a mindmap made by Rob Hooft: [Data Stewardship Mindmap](https://zenodo.org/record/3351949)\n\n## Changelog\n\n### 2.6.0\n\n*Released*: 2023-06-28\n\n* Add phase descriptions\n* Improve integrations (item templates)\n* Add references to [FAIR Cookbook](https://faircookbook.elixir-europe.org/)\n* ELSI tag and relate questions\n\n### 2.5.0\n\n*Released*: 2023-06-28\n\n* Incorporation changes/restructuring of questions related to human data \n\n### 2.4.5\n\n*Released*: 2023-01-27\n\n* Minor textual changes\n\n### 2.4.4\n\n*Released*: 2022-09-22\n\n* Fix duplicated *Horizon Europe DMP* tags for several questions\n\n### 2.4.3\n\n*Released*: 2022-09-22\n\n* Use of new value-question types (mostly email and URL)\n* New references\n\n### 2.4.2\n\n*Released*: 2022-06-15\n\n* Changes from workshops together with RDMkit on Toxicology, Biomolecular Simulations and    \n   Epitranscriptomics\n  - Small changes to phrasing and clarifications in various locations\n  - New guidance hierarchies added to locate existing data, standards and terminologies\n  - Moved \"provenance\" questions into the rest of the \"metadata\" group\n  - Added guidance summarising how to avoid problems with large amounts of intermediate data\n\n### 2.4.1\n\n*Released*: 2022-04-09\n\n* Fixed several minor typos (missing end of sentence, misspelling, typography etc.)\n\n### 2.4.0\n\n*Released*: 2022-03-15\n\n* KM verified and tested with the **Horizon Europe DMP template**\n\n### 2.3.14\n\n*Released*: 2022-03-10\n\n* Tags for Horizon Europe template generated\n\n### 2.3.13\n\n*Released*: 2022-03-08\n\n* Incorporating changes related to the Data Reuse workshop with RDMkit\n\n### 2.3.12\n\n*Released*: 2022-02-15\n\n* Incorporating changes related to the Data Analytics workshop with RDMkit\n\n### 2.3.11\n\n*Released*: 2022-02-15\n\n* Incorporating changes made in the Plant Sciences workshop with RDMkit\n\n### 2.3.10\n\n*Released*: 2022-02-03\n\n* Added references and questions from an RDMkit/DS Wizard working session on Preserving Data\n\n### 2.3.9\n\n*Released*: 2022-01-27\n\n* Fix missing Yes/No answers and use Text-Value for description of policies\n\n### 2.3.8\n\n*Released*: 2022-01-14\n\n* Questions for Horizon Europe added on budget for data management, other policies that are observed, persistent identifier allocation and archive preservation policies [Marek/Jana Horizon Europe issues 7-9, 11]\n\n### 2.3.7\n\n*Released*: 2022-01-11\n\n* Added references and questions from an RDMkit/DS Wizard working session on Human Data\n\n### 2.3.6\n\n*Released*: 2022-01-10\n\n* Questions about metadata for Horizon Europe added [Marek/Jana Horizon Europe issues 4-6]\n\n### 2.3.5\n\n*Released*: 2022-01-10\n\n* Added Tag for Horizon Europe\n* Moved the new questions from 2.3.4 from \"Science Europe\" to \"Horizon Europe\"\n* Added new question about qualified references from published data sets [Marek/Jana Horizon Europe issue 3]\n\n### 2.3.4\n\n*Released*: 2022-01-10\n\n* Change lists of reused (non-)reference datasets that are reused into lists of considered datasets, and add a question for each detailing whether they are actually reused and what for / why not. This is to be included in the Science Europe template [Marek/Jana Horizon Europe issue 1 and 2].\n\n### 2.3.3\n\n*Released*: 2021-12-14\n\n* Incorporation of changes from a collaborative workshop with RDMkit participants on data processing.\n   * Added links to RDMkit (and some to other external resources) in several places\n   * Clarified some questions\n   * Added question on data versioning for filesystems\n\n### 2.3.2\n\n*Released*: 2021-11-30\n\n* Incorporation of changes from a workshop with the authors of the RDMkit page on data collecting.\n   * Added links to RDMkit in several places\n   * Clarified some questions\n   * Moved questions on quality together\n   * Moved some questions out of the metadata subsection\n\n### 2.3.1\n\n*Released*: 2021-11-02\n\n* Incorporation of changes from a workshop with the authors of the RDMkit page on data sharing.\n    * Attempt to clarify difference between \"open\" and \"accessible\"\n    * Attempt to clarify difference between \"open\" and \"embargoed\"\n    * Added links to RDMkit Data Sharing page in a few places\n    * Added a few relevant questions\n\n### 2.3.0\n\n*Released*: 2020-11-11\n\nActivity during [BioHackathon Europe](biohackathon-europe.org) 2020 ([#BioHackEU20](twitter.com/search?q=%23BioHackEU20))\n\n* Added and tagged questions for Horizon 2020 template\n* Moved questions about collecting metadata to one consistent place\n* Added guidance on semantics in file names and question about using PIDs for identifying files\n* Generic small cleanups and typo fixes\n* Closing many issues of feedback received on the knowledge model (from [DSWGlobal/dsw](https://github.com/DSWGlobal/dsw))\n* Various question updates new options, clarifications, integrations\n* Added highly configurable [Wikidata](https://www.wikidata.org) SPARQL-based integration\n* Added [Research Organization Registry](https://ror.org) integration for contributor's affiliation\n\n### 2.2.0\n\n*Released*: 2020-07-01\n\n* Adjusted for compatibility with [RDA DMP Common Standard for machine-actionable DMPs (1.0)](https://github.com/RDA-DMP-Common/RDA-DMP-Common-Standard)\n  * Updated *Project* and *Funding* questions in *Administrative Details* chapter\n  * Reorganised *Dataset*, *Distribution*, *License* questions in *Data Publishing* chapter\n* Added *maDMP* tag to questions used in the RDA maDMP template\n\n### 2.1.0\n\n*Released*: 2020-05-09\n\n* Added *Science Europe DMP* tag to questions used in the Science Europe template\n\n### 2.0.2\n\n*Released*: 2020-05-09\n\n* Fixed missing and duplicated questions\n\n### 2.0.1\n\n*Released*: 2020-03-24\n\n* Fixed duplicated question in *Creating and collecting data* chapter (5ba53879-eb48-47f2-a73b-f7f7d83bf030)\n\n### 2.0.0\n\n*Released*: 2020-01-04\n\n* Added detailed questions for Science Europe DMPs\n* Fixed several typos and other minor problems\n* Added administrative chapter\n* Moving questions and refactoring according to [ds-km#24](https://github.com/ds-wizard/ds-km/pull/24)\n\n### 1.4.0\n\n*Released*: 2019-06-11\n\n* Adding integration for [FAIRsharing.org](https://fairsharing.org)\n* Adding 5 integration questions according to [ds-km@da5a8fc](https://github.com/ds-wizard/ds-km/commit/da5a8fc95d0a67f9369ce0b7727615115fc3656d)\n\nThe FAIRsharing integration requires configuration to contain `apiUrl` and `apiKey` for integration with id `fairsharing`.\n\n### 1.3.0\n\n*Released*: 2019-06-10\n\n* Refactoring list questions because of **deprecated item title** fields, i.e., a new question for item title created for each list question\n\nWhen using this version and higher, the DS Wizard configuration should have `itemTitleEnabled` set to `false`.\n\n### 1.2.0\n\n*Released*: 2019-06-09\n\n* Adding file naming SOP description question (9ff389f0-2236-48cf-880c-040ea1bb0d2f) to chapter 2 according to [ds-km@d879be0](https://github.com/ds-wizard/ds-km/commit/d879be0fa9d0808868396c649d03c4d783ac6742)\n\n### 1.1.0\n\n*Released*: 2019-06-09\n\n* Adding phases to questions (first draft) according to [ds-km@a6713d1](https://github.com/ds-wizard/ds-km/commit/a6713d1a4b9758bea63b3f7c56af5bd4f500d949) and [ds-km@1123211](https://github.com/ds-wizard/ds-km/commit/1123211bb5af43df8ef435039a2923f48e3e981c)\n\nPrior to this version, all questions were assigned with phase 2 - *Before submitting the DMP*.\n\n### 1.0.3\n\n*Released*: 2019-06-09\n\n* Fix: Removing extra question mark for a question (8018e15f-6c7e-433a-8686-ae0d695c7fc7) in chapter 5 according to: [ds-km@1123211](https://github.com/ds-wizard/ds-km/commit/1123211bb5af43df8ef435039a2923f48e3e981c)\n\n### 1.0.2\n\n*Released*: 2019-06-09\n\n* Fix: Adding some explanation to the list item questions (f5fef09d-ade5-4019-b089-f05bd89c34bc and b642c31d-a512-4ca7-8743-a2e0254006fa) in chapter 3 according to: [ds-km@96e28f4](https://github.com/ds-wizard/ds-km/commit/96e28f478d5dc6b59d384b5127f012dc2fe5f287)\n\n### 1.0.1\n\n*Released*: 2019-06-09\n\n* Fix: Adding forgotten question mark to end of question (39e0cc7c-17fe-4991-88d8-1280c3fe7923) in chapter 1 according to: [ds-km@644a373](https://github.com/ds-wizard/ds-km/commit/644a373685dc4ac15b76e86667a90151ca9c70ca)\n\n### 1.0.0\n\n*Released*: 2018-10-01\n\n* Initial version transformed from the previous DS-KM GitHub repository up to [ds-km@8442837](https://github.com/ds-wizard/ds-km/commit/8442837dbe3ff899b09e7d8d3fc1107e935a876f)","version":"2.6.0"},{"createdAt":"2023-07-25T09:44:17.933832Z","description":"DSW Knowledge Model originating from mindmap made by Rob Hooft","events":[{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["fd4637a2-a117-460a-a7fa-c03760c42629","87bb2042-8e3c-4733-ba1e-84509d7b1cf4","3c7bdc90-8ed3-4b34-90ec-7945d14cc443","4fa6f10d-b593-4b00-84cf-00d7f916147f"]},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2023-07-25T07:57:53Z","entityUuid":"dbb99f35-bdd9-4637-890e-23ba5bc19d6a","parentUuid":"c3dabaaf-c946-4a0d-889c-ede966f97667","uuid":"b83ec30e-a10d-4e29-938d-54029f0b2b11"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["87bb2042-8e3c-4733-ba1e-84509d7b1cf4","4fa6f10d-b593-4b00-84cf-00d7f916147f","3c7bdc90-8ed3-4b34-90ec-7945d14cc443","19b0fe70-a884-4539-96b9-a0aaf8c9b884","fd4637a2-a117-460a-a7fa-c03760c42629"]},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2023-07-25T07:57:58Z","entityUuid":"c3dabaaf-c946-4a0d-889c-ede966f97667","parentUuid":"1e85da40-bbfc-4180-903e-6c569ed2da38","uuid":"2e82dacb-85c2-4ad9-b899-5c61c700f2cd"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["fd4637a2-a117-460a-a7fa-c03760c42629","87bb2042-8e3c-4733-ba1e-84509d7b1cf4","3c7bdc90-8ed3-4b34-90ec-7945d14cc443","4fa6f10d-b593-4b00-84cf-00d7f916147f"]},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2023-07-25T08:06:55Z","entityUuid":"40005844-f7bb-493a-af6d-76c17a2f7eeb","parentUuid":"f301ae6e-5bbe-4fe9-a637-f2d5c5f05c73","uuid":"eaabab72-ab6f-4f05-a384-d36f7ba6281f"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["fd4637a2-a117-460a-a7fa-c03760c42629","87bb2042-8e3c-4733-ba1e-84509d7b1cf4","3c7bdc90-8ed3-4b34-90ec-7945d14cc443","4fa6f10d-b593-4b00-84cf-00d7f916147f"]},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2023-07-25T08:46:53Z","entityUuid":"b3ace89e-ca0b-4f62-b356-6001b5501e6d","parentUuid":"40005844-f7bb-493a-af6d-76c17a2f7eeb","uuid":"bc0c7e8f-ee6c-49fe-b9b2-d6dd6e0bf24c"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["fd4637a2-a117-460a-a7fa-c03760c42629","87bb2042-8e3c-4733-ba1e-84509d7b1cf4","3c7bdc90-8ed3-4b34-90ec-7945d14cc443","4fa6f10d-b593-4b00-84cf-00d7f916147f"]},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2023-07-25T08:47:20Z","entityUuid":"bd0dd2d0-b3ef-410d-be1f-8f4bf0bbd9d5","parentUuid":"40005844-f7bb-493a-af6d-76c17a2f7eeb","uuid":"4111cee5-bd9a-44d0-aeac-9105e160b491"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed"