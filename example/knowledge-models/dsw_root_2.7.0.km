e":{"changed":false},"testVariables":{"changed":true,"value":{"registry":"standard","status":"ready"}},"variables":{"changed":false}},"createdAt":"2025-09-30T08:52:10Z","entityUuid":"f3520558-707e-415a-8878-c7b8d6ccc2fb","parentUuid":"6f6241d9-136c-4770-9d58-8a3f39607052","uuid":"225e744e-6efa-4c92-8deb-5e0bc2796c04"},{"content":{"allowCustomReply":{"changed":false},"annotations":{"changed":false},"eventType":"EditIntegrationEvent","integrationType":"ApiIntegration","name":{"changed":false},"requestAllowEmptySearch":{"changed":false},"requestBody":{"changed":false},"requestHeaders":{"changed":false},"requestMethod":{"changed":false},"requestUrl":{"changed":false},"responseItemTemplate":{"changed":false},"responseItemTemplateForSelection":{"changed":false},"responseListField":{"changed":false},"testQ":{"changed":false},"testResponse":{"changed":true,"value":{"request":{"body":"","headers":[{"key":"Accept","value":"application/json"},{"key":"Authorization","value":"[SECRET:fairsharingApiKey]"}],"method":"GET","url":"[SECRET:fairsharingApiUrl]/search?registry=standard&q=doi&status=ready"},"response":{"body":"{\"data\":[{\"id\":\"1332\",\"registry\":\"standard\",\"record_type\":\"identifier_schema\",\"name\":\"Digital Object Identifier\",\"abbreviation\":\"DOI\",\"description\":\"The digital object identifier (DOI) system originated in a joint initiative of three trade associations in the publishing industry (International Publishers Association; International Association of Scientific, Technical and Medical Publishers; Association of American Publishers). The system was announced at the Frankfurt Book Fair 1997. The International DOI® Foundation (IDF) was created to develop and manage the DOI system, also in 1997. The DOI system was adopted as International Standard ISO 26324 in 2012. The DOI system implements the Handle System and adds a number of new features. The DOI system provides an infrastructure for persistent unique identification of objects of any type. The DOI system is designed to work over the Internet. A DOI name is permanently assigned to an object to provide a resolvable persistent network link to current information about that object, including where the object, or information about it, can be found on the Internet. While information about an object can change over time, its DOI name will not change. A DOI name can be resolved within the DOI system to values of one or more types of data relating to the object identified by that DOI name, such as a URL, an e-mail address, other identifiers and descriptive metadata. The DOI system enables the construction of automated services and transactions. Applications of the DOI system include but are not limited to managing information and documentation location and access; managing metadata; facilitating electronic transactions; persistent unique identification of any form of any data; and commercial and non-commercial transactions. The content of an object associated with a DOI name is described unambiguously by DOI metadata, based on a structured extensible data model that enables the object to be associated with metadata of any desired degree of precision and granularity to support description and services. The data model supports interoperability between DOI applications. The scope of the DOI system is not defined by reference to the type of content (format, etc.) of the referent, but by reference to the functionalities it provides and the context of use. The DOI system provides, within networks of DOI applications, for unique identification, persistence, resolution, metadata and semantic interoperability.\",\"doi\":\"10.25504/FAIRsharing.hFLKCn\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.hFLKCn\",\"homepage\":\"https://www.doi.org\",\"countries\":[\"Worldwide\"],\"disciplines\":[\"Knowledge and Information Systems\",\"Subject Agnostic\"],\"domains\":[\"centrally registered identifier\"],\"taxonomies\":[\"Not applicable\"],\"user_defined_tags\":[],\"legacy_ids\":[\"bsg-001182\",\"bsg-s001182\"],\"created_at\":\"2018-04-23T14:22:48.000Z\",\"updated_at\":\"2025-06-17T08:01:12.193Z\"},{\"id\":\"5886\",\"registry\":\"standard\",\"record_type\":\"model_and_format\",\"name\":\"mzMLb\",\"abbreviation\":null,\"description\":\"The Proteomics Standards Initiative (PSI) has established a clear and precise extensible markup language (XML) representation for data interchange, mzML, receiving substantial uptake; nevertheless, storage and file access efficiency has not been the main focus. We propose an HDF5 file format “mzMLb” that is optimized for both read/write speed and storage of the raw mass spectrometry data.\",\"doi\":null,\"url\":\"https://fairsharing.org/5886\",\"homepage\":\"https://pubs.acs.org/doi/10.1021/acs.jproteome.0c00192\",\"countries\":[\"United Kingdom\",\"United States\"],\"disciplines\":[\"Life Science\",\"Proteomics\"],\"domains\":[\"Mass spectrum\"],\"taxonomies\":[\"All\"],\"user_defined_tags\":[\"mass spectrometry\"],\"legacy_ids\":[],\"created_at\":\"2024-10-14T10:13:34.989Z\",\"updated_at\":\"2024-10-22T14:35:48.706Z\"},{\"id\":\"6213\",\"registry\":\"standard\",\"record_type\":\"reporting_guideline\",\"name\":\"Checklist for Artificial Intelligence in Medical Imaging\",\"abbreviation\":\"CLAIM \",\"description\":\"To aid authors and reviewers of AI manuscripts in med-ical imaging, we propose CLAIM, the Checklist for AI inMedical Imaging (see Table and downloadable Word docu-ment [supplement]). CLAIM is modeled after the STARDguideline and has been extended to address applicationsof AI in medical imaging that include classification, imagereconstruction, text analysis, and workflow optimization.The elements described here should be viewed as a “bestpractice” to guide authors in presenting their research. Thetext below amplifies the checklist with greater detail.\",\"doi\":null,\"url\":\"https://fairsharing.org/6213\",\"homepage\":\"https://pubs.rsna.org/doi/10.1148/ryai.2020200029\",\"countries\":[\"United States\"],\"disciplines\":[\"Biomedical Science\",\"Artificial Intelligence\"],\"domains\":[\"Medical imaging\"],\"taxonomies\":[\"Not applicable\"],\"user_defined_tags\":[],\"legacy_ids\":[],\"created_at\":\"2025-02-10T17:35:17.375Z\",\"updated_at\":\"2025-03-06T11:03:30.162Z\"},{\"id\":\"1296\",\"registry\":\"standard\",\"record_type\":\"terminology_artefact\",\"name\":\"Agroecology Knowledge Management\",\"abbreviation\":\"GECO\",\"description\":\"Agroecology knowledge management is an application ontology for the description and organization of knowledge to design innovative crop systems.\",\"doi\":\"10.25504/FAIRsharing.dxcjn5\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.dxcjn5\",\"homepage\":\"https://data.inrae.fr/dataset.xhtml?persistentId=doi:10.15454/1.4822495904463706E12\",\"countries\":[],\"disciplines\":[\"Farming Systems Research\",\"Knowledge and Information Systems\",\"Agroecology\"],\"domains\":[\"Cropping systems\"],\"taxonomies\":[\"All\"],\"user_defined_tags\":[],\"legacy_ids\":[\"bsg-000726\",\"bsg-s000726\"],\"created_at\":\"2017-10-12T09:44:16.000Z\",\"updated_at\":\"2023-01-27T18:41:40.072Z\"},{\"id\":\"5512\",\"registry\":\"standard\",\"record_type\":\"reporting_guideline\",\"name\":\"Research Integrity Assessment\",\"abbreviation\":\"RIA\",\"description\":\"We developed the research integrity assessment (RIA), a tool to assess the integrity of research and adherence to good clinical practice reported in RCTs of investigational drugs.\",\"doi\":null,\"url\":\"https://fairsharing.org/5512\",\"homepage\":\"https://onlinelibrary.wiley.com/doi/full/10.1002/jrsm.1599\",\"countries\":[\"Germany\",\"United Kingdom\"],\"disciplines\":[\"Clinical Studies\"],\"domains\":[],\"taxonomies\":[\"Not applicable\"],\"user_defined_tags\":[\"randomised controlled trials\"],\"legacy_ids\":[],\"created_at\":\"2024-06-11T13:12:49.871Z\",\"updated_at\":\"2024-06-17T10:30:59.634Z\"},{\"id\":\"5513\",\"registry\":\"standard\",\"record_type\":\"reporting_guideline\",\"name\":\"Cochrane Pregnancy and Childbirth Trustworthiness Screening Tool\",\"abbreviation\":\"CPC-TST\",\"description\":\"There is increasing concern that a significant proportion of randomized controlled trials (RCTs) included in Cochrane reviews may not be trustworthy. Applying the Cochrane Pregnancy and Childbirth Trustworthiness Screening Tool(CPC‐TST) has already had a clinically important effect on several published reviews.\",\"doi\":null,\"url\":\"https://fairsharing.org/5513\",\"homepage\":\"https://onlinelibrary.wiley.com/doi/epdf/10.1002/cesm.12037\",\"countries\":[\"United Kingdom\"],\"disciplines\":[\"Clinical Studies\"],\"domains\":[],\"taxonomies\":[\"Not applicable\"],\"user_defined_tags\":[\"randomised controlled trials\"],\"legacy_ids\":[],\"created_at\":\"2024-06-11T13:24:57.834Z\",\"updated_at\":\"2024-06-17T10:10:27.172Z\"},{\"id\":\"4610\",\"registry\":\"standard\",\"record_type\":\"model_and_format\",\"name\":\"Common Provenance Model\",\"abbreviation\":\"ISO/TS 23494-1:2023\",\"description\":\"Also known as the \\\"Provenance information model for biological material and data Part 1: Design concepts and general requirements\\\" (ISO/TS 23494-1:2023), the Common Provenance Model is a standard based on W3C PROV, which allows publishing, interlinking and finding provenance information in distributed environments.\\n\\nProvenance is information describing the lineage of an object, such as a dataset or biological material. Since these objects can be passed between organizations, each organization can document only parts of the objects life cycle. As a result, interconnection of distributed provenance parts forms distributed provenance chains. Dependant on the actual provenance content, complete provenance chains can provide traceability and contribute to reproducibility and FAIRness of research objects. The Common Provenance Model is a lightweight provenance model based on W3C PROV that enables generation of distributed provenance chains in complex, multi-organizational environments. The application of the model is demonstrated with a use case spanning several steps of a real-world research pipeline — starting with the acquisition of a specimen, its processing and storage, histological examination, and the generation/collection of associated data (images, annotations, clinical data), ending with training an AI model for the detection of tumor in the images.\",\"doi\":\"10.25504/FAIRsharing.ce6e9d\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.ce6e9d\",\"homepage\":\"https://www.iso.org/standard/80715.html\",\"countries\":[\"European Union\"],\"disciplines\":[\"Biotechnology\",\"Biology\"],\"domains\":[\"Reproducibility\",\"Biospecimen\",\"FAIR\"],\"taxonomies\":[\"All\"],\"user_defined_tags\":[],\"legacy_ids\":[],\"created_at\":\"2023-02-02T12:25:22.303Z\",\"updated_at\":\"2024-04-23T08:49:19.366Z\"},{\"id\":\"373\",\"registry\":\"standard\",\"record_type\":\"reporting_guideline\",\"name\":\"Reporting guidElines For randomized controLled trials for livEstoCk and food safeTy\",\"abbreviation\":\"REFLECT\",\"description\":\"REFLECT stands for Reporting guidElines For randomized controLled trials for livEstoCk and food safeTy. It is an evidence-based minimum set of items for trials reporting production, health, and food-safety outcomes.The aim of the REFLECT Statement is to help authors improve the reporting livestock trials with production, health, and food-safety outcomes. The REFLECT Statement consists of a 22-item checklist. It is an evolving document that is subject to change periodically as new evidence emerges.\",\"doi\":\"10.25504/FAIRsharing.tv1yg0\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.tv1yg0\",\"homepage\":\"https://onlinelibrary.wiley.com/doi/10.1111/j.1863-2378.2009.01312.x\",\"countries\":[\"United States\"],\"disciplines\":[\"Life Science\",\"Nutritional Science\",\"Preclinical Studies\"],\"domains\":[\"Safety Study\",\"group randomization\"],\"taxonomies\":[\"All\"],\"user_defined_tags\":[],\"legacy_ids\":[\"bsg-000110\",\"bsg-s000110\"],\"created_at\":\"2014-11-04T15:23:40.000Z\",\"updated_at\":\"2024-09-17T14:56:06.496Z\"},{\"id\":\"539\",\"registry\":\"standard\",\"record_type\":\"model_and_format\",\"name\":\"The CXI File Format for Coherent X-ray Imaging\",\"abbreviation\":\"CXI\",\"description\":\"The CXI ﬁle format was created as common format for all the data in the Coherent X-ray Imaging Data Bank (CXIDB). Naturally its scope is all experimental data collected during Coherent X-ray Imaging experiments as well as all data generated during the analysis of the experimental data.\",\"doi\":\"10.25504/FAIRsharing.9h5j8c\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.9h5j8c\",\"homepage\":\"http://cxidb.org/cxi.html\",\"countries\":[\"Sweden\",\"United States\"],\"disciplines\":[\"Life Science\",\"Physics\",\"Biophysics\",\"Atomic, Molecular, Optical and Plasma Physics\",\"Soft Matter Physics\",\"Materials Science\"],\"domains\":[\"Structure\",\"Imaging\",\"X-ray diffraction\"],\"taxonomies\":[\"All\"],\"user_defined_tags\":[\"Metadata standardization\"],\"legacy_ids\":[\"bsg-000542\",\"bsg-s000542\"],\"created_at\":\"2014-11-04T15:23:40.000Z\",\"updated_at\":\"2025-07-09T14:36:01.495Z\"},{\"id\":\"3904\",\"registry\":\"standard\",\"record_type\":\"identifier_schema\",\"name\":\"Research Activity Identifier\",\"abbreviation\":\"RAiD\",\"description\":\"Research Activity Identifier (RAiD) is an identifier mechanism designed for research projects and activities. It is persistent and connects existing PIDs for researchers, institutions, outputs and tools together to create a timeline of research activity which makes connecting digital infrastructure, reporting on impact and establishing data provenance clear and easy. RAiD is one of the Identifier Services owned and offered by the Australia Research Data Commons (ARDC), and can be accessed for machine-to-machine service by API integration, using a RAiD service point designated platform, or by manually minting via the RAiD user Dashboard.\",\"doi\":\"10.25504/FAIRsharing.dc702a\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.dc702a\",\"homepage\":\"https://raid.org/\",\"countries\":[\"Australia\"],\"disciplines\":[\"Subject Agnostic\"],\"domains\":[\"Resource metadata\",\"centrally registered identifier\",\"Knowledge representation\",\"FAIR\"],\"taxonomies\":[\"Not applicable\"],\"user_defined_tags\":[],\"legacy_ids\":[],\"created_at\":\"2022-03-09T19:02:59.839Z\",\"updated_at\":\"2025-09-05T12:19:47.696Z\"},{\"id\":\"259\",\"registry\":\"standard\",\"record_type\":\"model_and_format\",\"name\":\"Access to Biological Collection Data\",\"abbreviation\":\"ABCD\",\"description\":\"The Access to Biological Collections Data (ABCD) Schema is a standard for the access to and exchange of data about primary biodiversity data. It is compatible with several existing data standards and supports several datasets. It is implemented in XML and OWL.\",\"doi\":\"10.25504/FAIRsharing.kr3215\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.kr3215\",\"homepage\":\"http://www.tdwg.org/standards/115/\",\"countries\":[\"Worldwide\"],\"disciplines\":[\"Life Science\",\"Biodiversity\",\"Biology\"],\"domains\":[],\"taxonomies\":[\"All\"],\"user_defined_tags\":[\"Observations\"],\"legacy_ids\":[\"bsg-000197\",\"bsg-s000197\"],\"created_at\":\"2014-11-04T15:23:40.000Z\",\"updated_at\":\"2025-07-28T14:43:09.041Z\"},{\"id\":\"812\",\"registry\":\"standard\",\"record_type\":\"terminology_artefact\",\"name\":\"Systematized Nomenclature of Medicine, International Version\",\"abbreviation\":\"SNMI\",\"description\":\"Cote, Roger A., editor. Systematized Nomenclature of Human and Veterinary Medicine: SNOMED International. Northfield (IL): College of American Pathologists; Schaumburg (IL): American Veterinary Medical Association, Version 3.5, 1998.\",\"doi\":\"10.25504/FAIRsharing.6bxcr4\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.6bxcr4\",\"homepage\":\"http://bioportal.bioontology.org/ontologies/SNMI\",\"countries\":[\"Denmark\",\"United Kingdom\",\"Worldwide\"],\"disciplines\":[\"Anatomy\",\"Translational Medicine\",\"Veterinary Medicine\",\"Biomedical Science\",\"Occupational Medicine\",\"Pharmacology\"],\"domains\":[\"disease\",\"morphology\",\"drug interaction\"],\"taxonomies\":[\"All\"],\"user_defined_tags\":[],\"legacy_ids\":[\"bsg-001084\",\"bsg-s001084\"],\"created_at\":\"2017-10-24T08:41:41.000Z\",\"updated_at\":\"2025-07-08T16:07:16.585Z\"},{\"id\":\"264\",\"registry\":\"standard\",\"record_type\":\"reporting_guideline\",\"name\":\"Data required for the assignation of Digital Object Identifiers in the Global Information System\",\"abbreviation\":\"GLIS Descriptors\",\"description\":\"The GLIS Descriptors are based on the FAO/IPGRI Multi Crop Passport Descriptors. They are the metadata information associated to a Digital Object Identifier (DOI) in the GLIS system; they divided into 3 classes: mandatory, highly recommended and additional.\",\"doi\":\"10.25504/FAIRsharing.em3cg0\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.em3cg0\",\"homepage\":\"http://www.fao.org/plant-treaty/areas-of-work/global-information-system/descriptors/en/\",\"countries\":[\"Worldwide\"],\"disciplines\":[\"Agriculture\",\"Plant Genetics\",\"Botany\",\"Biology\"],\"domains\":[\"Agricultural products\"],\"taxonomies\":[\"All\"],\"user_defined_tags\":[],\"legacy_ids\":[\"bsg-001161\",\"bsg-s001161\"],\"created_at\":\"2018-03-22T09:18:38.000Z\",\"updated_at\":\"2023-01-27T20:07:06.916Z\"},{\"id\":\"4651\",\"registry\":\"standard\",\"record_type\":\"model_and_format\",\"name\":\"da|ra Metadata Schema\",\"abbreviation\":\"da|ra MS\",\"description\":\"The da|ra Metadata Schema is a list of core metadata properties chosen for the identification of data and retrieval purposes.The schema is used during the DOI registration process at da|ra and is based on the DataCite schema.\",\"doi\":\"10.25504/FAIRsharing.e0565d\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.e0565d\",\"homepage\":\"https://www.da-ra.de/downloads#metadata\",\"countries\":[\"Germany\"],\"disciplines\":[\"Economics\",\"Social Science\"],\"domains\":[],\"taxonomies\":[\"Not applicable\"],\"user_defined_tags\":[],\"legacy_ids\":[],\"created_at\":\"2023-03-10T11:04:11.208Z\",\"updated_at\":\"2024-06-06T11:05:19.656Z\"},{\"id\":\"297\",\"registry\":\"standard\",\"record_type\":\"model_and_format\",\"name\":\"Nexus XML\",\"abbreviation\":\"NeXML\",\"description\":\"To facilitate interoperability in evolutionary comparative analysis, we present NeXML, an XML standard (inspired by the current standard, NEXUS) that supports exchange of richly annotated comparative data. NeXML defines syntax for operational taxonomic units, character-state matrices, and phylogenetic trees and networks. Documents can be validated unambiguously. Importantly, any data element can be annotated, to an arbitrary degree of richness, using a system that is both flexible and rigorous. We describe how the use of NeXML by the TreeBASE and Phenoscape projects satisfies user needs that cannot be satisfied with other available file formats\",\"doi\":\"10.25504/FAIRsharing.knrb06\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.knrb06\",\"homepage\":\"https://github.com/nexml\",\"countries\":[\"Canada\",\"India\",\"Netherlands\",\"United States\"],\"disciplines\":[\"Life Science\",\"Phylogenetics\"],\"domains\":[],\"taxonomies\":[\"All\"],\"user_defined_tags\":[],\"legacy_ids\":[\"bsg-000529\",\"bsg-s000529\"],\"created_at\":\"2014-11-04T15:23:40.000Z\",\"updated_at\":\"2025-07-14T14:33:40.017Z\"},{\"id\":\"831\",\"registry\":\"standard\",\"record_type\":\"model_and_format\",\"name\":\"Data Standard for Sharing Quantitative Results in Mass Spectrometry Metabolomics\",\"abbreviation\":\"mzTab-M\",\"description\":\"Consortia efforts from the Metabolomics Standards Initiative, Proteomics Standards Initiative, and the Metabolomics Society have created mzTab-M to act as a common output format for analytical approaches using MS on small molecules. The intention of this specification, mzTab for Metabolomics (mzTab-M), is to extend the concepts established in the previous specification, so that more detail can be captured about the evidence trail for quantification, including MS features (different charge states or adducts) and the evidence trail for identifications, specifically for MS-based experiments on small molecules (metabolites, lipids, contaminants, etc.). mzTab-M is not formally backwards compatible, but follows a similar design pattern to simplify adaptation of existing software and to facilitate its integration into bioinformatics processing and submission workflows.\",\"doi\":\"10.25504/FAIRsharing.207caf\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.207caf\",\"homepage\":\"https://github.com/HUPO-PSI/mzTab/tree/master/specification_document-releases/2_0-Metabolomics-Release\",\"countries\":[\"Austria\",\"Germany\",\"United Kingdom\"],\"disciplines\":[\"Environmental Science\",\"Life Science\",\"Metabolomics\",\"Biomedical Science\"],\"domains\":[\"metabolite\",\"gas chromatography\",\"small molecule\",\"mass spectrometry assay\"],\"taxonomies\":[\"All\"],\"user_defined_tags\":[],\"legacy_ids\":[\"bsg-001611\",\"bsg-s001611\"],\"created_at\":\"2021-04-29T07:10:22.000Z\",\"updated_at\":\"2025-06-17T09:47:14.453Z\"},{\"id\":\"857\",\"registry\":\"standard\",\"record_type\":\"model_and_format\",\"name\":\"Project Tycho 2.0 custom-compiled dataset format\",\"abbreviation\":null,\"description\":\"The Project Tycho 2.0 custom-compiled dataset format is used for datasets compiled and downloaded through the Project Tycho Graphical User Interface or API. In addition to those fields available to the pre-compiled dataset formats provided by Tycho, this custom-compiled dataset format also includes, for each count, the DOI of the pre-compiled dataset that contains the count.\",\"doi\":\"10.25504/FAIRsharing.wqSgg8\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.wqSgg8\",\"homepage\":\"https://www.tycho.pitt.edu/dataformat/ProjectTychoCustomCompiledDataFormat.pdf\",\"countries\":[\"United States\"],\"disciplines\":[\"Biomedical Science\",\"Epidemiology\",\"Health Science\",\"Medicine\",\"Global Health\"],\"domains\":[],\"taxonomies\":[\"Bacteria\",\"Eukaryota\",\"Fungi\",\"Homo sapiens\",\"Viruses\"],\"user_defined_tags\":[],\"legacy_ids\":[\"bsg-001219\",\"bsg-s001219\"],\"created_at\":\"2018-07-02T16:21:51.000Z\",\"updated_at\":\"2024-06-06T10:30:44.422Z\"},{\"id\":\"1103\",\"registry\":\"standard\",\"record_type\":\"terminology_artefact\",\"name\":\"Woody Plant Ontology\",\"abbreviation\":\"CO_357\",\"description\":\"The Woody Plant Ontology lists reference variables used for experimentations and observations on woody plants (forest trees and shrubs, and possibly fruit trees). It is an international initiative based on various communities (French, Portuguese and European). Terms are collected from various sources and organized following the Crop Ontology standard which provides harmonized variables composed by a triplet: (i) a trait, the studied character, (ii) a method, the measurement protocol and (iii) a scale, the unit of measurement or scoring scale.\",\"doi\":\"10.25504/FAIRsharing.2b04ae\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.2b04ae\",\"homepage\":\"https://doi.org/10.15454/JB2WCE\",\"countries\":[\"Worldwide\"],\"disciplines\":[\"Life Science\",\"Botany\"],\"domains\":[\"phenotype\"],\"taxonomies\":[\"Viridiplantae\"],\"user_defined_tags\":[],\"legacy_ids\":[\"bsg-001136\",\"bsg-s001136\"],\"created_at\":\"2018-03-10T20:06:18.000Z\",\"updated_at\":\"2025-07-11T09:31:59.982Z\"},{\"id\":\"6679\",\"registry\":\"standard\",\"record_type\":\"terminology_artefact\",\"name\":\"Observatories of Seas Ontology\",\"abbreviation\":\"OSO\",\"description\":\"OSO (Observatories of Seas Ontology) is a lightweight and multilingual ontology developed to describe and interlink marine observing systems, including their infrastructures, platforms, sites, equipment, and responsible organisations.\\nIt is maintained by Ifremer and designed to support metadata harmonisation across European marine research infrastructures such as EMSO ERIC. The ontology uses standard vocabularies (OWL, DCAT, Dublin Core, FOAF, SKOS, etc.) and aligns with external identifiers (ROR, EDMO, DOI). OSO aims to improve semantic interoperability, enable FAIR metadata publication, and support long-term data stewardship in the marine domain.\",\"doi\":null,\"url\":\"https://fairsharing.org/6679\",\"homepage\":\"https://w3id.org/earthsemantics/OSO\",\"countries\":[\"France\",\"Greece\",\"Ireland\",\"Italy\",\"Mayotte\",\"New Caledonia\",\"Norway\",\"Portugal\",\"Romania\",\"Spain\",\"Vanuatu\"],\"disciplines\":[\"Marine Biology\",\"Earth Science\"],\"domains\":[\"marine coral reef biome\",\"marine environment\",\"marine metagenome\"],\"taxonomies\":[\"Not applicable\"],\"user_defined_tags\":[\"earth observation\",\"Marine Chemistry\",\"Marine Litter\",\"Semantic\",\"marine energy\",\"semantic web\",\"marine observatories\"],\"legacy_ids\":[],\"created_at\":\"2025-07-30T07:53:25.099Z\",\"updated_at\":\"2025-09-02T14:57:08.334Z\"},{\"id\":\"4500\",\"registry\":\"standard\",\"record_type\":\"model_and_format\",\"name\":\"RADAR Metadata Schema\",\"abbreviation\":null,\"description\":\"The RADAR metadata schema is a list of core metadata properties chosen for the accurate and consistent description of research data archived or published in the cross-disciplinary RADAR research data repository. It is based on the DataCite metadata schema kernel, a widely used standard for describing research datasets in a discipline-agnostic way, and is compatible with DublinCore. It provides a combination of controlled lists and free text fields. It contains 10 mandatory fields as a prerequisite for DOI registration in accordance with the DataCite metadata schema and 13 optional parameters that are transferable to different scientific disciplines.\",\"doi\":\"10.25504/FAIRsharing.e26f92\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.e26f92\",\"homepage\":\"https://radar.products.fiz-karlsruhe.de/en/radarfeatures/radar-metadatenschema\",\"countries\":[\"Germany\"],\"disciplines\":[\"Subject Agnostic\"],\"domains\":[\"Resource metadata\",\"Annotation\",\"Data retrieval\",\"centrally registered identifier\",\"FAIR\"],\"taxonomies\":[\"All\"],\"user_defined_tags\":[],\"legacy_ids\":[],\"created_at\":\"2022-11-06T18:40:46.962Z\",\"updated_at\":\"2024-06-06T11:04:55.255Z\"},{\"id\":\"4538\",\"registry\":\"standard\",\"record_type\":\"identifier_schema\",\"name\":\"International Generic Sample Number\",\"abbreviation\":\"IGSN (Generic)\",\"description\":\"An IGSN ID is a globally unique and persistent identifier for physical samples in all scientific fields. An IGSN ID can be applied to an individual sample, an aggregation of samples, or to a feature-of-interest (the real-world feature that the sample is taken from). From 2021, IGSN IDs are functionally DOIs and are registered with metadata encoded in the DataCite Metadata Schema. The IGSN ID, previously known as an \\\"International GeoSample Number\\\", naming schema has changed, to reflects the expanding scope and utilization as a partnership agreement between DataCite and the IGSN e.V.\",\"doi\":\"10.25504/FAIRsharing.c7f365\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.c7f365\",\"homepage\":\"https://www.igsn.org\",\"countries\":[\"Germany\",\"United States\",\"Worldwide\"],\"disciplines\":[\"Hydrogeology\",\"Geochemistry\",\"Environmental Science\",\"Data Management\",\"Omics\",\"Archaeology\",\"Geology\",\"Earth Science\"],\"domains\":[\"centrally registered identifier\",\"Biospecimen\"],\"taxonomies\":[\"environmental samples\"],\"user_defined_tags\":[],\"legacy_ids\":[],\"created_at\":\"2022-12-01T10:06:07.871Z\",\"updated_at\":\"2025-07-28T14:45:32.653Z\"},{\"id\":\"1544\",\"registry\":\"standard\",\"record_type\":\"model_and_format\",\"name\":\"Citation File Format\",\"abbreviation\":\"CFF\",\"description\":\"The Citation File Format (CFF) is a human-centric, machine-readable format for software citation metadata. It is developed to provide an easy way for RSEs, and other developers of software in academia, to ensure that they can receive credit for their work; likewise, it provides researchers with access to the necessary metadata for references to the software they use in their research. The Citation File Format follows the Software Citation Principles, and is compatible with the CodeMeta JSON-LD exchange format for software metadata.\",\"doi\":\"10.25504/FAIRsharing.m2NU20\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.m2NU20\",\"homepage\":\"https://citation-file-format.github.io/\",\"countries\":[\"France\",\"Germany\",\"Lithuania\",\"Netherlands\",\"Norway\",\"United Kingdom\"],\"disciplines\":[\"Subject Agnostic\"],\"domains\":[],\"taxonomies\":[\"Not applicable\"],\"user_defined_tags\":[\"Metadata standardization\"],\"legacy_ids\":[\"bsg-001271\",\"bsg-s001271\"],\"created_at\":\"2018-09-05T13:26:36.000Z\",\"updated_at\":\"2025-07-28T14:41:47.558Z\"},{\"id\":\"1367\",\"registry\":\"standard\",\"record_type\":\"model_and_format\",\"name\":\"Data Documentation Initiative Lifecycle\",\"abbreviation\":\"DDI-Lifecycle\",\"description\":\"Data Documentation Initiative (DDI) Lifecycle (DDI-Lifecycle, DDI-L) is designed to document and manage data across the entire life cycle, from conceptualization to data publication, analysis and beyond. The freely available international DDI standards describe data that result from observational methods in the social, behavioral, economic, and health sciences. DDI is used to document data in over 80 countries of the world. It encompasses all of the DDI-Codebook specification and extends it. Based on XML Schemas, DDI-Lifecycle is modular and extensible.\",\"doi\":\"10.25504/FAIRsharing.1t5ws6\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.1t5ws6\",\"homepage\":\"https://ddialliance.org/Specification/DDI-Lifecycle/3.3/\",\"countries\":[\"Worldwide\"],\"disciplines\":[\"Economics\",\"Biomedical Science\",\"Social Science\",\"Health Science\",\"Social and Behavioural Science\"],\"domains\":[\"study design\",\"Classification\"],\"taxonomies\":[\"Homo sapiens\"],\"user_defined_tags\":[],\"legacy_ids\":[\"bsg-000605\",\"bsg-s000605\"],\"created_at\":\"2015-07-22T11:39:04.000Z\",\"updated_at\":\"2022-11-16T11:01:28.496Z\"},{\"id\":\"595\",\"registry\":\"standard\",\"record_type\":\"terminology_artefact\",\"name\":\"Data Documentation Initiative Controlled Vocabularies\",\"abbreviation\":\"DDI CVs\",\"description\":\"The Data Documentation Initiative (DDI) Controlled Vocabularies Group (CVG) has created a set of controlled vocabularies (CVs) that can be used with DDI as well as for other purposes and applications. The DDI CVs are used to aid in the description and documentation of data in the social science research community. The published DDI-CVs work with both versions of the DDI specification (DDI-L and DDI-C).\",\"doi\":\"10.25504/FAIRsharing.y4RpVy\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.y4RpVy\",\"homepage\":\"https://ddialliance.org/controlled-vocabularies\",\"countries\":[\"Worldwide\"],\"disciplines\":[\"Humanities and Social Science\"],\"domains\":[],\"taxonomies\":[\"Not applicable\"],\"user_defined_tags\":[],\"legacy_ids\":[\"bsg-001469\",\"bsg-s001469\"],\"created_at\":\"2020-04-26T10:16:15.000Z\",\"updated_at\":\"2024-05-24T04:01:03.459Z\"},{\"id\":\"1148\",\"registry\":\"standard\",\"record_type\":\"model_and_format\",\"name\":\"Data Documentation Initiative Codebook\",\"abbreviation\":\"DDI-Codebook\",\"description\":\"Data Documentation Initiative (DDI-Codebook, DDI-C) is a more light-weight version of DDI-Lifecycle, intended primarily to document simple survey data. Originally DTD-based, DDI-C is now available as an XML Schema. The freely available international DDI standards describe data that result from observational methods in the social, behavioral, economic, and health sciences. DDI is used to document data in over 80 countries of the world.\",\"doi\":\"10.25504/FAIRsharing.EZCpPd\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.EZCpPd\",\"homepage\":\"https://ddialliance.org/Specification/DDI-Codebook/2.5/\",\"countries\":[\"Worldwide\"],\"disciplines\":[\"Economics\",\"Biomedical Science\",\"Social Science\",\"Health Science\",\"Social and Behavioural Science\"],\"domains\":[\"study design\"],\"taxonomies\":[\"Not applicable\"],\"user_defined_tags\":[],\"legacy_ids\":[\"bsg-001512\",\"bsg-s001512\"],\"created_at\":\"2020-07-18T12:34:51.000Z\",\"updated_at\":\"2022-11-16T09:42:16.764Z\"}],\"links\":{\"self\":null,\"first\":null,\"prev\":null,\"next\":null,\"last\":null},\"note\":\"Proxied for use in Data Stewardship Wizard (see https://ds-wizard.org for more)\"}","contentType":"application/json","responseType":"SuccessTypeHintResponse","status":200}}},"testVariables":{"changed":false},"variables":{"changed":false}},"createdAt":"2025-09-30T08:52:14Z","entityUuid":"f3520558-707e-415a-8878-c7b8d6ccc2fb","parentUuid":"6f6241d9-136c-4770-9d58-8a3f39607052","uuid":"639c96b8-291d-4aa7-a484-edaa3c2bdcf3"},{"content":{"allowCustomReply":{"changed":false},"annotations":{"changed":false},"eventType":"EditIntegrationEvent","integrationType":"ApiIntegration","name":{"changed":false},"requestAllowEmptySearch":{"changed":false},"requestBody":{"changed":false},"requestHeaders":{"changed":false},"requestMethod":{"changed":false},"requestUrl":{"changed":false},"responseItemTemplate":{"changed":true,"value":""},"responseItemTemplateForSelection":{"changed":false},"responseListField":{"changed":false},"testQ":{"changed":false},"testResponse":{"changed":false},"testVariables":{"changed":false},"variables":{"changed":