ged":false},"requestUrl":{"changed":true,"value":"{{secrets.fairsharingApiUrl}}/search?registry={{variables.registry}}&record_type={{variables.record_type}}&q={{q}}&status={{variables.status}}"},"responseItemTemplate":{"changed":true,"value":"![Logo](data:image/svg+xml;base64,) [**{{ item.name }}**]({{ item.url }}) ([{{ item.homepage }}]({{ item.homepage }}))\n\n{% if item.description %}\n {{ item.description | truncate(300, True, '...')}}\n{% endif %}"},"responseItemTemplateForSelection":{"changed":true,"value":"[**{{ item.name }}**]({{ item.url }}) ([{{ item.homepage }}]({{ item.homepage }}))\n\n{%- if item.shortname %}\n ({{ item.shortname }})\n{% endif %}\n\n{% if item.description %}\n {{ item.description | truncate(300, True, '...')}}\n{% endif %}"},"responseListField":{"changed":true,"value":"data"},"testQ":{"changed":true,"value":"foaf"},"testResponse":{"changed":true,"value":{"request":{"body":null,"headers":[{"key":"Accept","value":"application/json"},{"key":"Authorization","value":"[SECRET:fairsharingApiKey]"}],"method":"GET","url":"[SECRET:fairsharingApiUrl]/search?registry=standard&record_type=terminology_artefact&q=foaf&status=ready"},"response":{"body":"{\"data\":[{\"id\":\"750\",\"registry\":\"standard\",\"record_type\":\"terminology_artefact\",\"name\":\"Open Provenance Model Vocabulary\",\"abbreviation\":\"OPMV\",\"description\":\"OPMV, the Open Provenance Model Vocabulary, is a lightweight provenance vocabulary created to aid responsible data publishing and interoperability between provenance information on the Semantic Web. The Open Provenance Model Vocabulary is closely based on OPM data model. OPMV can be used together with other provenance-related RDF/OWL vocabularies/ontologies, such as Dublin Core, FOAF, the Changeset Vocabulary, and the Provenance Vocabulary.\",\"doi\":\"10.25504/FAIRsharing.3cf5bc\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.3cf5bc\",\"homepage\":\"http://purl.org/net/opmv/ns\",\"countries\":[\"United Kingdom\"],\"disciplines\":[\"Data Management\",\"Computer Science\"],\"domains\":[\"Resource metadata\"],\"taxonomies\":[\"Not applicable\"],\"user_defined_tags\":[],\"legacy_ids\":[\"bsg-001434\",\"bsg-s001434\"],\"created_at\":\"2020-01-22T13:11:08.000Z\",\"updated_at\":\"2023-01-27T22:48:44.564Z\"},{\"id\":\"6679\",\"registry\":\"standard\",\"record_type\":\"terminology_artefact\",\"name\":\"Observatories of Seas Ontology\",\"abbreviation\":\"OSO\",\"description\":\"OSO (Observatories of Seas Ontology) is a lightweight and multilingual ontology developed to describe and interlink marine observing systems, including their infrastructures, platforms, sites, equipment, and responsible organisations.\\nIt is maintained by Ifremer and designed to support metadata harmonisation across European marine research infrastructures such as EMSO ERIC. The ontology uses standard vocabularies (OWL, DCAT, Dublin Core, FOAF, SKOS, etc.) and aligns with external identifiers (ROR, EDMO, DOI). OSO aims to improve semantic interoperability, enable FAIR metadata publication, and support long-term data stewardship in the marine domain.\",\"doi\":\"10.25504/FAIRsharing.654931\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.654931\",\"homepage\":\"https://w3id.org/earthsemantics/OSO\",\"countries\":[\"France\",\"Greece\",\"Ireland\",\"Italy\",\"Mayotte\",\"New Caledonia\",\"Norway\",\"Portugal\",\"Romania\",\"Spain\",\"Vanuatu\"],\"disciplines\":[\"Marine Biology\",\"Earth Science\"],\"domains\":[\"marine coral reef biome\",\"marine environment\",\"marine metagenome\"],\"taxonomies\":[\"Not applicable\"],\"user_defined_tags\":[\"earth observation\",\"Marine Chemistry\",\"Marine Litter\",\"marine energy\",\"semantic web\",\"marine observatories\"],\"legacy_ids\":[],\"created_at\":\"2025-07-30T07:53:25.099Z\",\"updated_at\":\"2025-10-16T12:33:37.546Z\"}],\"links\":{\"self\":null,\"first\":null,\"prev\":null,\"next\":null,\"last\":null},\"note\":\"Proxied for use in Data Stewardship Wizard (see https://ds-wizard.org for more)\"}","contentType":"application/json","responseType":"SuccessTypeHintResponse","status":200}}},"testVariables":{"changed":true,"value":{"record_type":"terminology_artefact","registry":"standard","status":"ready"}},"variables":{"changed":true,"value":["registry","record_type","status"]}},"createdAt":"2025-11-25T12:17:06Z","entityUuid":"aacf9099-8221-4b15-8425-fc356eb16d9b","parentUuid":"6f6241d9-136c-4770-9d58-8a3f39607052","uuid":"c3aeb0a8-cf1e-49e6-bba8-ad87bee353c0"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"integrationUuid":{"changed":true,"value":"aacf9099-8221-4b15-8425-fc356eb16d9b"},"questionType":"IntegrationQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"variables":{"changed":true,"value":{"record_type":"model_and_format","registry":"Standard","status":"ready"}}},"createdAt":"2025-11-25T12:17:07Z","entityUuid":"f00cf643-5368-458a-97d4-b463c2000c66","parentUuid":"b08fe063-33f8-4380-b3a9-ba1e586dedf2","uuid":"fd17cfc0-9e84-4abe-9507-1dec066d2c6d"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"integrationUuid":{"changed":true,"value":"aacf9099-8221-4b15-8425-fc356eb16d9b"},"questionType":"IntegrationQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"variables":{"changed":true,"value":{"record_type":"model_and_format","registry":"Standard","status":"ready"}}},"createdAt":"2025-11-25T12:17:08Z","entityUuid":"63ed4349-9743-4fd1-96df-73dbb7e4f05b","parentUuid":"a797cab9-0829-4787-a096-1b5cedc9147f","uuid":"d7511e24-baa5-4769-b33c-63deeea4672c"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"integrationUuid":{"changed