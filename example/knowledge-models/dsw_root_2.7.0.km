meg.cessda.eu/Data-Management-Expert-Guide/3.-Process/Data-entry-and-integrity"}},"createdAt":"2025-09-30T11:05:28Z","entityUuid":"4cbf4d06-9b4f-4088-b5e4-ab0813c5d853","parentUuid":"02b3fed1-0b50-4a80-b8b6-a225a1107022","uuid":"77c0973c-4d37-415e-b33b-b65b0a28cc79"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2025-09-30T11:06:43Z","entityUuid":"15f661c7-2bfa-4687-823e-80692f3efd61","parentUuid":"49c009cb-a38c-4836-9780-8a8b3dd1cbac","uuid":"2ebd71b0-bd32-469e-9acf-5d0755ff2cba"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"DMEG on Data Protection"},"referenceType":"URLReference","url":{"changed":true,"value":"https://dmeg.cessda.eu/Data-Management-Expert-Guide/5.-Protect"}},"createdAt":"2025-09-30T11:06:45Z","entityUuid":"15f661c7-2bfa-4687-823e-80692f3efd61","parentUuid":"49c009cb-a38c-4836-9780-8a8b3dd1cbac","uuid":"277fddce-e309-4e11-ba5c-faba4169cc91"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2025-09-30T11:07:08Z","entityUuid":"4c559ae4-fbde-45a9-bb03-53fb626198ec","parentUuid":"49c009cb-a38c-4836-9780-8a8b3dd1cbac","uuid":"d7fd97c3-d67e-4076-a826-bd4d6cc58d6b"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"DMEG on Personal Data"},"referenceType":"URLReference","url":{"changed":true,"value":"https://dmeg.cessda.eu/Data-Management-Expert-Guide/5.-Protect/Processing-personal-data"}},"createdAt":"2025-09-30T11:07:17Z","entityUuid":"4c559ae4-fbde-45a9-bb03-53fb626198ec","parentUuid":"49c009cb-a38c-4836-9780-8a8b3dd1cbac","uuid":"cbdfbcf4-7253-4cf2-90ae-2b78a4709fba"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2025-09-30T11:08:14Z","entityUuid":"c653312c-e9b1-4d3c-b23f-26ba0c429cd4","parentUuid":"3782d32b-91b5-432f-8f93-92bb22868a22","uuid":"e164bd55-00bf-445a-bb9e-f5399aaced44"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"DMEG on Ethical Process Review"},"referenceType":"URLReference","url":{"changed":true,"value":"https://dmeg.cessda.eu/Data-Management-Expert-Guide/5.-Protect/Ethical-review-process"}},"createdAt":"2025-09-30T11:08:17Z","entityUuid":"c653312c-e9b1-4d3c-b23f-26ba0c429cd4","parentUuid":"3782d32b-91b5-432f-8f93-92bb22868a22","uuid":"7efa7b21-8a9f-433c-bbe7-76d56bda04fb"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2025-09-30T11:09:40Z","entityUuid":"ed8502b4-0043-4847-8db5-62377f135a3e","parentUuid":"d5784d24-0e66-4821-bd62-a711fb6d7a40","uuid":"077f114a-c75b-4ac0-ab41-f54fe571843f"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"DMEG on Storage"},"referenceType":"URLReference","url":{"changed":true,"value":"https://dmeg.cessda.eu/Data-Management-Expert-Guide/4.-Store/Storage"}},"createdAt":"2025-09-30T11:09:41Z","entityUuid":"ed8502b4-0043-4847-8db5-62377f135a3e","parentUuid":"d5784d24-0e66-4821-bd62-a711fb6d7a40","uuid":"31e1de0d-74d2-43c3-be67-80acf00cf1ae"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2025-09-30T11:10:59Z","entityUuid":"aa54555f-b312-41a5-9c24-609b2d7d9346","parentUuid":"1147485f-b9a9-486c-8341-27e05718c508","uuid":"fb3cf282-f501-4a9f-82f1-a2a4646b134b"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"DMEG on Backups"},"referenceType":"URLReference","url":{"changed":true,"value":"https://dmeg.cessda.eu/Data-Management-Expert-Guide/4.-Store/Backup"}},"createdAt":"2025-09-30T11:11:02Z","entityUuid":"aa54555f-b312-41a5-9c24-609b2d7d9346","parentUuid":"1147485f-b9a9-486c-8341-