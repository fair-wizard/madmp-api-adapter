entifier for a different data set) and _resolvable_ (you can actually locate the data set if you only know the identifier)."},"title":{"changed":false}},"createdAt":"2020-07-01T10:28:12Z","entityUuid":"cf727a0a-78c4-45a7-aa9b-cf7650ae873a","parentUuid":"4e0c1edf-660c-4ebf-81f5-9fa959dead30","uuid":"0e6791a4-f5e6-47b8-953e-8ec005d5671f"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"ValueQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":"Link to the license text, if available","validations":[],"valueType":"StringQuestionValueType"},"createdAt":"2020-07-01T10:28:13Z","entityUuid":"375792f1-d7c3-4c8d-bf9e-f15ffa38e2fb","parentUuid":"734d5f4e-91c0-4019-8164-8c70c2e0c8f2","uuid":"bdcf0dfc-309a-46d8-8ce3-1abeb68cfff0"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":true,"value":["30426255-b153-4f3e-bf20-f13573160a64","375792f1-d7c3-4c8d-bf9e-f15ffa38e2fb","f78fb7e9-2f26-493c-a19b-04e153c17274","a572c436-5d57-4385-ac9a-d6f117881444"]},"label":{"changed":false},"metricMeasures":{"changed":false}},"createdAt":"2020-07-01T10:28:14Z","entityUuid":"734d5f4e-91c0-4019-8164-8c70c2e0c8f2","parentUuid":"ca0f9465-3116-4824-8651-b592151c5368","uuid":"e3812da7-a610-4ba4-a605-9bf9ff777fc1"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"If the license is available as a text on the internet, please specify its URL here."},"title":{"changed":true,"value":"Link to the license text"},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2020-07-01T10:28:15Z","entityUuid":"375792f1-d7c3-4c8d-bf9e-f15ffa38e2fb","parentUuid":"734d5f4e-91c0-4019-8164-8c70c2e0c8f2","uuid":"42cb622e-f7c5-43e2-a31b-2abee2ddd258"},{"content":{