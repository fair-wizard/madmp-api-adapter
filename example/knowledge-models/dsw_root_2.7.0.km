d8e"},{"content":{"eventType":"DeleteQuestionEvent"},"createdAt":"2020-11-11T10:50:24Z","entityUuid":"d386268d-874d-42f5-9049-b85cb6ff0d55","parentUuid":"07fdfbfb-9c7c-4e9c-83fa-bccf85094fb6","uuid":"9a92bd8a-250b-4a80-b3a0-e011f2b6fb1d"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"If you use a standard that is not in FAIRsharing, please specify its PID or URL"},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2020-11-11T10:50:25Z","entityUuid":"c00627a4-40e3-48c2-b481-a0cff5e00080","parentUuid":"2bac9020-99cf-4463-8d34-0b0eb2781cd1","uuid":"4ac3d2a2-a45c-4d61-9630-02f7a1cb2c93"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"integrationUuid":{"changed":true,"value":"f3520558-707e-415a-8878-c7b8d6ccc2fb"},"questionType":"IntegrationQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"variables":{"changed":true,"value":{"registry":""}}},"createdAt":"2020-11-11T10:50:26Z","entityUuid":"9a7e42c3-eed2-46da-bf45-52acbf1eb50f","parentUuid":"2bac9020-99cf-4463-8d34-0b0eb2781cd1","uuid":"0d49673d-6ab2-4a29-afe2-e3188de773ce"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"integrationUuid":{"changed":false},"questionType":"IntegrationQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"variables":{"changed":true,"value":{"registry":"standards"}}},"createdAt":"2020-11-11T10:50:27Z","entityUuid":"9a7e42c3-eed2-46da-bf45-52acbf1eb50f","parentUuid":"2bac9020-99cf-4463-8d34-0b0eb2781cd1","uuid":"cce847f5-b9ec-4ce1-b452-f16fc02397fe"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Putting some thoughts into file naming can save a lot of trouble later. "},"title":{"changed":false}},"createdAt":"2020-11-11T10:50:28Z","entityUuid":"8e886b55-3287-48e7-b353-daf6ab40f7d8","parentUuid":"6d18bfff-0f53-469b-934e-9806dda9d4fb","uuid":"9da522c3-eb63-4a88-82de-7b3094b9a662"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"The file names are very useful as metadata for people involved in the project, but to computers they are just identifiers. To prevent accidents with e.g. renamed files metadata information should always also be available elsewhere and not only through the file name.\n\nAlso note that if metadata could need to change, embedding it in the file names may require renaming files during the project; and this may have implications for references to those files."},"title":{"changed":true,"value":"Will all the metadata that is embedded in the file names also be available in the proper metadata?"}},"createdAt":"2020-11-11T10:50:29Z","entityUuid":"7dfd022e-6d6e-4923-a81a-ca1f11024b57","parentUuid":"c05f27a2-30ac-44fd-9ac9-cd6f62b16d0c","uuid":"a38f894b-be41-448a-a108-f30266141b32"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":"Especially for large projects, referring to data internally via a persistent identifier system can be helpful as such a system can help to keep track of data that moves to a new location.","title":"Will you be using persistent identifiers to refer to data in the project?"},"createdAt":"2020-11-11T10:50:30Z","entityUuid":"b1f62b06-e69a-41be-8d16-1d73b9b75cd2","parentUuid":"c05f27a2-30ac-44fd-9ac9-cd6f62b16d0c","uuid":"b18d146b-4d40-4370-a3b0-544569c771e1"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[]},"createdAt":"2020-11-11T10:50:31Z","entityUuid":"22251809-e695-40cb-8c5a-f11fa9bb7918","parentUuid":"b1f62b06-e69a-41be-8d16-1d73b9b75cd2","uuid":"00fae376-f56a-4779-b2d8-648d9378d425"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[]},"createdAt":"2020-11-11T10:50:32Z","entityUuid":"c0898e79-f145-4ff4-b4c8-7e15c689c5f2","parentUuid":"b1f62b06-e69a-41be-8d16-1d73b9b75cd2","uuid":"61d28a14-e820-4fe7-a513-5de32ecf9e5f"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":true,"value":"1796fa3c-9f53-475f-89ff-c66a0453c42e"},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Will you be using persistent identifiers to refer to data within the project?"}},"createdAt":"2020-11-11T10:50:33Z","entityUuid":"b1f62b06-e69a-41be-8d16-1d73b9b75cd2","parentUuid":"c05f27a2-30ac-44fd-9ac9-cd6f62b16d0c","uuid":"0fbe7dfb-a3ac-4925-b21f-2e18e9b2a034"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"The Handle System","referenceType":"URLReference","url":"https://www.handle.net"},"createdAt":"2020-11-11T10:50:34Z","entityUuid":"d9ddb6db-2afd-45c0-8d25-f50208c53aa4","parentUuid":"b1f62b06-e69a-41be-8d16-1d73b9b75cd2","uuid":"d2015b1e-c1af-4157-992f-f12f5dac673a"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"Handbook on Persistent Identifiers","referenceType":"URLReference","url":"https://www.dpconline.org/handbook/technical-solutions-and-tools/persistent-identifiers"},"createdAt":"2020-11-11T10:50:35Z","entityUuid":"06ca6750-b48d-42fc-b350-8d98b462b458","parentUuid":"b1f62b06-e69a-41be-8d16-1d73b9b75cd2","uuid":"f71e728b-57d9-4a01-9b69-1ac1cb261258"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Will you be storing (in cold storage) copies of your own data for a longer period after the project has ended? Possibly as a continuation of archival as part of data storage strategy during the project? Data archival is distinct from data publishing, an archive is usually strictly limited in who can access the data."},"title":{"changed":true,"value":"Will you be archiving your data in 'cold storage' after the project finishes?"}},"createdAt":"2020-11-11T10:50:36Z","entityUuid":"f9d84278-b61d-4314-94e9-12644bfa1d00","parentUuid":"d5b27482-b598-4b8c-b534-417d4ad27394","uuid":"b1529da4-a42d-431a-9915-ac64059c6943"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Are there any other recurring fees to keep data or documents available?"}},"createdAt":"2020-11-11T10:50:37Z","entityUuid":"4baf405e-262e-4f1a-bfdc-fe72fc628650","parentUuid":"d5b27482-b598-4b8c-b534-417d4ad27394","uuid":"cc2e2048-3583-4269-ba7e-68e8c9861286"},{"content":{"annotations":{"changed":false},"eventType":"EditChapterEvent","questionUuids":{"changed":true,"value":["d5784d24-0e66-482