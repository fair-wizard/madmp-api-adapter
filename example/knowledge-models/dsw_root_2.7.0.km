ionEvent","questionType":"ValueQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":"Mail address","validations":[],"valueType":"StringQuestionValueType"},"createdAt":"2020-01-04T14:34:11Z","entityUuid":"3a2ffc13-6a0e-4976-bb34-14ab6d938348","parentUuid":"73d686bd-7939-412e-8631-502ee6d9ea7b","uuid":"03ec969c-cbe1-4331-81b0-2bfc4bd20318"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"ValueQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":"ORCID Identifier","validations":[],"valueType":"StringQuestionValueType"},"createdAt":"2020-01-04T14:34:12Z","entityUuid":"6295a55d-48d7-4f3c-961a-45b38eeea41f","parentUuid":"73d686bd-7939-412e-8631-502ee6d9ea7b","uuid":"3d6505c1-d016-4a6c-bea4-4a8c073b2420"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":"Role"},"createdAt":"2020-01-04T14:34:13Z","entityUuid":"829dcda6-db8a-40ac-819a-92b9b52490f5","parentUuid":"73d686bd-7939-412e-8631-502ee6d9ea7b","uuid":"3e5829bd-9510-4256-9830-2052413c6a70"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"E-mail address"},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2020-01-04T14:34:14Z","entityUuid":"3a2ffc13-6a0e-4976-bb34-14ab6d938348","parentUuid":"73d686bd-7939-412e-8631-502ee6d9ea7b","uuid":"dee73b95-f66d-4e00-973e-722260b7f789"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Contact Person","metricMeasures":[]},"createdAt":"2020-01-04T14:34:15Z","entityUuid":"f7468e79-c621-4ac9-95e0-263ebdf23c73","parentUuid":"829dcda6-db8a-40ac-819a-92b9b52490f5","uuid":"04eb51c5-4ea5-4db2-8b22-ff98bbf76f38"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Data Collector","metricMeasures":[]},"createdAt":"2020-01-04T14:34:16Z","entityUuid":"fe411838-170e-45d7-9d91-14f95ad347e6","parentUuid":"829dcda6-db8a-40ac-819a-92b9b52490f5","uuid":"644f5078-bd61-4919-9ede-5a7bccfecf2e"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Data Curator","metricMeasures":[]},"createdAt":"2020-01-04T14:34:17Z","entityUuid":"0ee99167-c1a2-4fe9-a799-ef07a31ccf35","parentUuid":"829dcda6-db8a-40ac-819a-92b9b52490f5","uuid":"e4143397-cf1f-4cf9-8ad2-cec4da701f09"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Data Manager","metricMeasures":[]},"createdAt":"2020-01-04T14:34:18Z","entityUuid":"6eef8c10-150a-496c-b02a-61c90e62e95b","parentUuid":"829dcda6-db8a-40ac-819a-92b9b52490f5","uuid":"0c294711-ae6f-4f8c-83a3-5ab6abb7cefa"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Distributor","metricMeasures":[]},"createdAt":"2020-01-04T14:34:19Z","entityUuid":"ae91b0b1-a591-49d1-a85c-13071550c043","parentUuid":"829dcda6-db8a-40ac-819a-92b9b52490f5","uuid":"9dfbdad1-d212-46bf-969b-08ccb09d3bcb"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Editor","metricMeasures":[]},"createdAt":"2020-01-04T14:34:20Z","entityUuid":"b7ee1e51-2628-486e-a341-2437c546897d","parentUuid":"829dcda6-db8a-40ac-819a-92b9b52490f5","uuid":"521a84a2-3e25-4bfc-a7fb-a60be67c4446"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Producer","metricMeasures":[]},"createdAt":"2020-01-04T14:34:21Z","entityUuid":"ac02d12c-db42-4d47-a557-5fbd1d7ae524","parentUuid":"829dcda6-db8a-40ac-819a-92b9b52490f5","uuid":"5450b557-ee0f-421a-8f92-d62ad23fca83"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Project Leader","metricMeasures":[]},"createdAt":"2020-01-04T14:34:22Z","entityUuid":"c1caf2a7-fd84-4856-b3c4-35e09b5e1aca","parentUuid":"829dcda6-db8a-40ac-819a-92b9b52490f5","uuid":"89a65922-a626-4b3e-bf1c-34351d9491d2"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Project Manager","metricMeasures":[]},"createdAt":"2020-01-04T14:34:23Z","entityUuid":"99f5e968-cea8-49bf-a406-f134e664e657","parentUuid":"829dcda6-db8a-40ac-819a-92b9b52490f5","uuid":"ec64e859-f22f-40e9-ab5f-024fd7423cb2"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Project Member","metricMeasures":[]},"createdAt":"2020-01-04T14:34:24Z","entityUuid":"53dade1c-828c-4887-829a-65b4540291d5","parentUuid":"829dcda6-db8a-40ac-819a-92b9b52490f5","uuid":"22b41e51-8cb7-49e0-b342-0d017fbe55b6"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Researcher","metricMeasures":[]},"createdAt":"2020-01-04T14:34:25Z","entityUuid":"369db75c-cf52-459a-836c-e3bcac3590bb","parentUuid":"829dcda6-db8a-40ac-819a-92b9b52490f5","uuid":"0c4f7006-a33d-443f-a805-6995af4df290"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Rights Holder","metricMeasures":[]},"createdAt":"2020-01-04T14:34:26Z","entityUuid":"5d758307-4e3a-439b-8c88-4dbdbfcd2154","parentUuid":"829dcda6-db8a-40ac-819a-92b9b52490f5","uuid":"ea704497-1d64-4f01-bd39-7eb569e52b0a"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Sponsor","metricMeasures":[]},"createdAt":"2020-01-04T14:34:27Z","entityUuid":"82ecfb2d-e321-47e4-93d8-e36a9a7031e9","parentUuid":"829dcda6-db8a-40ac-819a-92b9b52490f5","uuid":"6b3495de-0a62-409d-a66d-d2cadb50b9c6"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Supervisor","metricMeasures":[]},"createdAt":"2020-01-04T14:34:28Z","entityUuid":"c6883c1f-6dd8-4c5b-aa7d-b93e4e2d9378","parentUuid":"829dcda6-db8a-40ac-819a-92b9b52490f5","uuid":"955740a6-9f95-4d22-b7ea-8f99988fec3f"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Work Package Leader","metricMeasures":[]},"createdAt":"2020-01-04T14:34:29Z","entityUuid":"d24fd64b-6a66-4d22-80f0-2d1aae4a554f","parentUuid":"829dcda6-db8a-40ac-819a-92b9b52490f5","uuid":"4a3e658e-d698-4553-b6c3-83e1162f6972"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Other","metricMeasures":[]},"createdAt":"2020-01-04T14:34:30Z","entityUuid":"dead02bb-d5b2-4036-9e99-3318f191b3d0","parentUuid":"829dcda6-db8a-40ac-819a-92b9b52490f5","uuid":"5193b592-cb10-4a62-97f2-7855125a7c32"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Roles in a project should be given as they are defined by [datacite](https://schema.datacite.org/meta/kernel-4.1/doc/DataCite-MetadataKernel_v4.1.pdf). You should specify at least one \"Contact Person\"."},"title":{"changed":false}},"createdAt":"2020-01-04T14:34:31Z","entityUuid":"829dcda6-db8a-40ac-819a-92b9b52490f5","parentUuid":"73d686bd-7939-412e-8631-502ee6d9ea7b","uuid":"5d298a9b-1b6e-4070-9568-389b811e686e"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Much of todays data is used in comparison with reference data. You may be comparing your own data with a \"standard set\" which is maintained as a collection by someone else. Or you could be determining differences to a stanndard (in bioinformatics, a genome is often compared with a reference genome to identify genomic variants). If you use reference data, there are several other issues that you should consider. What are the reference data sets that you will use?"},"title":{"changed":false}},"createdAt":"2020-01-04T14:34:32Z","entityUuid":"fcc51962-08df-4f4c-85ad-6bb932107010","parentUuid":"dac677d4-99f9-4af8-935a-4a1c9c7cdbdf","uuid":"74067454-05a2-437e-b083-ae5616b8a4c7"},{"content":{"annotations":{"changed":false},"eventType":"EditChapterEvent","questionUuids":{"changed":false},"text":{"changed":true,"value":"Before you decide to embark on any new study, it is nowadays good practice to check all options to re-use existing available data, either collected or generated by yourself in an earlier project, or data from others (Barend Mons calls this \"Other PEople's Data And Services\" or OPEDAS). This can include reusable data that have been created for an earlier study, and also so-called \"reference data\" which is used by many projects.\n\nIt is not because we can generate massive amounts of data that we always need to do so. Creating data with public money is bringing with it the responsibility to treat those data well and (if potentially useful) make them available for re-use by others. And the circle is only complete if such data is actually re-used."},"title":{"changed":false}},"createdAt":"2020-01-04T14:34:33Z","entityUuid":"82fd0cce-2b41-423f-92ad-636d0872045c","parentUuid":"6f6241d9-136c-4770-9d58-8a3f39607052","uuid":"76a27bf8-c9a3-4703-93e8-8ced1244bfa5"},{"content":{"annotations":{"changed":false},"eventType":"EditChapterEvent","questionUuids":{"changed":false},"text":{"changed":true,"value":"We will make sure that we know what data will be coming together in the project, when it will be coming. We also need to make sure that we have adequate storage space to deal with it, and that all the responsibilities have been taken care of."},"title":{"changed":false}},"createdAt":"2020-01-04T14:34:34Z","entityUuid":"b1df3c74-0b1f-4574-81c4-4cc2d780c1af","parentUuid":"6f6241d9-136c-4770-9d58-8a3f39607052","uuid":"a2cf087c-b10d-4302-b72b-87320e322e45"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Have you identified types of data that you will use that are used by others too? Some types of data (for example \"images\" or \"tables\") are used by many different projects. For such data, often common standards exist (in our example \"JPG\" and \"CSV\") that help to make these data reusable. Are you using such common data formats?"},"title":{"changed":false}},"createdAt":"2020-01-04T14:34:35Z","entityUuid":"b08fe063-33f8-4380-b3a9-ba1e586dedf2","parentUuid":"d5b27482-b598-4b8c-b534-417d4ad27394","uuid":"1ea3b16e-4ace-4c3a-a71f-c5871bf7825a"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Complicated (binary) file formats tend to change over time, and software may not stay compatible with older versions. Also, some formats hamper long term usability by making use of patents or being hampered by restrictive licensing."},"title":{"changed":false}},"createdAt":"2020-01-04T14:34:36Z","entityUuid":"ced5a7c2-4034-4763-a1d5-3cb815cdfddb","parentUuid":"b08fe063-33f8-4380-b3a9-ba1e586dedf2","uuid":"50002daf-3732-42b0-9d7e-1a6ceea8c0a6"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Even if you will be producing your own data, you often will also be relying on existing data sets (e.g. from your own earlier projects). You may need to integrate your new data with an existing data set or retrieve additional information from related data bases. Will you be doing such things?"},"title":{"changed":false}},"createdAt":"2020-01-04T14:34:37Z","entityUuid":"be872000-cb98-442f-999c-ca3ef58dcfe8","parentUuid":"dac677d4-99f9-4af8-935a-4a1c9c7cdbdf","uuid":"61e6efa8-761a-416c-a90e-e910c8b25274"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"integrationUuid":{"changed":false},"questionType":"IntegrationQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Give a name for the data set. You will get suggestions listing databases listed in FAIRSharing, but you can also specify data sets that are not listed."},"title":{"changed":false},"variables":{"changed":false}},"createdAt":"2020-01-04T14:34:38Z","entityUuid":"44120979-2840-4522-8297-df13f7fd1e3a","parentUuid":"be872000-cb98-442f-999c-ca3ef58dcfe8","uuid":"a44d0ef2-d191-4231-ad15-c002273d1608"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"There can be restrictions imposed on the re-use of data. This could be through licensing, or if personal or sensitive data is involved there may be other restrictions (e.g. consent)."},"title":{"changed":false}},"createdAt":"2020-01-04T14:34:39Z","entityUuid":"27c83b38-1df2-4f91-89ac-2f6bf4e72190","parentUuid":"be872000-cb98-442f-999c-ca3ef58dcfe8","uuid":"9ee51727-c74b-4572-9d80-ce0ef858faaf"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"If the data that you will re-use is coupled to people, the informed consent that was originally obtained from those people may not be covering your current research. In that case re-consent may be necessary."},"title":{"changed":false}},"createdAt":"2020-01-04T14:34:40Z","entityUuid":"467ff3ad-156c-4285-9efb-c91072b3544e","parentUuid":"be872000-cb98-442f-999c-ca3ef58dcfe8","uuid":"57b50cdc-9c70-4d71-bd24-0e2360b31d19"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Will you be using a working space that is shared between all the people working on the data in the project? Sometimes such a system is called a *Virtual Research Environment*."},"title":{"changed":false}},"createdAt":"2020-01-04T14:34:41Z","entityUuid":"72099c46-16e7-47a2-a320-cc768b7085fe","parentUuid":"10a10ffd-bfe1-4c6b-bbb6-3dfb1e63a5d5","uuid":"ba827220-6579-4055-9e07-bf0599c52780"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Each person contributing to creating or executing the data management plan should be added as a contributor. A project probably should have a Contact Person, and a Data Curator."},"title":{"changed":false}},"createdAt":"2020-01-04T14:34:42Z","entityUuid":"73d686bd-7939-412e-8631-502ee6d9ea7b","parentUuid":"1e85da40-bbfc-4180-903e-6c569ed2da38","uuid":"8ba0c9f8-e031-4841-b1fd-0d379de75167"},{"content":{"annotations":{"changed":false},"answe