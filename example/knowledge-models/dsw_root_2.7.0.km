:32Z","entityUuid":"013ddcd2-914c-41ff-8928-776ad863d9ac","parentUuid":"730bf055-5e8e-4837-992c-d8a071855b4f","uuid":"275618fe-2851-4b26-8657-d7a58ddce46d"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2023-04-17T06:07:37Z","entityUuid":"0d83c012-eb25-4078-a5e2-139fe6b31cb7","parentUuid":"730bf055-5e8e-4837-992c-d8a071855b4f","uuid":"2058687c-fe62-4abc-bbda-a175be8b55b4"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"FAIRCookBook on making Workflows FAIR"},"referenceType":"URLReference","url":{"changed":true,"value":"https://w3id.org/faircookbook/FCB062"}},"createdAt":"2023-04-17T06:07:57Z","entityUuid":"0d83c012-eb25-4078-a5e2-139fe6b31cb7","parentUuid":"730bf055-5e8e-4837-992c-d8a071855b4f","uuid":"7da6e490-3f16-411f-a359-13080fa52db6"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2023-04-20T15:44:16Z","entityUuid":"692f635c-22a5-48e6-a3af-07ff881c3701","parentUuid":"8c962e6f-17ee-4b22-8ebb-9f06f779e3b3","uuid":"a9f767ed-c957-4141-a341-1e73db296d8f"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"FAIRCookBook on FAIR and the notion of Metadata "},"referenceType":"URLReference","url":{"changed":true,"value":"https://w3id.org/faircookbook/FCB068"}},"createdAt":"2023-04-20T15:45:01Z","entityUuid":"692f635c-22a5-48e6-a3af-07ff881c3701","parentUuid":"8c962e6f-17ee-4b22-8ebb-9f06f779e3b3","uuid":"c220376d-9ad9-4675-955f-3a5b9d493969"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2023-04-20T15:46:19Z","entityUuid":"0dfcc19c-aa2f-4054-a44d-3a95e2d7c628","parentUuid":"6cc96576-2535-46b3-8c9b-a12703ee96cc","uuid":"36ab5ce7-b6ce-4b8f-a6ae-ca305178355d"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"FAIRCookBook on Data Protection Impact Assessment"},"referenceType":"URLReference","url":{"changed":true,"value":"https://w3id.org/faircookbook/FCB074"}},"createdAt":"2023-04-20T15:46:45Z","entityUuid":"0dfcc19c-aa2f-4054-a44d-3a95e2d7c628","parentUuid":"6cc96576-2535-46b3-8c9b-a12703ee96cc","uuid":"3e9fe972-4ab1-4d56-b709-3a3735b1c332"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Datasets can be assigned persistent identifiers. Just like journal articles get assigned DOIs, these are often also used for data sets. Note that the DOI of a paper is not a persistent identifier for its supplementary information.\n\nMany repositories make sure that your data get a persistent and resolvable identifiers. In other cases, you should take care of this yourself."},"title":{"changed":false}},"createdAt":"2023-04-20T15:49:21Z","entityUuid":"d21fdb06-22bf-418e-aa40-dc5ef1485f56","parentUuid":"81d3095e-a530-40a4-878e-ced42fabc4cd","uuid":"e5eeacf1-a398-4d3a-8970-3e9553b0db75"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2023-04-20T15:49:26Z","entityUuid":"b0f4ce3b-4dcd-467f-92e1-07c4f97004b7","parentUuid":"d21fdb06-22bf-418e-aa40-dc5ef1485f56","uuid":"9869f507-1eb1-49c8-84c7-16b41574c253"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"FAIRCookBook on creating resolvable identifiers"},"referenceType":"URLReference","url":{"changed":true,"value":"https://w3id.org/faircookbook/FCB077"}},"createdAt":"2023-04-20T15:49:54Z","entityUuid":"b0f4ce3b-4dcd-467f-92e1-07c4f97004b7","parentUuid":"d21fdb06-22bf-418e-aa40-dc5ef1485f56","uuid":"1c1c7102-f010-49f9-bb49-c27d908d8db5"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2023-04-20T15:50:46Z","entityUuid":"e9091f21-22a1-4f5e-b8e1-6e3e4b2f8dca","parentUuid":"b1f62b06-e69a-41be-8d16-1d73b9b75cd2","uuid":"f109b9d4-a5b7-4275-9b9b-86fe542f4d74"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"FAIRCookBook on creating resolvable identifiers"},"referenceType":"URLReference","url":{"changed":true,"value":"https://w3id.org/faircookbook/FCB077"}},"createdAt":"2023-04-20T15:51:03Z","entityUuid":"e9091f21-22a1-4f5e-b8e1-6e3e4b2f8dca","parentUuid":"b1f62b06-e69a-41be-8d16-1d73b9b75cd2","uuid":"0a93b926-65ac-4bb7-9729-1d934b1a3212"},{"content":{"annotations":{"changed":false},"color":{"changed":false},"description":{"changed":true,"value":"Ethical, legal, and social implications / aspects"},"eventType":"EditTagEvent","name":{"changed":false}},"createdAt":"2023-06-12T09:30:25Z","entityUuid":"4fa6f10d-b593-4b00-84cf-00d7f916147f","parentUuid":"6f6241d9-136c-4770-9d58-8a3f39607052","uuid":"deb258f3-e14a-4285-843b-b3a632a744da"},{"content":{"annotations":{"changed":false},"description":{"changed":true,"value":"The project team conducts extensive research and analysis to gather relevant information and identify potential challenges and opportunities. It is important to collaboratively outline the proposal's objectives, scope, and timeline, ensuring that it aligns with the requirements and sets a strong foundation for the project's success."},"eventType":"EditPhaseEvent","title":{"changed":false}},"createdAt":"2023-06-12T09:33:50Z","entityUuid":"b101f2d0-2476-452d-aa8d-95a41a02b52c","parentUuid":"6f6241d9-136c-4770-9d58-8a3f39607052","uuid":"06366c72-b92d-4788-a780-e3e1df353f12"},{"content":{"annotations":{"changed":false},"description":{"changed":true,"value":"The project team focuses on developing a comprehensive plan for managing and protecting the project's data assets. This involves assessing data collection methods, defining data storage and access protocols, and addressing data privacy and security concerns. The team also collaborates with stakeholders to ensure the DMP meets regulatory requirements and supports the project's goals effectively."},"eventType":"EditPhaseEvent","title":{"changed":false}},"createdAt":"2023-06-12T09:34:31Z","entityUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","parentUuid":"6f6241d9-136c-4770-9d58-8a3f39607052","uuid":"a9e15faf-34da-491b-82f4-4c12da6b4fbb"},{"content":{"annotations":{"changed":false},"description":{"changed":true,"value":"The project team conducts thorough evaluations and quality checks to ensure that all project deliverables and objectives have been met. Final testing and validation processes are conducted to address any remaining issues or risks, and document lessons learned for future projects. Additionally, the team prepares necessary documentation, such as project closure reports and handover plans, to ensure a smooth transition and successful completion of the project."},"eventType":"EditPhaseEvent","title":{"changed":false}},"createdAt":"2023-06-12T09:35:30Z","entityUuid":"adc9133d-afcd-4616-9aea-db5f475898a2","parentUuid":"6f6241d9-136c-4770-9d58-8a3f39607052","uuid":"a633a3dc-3fcb-443e-9338-0747ac3cc224"},{"content":{"annotations":{"changed":false},"description":{"changed":true,"value":"The team conducts a comprehensive project review to evaluate its overall success and identify areas for improvement. Relevant feedback is gathered from stakeholders,  team is also finalizing reports and archiving project documentation. Finally, lessons learned are being documented for future reference."},"eventType":"EditPhaseEvent","title":{"changed":false}},"createdAt":"2023-06-12T10:32:00Z","entityUuid":"1ace0fc6-a949-495f-a32e-e948f3f6bed1","parentUuid":"6f6241d9-136c-4770-9d58-8a3f39607052","uuid":"f8d5452c-67d2-4f6e-aa6c-573b3c99da08"},{"content