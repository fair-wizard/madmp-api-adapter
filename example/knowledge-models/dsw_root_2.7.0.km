28T14:48:51Z","entityUuid":"18db88c7-97c9-416e-b1ae-763bf018345e","parentUuid":"c2da0410-ede1-4b0a-a750-09e6e6bd38cf","uuid":"1d9e5844-a1ff-4b7c-8a77-44847099adf9"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Legal requirement: we are legally obliged to do this data processing"},"metricMeasures":{"changed":false}},"createdAt":"2022-02-28T14:48:52Z","entityUuid":"18db88c7-97c9-416e-b1ae-763bf018345e","parentUuid":"c2da0410-ede1-4b0a-a750-09e6e6bd38cf","uuid":"749a3035-a404-44ac-89c1-5879f8ff7bb5"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"What is the legal basis for processing the data under the GDPR?"}},"createdAt":"2022-02-28T14:48:53Z","entityUuid":"c2da0410-ede1-4b0a-a750-09e6e6bd38cf","parentUuid":"1bbafc04-e527-481b-ad1f-521cc48de186","uuid":"7c8af938-a4a0-46cb-b28c-928663e58215"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-02-28T14:48:54Z","entityUuid":"597d2547-4e97-4045-8605-3b5249f2b412","parentUuid":"c2da0410-ede1-4b0a-a750-09e6e6bd38cf","uuid":"f513a2d1-fc87-4d9c-940c-f457d93b71ee"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Public interest: we do this for the benefit of society, and this is more important than the privacy of the subjects"},"metricMeasures":{"changed":false}},"createdAt":"2022-02-28T14:48:55Z","entityUuid":"597d2547-4e97-4045-8605-3b5249f2b412","parentUuid":"c2da0410-ede1-4b0a-a750-09e6e6bd38cf","uuid":"2b49fb0f-7721-40f3-9424-430aee9b161a"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Vital interest: we need to do this to protect the vital interests of the data subject"},"metricMeasures":{"changed":false}},"createdAt":"2022-02-28T14:48:56Z","entityUuid":"8caeb960-7c5e-457c-ae9e-1a2e038a466a","parentUuid":"c2da0410-ede1-4b0a-a750-09e6e6bd38cf","uuid":"84769399-63e0-4026-806b-ab96ddd26660"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":true,"value":["597d2547-4e97-4045-8605-3b5249f2b412","eb17ff9a-c57e-4fd4-b3bd-89edb31c6568","bfb7a92c-5eec-497e-8a0f-ef7b12f353c2","34bf8a67-6bba-4eab-8264-8d76f97e66c8","8caeb960-7c5e-457c-ae9e-1a2e038a466a","18db88c7-97c9-416e-b1ae-763bf018345e"]},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2022-02-28T14:48:57Z","entityUuid":"c2da0410-ede1-4b0a-a750-09e6e6bd38cf","parentUuid":"1bbafc04-e527-481b-ad1f-521cc48de186","uuid":"fea0e94f-4233-458e-8c1e-45ebe1d1b684"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2022-02-28T14:48:58Z","entityUuid":"28e7c4f7-7ade-42b2-a68e-63ab4f67b960","parentUuid":"eb17ff9a-c57e-4fd4-b3bd-89edb31c6568","uuid":"1d0a36dc-9d1b-4537-9539-55e23f058f48"},{"content":{"advice":{"changed":true,"value":"Traditionally, *consent* has been the basis for processing personal data for research, but under the GDPR there cannot be an imbalance between the processor and the data subject for it to be considered to be freely given. In some countries the use of *consent* as the legal basis for processing by universities for research purposes is therefore not recommended. In those cases, public interest should probably be your legal basis. Note that if your legal basis for processing is consent, [a number of requirements](https://gdpr-info.eu/issues/consent/) exists for the consent to be considered valid under the GDPR. Consents given before the GDPR might not live up to this. "},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Consent given by the research subject"},"metricMeasures":{"changed":false}},"createdAt":"2022-02-28T14:48:59Z","entityUuid":"eb17ff9a-c57e-4fd4-b3bd-89edb31c6568","parentUuid":"c2da0410-ede1-4b0a-a750-09e6e6bd38cf","uuid":"5824713d-6bd5-4ff1-856c-d940b1c7aa57"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Does the consent cover your data reuse?"}},"createdAt":"2022-02-28T14:49:00Z","entityUuid":"28e7c4f7-7ade-42b2-a68e-63ab4f67b960","parentUuid":"eb17ff9a-c57e-4fd4-b3bd-89edb31c6568","uuid":"723e5bd1-5620-4d06-a39a-82b0aede4d46"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":true,"value":"b101f2d0-2476-452d-aa8d-95a41a02b52c"},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2022-02-28T14:49:01Z","entityUuid":"c2da0410-ede1-4b0a-a750-09e6e6bd38cf","parentUuid":"1bbafc04-e527-481b-ad1f-521cc48de186","uuid":"d1999d06-4e18-49b9-9e86-8bbe77dcfbd1"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-02-28T14:49:02Z","entityUuid":"15071f5e-c120-4a10-b0e8-05