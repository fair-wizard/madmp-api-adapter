e data","metricMeasures":[{"measure":0.8,"metricUuid":"0bafe0c2-a8f2-4c74-80c8-dbf3a5b8e9b7","weight":1}]},"createdAt":"2018-10-01T00:12:13Z","entityUuid":"4cc765a2-39b3-4790-bd7d-979361677a20","parentUuid":"099902bd-1637-4e32-a744-b95031030c6c","uuid":"f4a051ab-8860-4f88-b60c-f1cd6b61f63d"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes, we will automatically make test runs on the same data","metricMeasures":[{"measure":1,"metricUuid":"0bafe0c2-a8f2-4c74-80c8-dbf3a5b8e9b7","weight":1}]},"createdAt":"2018-10-01T00:12:14Z","entityUuid":"c9c66274-13b1-4ab8-8245-56ab7415d858","parentUuid":"099902bd-1637-4e32-a744-b95031030c6c","uuid":"49192537-1cf3-499f-ac15-820e4e3f0ae2"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":null,"title":"Are all tools you use under your complete control?"},"createdAt":"2018-10-01T00:12:15Z","entityUuid":"df3aff84-acf9-4614-996b-e69f7ddb96de","parentUuid":"ebc3a870-5f89-43ad-9d90-de5c91528ea2","uuid":"cff3b5b0-5353-4ca7-b922-75c3c32a77d1"},{"content":{"annotations":[],"description":"Control over tools in the workflow engine","eventType":"AddReferenceEvent","referenceType":"CrossReference","targetUuid":"655180dc-1cb9-41f6-8a36-7c6ecf02009a"},"createdAt":"2018-10-01T00:12:16Z","entityUuid":"df070071-38a9-4250-a035-445c12f95af3","parentUuid":"df3aff84-acf9-4614-996b-e69f7ddb96de","uuid":"3a7ab40c-0981-4590-806a-e4b0f28ba17b"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No, we use tools maintained by others","metricMeasures":[]},"createdAt":"2018-10-01T00:12:17Z","entityUuid":"af507b8a-824b-4198-9adf-c54f984f4fb5","parentUuid":"df3aff84-acf9-4614-996b-e69f7ddb96de","uuid":"01bef32e-9806-4125-b2f0-1311eebce786"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c