e},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":true,"value":["b0949d09-d179-4491-9fb4-14b0deb9f862","80a682bd-8a5c-4a52-935d-680509838a4e","46039bea-87e6-4c61-8567-4e819404b4d0"]},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2019-06-10T16:39:09Z","entityUuid":"4e0c1edf-660c-4ebf-81f5-9fa959dead30","parentUuid":"6be88f7c-f868-460f-bba7-91e1c659adfd","uuid":"09a791ab-e327-417a-8cad-e0e0d5b711cd"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"ValueQuestion","requiredPhaseUuid":"adc9133d-afcd-4616-9aea-db5f475898a2","tagUuids":[],"text":null,"title":"Software package:","validations":[],"valueType":"StringQuestionValueType"},"createdAt":"2019-06-10T16:39:10Z","entityUuid":"1024bb15-aaf5-4696-9b49-42898b72a16d","parentUuid":"1ae8d7b0-4bcd-4914-aaea-fa389fc056f4","uuid":"c187d981-d224-424a-8589-fa60b609c662"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":true,"value":["1024bb15-aaf5-4696-9b49-42898b72a16d","36938ca8-e22d-47a6-8859-a52f536101c5","87b45400-169d-424d-8e71-d2034618dab5","3effd452-f0ae-4c25-b971-2b5762889ca4"]},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2019-06-10T16:39:11Z","entityUuid":"1ae8d7b0-4bcd-4914-aaea-fa389fc056f4","parentUuid":"6be88f7c-f868-460f-bba7-91e1c659adfd","uuid":"bd652c59-e061-4833-b82c-e13bacaac2c2"}],"forkOfPackageId":null,"id":"dsw:root:1.3.0","kmId":"root","language":"en","license":"Apache-2.0","mergeCheckpointPackageId":null,"metamodelVersion":20,"name":"Common DSW Knowledge Model","nonEditable":false,"organizationId":"dsw","phase":"DeprecatedKnowledgeModelPackagePhase","previousPackageId":"dsw:root:1.2.0","readme":"# Common DSW Knowledge Model\n\nCommon DSW Knowledge Model deals with questions that a researcher should answer in order to create a Data Stewardship Plan, as well as other related questionnaire data. It originated from mindmap made by Rob Hooft.\n\n## Changelog\n\n### 1.3.0\n\n* Refactoring list questions because of **deprecated item title** fields, i.e., a new question for item title created for each list question.\n\nWhen using this version and higher, the DS Wizard configuration should have `itemTitleEnabled` set to `false`.\n\n### 1.2.0\n\n* Adding file naming SOP description question (9ff389f0-2236-48cf-880c-040ea1bb0d2f) to chapter 2 according to [ds-km@d879be0]https://github.com/ds-wizard/ds-km/commit/d879be0fa9d0808868396c649d03c4d783ac6742)\n\n### 1.1.0\n\n* Adding phases to questions (first draft) according to [ds-km@a6713d1](https://github.com/ds-wizard/ds-km/commit/a6713d1a4b9758bea63b3f7c56af5bd4f500d949) and [ds-km@1123211](https://github.com/ds-wizard/ds-km/commit/1123211bb5af43df8ef435039a2923f48e3e981c)\n\nPrior to this version, all questions were assigned with phase 2 - *Before submitting the DMP*. \n\n### 1.0.3\n\n* Fix: Removing extra question mark for a question (8018e15f-6c7e-433a-8686-ae0d695c7fc7) in chapter 5 according to: [ds-km@1123211](https://github.com/ds-wizard/ds-km/commit/1123211bb5af43df8ef435039a2923f48e3e981c)\n\n### 1.0.2\n\n* Fix: Adding some explanation to the list item questions (f5fef09d-ade5-4019-b089-f05bd89c34bc and b642c31d-a512-4ca7-8743-a2e0254006fa) in chapter 3 according to: [ds-km@96e28f4](https://github.com/ds-wizard/ds-km/commit/96e28f478d5dc6b59d384b5127f012dc2fe5f287)\n\n### 1.0.1\n\n* Fix: Adding forgotten question mark to end of question (39e0cc7c-17fe-4991-88d8-1280c3fe7923) in chapter 1 according to: [ds-km@644a373](https://github.com/ds-wizard/ds-km/commit/644a373685dc4ac15b76e86667a90151ca9c70ca)\n\n### 1.0.0\n\n* Initial version transformed from the previous DS-KM GitHub repository up to [ds-km@8442837](https://github.com/ds-wizard/ds-km/commit/8442837dbe3ff899b09e7d8d3fc1107e935a876f)","version":"1.3.0"},{"createdAt":"2019-06-11T05:39:31.678Z","description":"DSW Knowledge Model originated from mindmap made by Rob Hooft","events":[{"content":{"allowCustomReply":true,"annotations":[],"eventType":"AddIntegrationEvent","integrationType":"ApiIntegration","name":"FAIRsharing","requestAllowEmptySearch":true,"requestBody":"","requestHeaders":[{"key":"Accept","value":"application/json"},{"key":"Api-Key","value":"${apiKey}"}],"requestMethod":"GET","requestUrl":"${apiUrl}/search/?q=${q}&registry=${registry}","responseItemTemplate":"{{item.name}}","responseItemTemplateForSelection":null,"responseListField":"results","testQ":"","testResponse":null,"testVariables":{},"variables":["registry"]},"createdAt":"2019-06-11T05:39:32Z","entityUuid":"f3520558-707e-415a-8878-c7b8d6ccc2fb","parentUuid":"6f6241d9-136c-4770-9d58-8a3f39607052","uuid":"82090e7d-7aa8-4339-a8c5-2330c27ae147"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"integrationUuid":{"changed":true,"value":"f3520558-707e-415a-8878-c7b8d6ccc2fb"},"questionType":"IntegrationQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"variables":{"changed":true,"value":{"registry":"Database"}}},"createdAt":"2019-06-11T05:39:33Z","entityUuid":"93988527-5bff-4125-8834-3750e9a28683","parentUuid":"fcc51962-08df-4f4c-85ad-6bb932107010","uuid":"9ccac2f3-925b-4727-8aee-d6d6aa692f6b"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"integrationUuid":{"changed":true,"value":"f3520558-707e-415a-8878-c7b8d6ccc2fb"},"questionType":"IntegrationQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"variables":{"changed":true,"value":{"registry":"Database"}}},"createdAt":"2019-06-11T05:39:34Z","entityUuid":"44120979-2840-4522-8297-df13f7fd1e3a","parentUuid":"be872000-cb98-442f-999c-ca3ef58dcfe8","uuid":"95f8de07-1b42-46aa-94b0-406210cf9fd2"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"integrationUuid":{"changed":true,"value":"f3520558-707e-415a-8878-c7b8d6ccc2fb"},"questionType":"IntegrationQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"variables":{"changed":true,"value":{"registry":"Standard"}}},"createdAt":"2019-06-11T05:39:35Z","entityUuid":"f00cf643-5368-458a-97d4-b463c2000c66","parentUuid":"b08fe063-33f8-4380-b3a9-ba1e586dedf2","uuid":"86b6b546-0b8f-4149-a9a4-44d6151d2f1e"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"integrationUuid":{"changed":true,"value":"f3520558-707e-415a-8878-c7b8d6ccc2fb"},"questionType":"IntegrationQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"variables":{"changed":true,"value":{"registry":"Standard"}}},"createdAt":"2019-06-11T05:39:36Z","entityUuid":"63ed4349-9743-4fd1-96df-73dbb7e4f05b","parentUuid":"a797cab9-0829-4787-a096-1b5cedc9147f","uuid":"7f4e4e54-b11f-4ed8-afce-51bd81d9d817"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"integrationUuid":{"changed":true,"value":"f3520558-707e-415a-8878-c7b8d6ccc2fb"},"questionType":"IntegrationQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"variables":{"changed":true,"value":{"registry":"Database"}}},"createdAt":"2019-06-11T05:39:37Z","entityUuid":"221c322e-dff5-438f-8a2e-90e762681156","parentUuid":"1dc412c6-da92-4cc2-8639-316c0c6ec5ff","uuid":"cbeb105c-c1ff-4436-90fb-f532c2d5f65d"}],"forkOfPackageId":null,"id":"dsw:root:1.4.0","kmId":"root","language":"en","license":"Apache-2.0","mergeCheckpointPackageId":null,"metamodelVersion":20,"name":"Common DSW Knowledge Model","nonEditable":false,"organizationId":"dsw","phase":"DeprecatedKnowledgeModelPackagePhase","previousPackageId":"dsw:root:1.3.0","readme":"# Common DSW Knowledge Model\n\nCommon DSW Knowledge Model deals with questions that a researcher should answer in order to create a Data Stewardship Plan, as well as other related questionnaire data. It originated from mindmap made by Rob Hooft.\n\n## Changelog\n\n### 1.4.0\n\n* Adding integration for [FAIRsharing.org](https://fairsharing.org)\n* Adding 5 integration questions according to [ds-km@da5a8fc](https://github.com/ds-wizard/ds-km/commit/da5a8fc95d0a67f9369ce0b7727615115fc3656d).\n\nThe FAIRsharing integration requires configuration to contain `apiUrl` and `apiKey` for integration with id `fairsharing`.\n\n### 1.3.0\n\n* Refactoring list questions because of **deprecated item title** fields, i.e., a new question for item title created for each list question.\n\nWhen using this version and higher, the DS Wizard configuration should have `itemTitleEnabled` set to `false`.\n\n### 1.2.0\n\n* Adding file naming SOP description question (9ff389f0-2236-48cf-880c-040ea1bb0d2f) to chapter 2 according to [ds-km@d879be0]https://github.com/ds-wizard/ds-km/commit/d879be0fa9d0808868396c649d03c4d783ac6742)\n\n### 1.1.0\n\n* Adding phases to questions (first draft) according to [ds-km@a6713d1](https://github.com/ds-wizard/ds-km/commit/a6713d1a4b9758bea63b3f7c56af5bd4f500d949) and [ds-km@1123211](https://github.com/ds-wizard/ds-km/commit/1123211bb5af43df8ef435039a2923f48e3e981c)\n\nPrior to this version, all questions were assigned with phase 2 - *Before submitting the DMP*. \n\n### 1.0.3\n\n* Fix: Removing extra question mark for a question (8018e15f-6c7e-433a-8686-ae0d695c7fc7) in chapter 5 according to: [ds-km@1123211](https://github.com/ds-wizard/ds-km/commit/1123211bb5af43df8ef435039a2923f48e3e981c)\n\n### 1.0.2\n\n* Fix: Adding some explanation to the list item questions (f5fef09d-ade5-4019-b089-f05bd89c34bc and b642c31d-a512-4ca7-8743-a2e0254006fa) in chapter 3 according to: [ds-km@96e28f4](https://github.com/ds-wizard/ds-km/commit/96e28f478d5dc6b59d384b5127f012dc2fe5f287)\n\n### 1.0.1\n\n* Fix: Adding forgotten question mark to end of question (39e0cc7c-17fe-4991-88d8-1280c3fe7923) in chapter 1 according to: [ds-km@644a373](https://github.com/ds-wizard/ds-km/commit/644a373685dc4ac15b76e86667a90151ca9c70ca)\n\n### 1.0.0\n\n* Initial version transformed from the previous DS-KM GitHub repository up to [ds-km@8442837](https://github.com/ds-wizard/ds-km/commit/8442837dbe3ff899b09e7d8d3fc1107e935a876f)","version":"1.4.0"},{"createdAt":"2020-01-04T14:33:19.68Z","description":"DSW Knowledge Model originated from mindmap made by Rob Hooft","events":[{"content":{"annotations":{"changed":false},"eventType":"EditChapterEvent","questionUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Re-using data"}},"createdAt":"2020-01-04T14:33:20Z","entityUuid":"82fd0cce-2b41-423f-92ad-636d0872045c","parentUuid":"6f6241d9-136c-4770-9d58-8a3f39607052","uuid":"41b83115-b010-4f41-a078-aca78c5113e1"},{"content":{"annotations":{"changed":false},"eventType":"EditChapterEvent","questionUuids":{"changed":false},"text":{"changed":true,"value":"We will make sure that we know what data comes when, that we have adequate storage space to deal with it, and that all the responsibilities have been taken care of."},"title":{"changed":true,"value":"Creating and collecting data"}},"createdAt":"2020-01-04T14:33:21Z","entityUuid":"b1df3c74-0b1f-4574-81c4-4cc2d780c1af","parentUuid":"6f6241d9-136c-4770-9d58-8a3f39607052","uuid":"db768d30-ade9-4ef1-80c5-f7d86a50c210"},{"content":{"annotations":{"changed":false},"eventType":"EditChapterEvent","questionUuids":{"changed":false},"text":{"changed":true,"value":"In the processing phase, the data will be undergoing the mostly automated steps for processing, before the analysis and interpretation."},"title":{"changed":true,"value":"Processing data"}},"createdAt":"2020-01-04T14:33:22Z","entityUuid":"10a10ffd-bfe1-4c6b-bbb6-3dfb1e63a5d5","parentUuid":"6f6241d9-136c-4770-9d58-8a3f39607052","uuid":"09323f1d-766a-4a6d-a907-189507ebc9c6"},{"content":{"annotations":{"changed":false},"eventType":"EditChapterEvent","questionUuids":{"changed":false},"text":{"changed":true,"value":"The analysis of the data consistst of the last steps of processing (often with manual interventions), visualisation, and data integration. In this chapter many questions about data interoperability will come up."},"title":{"changed":true,"value":"Analysing data"}},"createdAt":"2020-01-04T14:33:23Z","entityUuid":"83438863-0aa0-4458-b14b-2b2c0d4f811d","parentUuid":"6f6241d9-136c-4770-9d58-8a3f39607052","uuid":"fe96682e-4351-4a05-896a-5ea487f488b2"},{"content":{"annotations":{"changed":false},"eventType":"EditChapterEvent","questionUuids":{"changed":false},"text":{"changed":true,"value":"In this chapter, issues regarding data publication and long term archiving are addressed."},"title":{"changed":true,"value":"Preserving data"}},"createdAt":"2020-01-04T14:33:24Z","entityUuid":"d5b27482-b598-4b8c-b534-417d4ad27394","parentUuid":"6f6241d9-136c-4770-9d58-8a3f39607052","uuid":"8b909db8-9467-42a5-a1c6-44b2d96d505e"},{"content":{"annotations":{"changed":false},"eventType":"EditChapterEvent","questionUuids":{"changed":false},"text":{"changed":true,"value":"This chapter deals with the information needed by people who will re-use your data, and with the access conditions they will need to follow."},"title":{"changed":true,"value":"Giving Access to data"}},"createdAt":"2020-01-04T14:33:25Z","entityUuid":"6be88f7c-f868-460f-bba7-91e1c659adfd","parentUuid":"6f6241d9-136c-4770-9d58-8a3f39607052","uuid":"19a1fed3-3a14-4312-ae37-60bd53560b4b"},{"content":{"annotations":[],"eventType":"AddChapterEvent","text":null,"title":"Administrative details"},"createdAt":"2020-01-04T14:33:26Z","entityUuid":"1e85da40-bbfc-4180-903e-6c569ed2da38","parentUuid":"6f6241d9-136c-4770-9d58-8a3f39607052","uuid":"f7af50c6-e514-4bc2-9dbc-bdd20846ce9e"},{"content":{"annotations":{"changed":false},"chapterUuids":{"changed":true,"value":["1e85da40-bbfc-4180-903e-6c569ed2da38","82fd0cce-2b41-423f-92ad-636d0872045c","b1df3c74-0b1f-4574-81c4-4cc2d780c1af","c4eda690-066f-495a-8c29-8e8a258ac487","10a10ffd-bfe1-4c6b-bbb6-3dfb1e63a5d5","83438863-0aa0-4458-b14b-2b2c0d4f811d","d5b27482-b598-4b8c-b534-417d4ad27394","6be88f7c-f868-460f-bba7-91e1c659adfd"]},"eventType":"EditKnowledgeModelEvent","integrationUuids":{"changed":false},"metricUuids":{"changed":false},"phaseUuids":{"changed":false},"resourceCollectionUuids":{"changed":false},"tagUuids":{"changed":false}},"createdAt":"2020-01-04T14:33:27Z","entityUuid":"6f6241d9-136c-4770-9d58-8a3f39607052","parentUuid":"00000000-0000-0000-0000-000000000000","uuid":"d402825b-b145-4ad3-8578-895dfbd312c1"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"ValueQuestion","requiredPhaseUuid":"b101f2d0-2476-452d-aa8d-95a41a02b52c","tagUuids":[],"text":null,"title":"Project name","validations":[],"valueType":"StringQuestionValueType"},"createdAt":"2020-01-04T14:33:28Z","entityUuid":"f0ef08fd-d733-465c-bc66-5de0b826c41b","parentUuid":"1e85da40-bbfc-4180-903e-6c569ed2da38","uuid":"362da03e-dcd1-4b94-99c3-014f6a42e0cf"},{"content":{"eventType":"MoveQuestionEvent","targetUuid":"b1df3c74-0b1f-4574-81c4-4cc2d780c1af"},"createdAt":"2020-01-04T14:33:29Z","entityUuid":"f5fef09d-ade5-4019-b089-f05bd89c34bc","parentUuid":"c4eda690-066f-495a-8c29-8e8a258ac487","uuid":"600ced58-3ce8-4e92-8bf3-b44bb378bc6f"},{"content":{"eventType":"MoveQuestionEvent","target