Type":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":"Some old data may need to be recovered, e.g. from tables in scientific papers or may be punch cards.","title":"Will you be using data that needs to be (re-)made computer readable first?"},"createdAt":"2018-10-01T00:01:27Z","entityUuid":"7e77ee02-ce26-4cd9-b07d-3eea03bc35c9","parentUuid":"2663b978-5125-4224-9930-0a50dbe895c9","uuid":"541ba562-9db1-4f26-a229-936864c3481b"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","referenceType":"ResourcePageReference","resourcePageUuid":null},"createdAt":"2018-10-01T00:01:28Z","entityUuid":"9cb15c77-9a13-4621-b7f9-265bcbe3d3ba","parentUuid":"7e77ee02-ce26-4cd9-b07d-3eea03bc35c9","uuid":"68267c33-4708-4bc9-b952-31069f337cba"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[]},"createdAt":"2018-10-01T00:01:29Z","entityUuid":"d613ee29-a81b-44aa-83b5-2bf21ba43d22","parentUuid":"7e77ee02-ce26-4cd9-b07d-3eea03bc35c9","uuid":"ed656dcf-a4c2-4c85-bce3-472ea98fe39c"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[]},"createdAt":"2018-10-01T00:01:30Z","entityUuid":"4a3e9d91-240b-4eae-bc90-02c12a2a4744","parentUuid":"7e77ee02-ce26-4cd9-b07d-3eea03bc35c9","uuid":"2ebb1d90-8868-4770-b1a6-265f5f7d545b"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":null,"title":"Will you be making this data available in computer readable form to others?"},"createdAt":"2018-10-01T00:01:31Z","entityUuid":"530124a4-c7e9-4821-b26d-32a8ecd0d978","parentUuid":"4a3e9d91-240b-4eae-bc90-02c12a2a4744","uuid":"791df887-1ff8-4c15-837c-f93668aa604d"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[{"measure":0,"metricUuid":"0bafe0c2-a8f2-4c74-80c8-dbf3a5b8e9b7","weig