:null,"title":""},"createdAt":"2022-02-28T14:45:58Z","entityUuid":"3558f2b9-4c66-4751-85bb-e82062ebf0d3","parentUuid":"452b8a0d-41f3-43db-a115-054de185c6fc","uuid":"809260e7-d5b8-4e19-8a20-4ec65d367d3d"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["4fa6f10d-b593-4b00-84cf-00d7f916147f"]},"text":{"changed":false},"title":{"changed":true,"value":"Dataset(s)"},"validations":{"changed":false},"valueType":{"changed":true,"value":"StringQuestionValueType"}},"createdAt":"2022-02-28T14:45:59Z","entityUuid":"3558f2b9-4c66-4751-85bb-e82062ebf0d3","parentUuid":"452b8a0d-41f3-43db-a115-054de185c6fc","uuid":"bb04bc4c-ede1-4d06-b8fa-aa7f7d07a0bc"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-02-28T14:46:00Z","entityUuid":"b4e2ca98-aa19-4f8b-8212-a2849f5a6d42","parentUuid":"3d071155-85d7-4a08-bdaa-5aa64fac0cef","uuid":"2523f372-907b-49ee-89b0-2adae62a5d2d"},{"content":{"advice":{"changed":true,"value":"**Note:** Subjects should be informed about this, and this should preferably be stated in the informed consents and/or ethical approvals."},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"The dataset(s) will be archived in a controlled access repository for re-use."},"metricMeasures":{"changed":false}},"createdAt":"2022-02-28T14:46:01Z","entityUuid":"b4e2ca98-aa19-4f8b-8212-a2849f5a6d42","parentUuid":"3d071155-85d7-4a08-bdaa-5aa64fac0cef","uuid":"b816bebf-fac4-48ec-ae77-adc998713843"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2022-02-28T14:46:02Z","entityUuid":"a550c466-1bf2-4ca5-96f0-b2d6a5dbe862","parentUuid":"b4e2ca98-aa19-4f8b-8212-a2849f5a6d42","uuid":"e375c34c-a027-44dc-9aca-333d76cb79f4"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["4fa6f10d-b593-4b00-84cf-00d7f916147f"]},"text":{"changed":false},"title":{"changed":true,"value":"Dataset(s)"},"validations":{"changed":false},"valueType":{"changed":true,"value":"StringQuestionValueType"}},"createdAt":"2022-02-28T14:46:03Z","entityUuid":"a550c466-1bf2-4ca5-96f0-b2d6a5dbe862","parentUuid":"b4e2ca98-aa19-4f8b-8212-a2849f5a6d42","uuid":"70e29d4d-1919-4690-9e17-1020115f6f5a"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2022-02-28T14:46:04Z","entityUuid":"d26aa144-a58c-476f-9f73-19033f87e845","parentUuid":"7dd7320e-41dd-43b9-b6aa-7622eaa34679","uuid":"652ee63e-a77d-4d2b-8963-7ec213357b97"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["4fa6f10d-b593-4b00-84cf-00d7f916147f"]},"text":{"changed":false},"title":{"changed":true,"value":"In what form will the data sets be stored?"}},"createdAt":"2022-02-28T14:46:05Z","entityUuid":"d26aa144-a58c-476f-9f73-19033f87e845","parentUuid":"7dd7320e-41dd-43b9-b6aa-7622eaa34679","uuid":"29412009-39ad-4e6c-80e8-ee097bf79374"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2022-02-28T14:46:06Z","entityUuid":"7cc7b00c-6f1e-4ad9-9742-f02df552dbee","parentUuid":"d26aa144-a58c-476f-9f73-19033f87e845","uuid":"df690e5a-0384-463b-84c9-ec9d09114d28"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["4fa6f10d-b593-4b00-84cf-00d7f916147f"]},"text":{"changed":true,"value":"Anonymisation refers to the processing of personal data in a manner that makes it impossible to identify individuals from them. For example, the data can be rendered down to a general level (aggregated) or converted into statistics so that individuals can no longer  be identified from them. \n\nPseudonymisation refers to the processing of personal data in such a manner that the personal data can no longer be attributed to a specific person without the use of additional information, i.e. any identifying characteristics are replaced with\na pseudonym."},"title":{"changed":true,"value":"Select form"}},"createdAt":"2022-02-28T14:46:07Z","entityUuid":"7cc7b00c-6f1e-4ad9-9742-f02df552dbee","parentUuid":"d26aa144-a58c-476f-9f73-19033f87e845","uuid":"2c3840fd-e2f5-4c52-b3e7-fd66fe23a8c5"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-02-28T14:46:08Z","entityUuid":"40a6b522-c130-44ec-924b-5316e0826bc2","parentUuid":"7cc7b00c-6f1e-4ad9-9742-f02df552dbee","uuid":"427372b8-4490-4a21-b4be-8d7f46a2edde"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Irrevocably anonymised"},"metricMeasures":{"changed":false}},"createdAt":"2022-02-28T14:46:09Z","entityUuid":"40a6b522-c130-44ec-924b-5316e0826bc2","parentUuid":"7cc7b00c-6f1e-4ad9-9742-f02df552dbee","uuid":"966b3448-69df-4153-9bcf-43a2df6c1d63"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredP