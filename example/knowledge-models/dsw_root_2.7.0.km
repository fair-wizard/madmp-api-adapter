f-c66a0453c42e","tagUuids":[],"text":null,"title":"How will you make sure to know what exactly has been run?"},"createdAt":"2018-10-01T00:12:23Z","entityUuid":"1991077f-04ae-4808-90a5-e4b2f82e30bf","parentUuid":"10a10ffd-bfe1-4c6b-bbb6-3dfb1e63a5d5","uuid":"0a2e47d7-7402-4030-8b3a-68690c73dbc7"},{"content":{"annotations":[],"description":"Keeping provenance metadata","eventType":"AddReferenceEvent","referenceType":"CrossReference","targetUuid":"daa06d1a-6314-4c6d-93a8-69954c7f5c54"},"createdAt":"2018-10-01T00:12:24Z","entityUuid":"0c4383ec-211b-4937-9e63-31eb3a2bea8b","parentUuid":"1991077f-04ae-4808-90a5-e4b2f82e30bf","uuid":"5cd58f7a-77fd-4ac9-8c46-b6aaf0ba76e9"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Explore","metricMeasures":[]},"createdAt":"2018-10-01T00:12:25Z","entityUuid":"12a85bf3-1407-4783-9e73-564d75e7c98a","parentUuid":"1991077f-04ae-4808-90a5-e4b2f82e30bf","uuid":"8dde37a1-1e00-4cc6-a2aa-467d7b87e01e"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":null,"title":"Will you keep results together with all processing scripts or workflows including documentation of the versions of the tools that have been run?"},"createdAt":"2018-10-01T00:12:26Z","entityUuid":"5e111fc1-9d17-4ec8-aafb-1694a538a3aa","parentUuid":"12a85bf3-1407-4783-9e73-564d75e7c98a","uuid":"22f77de8-0b21-44ba-8077-6599bb162c05"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[{"measure":0,"metricUuid":"0bafe0c2-a8f2-4c74-80c8-dbf3a5b8e9b7","weight":1}]},"createdAt":"2018-10-01T00:12:27Z","entityUuid":"f5518b1e-77c8-47f7-98e4-4be5ea58f9ab","parentUuid":"5e111fc1-9d17-4ec8-aafb-1694a538a3aa","uuid":"0a295748-5b13-48e9-8201-27654fef466e"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[{"measure":1,"metricUuid":"0bafe0c2-a8f2-4c74-80c8-dbf3a5b8e9b7","weight":1}]},"createdAt":"2018-10-01T00:12:28Z","entityUuid":"0d9d77b1-bbcd-480e-b165-8bcb29bd4a67","parentUuid":"5e111fc1-9d17-4ec8-aafb-1694a538a3aa","uuid":"3dd842c9-d46c-4a64-bc35-127b3201cfa9"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":"File formats like VCF (for genetics) and TIFF (for images) have possibilities to document metadata in the file header. It is a good idea to use work flow tools that use these fields to document what was done to obtain the data.","title":"Will you make use of the metadata fields in your output data files to register how the data was obtained?"},"createdAt":"2018-10-01T00:12:29Z","entityUuid":"a972fba5-7586-4156-bdf8-8251288dc341","parentUuid":"12a85bf3-1407-4783-9e73-564d75e7c98a","uuid":"2624cf7e-3b01-4f59-87a1-a454e7f97c41"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[{"measure":0,"metricUuid":"0bafe0c2-a8f2-4c74-80c8-dbf3a5b8e9b7","weight":1}]},"createdAt":"2018-10-01T00:12:30Z","entityUuid":"a3031101-4077-4c5b-877f-bff865c1920c","parentUuid":"a972fba5-7586-4156-bdf8-8251288dc341","uuid":"a78e81ca-8603-4f00-9a2e-c7e600726111"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[{"measure":1,"metricUuid":"0bafe0c2-a8f2-4c74-80c8-dbf3a5b8e9b7","weight":1}]},"createdAt":"2018-10-01T00:12:31Z","entityUuid":"2f4e30d6-6a43-4f52-b146-26f1f690549f","parentUuid":"a972fba5-7586-4156-bdf8-8251288dc341","uuid":"5f213afc-0508-49a8-8e74-31f0f1c2eb39"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":"Especially if analysis and processing of data in the project is done on multiple different computers by different people, it is a good idea to have your own repository of tools and their blessed versions.","title":"Will you use a central repository for all tools and their versions as used in your project?"},"createdAt":"2018-10-01T00:12:32Z","entityUuid":"decb7c9c-c6dc-4027-8c0e-18934c852ca6","parentUuid":"12a85bf3-1407-4783-9e73-564d75e7c98a","uuid":"764627ae-f201-412f-ab53-974835e946d4"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","referenceType":"ResourcePageReference","resourcePageUuid":null},"createdAt":"2018-10-01T00:12:33Z","entityUuid":"dc4fef18-bea8-4c7e-b32b-d487473bb9f0","parentUuid":"decb7c9c-c6dc-4027-8c0e-18934c852ca6","uuid":"bac2c1b4-8939-4f02-8ac5-9cdc8b6356ff"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[{"measure":0,"metricUuid":"0bafe0c2-a8f2-4c74-80c8-dbf3a5b8e9b7","weight":1}]},"createdAt":"2018-10-01T00:12:34Z","entityUuid":"45d40564-f470-4e56-9262-cfcb94b1bbef","parentUuid":"decb7c9c-c6dc-4027-8c0e-18934c852ca6","uuid":"edb46fc0-b21f-42ae-9355-2d57860905c9"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[{"measure":1,"metricUuid":"0bafe0c2-a8f2-4c74-80c8-dbf3a5b8e9b7","weight":1}]},"createdAt":"2018-10-01T00:12:35Z","entityUuid":"a7b481ba-13cb-407d-896f-cc662160f4ee","parentUuid":"decb7c9c-c6dc-4027-8c0e-18934c852ca6","uuid":"ffa8eafd-7e3e-4f3c-af69-c133fc0ab50f"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":"Especially if analysis and processing of data in the project is done on multiple different computers by different people, it is a good idea to have your own repository of reference data versions.","title":"Will you use a central repository for reference data used in your project?"},"createdAt":"2018-10-01T00:12:36Z","entityUuid":"4c7cd15f-90f9-4ab3-8082-38da4f642de1","parentUuid":"12a85bf3-1407-4783-9e73-564d75e7c98a","uuid":"a76b39eb-65e1-4b3a-93a4-550475cfbfd6"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","referenceType":"ResourcePageReference","resourcePageUuid":null},"createdAt":"2018-10-01T00:12:37Z","entityUuid":"2efb44c3-7623-464c-807d-809ef666cc53","parentUuid":"4c7cd15f-90f9-4ab3-8082-38da4f642de1","uuid":"e3710a58-015c-40fb-b02c-fea82c3982c9"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[{"measure":0,"metricUuid":"0bafe0c2-a8f2-4c74-80c8-dbf3a5b8e9b7","weight":1}]},"createdAt":"2018-10-01T00:12:38Z","entityUuid":"67ba0ead-d482-48c8-965a-2472a99648f3","parentUuid":"4c7cd15f-90f9-4ab3-8082-38da4f642de1","uuid":"07404e41-d6db-4c4f-99ec-8a0c458a30ff"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[{"measure":1,"metricUuid":"0bafe0c2-a8f2-4c74-80c8-dbf3a5b8e9b7","weight":1}]},"createdAt":"2018-10-01T00:12:39Z","entityUuid":"e8b48f96-d3d5-4e54-a215-4454d08e6b59","parentUuid":"4c7cd15f-90f9-4ab3-8082-38da4f642de1","uuid":"ca1e3a78-f3f1-4fd0-9734-11f7ddcbb04f"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":"It is much easier to guarantee consistency and reproducibility if all data processing is done using automated work flows, especially if the workflow engine automatically keeps adequate provenance data.","title":"Will you make use of standard workflow engines and automatic work flows for all data analysis in the project?"},"createdAt":"2018-10-01T00:12:40Z","entityUuid":"49199b05-73d7-4912-a5ca-bc1e14a09468","parentUuid":"12a85bf3-1407-4783-9e73-564d75e7c98a","uuid":"963b8744-0f37-4c81-af12-94a25b5c9476"},{"content":{"annotations":[],"description":"Provenance as selection criterion for workflow engine","eventType":"AddReferenceEvent","referenceType":"CrossReference","targetUuid":"28b10fd8-28a6-49b8-822d-f3d47780ab20"},"createdAt":"2018-10-01T00:12:41Z","entityUuid":"d522881a-9f3e-45fc-a420-f444e4da3ad0","parentUuid":"49199b05-73d7-4912-a5ca-bc1e14a09468","uuid":"cb6944f3-f8a6-4cea-bbbd-5f84dcdadb3e"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[{"measure":0,"metricUuid":"0bafe0c2-a8f2-4c74-80c8-dbf3a5b8e9b7","weight":1}]},"createdAt":"2018-10-01T00:12:42Z","entityUuid":"a9db9446-5bbc-431e-981d-d2f487ab28ae","parentUuid":"49199b05-73d7-4912-a5ca-bc1e14a09468","uuid":"8306c3be-2e44-49a1-9cf4-6c6c838ce6fb"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[{"measure":1,"metricUuid":"0bafe0c2-a8f2-4c74-80c8-dbf3a5b8e9b7","weight":1}]},"createdAt":"2018-10-01T00:12:43Z","entityUuid":"ea0ab328-184c-40f2-a391-c89617b37fe9","parentUuid":"49199b05-73d7-4912-a5ca-bc1e14a09468","uuid":"a8baa5f1-5d26-487e-849e-cee79e6d46d3"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":"Will you be able to find and reproduce exactly which version was used for any analysis? Not only for the major tools in the workflows, but also for all 'glue' code and small tools you created especially for the project?","title":"Are all software tools in the work flow professionally maintained, with version control?"},"createdAt":"2018-10-01T00:12:44Z","entityUuid":"56bc8ebb-aba5-4745-8034-17ed3fe4fe07","parentUuid":"12a85bf3-1407-4783-9e73-564d75e7c98a","uuid":"84d40a30-dd85-414d-b456-55e607025bd8"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[{"measure":0,"metricUuid":"0bafe0c2-a8f2-4c74-80c8-dbf3a5b8e9b7","weight":1}]},"createdAt":"2018-10-01T00:12:45Z","entityUuid":"76d2327b-8ac0-44eb-9d42-2434182824a0","parentUuid":"56bc8ebb-aba5-4745-8034-17ed3fe4fe07","uuid":"ccce25a5-3de9-4242-9c9f-bfe77791071b"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[{"measure":1,"metricUuid":"0bafe0c2-a8f2-4c74-80c8-dbf3a5b8e9b7","weight":1}]},"createdAt":"2018-10-01T00:12:46Z","entityUuid":"8afcd524-0916-4980-8bee-15b00bf5c335","parentUuid":"56bc8ebb-aba5-4745-8034-17ed3fe4fe07","uuid":"48fe8fab-d6dc-467a-b8ec-9bd8e9f6c46d"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":null,"title":"How will you validate the integrity of the results?"},"createdAt":"2018-10-01T00:12:47Z","entityUuid":"918d5fd1-ea37-468f-8acd-ca3e80203900","parentUuid":"10a10ffd-bfe1-4c6b-bbb6-3dfb1e63a5d5","uuid":"73f7eb4b-7ba3-436c-b63d-327a18aa73a9"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Explore","metricMeasures":[]},"createdAt":"2018-10-01T00:12:48Z","entityUuid":"30d1e85c-0e3e-482f-97f9-22a7658b329e","parentUuid":"918d5fd1-ea37-468f-8acd-ca3e80203900","uuid":"3da0b0dc-1df8-46ef-9398-16111c27aa5a"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":"There are surprisingly many complications that can cause (slight) inconsistencies between results when workflows are run on different compute infrastructures. A good way to make sure this does not bite you is to run a subset of all jobs on all different infrastructure to check the consistency.","title":"Will you run a subset of your jobs several times across the different compute infrastructures you are using?"},"createdAt":"2018-10-01T00:12:49Z","entityUuid":"e8a08f27-9f82-4147-b446-822d34a5d468","parentUuid":"30d1e85c-0e3e-482f-97f9-22a7658b329e","uuid":"94ae4ee2-cbb7-469d-9e8b-c09cdf868bc8"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[{"measure":0,"metricUuid":"0bafe0c2-a8f2-4c74-80c8-dbf3a5b8e9b7","weight":1}]},"createdAt":"2018-10-01T00:12:50Z","entityUuid":"8d038086-a207-46f4-9e7c-180780d9c3a6","parentUuid":"e8a08f27-9f82-4147-b446-822d34a5d468","uuid":"723dd950-20d4-4a80-9d05-2105b5239855"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[{"measure":1,"metricUuid":"0bafe0c2-a8f2-4c74-80c8-dbf3a5b8e9b7","weight":1}]},"createdAt":"2018-10-01T00:12:51Z","entityUuid":"be0761b6-421a-4683-8ff9-de496868feea","parentUuid":"e8a08f27-9f82-4147-b446-822d34a5d468","uuid":"5d7b19e9-32cc-4125-b7e9-0c0657b27c4b"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":"Surrounding all tools in your data processing and analysis workflows with the 'boilerplate' code necessary on the computer system you are using is tedious and error prone. Especially if you are using the same tools in multiple different work flows and/or on multiple different computer architectures. Automated instrumentation, e.g. by using a workflow management system, can prevent many mistakes.","title":"Will you be instrumenting the tools into pipelines and workflows using automated tools?"},"createdAt":"2018-10-01T00:12:52Z","entityUuid":"a3a4ce37-4ced-41df-8ec6-e42d87a6a3f1","parentUuid":"30d1e85c-0e3e-482f-97f9-22a7658b329e","uuid":"ac4c8e66-a70b-4c63-bf2b-a3a259e501ca"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[{"measure":0,"metricUuid":"0bafe0c2-a8f2-4c74-80c8-dbf3a5b8e9b7","weight":1}]},"createdAt":"2018-10-01T00:12:53Z","entityUuid":"9ffbb7f2-5eb8-455a-bd98-6547887e0eb6","parentUuid":"a3a4ce37-4ced-41df-8ec6-e42d87a6a3f1","uuid":"24d697e9-b03b-4db5-8e2c-caacc1ce04ae"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[{"measure":1,"metricUuid":"0bafe0c2-a8f2-4c74-80c8-dbf3a5b8e9b7","weight":1}]},"createdAt":"2018-10-01T00:12:54Z","entityUuid":"4715c145-8e34-45b9-b7c1-77d835d3ade8","parentUuid":"a3a4ce37-4ced-41df-8ec6-e42d87a6a3f1","uuid":"6963e043-c3a4-4af5-ad57-8756e86e69b6"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":"Validation of results without a golden standard is very hard. One way of doing it is to develop two solutions for a problem (two independent workflows or two independently developed tools) to check whether the results are identical or comparable.","title":"Will you use independently developed duplicate tools or workflows for critical steps to reduce or eliminate human errors?"},"createdAt":"2018-10-01T00:12:55Z","entityUuid":"34a3ef8b-4a17-4030-9157-ed1c1bf60b80","parentUuid":"30d1e85c-0e3e-482f-97f9-22a7658b329e","uuid":"a2208fac-d77e-4975-b011-74dde949bd68"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[{"measure":0,"metricUuid":"0bafe0c2-a8f2-4c74-80c8-dbf3a5b8e9b7","weight":0.5}]},"createdAt":"2018-10-01T00:12:56Z","entityUuid":"f14a3135-32d9-4520-bc09-45f50f0c6031","parentUuid":"34a3ef8b-4a17-4030-9157-ed1c1bf60b80","uuid":"10b2ffec-68a6-42ad-85fc-4e9d38324fb8"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[{"measure":1,"metricUuid":"0bafe0c2-a8f2-4c74-80c8-dbf3a5b8e9b7","weight":0.5}]},"createdAt":"2018-10-01T00:12:57Z","entityUuid":"56c899c9-fb21-449c-a905-4b9f4fbf6458","parentUuid":"34a3ef8b-4a17-4030-9157-ed1c1bf60b80","uuid":"bffae96f-7fee-4c6c-b223-2b7815b231d5"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":"Running a small subset of the data repeatedly can be useful to catch unexpected problems that would otherwise be very hard to detect.","title":"Will you run part of the data set repeatedly to catch unexpected changes in results?"},"createdAt":"2018-10-01T00:12:58Z","entityUuid":"faf72b3d-ac29-41d1-97f2-5223b199a086","parentUuid":"30d1e85c-0e3e-482f-97f9-22a7658b329e","uuid":"2e8ad8b0-b302-40ee-8e0b-34023c2928ed"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","referenceType":"ResourcePageReference","resourcePageUuid":null},"createdAt":"2018-10-01T00:12:59Z","entityUuid":"12145f57-2bf5-456b-b35c-66f533b316bc","parentUuid":"faf72b3d-ac29-41d1-97f2-5223b199a086","uuid":"7e3036cb-8b5d-467d-bccd-c0bfdc769830"},{"content":{"annotations":[],"description":"Validation of tools updates","eventType":"AddReferenceEvent","referenceType":"CrossReference","targetUuid":"099902bd-1637-4e32-a744-b95031030c6c"},"createdAt":"2018-10-01T00:13:00Z","entityUuid":"fbe68369-30cb-422b-b5c1-fd871bb16331","parentUuid":"faf72b3d-ac29-41d1-97f2-5223b199a086","uuid":"cd58378b-19fa-4fe1-9d72-0e11a6e5f774"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[{"measure":0,"metricUuid":"0bafe0c2-a8f2-4c74-80c8-dbf3a5b8e9b7","weight":1}]},"createdAt":"2018-10-01T00:13:01Z","entityUuid":"168ba2ce-e5aa-4dc5-a840-845a5c20058f","parentUuid":"faf72b3d-ac29-41d1-97f2-5223b199a086","uuid":"83ed8e1f-81eb-41ab-b705-1bad3f85aa9e"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[{"measure":1,"metricUuid":"0bafe0c2-a8f2-4c74-80c8-dbf3a5b8e9b7","weight":1}]},"createdAt":"2018-10-01T00:13:02Z","entityUuid":"2c9f5097-34a8-4852-8e10-b26bd71ee1ba","parentUuid":"faf72b3d-ac29-41d1-97f2-5223b199a086","uuid":"6c15cdb3-e527-4568-ab1b-cce4b7295c33"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":"What will you do if the compute facility is down?","title":"Do you have a contingency plan?"},"createdAt":"2018-10-01T00:13:03Z","entityUuid":"acc82522-327a-4c76-8c24-f8034f7dc1d4","parentUuid":"10a10ffd-bfe1-4c6b-bbb6-3dfb1e63a5d5","uuid":"9754fad5-b50e-4563-a6bb-c6fbb1397a22"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"We will wait until the problem is fixed","metricMeasures":[]},"createdAt":"2018-10-01T00:13:04Z","entityUuid":"05a642e0-4d1c-4c1e-ac9e-06463c2e97f4","parentUuid":"acc82522-327a-4c76-8c24-f8034f7dc1d4","uuid":"7d8e41e9-6559-412f-871b-7841b353b04d"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"We have an alternative","metricMeasures":[]},"createdAt":"2018-10-01T00:13:05Z","entityUuid":"b430a132-0c46-4e16-9508-190801976633","parentUuid":"acc82522-327a-4c76-8c24-f8034f7dc1d4","uuid":"00c9af4a-03d5-400e-a99b-b96648cd0ddf"},{"content":{"annotations":[],"eventType":"AddChapterEvent","text":"","title":"Data integration"},"createdAt":"2018-10-01T00:13:06Z","entityUuid":"83438863-0aa0-4458-b14b-2b2c0d4f811d","parentUuid":"6f6241d9-136c-4770-9d58-8a3f39607052","uuid":"4db18977-5cc7-44cc-8e56-e62b6b9f6897"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":null,"title":"How will you be doing the integration of different data sources?"},"createdAt":"2018-10-01T00:13:07Z","entityUuid":"109ed7ea-ef1d-4719-b2b4-eb4f7202c65c","parentUuid":"83438863-0aa0-4458-b14b-2b2c0d4f811d","uuid":"ffed5d68-81cc-4f0a-970e-9b8cfca1603d"},{"content":{"annotations":[],"description":"Data warehousing tools","eventType":"AddReferenceEvent","referenceType":"CrossReference","targetUuid":"ab4b3f39-dfab-45a5-9489-2d46ceacbb73"},"createdAt":"2018-10-01T00:13:08Z","entityUuid":"b289c48c-b586-419f-8099-db94ce323398","parentUuid":"109ed7ea-ef1d-4719-b2b4-eb4f7202c65c","uuid":"2b2d6dc0-c9c0-457c-931b-7dc5f174e724"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Explore","metricMeasures":[]},"createdAt":"2018-10-01T00:13:09Z","entityUuid":"238ace4b-22bb-4a9d-a312-e30d82d4382d","parentUuid":"109ed7ea-ef1d-4719-b2b4-eb4f7202c65c","uuid":"c9c5b9fe-6500-4299-9722-8156443fc1bd"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"ListQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":"Answer some questions for each","title":"List the data formats you will be using for data integration"},"createdAt":"2018-10-01T00:13:10Z","entityUuid":"a797cab9-0829-4787-a096-1b5cedc9147f","parentUuid":"238ace4b-22bb-4a9d-a312-e30d82d4382d","uuid":"2f5dfe88-22bb-4097-b6f3-c07f732b04db"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":null,"title":"How is the data structured?"},"createdAt":"2018-10-01T00:13:11Z","entityUuid":"87fe7235-0a0f-4788-8f44-04523461655f","parentUuid":"a797cab9-0829-4787-a096-1b5cedc9147f","uuid":"9f842b10-f62d-4a8f-abe3-40cff4fa7ce5"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"(meta)data fields in a domain specific file","metricMeasures":[]},"createdAt":"2018-10-01T00:13:12Z","entityUuid":"b308b8bb-83ed-4599-ae28-39c5c1218cbf","parentUuid":"87fe7235-0a0f-4788-8f44-04523461655f","uuid":"e8ba7316-f82c-4be8-b930-4a2dd5fdaf81"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":null,"title":"Can all of the data you want to couple be captured in that format?"},"createdAt":"2018-10-01T00:13:13Z","entityUuid":"37531bec-1488-4204-807d-762794b538e9","parentUuid":"b308b8bb-83ed-4599-ae28-39c5c1218cbf","uuid":"fa65591f-6f35-4fc2-a376-c65a3ad09b80"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[]},"createdAt":"2018-10-01T00:13:14Z","entityUuid":"5313e765-56a9-4c22-8ecf-b55253f17366","parentUuid":"37531bec-1488-4204-807d-762794b538e9","uuid":"da839353-4434-44e8-8581-3427e58abde1"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[]},"createdAt":"2018-10-01T00:13:15Z","entityUuid":"f2c24899-477f-492f-a979-c7586b9593b0","parentUuid":"37531bec-1488-4204-807d-762794b538e9","uuid":"7c340f32-ab0c-4870-ae84-4cc8b10585b8"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":null,"title":"Will you be doing it that way?"},"createdAt":"2018-10-01T00:13:16Z","entityUuid":"45efdccf-761e-4414-b6a8-1d28ddaeafec","parentUuid":"f2c24899-477f-492f-a979-c7586b9593b0","uuid":"720996f1-4b8f-4d54-9b67-5f61c568fcfe"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[]},"createdAt":"2018-10-01T00:13:17Z","entityUuid":"2d37695e-a212-4a92-9b19-70693cbfd4d6","parentUuid":"45efdccf-761e-4414-b6a8-1d28ddaeafec","uuid":"5ed9e645-67d9-43f8-8e60-09662fa5efbd"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[]},"createdAt":"2018-10-01T00:13:18Z","entityUuid":"9dd082ed-e29f-43c6-bb8c-d29daebfa629","parentUuid":"45efdccf-761e-4414-b6a8-1d28ddaeafec","uuid":"496fba34-4e0b-4fde-a42a-9a4028d5b01b"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":null,"title":"Does the domain specific format come with its own suite of integration tools that you will use??"},"createdAt":"2018-10-01T00:13:19Z","entityUuid":"8018e15f-6c7e-433a-8686-ae0d695c7fc7","parentUuid":"b308b8bb-83ed-4599-ae28-39c5c1218cbf","uuid":"cf08ef70-b955-42ee-86e7-970c212a73d6"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[]},"createdAt":"2018-10-01T00:13:20Z","entityUuid":"fa12de49-cf29-4bcd-acf9-85eb39957d95","parentUuid":"8018e15f-6c7e-433a-8686-ae0d695c7fc7","uuid":"91a26d1f-425d-4ea7-92b0-eb78177943d6"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[]},"createdAt":"2018-10-01T00:13:21Z","entityUuid":"231524b8-9133-4319-b633-f0c96871211d","parentUuid":"8018e15f-6c7e-433a-8686-ae0d695c7fc7","uuid":"f1684c78-3969-4e18-b0d3-44b1cab5f7a9"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"A table or set of tables (consisting of 'data records')","metricMeasures":[]},"createdAt":"2018-10-01T00:13:22Z","entityUuid":"e8334918-27f8-4e1c-aa9f-5e8191b7fabb","parentUuid":"87fe7235-0a0f-4788-8f44-04523461655f","uuid":"2216b5a7-3b65-40e6-8730-58528f72afa1"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":"In a table, the data items are arranged in columns. Is there a header for each of these describing what is in there?","title":"Does each column have a header?"},"createdAt":"2018-10-01T00:13:23Z","entityUuid":"6bfde30e-90e7-4422-b984-d571196194e0","parentUuid":"e8334918-27f8-4e1c-aa9f-5e8191b7fabb","uuid":"e9006262-06e6-44ac-8793-bac857f2f424"},{"content":{"advice":"You will need to have a header in order to make the data interoperable and reusable","annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[{"measure":0,"metricUuid":"a42bded3-a085-45f8-b384-32b4a77c8385","weight":1}]},"createdAt":"2018-10-01T00:13:24Z","entityUuid":"595acdbc-f0d7-4550-9c56-9177f3c5695b","parentUuid":"6bfde30e-90e7-4422-b984-d571196194e0","uuid":"57674512-308a-433a-ab2b-9c42febf418a"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[{"measure":1,"metricUuid":"a42bded3-a085-45f8-b384-32b4a77c8385","weight":1}]},"createdAt":"2018-10-01T00:13:25Z","entityUuid":"53d43c6a-d12e-4bfd-b70d-233bf62c7f5b","parentUuid":"6bfde30e-90e7-4422-b984-d571196194e0","uuid":"e02480f1-a5b0-4b07-9614-a452dd213c0b"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":"A human being quickly 'understands' data items and their relations. For good data reusability, it is necessary that computers can understand your data too.","title":"Are all column headers unambiguous?"},"createdAt":"2018-10-01T00:13:26Z","entityUuid":"cacee0fd-7de5-4e07-aa94-1661cb853558","parentUuid":"53d43c6a-d12e-4bfd-b70d-233bf62c7f5b","uuid":"5f5d7e02-1c73-4d6e-9cb2-6204b0c46ffc"},{"content":{"advice":"Check whether you can find an ontology for each of your data items","annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[{"measure":0,"metricUuid":"a42bded3-a085-45f8-b384-32b4a77c8385","weight":1}]},"createdAt":"2018-10-01T00:13:27Z","entityUuid":"1485ec8b-094c-49bb-8de1-ce214c83790f","parentUuid":"cacee0fd-7de5-4e07-aa94-1661cb853558","uuid":"eb27e01c-7433-42b0-93cc-5e75fe004a1a"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[{"measure":1,"metricUuid":"a42bded3-a085-45f8-b384-32b4a77c8385","weight":1}]},"createdAt":"2018-10-01T00:13:28Z","entityUuid":"02b2c93a-5956-4c75-8797-d3803d4344e8","parentUuid":"cacee0fd-7de5-4e07-aa94-1661cb853558","uuid":"3debcca6-ef20-435a-85a7-8fc0833ccc3e"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":"A label like 'temperature' only makes sense to a computer if it is also clear what the units are and what temperature has been measured. In many cases, it is also important how it was measured.","title":"Do all columns/headers have a data type?"},"createdAt":"2018-10-01T00:13:29Z","entityUuid":"6ab36a2a-23ca-484d-b3d7-0c1a4eea821a","parentUuid":"53d43c6a-d12e-4bfd-b70d-233bf62c7f5b","uuid":"8dd3acdf-c9f3-43cc-9aa4-688e40b9bad2"},{"content":{"advice":"Check whether you can find a data type (potentially in a data type registry) for each of your data items","annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[{"measure":0,"metricUuid":"a42bded3-a085-45f8-b384-32b4a77c8385","weight":1}]},"createdAt":"2018-10-01T00:13:30Z","entityUuid":"7108a5e7-f804-4410-b40d-cabed6b3da15","parentUuid":"6ab36a2a-23ca-484d-b3d7-0c1a4eea821a","uuid":"b40c2329-72f5-4bf4-a42f-78bd1ae1e6b8"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[{"measure":1,"metricUuid":"a42bded3-a085-45f8-b384-32b4a77c8385","weight":1}]},"createdAt":"2018-10-01T00:13:31Z","entityUuid":"d4a545a3-0981-461b-9762-7073e5750ea9","parentUuid":"6ab36a2a-23ca-484d-b3d7-0c1a4eea821a","uuid":"afa9323c-9e06-498f-97c2-9ad4cc855e1f"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":"If there are reasonable limitations to the values in a column, or even a limited set of allowed values, it is very good for data vvalidation and reusability if these limitations are explicit, and e.g. software used for data entry and editing will not allow anything else.","title":"Are the limitations to allowed data values in each column explicit?"},"createdAt":"2018-10-01T00:13:32Z","entityUuid":"c47d330a-2eb4-472e-be48-d06b3ec9b8e8","parentUuid":"53d43c6a-d12e-4bfd-b70d-233bf62c7f5b","uuid":"5c53e316-adef-4b67-9945-302fdd87bb2e"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"Rightfield: Template fields in Microsoft Excel","referenceType":"URLReference","url":"http://rightfield.org.uk/"},"createdAt":"2018-10-01T00:13:33Z","entityUuid":"03640bc5-605b-4a3a-a5de-2dae66542b66","parentUuid":"c47d330a-2eb4-472e-be48-d06b3ec9b8e8","uuid":"7ba3aaff-a50b-49fa-8b2c-fdc612425c54"},{"content":{"advice":"Check whether there is a way to explicitly limit data values.","annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[{"measure":0,"metricUuid":"a42bded3-a085-45f8-b384-32b4a77c8385","weight":0.5}]},"createdAt":"2018-10-01T00:13:34Z","entityUuid":"6bda04d8-1f32-4ace-ab8b-1121ea7c526e","parentUuid":"c47d330a-2eb4-472e-be48-d06b3ec9b8e8","uuid":"f47d8cd4-8a22-4c92-8daf-59d875a662cc"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[{"measure":1,"metricUuid":"a42bded3-a085-45f8-b384-32b4a77c8385","weight":0.5}]},"createdAt":"2018-10-01T00:13:35Z","entityUuid":"2376500a-34cb-4535-868e-b7b126321f34","parentUuid":"c47d330a-2eb4-472e-be48-d06b3ec9b8e8","uuid":"fb0a95e0-9645-46b0-8282-da0e3944e835"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":null,"title":"Is it clear what a row in the table represents?"},"createdAt":"2018-10-01T00:13:36Z","entityUuid":"0259866a-50b2-4f77-858f-982c9e16091d","parentUuid":"e8334918-27f8-4e1c-aa9f-5e8191b7fabb","uuid":"6c8a3178-3828-4a49-b58c-b6f444b99827"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[{"measure":0,"metricUuid":"a42bded3-a085-45f8-b384-32b4a77c8385","weight":1}]},"createdAt":"2018-10-01T00:13:37Z","entityUuid":"b75a4215-357e-48d2-bb66-436da069bb00","parentUuid":"0259866a-50b2-4f77-858f-982c9e16091d","uuid":"2c740d9e-3ff4-41cd-9be3-3c6eea827f35"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[{"measure":1,"metricUuid":"a42bded3-a085-45f8-b384-32b4a77c8385","weight":1}]},"createdAt":"2018-10-01T00:13:38Z","entityUuid":"7341ed8c-c4d6-4562-808f-068bc47ec418","parentUuid":"0259866a-50b2-4f77-858f-982c9e16091d","uuid":"f92f5088-4687-4811-ba37-2b0b45ce2b39"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":null,"title":"Does each row have an identifier?"},"createdAt":"2018-10-01T00:13:39Z","entityUuid":"ccaaf562-ebed-4d94-b168-b8398ed25546","parentUuid":"e8334918-27f8-4e1c-aa9f-5e8191b7fabb","uuid":"5ba15430-aa47-42f3-baca-2530560cc942"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[{"measure":0,"metricUuid":"a42bded3-a085-45f8-b384-32b4a77c8385","weight":1}]},"createdAt":"2018-10-01T00:13:40Z","entityUuid":"435f76fe-feff-436f-b987-61d65a73f22b","parentUuid":"ccaaf562-ebed-4d94-b168-b8398ed25546","uuid":"dd695dc1-5c1b-4221-846d-6377c9633868"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[{"measure":1,"metricUuid":"a42bded3-a085-45f8-b384-32b4a77c8385","weight":1}]},"createdAt":"2018-10-01T00:13:41Z","entityUuid":"b904da82-6aae-4f2e-8b5d-5359cf48939e","parentUuid":"ccaaf562-ebed-4d94-b168-b8398ed25546","uuid":"c49cf50e-a058-4e64-960f-9e95df6bc110"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":"Sometimes, and empty field or a zero is indicating a missing value. But is that really unique? Could there be valid empty or zero fields? Has the convention for missing values been made explicit somewhere?","title":"Is there a distinguishing way a missing value in the table can be recognized?"},"createdAt":"2018-10-01T00:13:42Z","entityUuid":"f90914d8-2731-4cd1-bbf8-2710a5e08c43","parentUuid":"e8334918-27f8-4e1c-aa9f-5e8191b7fabb","uuid":"66a5abe5-8afb-455a-a5ca-f100e77d42c3"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[{"measure":0,"metricUuid":"a42bded3-a085-45f8-b384-32b4a77c8385","weight":1}]},"createdAt":"2018-10-01T00:13:43Z","entityUuid":"3cb15eb1-dfdc-4a1d-b208-42fe7264d5bd","parentUuid":"f90914d8-2731-4cd1-bbf8-2710a5e08c43","uuid":"9ccaa3af-1952-4b1c-8e05-d287d05f63aa"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[{"measure":1,"metricUuid":"a42bded3-a085-45f8-b384-32b4a77c8385","weight":1}]},"createdAt":"2018-10-01T00:13:44Z","entityUuid":"6daf9964-6a2a-46aa-8a87-c918391f8625","parentUuid":"f90914d8-2731-4cd1-bbf8-2710a5e08c43","uuid":"32033cb1-91bd-4c71-8bae-dea2e0d61237"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":"It may appear that in a table with 'patients' as rows, a column labeled 'disease' coupled to an ontology has a clear meaning. But that is not always explicit enough! A 'disease' could e.g. be the disease that the patient is suffering from, but it could also be an earlier diagnose, a suspected diagnose, or the disease a family member recently died of.","title":"Is the relation between each of the columns and the record identifier clear?"},"createdAt":"2018-10-01T00:13:45Z","entityUuid":"0451d421-4c97-452e-b399-4fe278b97147","parentUuid":"e8334918-27f8-4e1c-aa9f-5e8191b7fabb","uuid":"e8e06ce7-cae4-438a-8ccd-03e49f6b38c3"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[{"measure":0,"metricUuid":"a42bded3-a085-45f8-b384-32b4a77c8385","weight":1}]},"createdAt":"2018-10-01T00:13:46Z","entityUuid":"3ab6d840-fd16-4ff4-bd2b-77139384b54e","parentUuid":"0451d421-4c97-452e-b399-4fe278b97147","uuid":"d14dc4c8-62c5-4b1e-8a14-9bdc55c892d3"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[{"measure":1,"metricUuid":"a42bded3-a085-45f8-b384-32b4a77c8385","weight":1}]},"createdAt":"2018-10-01T00:13:47Z","entityUuid":"a2aa695e-4ea9-4dc6-81f3-cb8c9605bf98","parentUuid":"0451d421-4c97-452e-b399-4fe278b97147","uuid":"ddc51c76-801f-475b-82e1-bd570d4c944a"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":"For a good understanding of tabular data, you need to make the relationship between each pair of columns explicit. E.g. if one column is 'disease' and another is 'treatment', you want to make sure that this is the chosen treatment that this person is undergoing for the given disease.","title":"Are all the relations between the column headers explicit?"},"createdAt":"2018-10-01T00:13:48Z","entityUuid":"bdaba73c-02e0-4ff1-acb3-a68df891c36a","parentUuid":"e8334918-27f8-4e1c-aa9f-5e8191b7fabb","uuid":"966c448d-36c3-428c-8214-4b79dc3b9b46"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[{"measure":0,"metricUuid":"a42bded3-a085-45f8-b384-32b4a77c8385","weight":1}]},"createdAt":"2018-10-01T00:13:49Z","entityUuid":"b7118fba-770a-42cb-abe1-d243d0b624b4","parentUuid":"bdaba73c-02e0-4ff1-acb3-a68df891c36a","uuid":"5b304927-56cc-4e68-9e91-c91a15f6c564"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[{"measure":1,"metricUuid":"a42bded3-a085-45f8-b384-32b4a77c8385","weight":1}]},"createdAt":"2018-10-01T00:13:50Z","entityUuid":"7dcc6fb0-e591-4f87-87fa-166ae839193a","parentUuid":"bdaba73c-02e0-4ff1-acb3-a68df891c36a","uuid":"4285dddf-29df-4629-a90f-d90b9bfc84b2"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Complex data, like a graph","metricMeasures":[]},"createdAt":"2018-10-01T00:13:51Z","entityUuid":"d7911ab4-d3cc-4dc2-95cc-4aba7b0d010a","parentUuid":"87fe7235-0a0f-4788-8f44-04523461655f","uuid":"407ac044-dfe5-4c1b-864a-6cbca980ee2b"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":"RDF is the graph representat