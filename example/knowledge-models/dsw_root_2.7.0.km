a7871719f2dc"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2022-02-28T14:44:30Z","entityUuid":"eccb8305-b78e-4e60-a4ee-094c70003b7a","parentUuid":"7dd7320e-41dd-43b9-b6aa-7622eaa34679","uuid":"e9277e1a-d465-4eec-b02e-97f7ea1905fb"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["4fa6f10d-b593-4b00-84cf-00d7f916147f"]},"text":{"changed":true,"value":"[Article 4](https://gdpr-info.eu/art-4-gdpr/) (7): *“**‘controller’** means the natural or legal person, public authority, agency or other body which, alone or jointly with others, **determines the purposes** and means of the processing of personal data; […].”* The Controller is typically the university employer of the PI, and the PI should act as a representative of her university employer and is responsible for ensuring that personal data is handled correctly in her projects. For cross-border collaborative projects the controllers of different datasets should be identified. Also, if joint controllership is considered, make sure that all parties understand their obligations, and it is probably good to define the terms for this in an agreement between the parties."},"title":{"changed":true,"value":"Who are the data controllers of the personal data processed in the project?"}},"createdAt":"2022-02-28T14:44:31Z","entityUuid":"eccb8305-b78e-4e60-a4ee-094c70003b7a","parentUuid":"7dd7320e-41dd-43b9-b6aa-7622eaa34679","uuid":"603ac3e1-8e82-40c6-9337-30365aaa415f"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2022-02-28T14:44:32Z","entityUuid":"e7575446-405c-452b-8eb2-772fee8b50a8","parentUuid":"eccb8305-b78e-4e60-a4ee-094c70003b7a","uuid":"4a8c423e-4ce3-40ea-86aa-3faafd6003d8"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["4fa6f10d-b593-4b00-84cf-00d7f916147f"]},"text":{"changed":false},"title":{"changed":true,"value":"Dataset(s)"},"validations":{"changed":false},"valueType":{"changed":true,"value":"StringQuestionValueType"}},"createdAt":"2022-02-28T14:44:33Z","entityUuid":"e7575446-405c-452b-8eb2-772fee8b50a8","parentUuid":"eccb8305-b78e-4e60-a4ee-094c70003b7a","uuid":"471edb8a-4b99-409c-a250-5bd3b4d4a8a2"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2022-02-28T14:44:34Z","entityUuid":"0f1c1125-b87f-4d88-a8b0-865f2161f604","parentUuid":"eccb8305-b78e-4e60-a4ee-094c70003b7a","uuid":"a13b58c8-e878-4a0e-8208-b38cc084cdbf"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Controller"}},"createdAt":"2022-02-28T14:44:35Z","entityUuid":"0f1c1125-b87f-4d88-a8b0-865f2161f604","parentUuid":"eccb8305-b78e-4e60-a4ee-094c70003b7a","uuid":"3e7dc0a5-477e-498e-b772-feb7f3b9a922"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["4fa6f10d-b593-4b00-84cf-00d7f916147f"]},"text":{"changed":false},"title":{"changed":false},"va