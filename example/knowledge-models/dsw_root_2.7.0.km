":"https://rdmkit.elixir-europe.org/data_transfer.html"},"createdAt":"2021-11-30T16:33:03Z","entityUuid":"5b5a7569-939f-4304-9d79-f71e383d7ad2","parentUuid":"2e8d6e55-36ea-46eb-a921-65e550bce5dc","uuid":"54268139-7bd0-4881-a1cb-259f698534a1"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"RDMkit on Data Quality","referenceType":"URLReference","url":"https://rdmkit.elixir-europe.org/data_quality.html"},"createdAt":"2021-11-30T16:33:04Z","entityUuid":"5414f646-58a7-403d-b269-09526c8a19fa","parentUuid":"ba38b16d-2154-4372-b445-7854a6e90443","uuid":"6870c89b-a8eb-439e-a9ca-72f5e685cb7c"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":"Will you make explicit reference to physical samples from your digital data?"},"createdAt":"2021-11-30T16:33:05Z","entityUuid":"9e238002-da35-4f9b-a9b7-8fe3613a3c03","parentUuid":"05873934-f03d-4d90-8bfd-291350c14673","uuid":"07ca1488-e4bb-44f3-8aff-5de291a006b6"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[]},"createdAt":"2021-11-30T16:33:06Z","entityUuid":"2fb2cb0a-9d9c-414b-bff0-e89ac51c3547","parentUuid":"9e238002-da35-4f9b-a9b7-8fe3613a3c03","uuid":"d1a0a1b9-c4fa-4361-b46f-d2103f6b40e0"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[]},"createdAt":"2021-11-30T16:33:07Z","entityUuid":"20249329-2492-420e-8c3e-16d7538f8baa","parentUuid":"9e238002-da35-4f9b-a9b7-8fe3613a3c03","uuid":"d23fbd53-44a8-43f8-b7bf-58ff91f3901f"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":false},"metricMeasures":{"changed":true,"value":[{"measure":1,"metricUuid":"0bafe0c2-a8f2-4c74-80c8-dbf3a5b8e9b7","weight":1}]}},"createdAt":"2021-11-30T16:33:08Z","entityUuid":"20249329-2492-420e-8c3e-16d7538f8baa","parentUuid":"9e238002-da35-4f9b-a9b7-8fe3613a3c03","uuid":"0c836d93-2977-44d0-9ec7-eb15aaf346cb"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":false},"metricMeasures":{"changed":true,"value":[{"measure":0,"metricUuid":"0bafe0c2-a8f2-4c74-80c8-dbf3a5b8e9b7","weight":1}]}},"createdAt":"2021-11-30T16:33:09Z","entityUuid":"2fb2cb0a-9d9c-414b-bff0-e89ac51c3547","parentUuid":"9e238002-da35-4f9b-a9b7-8fe3613a3c03","uuid":"1c75c189-8fd5-4062-97fb-922f49bd0b39"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Will you make explicit cross-reference between physical samples and your digital data?"}},"createdAt":"2021-11-30T16:33:10Z","entityUuid":"9e238002-da35-4f9b-a9b7-8fe3613a3c03","parentUuid":"05873934-f03d-4d90-8bfd-291350c14673","uuid":"8c42b2e6-c6ec-4073-bbaf-27f744369851"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Is the identifier of your physical sample present in the metadata for the digital data that associates to it? Will you be able to locate the physical sample if you have the digital data? And how about the reverse?\n"},"title":{"changed":false}},"createdAt":"2021-11-30T16:33:11Z","entityUuid":"9e238002-da35-4f9b-a9b7-8fe3613a3c03","parentUuid":"05873934-f03d-4d90-8bfd-291350c14673","uuid":"36f415f0-6b11-489e-a696-4882bdff0ca0"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"In the design of your experiment, there are many considerations and techniques that can be used to ensure and monitor data quality."},"title":{"changed":true,"value":"What techniques are you using to ensure data quality and integrity?"}},"createdAt":"2021-11-30T16:33:12Z","entityUuid":"59cd7bb6-8b24-4a4b-9baa-e7147807c58d","parentUuid":"b1df3c74-0b1f-4574-81c4-4cc2d780c1af","uuid":"65e39dfb-c6b4-4540-83ca-386e78ed3f98"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"RDMkit on Data Quality","referenceType":"URLReference","url":"https://rdmkit.elixir-europe.org/data_quality.html"},"createdAt":"2021-11-30T16:33:13Z","entityUuid":"17e1ed37-09d5-4b8b-9733-31ce9e3e65fb","parentUuid":"59cd7bb6-8b24-4a4b-9baa-e7147807c58d","uuid":"4e22f65e-3c93-4cd1-9648-fd04976f486c"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Are you running repeat samples or are you repeating measurements in order to monitor consistency of the results?"}},"createdAt":"2021-11-30T16:33:14Z","entityUuid":"d5ab8298-9382-455c-8241-f64d3cc54ffe","parentUuid":"9a8dbe23-8fb2-4501-adde-3b6261dc1653","uuid":"8f940729-7162-4bbb-ac58-96ad2ccd7198"},{"content":{"eventType":"DeleteQuestionEvent"},"createdAt":"2021-11-30T16:33:15Z","entityUuid":"9a4050de-5264-4de6-933c-3cfff3684119","parentUuid":"f55f2b65-40ea-428c-99e3-f78b9e8032a0","uuid":"feb25fc7-0217-42b4-88a5-8f61b69c3c2c"},{"content":{"eventType":"DeleteQuestionEvent"},"createdAt":"2021-11-30T16:33:16Z","entityUuid":"aec4bc32-9a52-4903-a17d-cb8d69bb8417","parentUuid":"f55f2b65-40ea-428c-99e3-f78b9e8032a0","uuid":"21f18a7a-176b-4b5a-a20c-2fbfb05179c5"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":"Are you measuring samples for which the outcome is known in order to monitor consistency?"},"createdAt":"2021-11-30T16:33:17Z","entityUuid":"1b919e1e-a4fe-4be6-a976-862b82aab9b0","parentUuid":"9a8dbe23-8fb2-4501-adde-3b6261dc1653","uuid":"aade4db5-670b-470b-8f67-637738975c43"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[]},"createdAt":"2021-11-30T16:33:18Z","entityUuid":"6dbf4e18-d104-4ea2-96f0-fa6e0f158682","parentUuid":"1b919e1e-a4fe-4be6-a976-862b82aab9b0","uuid":"46c80b47-e28b-4003-8f2e-8c3e7bd735af"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[]},"createdAt":"2021-11-30T16:33:19Z","entityUuid":"4f39e294-eed3-45b7-9d77-406268eda5a3","parentUuid":"1b919e1e-a4fe-4be6-a976-862b82aab9b0","uuid":"98f9b1ac-76ce-4f11-92a4-9a0b88af1fcc"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":true,"value":"1796fa3c-9f53-475f-89ff-c66a0453c42e"},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2021-11-30T16:33:20Z","entityUuid":"1b919e1e-a4fe-4be6-a976-862b82aab9b0","parentUuid":"9a8dbe23-8fb2-4501-adde-3b6261dc1653","uuid":"ec4b04d9-60b7-42dc-ae13-4c4582d7fe8b"},{"content":{"eventType":"DeleteQuestionEvent"},"createdAt":"2021-11-30T16:33:21Z","entityUuid":"691f896d-c28f-4da8-b648-9dab7066d454","parentUuid":"f55f2b65-40ea-428c-99e3-f78b9e8032a0","uuid":"55ab4444-1920-4e73-a613-b9d5854b5521"},{"content":{"eventType":"DeleteAnswerEvent"},"createdAt":"2021-11-30T16:33:22Z","entityUuid":"f55f2b65-40ea-428c-99e3-f78b9e8032a0","parentUuid":"59cd7bb6-8b24-4a4b-9baa-e7147807c58d","uuid":"7d7bc92e-e922-4b07-a8fb-9f4f87ec89d8"},{"content":{"eventType":"DeleteQuestionEvent"},"createdAt":"2021-11-30T16:33:23Z","entityUuid":"59cd7bb6-8b24-4a4b-9baa-e7147807c58d","parentUuid":"b1df3c74-0b1f-4574-81c4-4cc2d780c1af","uuid":"239390c6-bb16-4067-8825-00c44a6302c5"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Did you consider how to monitor data integrity once it has been collected?"}},"createdAt":"2021-11-30T16:33:24Z","entityUuid":"02b3fed1-0b50-4a80-b8b6-a225a1107022","parentUuid":"b1df3c74-0b1f-4574-81c4-4cc2d780c1af","uuid":"099902bf-efa9-4404-a280-1f48529119ac"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"RDMkit on Data Quality","referenceType":"URLReference","url":"https://rdmkit.elixir-europe.org/data_quality.html"},"createdAt":"2021-11-30T16:33:25Z","entityUuid":"148f612f-722b-420f-b1ca-e9ac6a6be8cb","parentUuid":"02b3fed1-0b50-4a80-b8b6-a225a1107022","uuid":"e3d3e489-ae04-4917-972e-c95449eeee0d"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"RDMkit on Reusing Data"},"referenceType":"URLReference","url":{"changed":false}},"createdAt":"2021-11-30T16:33:26Z","entityUuid":"7e8d2692-7da6-4f29-a97c-1cf09e2cbb06","parentUuid":"efc80cc8-8318-4f8c-acb7-dc1c60e491c1","uuid":"723a1287-0ce5-4d11-9795-c8a951abdbda"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Will you be collecting physical samples?"}},"createdAt":"2021-11-30T16:33:27Z","entityUuid":"0e810343-6026-4992-8ea0-5539cbc77093","parentUuid":"b1df3c74-0b1f-4574-81c4-4cc2d780c1af","uuid":"6f1ac1cb-8462-4ab4-b60d-d8fda3d2977c"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Specify how you guarantee that measurements measure what you think they should measure, and how you establish completeness and correctness of data and metadata."},"title":{"changed":false}},"createdAt":"2021-11-30T16:33:28Z","entityUuid":"ba38b16d-2154-4372-b445-7854a6e90443","parentUuid":"f5fef09d-ade5-4019-b089-f05bd89c34bc","uuid":"2536b4d2-3871-47f2-94c6-8315de0e12ed"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Are you checking that data that is entered e.g. in forms is satisfying criteria of reasonability?"},"title":{"changed":false}},"createdAt":"2021-11-30T16:33:29Z","entityUuid":"01b70401-021b-4fe7-9073-570ecb3b320c","parentUuid":"9a8dbe23-8fb2-4501-adde-3b6261dc1653","uuid":"863b16b2-53a5-454d-b17e-08b178971144"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Do you make sure all collected is cross-checked by colleagues?"},"title":{"changed":false}},"createdAt":"2021-11-30T16:33:30Z","entityUuid":"56354f8a-31df-40fc-aeae-67d45af560b5","parentUuid":"9a8dbe23-8fb2-4501-adde-3b6261dc1653","uuid":"b978f858-e15f-4d70-b44c-9cbe3f2832e0"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Controlled vocabularies should be used to limit what can be entered in most text fields. "},"title":{"changed":true,"value":"Are you using controlled vocabularies where possible?"}},"createdAt":"2021-11-30T16:33:31Z","entityUuid":"e2401b56-5d7e-42c6-bb97-c8bede39b4b0","parentUuid":"9a8dbe23-8fb2-4501-adde-3b6261dc1653","uuid":"da16757a-95e5-41e9-b0f1-11b0e9c7db9e"}],"forkOfPackageId":null,"id":"dsw:root:2.3.2","kmId":"root","language":"en","license":"Apache-2.0","mergeCheckpointPackageId":null,"metamodelVersion":20,"name":"Common DSW Knowledge Model","nonEditable":false,"organizationId":"dsw","phase":"DeprecatedKnowledgeModelPackagePhase","previousPackageId":"dsw:root:2.3.1","readme":"# Common DSW Knowledge Model\r\n\r\nCommon DSW Knowledge Model deals with questions that a researcher should answer in order to create a Data Stewardship Plan, as well as other related questionnaire data. It originated from mindmap made by Rob Hooft.\r\n\r\n## Changelog\r\n\r\n### 2.3.2\r\n* Incorporation of changes from a workshop with the authors of the RDMkit page on data collecting.\r\n   * Added links to RDMkit in several places\r\n   * Clarified some questions\r\n   * Moved questions on quality together\r\n   * Moved some questions out of the metadata subsection\r\n\r\n### 2.3.1\r\n* Incorporation of changes from a workshop with the authors of the RDMkit page on data sharing.\r\n    * Attempt to clarify difference between \"open\" and \"accessible\"\r\n    * Attempt to clarify difference between \"open\" and \"embargoed\"\r\n    * Added links to RDMkit Data Sharing page in a few places\r\n    * Added a few relevant questions\r\n\r\n### 2.3.0\r\n\r\nActivity during [BioHackathon Europe](biohackathon-europe.org) 2020 ([#BioHackEU20](twitter.com/search?q=%23BioHackEU20))\r\n\r\n* Added and tagged questions for Horizon 2020 template\r\n* Moved questions about collecting metadata to one consistent place\r\n* Added guidance on semantics in file names and question about using PIDs for identifying files\r\n* Generic small cleanups and typo fixes\r\n* Closing many issues of feedback received on the knowledge model (from [DSWGlobal/dsw](https://github.com/DSWGlobal/dsw))\r\n* Various question updates new options, clarifications, integrations\r\n* Added highly configurable [Wikidata](https://www.wikidata.org) SPARQL-based integration\r\n* Added [Research Organization Registry](https://ror.org) integration for contributor's affiliation\r\n\r\n### 2.2.0\r\n\r\n* Adjusted for compatibility with [RDA DMP Common Standard for machine-actionable DMPs (1.0)](https://github.com/RDA-DMP-Common/RDA-DMP-Common-Standard)\r\n  * Updated *Project* and *Funding* questions in *Administrative Details* chapter\r\n  * Reorganised *Dataset*, *Distribution*, *License* questions in *Data Publishing* chapter\r\n* Added *maDMP* tag to questions used in the RDA maDMP template\r\n\r\n### 2.1.0\r\n\r\n* Added *Science Europe DMP* tag to questions used in the Science Europe template\r\n\r\n### 2.0.2\r\n\r\n* Fixed missing and duplicated questions\r\n\r\n### 2.0.1\r\n\r\n* Fixed duplicated question in *Creating and collecting data* chapter (5ba53879-eb48-47f2-a73b-f7f7d83bf030)\r\n\r\n### 2.0.0\r\n\r\n* Added detailed questions for Science Europe DMPs\r\n* Fixed several typos and other minor problems\r\n* Added administrative chapter\r\n* Moving questions and refactoring according to [ds-km#24](https://github.com/ds-wizard/ds-km/pull/24)\r\n\r\n### 1.4.0\r\n\r\n* Adding integration for [FAIRsharing.org](https://fairsharing.org)\r\n* Adding 5 integration questions according to [ds-km@da5a8fc](https://github.com/ds-wizard/ds-km/commit/da5a8fc95d0a67f9369ce0b7727615115fc3656d)\r\n\r\nThe FAIRsharing integration requires configuration to contain `apiUrl` and `apiKey` for integration with id `fairsharing`.\r\n\r\n### 1.3.0\r\n\r\n* Refactoring list questions because of **deprecated item title** fields, i.e., a new question for item title created for each list question\r\n\r\nWhen using this version and higher, the DS Wizard configuration should have `itemTitleEnabled` set to `false`.\r\n\r\n### 1.2.0\r\n\r\n* Adding file naming SOP description question (9ff389f0-2236-48cf-880c-040ea1bb0d2f) to chapter 2 according to [ds-km@d879be0](https://github.com/ds-wizard/ds-km/commit/d879be0fa9d0808868396c649d03c4d783ac6742)\r\n\r\n### 1.1.0\r\n\r\n* Adding phases to questions (first draft) according to [ds-km@a6713d1](https://github.com/ds-wizard/ds-km/commit/a6713d1a4b9758bea63b3f7c56af5bd4f500d949) and [ds-km@1123211](https://github.com/ds-wizard/ds-km/commit/1123211bb5af43df8ef435039a2923f48e3e981c)\r\n\r\nPrior to this version, all questions were assigned with phase 2 - *Before submitting the DMP*.\r\n\r\n### 1.0.3\r\n\r\n* Fix: Removing extra question mark for a question (8018e15f-6c7e-433a-8686-ae0d695c7fc7) in chapter 5 according to: [ds-km@1123211](https://github.com/ds-wizard/ds-km/commit/1123211bb5af43df8ef435039a2923f48e3e981c)\r\n\r\n### 1.0.2\r\n\r\n* Fix: Adding some explanation to the list item questions (f5fef09d-ade5-4019-b089-f05bd89c34bc and b642c31d-a512-4ca7-8743-a2e0254006fa) in chapter 3 according to: [ds-km@96e28f4](https://github.com/ds-wizard/ds-km/commit/96e28f478d5dc6b59d384b5127f012dc2fe5f287)\r\n\r\n### 1.0.1\r\n\r\n* Fix: Adding forgotten question mark to end of question (39e0cc7c-17fe-4991-88d8-1280c3fe7923) in chapter 1 according to: [ds-km@644a373](https://github.com/ds-wizard/ds-km/commit/644a373685dc4ac15b76e86667a90151ca9c70ca)\r\n\r\n### 1.0.0\r\n\r\n* Initial version transformed from the previous DS-KM GitHub repository up to [ds-km@8442837](https://github.com/ds-wizard/ds-km/commit/8442837dbe3ff899b09e7d8d3fc1107e935a876f)","version":"2.3.2"},{"createdAt":"2021-12-14T16:06:07.542063Z","description":"DSW Knowledge Model originated from mindmap made by Rob Hooft","events":[{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Do you plan taking special measures to guarantee the integrity of tools in the workflow?"}},"createdAt":"2021-12-14T16:06:08Z","entityUuid":"558f01a3-2563-4114-9244-812b212c9791","parentUuid":"bb00eb32-e1c2-4288-a874-02264f757cb3","uuid":"9f70e8fc-aa28-4e09-a659-a587b8eab62a"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"RDMkit on Data Transfer","referenceType":"URLReference","url":"https://rdmkit.elixir-europe.org/data_transfer.html"},"createdAt":"2021-12-14T16:06:09Z","entityUuid":"2a84091c-43eb-49c1-b5d8-78b37dcb3cc5","parentUuid":"f4065e54-d27a-45de-be4c-10384feacd0d","uuid":"7df287b4-e9fe-4ad6-b5e6-043a0a057b29"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"RDMkit on Data Organisation","referenceType":"URLReference","url":"https://rdmkit.elixir-europe.org/data_organisation.html"},"createdAt":"2021-12-14T16:06:10Z","entityUuid":"68a842d8-280a-43fc-82c6-1de8b9821d17","parentUuid":"a12aa967-28a5-4a9b-8df8-f7c533205ea4","uuid":"9e7767c1-5e50-4bcd-aa63-1aa1f84ab131"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":"Did you document how you manage file versioning?"},"createdAt":"2021-12-14T16:06:11Z","entityUuid":"a2e22a59-4747-4c29-84c0-3a9cbd859249","parentUuid":"00ed33b9-ef1c-4de0-932b-bc6a29023e76","uuid":"f8104ac2-0dcc-49c3-bc02-48db3b24fd87"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[]},"createdAt":"2021-12-14T16:06:12Z","entityUuid":"d23c7fe6-4b85-4a84-9253-0322f9a94756","parentUuid":"a2e22a59-4747-4c29-84c0-3a9cbd859249","uuid":"b266abca-a0e1-4ce8-9597-336aaf810baa"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[]},"createdAt":"2021-12-14T16:06:13Z","entityUuid":"7df4eaa1-6779-473e-ab7d-44421d4e5f49","parentUuid":"a2e22a59-4747-4c29-84c0-3a9cbd859249","uuid":"cba83d04-5031-4b6b-bcea-5ac0aab4e69c"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":false},"metricMeasures":{"changed":true,"value":[{"measure":0,"metricUuid":"8845fe2b-79df-4138-baea-3a035bf5e249","weight":1}]}},"createdAt":"2021-12-14T16:06:14Z","entityUuid":"d23c7fe6-4b85-4a84-9253-0322f9a94756","parentUuid":"a2e22a59-4747-4c29-84c0-3a9cbd859249","uuid":"7ced8db4-75f5-49cc-97d1-6fa675bdf759"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":false},"metricMeasures":{"changed":true,"value":[{"measure":1,"metricUuid":"8845fe2b-79df-4138-baea-3a035bf5e249","weight":1}]}},"createdAt":"2021-12-14T16:06:15Z","entityUuid":"7df4eaa1-6779-473e-ab7d-44421d4e5f49","parentUuid":"a2e22a59-4747-4c29-84c0-3a9cbd859249","uuid":"0cb9f67a-fb78-4aa1-b310-70e5e34a878e"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":true,"value":"1796fa3c-9f53-475f-89ff-c66a0453c42e"},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2021-12-14T16:06:16Z","entityUuid":"a2e22a59-4747-4c29-84c0-3a9cbd859249","parentUuid":"00ed33b9-ef1c-4de0-932b-bc6a29023e76","uuid":"305a20ad-2de9-4cab-91f6-8f8570271334"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Some \"file\" storage systems do not have a tree structure like we know in a file system, but rather have direct pointers to any file in the system. Such systems are called \"object store\". Examples are Amazon S3 and CEPH"},"title":{"changed":false}},"createdAt":"2021-12-14T16:06:17Z","entityUuid":"dc39957e-688a-4f71-a6a8-57f52509e7cf","parentUuid":"f7f2ff16-eee0-42a7-a89a-bd7291cef5fc","uuid":"965bdbe3-1d9b-4278-b316-22b362707be1"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"Wikipedia on object storage","referenceType":"URLReference","url":"https://en.wikipedia.org/wiki/Object_storage"},"createdAt":"2021-12-14T16:06:18Z","entityUuid":"70820c40-99b2-4a5e-9bb5-71135d6c92e0","parentUuid":"dc39957e-688a-4f71-a6a8-57f52509e7cf","uuid":"797d3503-2c62-40ee-8e13-f39663fdeb6f"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"RDMkit on Data Storage","referenceType":"URLReference","url":"https://rdmkit.elixir-europe.org/storage.html"},"createdAt":"2021-12-14T16:06:19Z","entityUuid":"e27878a0-c9f0-4aef-8f15-858418336a75","parentUuid":"dc39957e-688a-4f71-a6a8-57f52509e7cf","uuid":"86a1560a-5741-4b8d-bf68-8150bbc3c028"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":"Are you using an Electronic Lab Notebook (ELN) or Electronic Data Capture (EDC) applications ","title":"Are you storing (some of your) data in a specific application?"},"createdAt":"2021-12-14T16:06:20Z","entityUuid":"65730a4d-40db-46c9-b6d2-2b44b35f617e","parentUuid":"f7f2ff16-eee0-42a7-a89a-bd7291cef5fc","uuid":"6bff2bb3-a1b8-47b0-b6dc-c1a4771978b6"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[]},"createdAt":"2021-12-14T16:06:21Z","entityUuid":"643254d2-6f0e-419b-97d3-bd57b03ab1ac","parentUuid":"65730a4d-40db-46c9-b6d2-2b44b35f617e","uuid":"d20fa1a6-b127-4600-aacc-94fc82e4e9fe"},{"content":{"advice":"Note that using the data that is stored in such a system will need to be exported in some standard way before it becomes available for other data analysis tools.","annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[]},"createdAt":"2021-12-14T16:06:22Z","entityUuid":"d5575f62-2083-403f-b41c-5560a5387da8","parentUuid":"65730a4d-40db-46c9-b6d2-2b44b35f617e","uuid":"a49e975e-d508-4ff0-b95c-22a59ed6ebe2"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Are you storing (some of your) data in an application specific manner?"}},"createdAt":"2021-12-14T16:06:23Z","entityUuid":"65730a4d-40db-46c9-b6d2-2b44b35f617e","parentUuid":"f7f2ff16-eee0-42a7-a89a-bd7291cef5fc","uuid":"738acb30-0885-4181-88af-4de82bc6a262"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Are you using e.g. an Electronic Lab Notebook (ELN) or Electronic Data Capture (EDC) application? Such applications often have their own data structure that can only be accessed through the application."},"title":{"changed":false}},"createdAt":"2021-12-14T16:06:24Z","entityUuid":"65730a4d-40db-46c9-b6d2-2b44b35f617e","parentUuid":"f7f2ff16-eee0-42a7-a89a-bd7291cef5fc","uuid":"381f7f1c-0902-4c86-9276-6467bfb0a16e"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"RDMkit on Data Analysis","referenceType":"URLReference","url":"https://rdmkit.elixir-europe.org/data_analysis.html"},"createdAt":"2021-12-14T16:06:25Z","entityUuid":"45d989ae-e78a-4d80-9af7-168ebb0d681b","parentUuid":"a1c37c05-57ff-499c-b58c-e90f511241fa","uuid":"8a17da6c-5ac4-491e-9514-69dd07d5fdca"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"RDMkit on Data Analysis","referenceType":"URLReference","url":"https://rdmkit.elixir-europe.org/data_analysis.html"},"createdAt":"2021-12-14T16:06:26Z","entityUuid":"f3fd7baf-c902-4f01-b979-2f1136a1df36","parentUuid":"1991077f-04ae-4808-90a5-e4b2f82e30bf","uuid":"c951ce3f-66b2-43bf-a772-3ff9c5211f24"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Is there sufficient experience with the chosen computing platform in the project, and sufficient time to support the project partners?"}},"createdAt":"2021-12-14T16:06:27Z","entityUuid":"851a72ac-9497-4d8a-ae1a-6509d021a20b","parentUuid":"ae82cfc8-6b5f-4f06-a969-d430db181ac5","uuid":"a81c859b-35d2-48c1-933e-6141b248667a"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"RDMkit on Sensitive Data","referenceType":"URLReference","url":"https://rdmkit.elixir-europe.org/sensitive_data.html"},"createdAt":"2021-12-14T16:06:28Z","entityUuid":"3fe12009-cd7c-4e4e-a7f8-2617c25c33c7","parentUuid":"d5990471-0618-42cd-92cb-bbbfd4f61532","uuid":"aa546bdf-71e2-415a-93df-101da08454b5"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Your institute may have a generic risk assessment; you should be informed about this."},"title":{"changed":false}},"createdAt":"2021-12-14T16:06:29Z","entityUuid":"a20ddc5d-e883-4bc4-9948-36a2cb477d10","parentUuid":"b2f76c0a-847a-403c-9ed6-09cad10e625e","uuid":"045a5f50-ccf0-4231-8b20-1001ae4d1e94"}],"forkOfPackageId":null,"id":"dsw:root:2.3.3","kmId":"root","language":"en","license":"Apache-2.0","mergeCheckpointPackageId":null,"metamodelVersion":20,"name":"Common DSW Knowledge Model","nonEditable":false,"organizationId":"dsw","phase":"DeprecatedKnowledgeModelPackagePhase","previousPackageId":"dsw:root:2.3.2","readme":"# Common DSW Knowledge Model\r\n\r\nCommon DSW Knowledge Model deals with questions that a researcher should answer in order to create a Data Stewardship Plan, as well as other related questionnaire data. It originated from mindmap made by Rob Hooft.\r\n\r\n## Changelog\r\n\r\n### 2.3.3\r\n* Incorporation of changes from a collaborative workshop with RDMkit participants on data processing.\r\n   * Added links to RDMkit (and some to other external resources) in several places\r\n   * Clarified some questions\r\n   * Added question on data versioning for filesystems\r\n\r\n### 2.3.2\r\n* Incorporation of changes from a workshop with the authors of the RDMkit page on data collecting.\r\n   * Added links to RDMkit in several places\r\n   * Clarified some questions\r\n   * Moved questions on quality together\r\n   * Moved some questions out of the metadata subsection\r\n\r\n### 2.3.1\r\n* Incorporation of changes from a workshop with the authors of the RDMkit page on data sharing.\r\n    * Attempt to clarify difference between \"open\" and \"accessible\"\r\n    * Attempt to clarify difference between \"open\" and \"embargoed\"\r\n    * Added links to RDMkit Data Sharing page in a few places\r\n    * Added a few relevant questions\r\n\r\n### 2.3.0\r\n\r\nActivity during [BioHackathon Europe](biohackathon-europe.org) 2020 ([#BioHackEU20](twitter.com/search?q=%23BioHackEU20))\r\n\r\n* Added and tagged questions for Horizon 2020 template\r\n* Moved questions about collecting metadata to one consistent place\r\n* Added guidance on semantics in file names and question about using PIDs for identifying files\r\n* Generic small cleanups and typo fixes\r\n* Closing many issues of feedback received on the knowledge model (from [DSWGlobal/dsw](https://github.com/DSWGlobal/dsw))\r\n* Various question updates new options, clarifications, integrations\r\n* Added highly configurable [Wikidata](https://www.wikidata.org) SPARQL-based integration\r\n* Added [Research Organization Registry](https://ror.org) integration for contributor's affiliation\r\n\r\n### 2.2.0\r\n\r\n* Adjusted for compatibility with [RDA DMP Common Standard for machine-actionable DMPs (1.0)](https://github.com/RDA-DMP-Common/RDA-DMP-Common-Standard)\r\n  * Updated *Project* and *Funding* questions in *Administrative Details* chapter\r\n  * Reorganised *Dataset*, *Distribution*, *License* questions in *Data Publishing* chapter\r\n* Added *maDMP* tag to questions used in the RDA maDMP template\r\n\r\n### 2.1.0\r\n\r\n* Added *Science Europe DMP* tag to questions used in the Science Europe template\r\n\r\n### 2.0.2\r\n\r\n* Fixed missing and duplicated questions\r\n\r\n### 2.0.1\r\n\r\n* Fixed duplicated question in *Creating and collecting data* chapter (5ba53879-eb48-47f2-a73b-f7f7d83bf030)\r\n\r\n### 2.0.0\r\n\r\n* Added detailed questions for Science Europe DMPs\r\n* Fixed several typos and other minor problems\r\n* Added administrative chapter\r\n* Moving questions and refactoring according to [ds-km#24](https://github.com/ds-wizard/ds-km/pull/24)\r\n\r\n### 1.4.0\r\n\r\n* Adding integration for [FAIRsharing.org](https://fairsharing.org)\r\n* Adding 5 integration questions according to [ds-km@da5a8fc](https://github.com/ds-wizard/ds-km/commit/da5a8fc95d0a67f9369ce0b7727615115fc3656d)\r\n\r\nThe FAIRsharing integration requires configuration to contain `apiUrl` and `apiKey` for integration with id `fairsharing`.\r\n\r\n### 1.3.0\r\n\r\n* Refactoring list questions because of **deprecated item title** fields, i.e., a new question for item title created for each list question\r\n\r\nWhen using this version and higher, the DS Wizard configuration should have `itemTitleEnabled` set to `false`.\r\n\r\n### 1.2.0\r\n\r\n* Adding file naming SOP description question (9ff389f0-2236-48cf-880c-040ea1bb0d2f) to chapter 2 according to [ds-km@d879be0](https://github.com/ds-wizard/ds-km/commit/d879be0fa9d0808868396c649d03c4d783ac6742)\r\n\r\n### 1.1.0\r\n\r\n* Adding phases to questions (first draft) according to [ds-km@a6713d1](https://github.com/ds-wizard/ds-km/commit/a6713d1a4b9758bea63b3f7c56af5bd4f500d949) and [ds-km@1123211](https://github.com/ds-wizard/ds-km/commit/1123211bb5af43df8ef435039a2923f48e3e981c)\r\n\r\nPrior to this version, all questions were assigned with phase 2 - *Before submitting the DMP*.\r\n\r\n### 1.0.3\r\n\r\n* Fix: Removing extra question mark for a question (8018e15f-6c7e-433a-8686-ae0d695c7fc7) in chapter 5 according to: [ds-km@1123211](https://github.com/ds-wizard/ds-km/commit/1123211bb5af43df8ef435039a2923f48e3e981c)\r\n\r\n### 1.0.2\r\n\r\n* Fix: Adding some explanation to the list item questions (f5fef09d-ade5-4019-b089-f05bd89c34bc and b642c31d-a512-4ca7-8743-a2e0254006fa) in chapter 3 according to: [ds-km@96e28f4](https://github.com/ds-wizard/ds-km/commit/96e28f478d5dc6b59d384b5127f012dc2fe5f287)\r\n\r\n### 1.0.1\r\n\r\n* Fix: Adding forgotten question mark to end of question (39e0cc7c-17fe-4991-88d8-1280c3fe7923) in chapter 1 according to: [ds-km@644a373](https://github.com/ds-wizard/ds-km/commit/644a373685dc4ac15b76e86667a90151ca9c70ca)\r\n\r\n### 1.0.0\r\n\r\n* Initial version transformed from the previous DS-KM GitHub repository up to [ds-km@8442837](https://github.com/ds-wizard/ds-km/commit/8442837dbe3ff899b09e7d8d3fc1107e935a876f)","version":"2.3.3"},{"createdAt":"2022-01-10T11:03:39.047838Z","description":"DSW Knowledge Model originated from mindmap made by Rob Hooft","events":[{"content":{"eventType":"MoveQuestionEvent","targetUuid":"2663b978-5125-4224-9930-0a50dbe895c9"},"createdAt":"2022-01-10T11:03:40Z","entityUuid":"fcc51962-08df-4f4c-85ad-6bb932107010","parentUuid":"dac677d4-99f9-4af8-935a-4a1c9c7cdbdf","uuid":"d19ea8a6-70a2-4bd3-8e9c-2f588aaec539"},{"content":{"eventType":"MoveQuestionEvent","targetUuid":"2663b978-5125-4224-9930-0a50dbe895c9"},"createdAt":"2022-01-10T11:03:41Z","entityUuid":"be872000-cb98-442f-999c-ca3ef58dcfe8","parentUuid":"dac677d4-99f9-4af8-935a-4a1c9c7cdbdf","uuid":"521aa445-0458-492a-9762-c37d7357f1e7"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":true,"value":["fcc51962-08df-4f4c-85ad-6bb932107010","be872000-cb98-442f-999c-ca3ef58dcfe8","59efe0c4-fc18-4082-a656-6d0c1db45899","8cedcf93-7676-4397-b3fc-a81167ff1853","7e77ee02-ce26-4cd9-b07d-3eea03bc35c9"]},"label":{"changed":false},"metricMeasures":{"changed":false}},"createdAt":"2022-01-10T11:03:42Z","entityUuid":"2663b978-5125-4224-9930-0a50dbe895c9","parentUuid":"efc80cc8-8318-4f8c-acb7-dc1c60e491c1","uuid":"239b3cb2-4854-4b3a-9c4c-e6343af9d795"},{"content":{"eventType":"DeleteQuestionEvent"},"createdAt":"2022-01-10T11:03:43Z","entityUuid":"59efe0c4-fc18-4082-a656-6d0c1db45899","parentUuid":"2663b978-5125-4224-9930-0a50dbe895c9","uuid":"1f716622-dafc-4533-b3ed-ed7eff93f151"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"