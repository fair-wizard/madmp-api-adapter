,"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2025-11-25T12:17:28Z","entityUuid":"44120979-2840-4522-8297-df13f7fd1e3a","parentUuid":"be872000-cb98-442f-999c-ca3ef58dcfe8","uuid":"23e3df45-fe5c-4991-9e2b-ad77496bf647"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2025-11-25T12:17:29Z","entityUuid":"682da8d1-c109-4f62-8cf1-dadd8908af77","parentUuid":"be872000-cb98-442f-999c-ca3ef58dcfe8","uuid":"709e8b9b-dd86-4782-adce-dd1cb3996a7d"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":true,"value":"b101f2d0-2476-452d-aa8d-95a41a02b52c"},"tagUuids":{"changed":true,"value":["19b0fe70-a884-4539-96b9-a0aaf8c9b884","fd4637a2-a117-460a-a7fa-c03760c42629","87bb2042-8e3c-4733-ba1e-84509d7b1cf4","3c7bdc90-8ed3-4b34-90ec-7945d14cc443"]},"text":{"changed":true,"value":"Give a name for the data set."},"title":{"changed":true,"value":"Non-reference data set"}},"createdAt":"2025-11-25T12:17:30Z","entityUuid":"682da8d1-c109-4f62-8cf1-dadd8908af77","parentUuid":"be872000-cb98-442f-999c-ca3ef58dcfe8","uuid":"f4b3626e-0110-4ea9-b26b-395579adaca7"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2025-11-25T12:17:31Z","entityUuid":"682da8d1-c109-4f62-8cf1-dadd8908af77","parentUuid":"be872000-cb98-442f-999c-ca3ef58dcfe8","uuid":"e28de4ad-9583-4828-9e73-3929519faf78"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"integrationUuid":{"changed":true,"value":"00000000-0000-0000-0000-000000000000"},"questionType":"IntegrationQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"variables":{"changed":false}},"createdAt":"2025-11-25T12:17:32Z","entityUuid":"682da8d1-c109-4f62-8cf1-dadd8908af77","parentUuid":"be872000-cb98-442f-999c-ca3ef58dcfe8","uuid":"7768abf3-be9c-46da-894f-0abd986e27cb"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":true,"value":"StringQuestionValueType"}},"createdAt":"2025-11-25T12:17:33Z","entityUuid":"682da8d1-c109-4f62-8cf1-dadd8908af77","parentUuid":"be872000-cb98-442f-999c-ca3ef58dcfe8","uuid":"ed4adcc4-5ea4-4c04-b80b-731c0e75749b"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":true,"value":["44120979-2840-4522-8297-df13f7fd1e3a","682da8d1-c109-4f62-8cf1-dadd8908af77","5f73797c-268a-4862-b48b-75719ff47709","f5e129dc-d59d-4352-a5ed-25efe1d83811"]},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2025-11-25T12:17:34Z","entityUuid":"be872000-cb98-442f-999c-ca3ef58dcfe8","parentUuid":"2663b978-5125-4224-9930-0a50dbe895c9","uuid":"2b5980da-1ef3-4dde-9c02-a51ddb2618cc"},{"content":{"eventType":"DeleteQuestionEvent"},"createdAt":"2025-11-25T12:17:35Z","entityUuid":"93988527-5bff-4125-8834-3750e9a28683","parentUuid":"fcc51962-08df-4f4c-85ad-6bb932107010","uuid":"2afef0d9-4b0b-491d-b4e6-e8c1ee0b0a43"},{"content":{"eventType":"DeleteQuestionEvent"},"createdAt":"2025-11-25T12:17:36Z","entityUuid":"44120979-2840-4522-8297-df13f7fd1e3a","parentUuid":"be872000-cb98-442f-999c-ca3ef58dcfe8","uuid":"3f6bbdd2-6800-42a1-bda7-21ffbdac6756"},{"content":{"allowCustomReply":{"changed":false},"annotations":{"changed":false},"eventType":"EditIntegrationEvent","integrationType":"ApiIntegration","name":{"changed":false},"requestAllowEmptySearch":{"changed":false},"requestBody":{"changed":false},"requestHeaders":{"changed":false},"requestMethod":{"changed":false},"requestUrl":{"changed":true,"value":"{{secrets.fairsharingApiUrl}}/v2/search?registry={{variables.registry}}&record_type={{variables.record_type}}&q={{q}}&status={{variables.status}}"},"responseItemTemplate":{"changed":false},"responseItemTemplateForSelection":{"changed":false},"responseListField":{"changed":false},"testQ":{"changed":false},"testResponse":{"changed":true,"value":{"request":{"body":null,"headers":[{"key":"Accept","value":"application/json"},{"key":"Authorization","value":"[SECRET:fairsharingApiKey]"}],"method":"GET","url":"[SECRET:fairsharingApiUrl]/v2/search?registry=standard&record_type=reporting_guideline,model_and_format&q=foaf&status=ready"},"response":{"body":"[{\"id\":4684,\"type\":\"model_and_format\",\"name\":\"OpenAIRE Research Graph Data Model\",\"homepage\":\"https://www.openaire.eu/schema/latest/doc/oaf.html\",\"abbreviation\":\"OAF\",\"doi\":\"10.25504/FAIRsharing.5d6c49\",\"description\":\"OpenAIRE operates a research graph whose objects are scientific outputs, organizations, funders, communities, organizations, and data sources. The OpenAIRE Research Graph Data Model is used to describe these entities, following existing metadata standards such as CERIF.\",\"registry\":\"standard\",\"status\":\"ready\"},{\"id\":957,\"type\":\"model_and_format\",\"name\":\"Extensible Stylesheet Language\",\"homepage\":\"http://www.w3.org/TR/xsl11/\",\"abbreviation\":\"XSL\",\"doi\":\"10.25504/FAIRsharing.b8b212\",\"description\":\"This specification defines the features and syntax for the Extensible Stylesheet Language (XSL, also known colloquially as the Extensible Stylesheet Language Formatting Objects (XSLFO)), a language for expressing stylesheets. XSL is a family of recommendations for defining XML document transformation and presentation. It consists of three parts: XSL Transformations (XSLT), a language for transforming XML; The XML Path Language (XPath), an expression language used by XSLT (and many other languages) to access or refer to parts of an XML document; and XSL Formatting Objects (XSL-FO), an XML vocabulary for specifying formatting semantics (described here).\",\"registry\":\"standard\",\"status\":\"ready\"}]","contentType":"application/json","responseType":"SuccessTypeHintResponse","status":200}}},"testVariables":{"changed":true,"value":{"record_type":"reporting_guideline,model_and_format","registry":"standard","status":"ready"}},"variables":{"changed":false}},"createdAt":"2025-11-25T12:17:37Z","entityUuid":"aacf9099-8221-4b15-8425-fc356eb16d9b","parentUuid":"6f6241d9-136c-4770-9d58-8a3f39607052","uuid":"3ade7b04-d7e9-4bcb-a7be-2eb83ead32f9"},{"content":{"allowCustomReply":{"changed":false},"annotations":{"changed":false},"eventType":"EditIntegrationEvent","integrationType":"ApiIntegration","name":{"changed":false},"requestAllowEmptySearch":{"changed":false},"requestBody":{"changed":false},"requestHeaders":{"changed":false},"requestMethod":{"changed":false},"requestUrl":{"changed":true,"value":"{{secrets.fairsharingApiUrl}}/v2/search?registry={{variables.registry}}&record_type={{variables.record_type}}&q={{q}}&status={{variables.status}}"},"responseItemTemplate":{"changed":true,"value":"![Logo](data:image/svg+xml;base64,) [**{{ item.name }}**](https://fairsharing.org/{{ item.id }}) {% if item.doi or item.homepage -%}\n(\n{%- if item.homepage -%}\n  [{{ item.homepage }}]({{ item.homepage }})\n{%- endif -%} \n{%- if item.homepage and item.doi -%}, {% endif -%}\n  {%- if item.doi -%}[DOI: {{ item.doi }}](https://doi.org/{{ item.doi }})\n{%- endif -%}\n)\n{%- endif %}\n\n{% if item.description %}\n {{ item.description | truncate(300, True, '...')}}\n{% endif %}\n"},"responseItemTemplateForSelection":{"changed":true,"value":"[**{{ item.name }}**](https://fairsharing.org/{{ item.id }}) {% if item.doi or item.homepage -%}\n(\n{%- if item.homepage -%}\n  [{{ item.homepage }}]({{ item.homepage }})\n{%- endif -%} \n{%- if item.homepage and item.doi -%}, {% endif -%}\n  {%- if item.doi -%}[DOI: {{ item.doi }}](https://doi.org/{{ item.doi }})\n{%- endif -%}\n)\n{%- endif %}\n\n{% if item.description %}\n {{ item.description | truncate(300, True, '...')}}\n{% endif %}\n"},"responseListField":{"changed":true,"value":null},"testQ":{"changed":true,"value":"ddi"},"testResponse":{"changed":true,"value":{"request":{"body":"","headers":[{"key":"Accept","value":"application/json"},{"key":"Authorization","value":"[SECRET:fairsharingApiKey]"}],"method":"GET","url":"[SECRET:fairsharingApiUrl]/v2/search?registry=standard&record_type=reporting_guideline,model_and_format,terminology_artefact&q=ddi&status=ready"},"response":{"body":"[{\"id\":1367,\"type\":\"model_and_format\",\"name\":\"Data Documentation Initiative Lifecycle\",\"homepage\":\"https://ddialliance.org/Specification/DDI-Lifecycle/3.3/\",\"abbreviation\":\"DDI-Lifecycle\",\"doi\":\"10.25504/FAIRsharing.1t5ws6\",\"description\":\"Data Documentation Initiative (DDI) Lifecycle (DDI-Lifecycle, DDI-L) is designed to document and manage data across the entire life cycle, from conceptualization to data publication, analysis and beyond. The freely available international DDI standards describe data that result from observational methods in the social, behavioral, economic, and health sciences. DDI is used to document data in over 80 countries of the world. It encompasses all of the DDI-Codebook specification and extends it. Based on XML Schemas, DDI-Lifecycle is modular and extensible.\",\"registry\":\"standard\",\"status\":\"ready\"},{\"id\":1148,\"type\":\"model_and_format\",\"name\":\"Data Documentation Initiative Codebook\",\"homepage\":\"https://ddialliance.org/Specification/DDI-Codebook/2.5/\",\"abbreviation\":\"DDI-Codebook\",\"doi\":\"10.25504/FAIRsharing.EZCpPd\",\"description\":\"Data Documentation Initiative (DDI-Codebook, DDI-C) is a more light-weight version of DDI-Lifecycle, intended primarily to document simple survey data. Originally DTD-based, DDI-C is now available as an XML Schema. The freely available international DDI standards describe data that result from observational methods in the social, behavioral, economic, and health sciences. DDI is used to document data in over 80 countries of the world.\",\"registry\":\"standard\",\"status\":\"ready\"},{\"id\":595,\"type\":\"terminology_artefact\",\"name\":\"Data Documentation Initiative Controlled Vocabularies\",\"homepage\":\"https://ddialliance.org/controlled-vocabularies\",\"abbreviation\":\"DDI CVs\",\"doi\":\"10.25504/FAIRsharing.y4RpVy\",\"description\":\"The Data Documentation Initiative (DDI) Controlled Vocabularies Group (CVG) has created a set of controlled vocabularies (CVs) that can be used with DDI as well as for other purposes and applications. The DDI CVs are used to aid in the description and documentation of data in the social science research community. The published DDI-CVs work with both versions of the DDI specification (DDI-L and DDI-C).\",\"registry\":\"standard\",\"status\":\"ready\"},{\"id\":1409,\"type\":\"model_and_format\",\"name\":\"Extended Knowledge Organization System\",\"homepage\":\"https://ddialliance.org/Specification/RDF/XKOS\",\"abbreviation\":\"XKOS\",\"doi\":\"10.25504/FAIRsharing.tXtp2S\",\"description\":\"Extended Knowledge Organization System (XKOS) extends the Simple Knowledge Organization System (SKOS) for statistical classifications. It does so in two main directions. First, it defines a number of terms that enable the representation of statistical classifications with their structure and textual properties, as well as the relations between classifications. Second, it refines SKOS semantic properties to allow the use of more specific relations between concepts. Those specific relations can be used for the representation of classifications or for any other case where SKOS is employed. XKOS adds the extensions that are desirable to meet the requirements of the statistical community.\",\"registry\":\"standard\",\"status\":\"ready\"},{\"id\":4860,\"type\":\"terminology_artefact\",\"name\":\"Drug-Drug Interactions Ontology\",\"homepage\":\"https://github.com/labda/DINTO\",\"abbreviation\":\"DINTO\",\"doi\":\"10.25504/FAIRsharing.de478a\",\"description\":\"DINTO is an OWL ontology that systematically organizes all drug-drug interaction (DDI) related information.\",\"registry\":\"standard\",\"status\":\"ready\"},{\"id\":1329,\"type\":\"terminology_artefact\",\"name\":\"CESSDA Vocabulary\",\"homepage\":\"https://vocabularies.cessda.eu/#!discover\",\"abbreviation\":\"CESSDA Vocabulary\",\"doi\":\"10.25504/FAIRsharing.5c7cec\",\"description\":\"CESSDA Vocabulary Service enables users to discover, browse, and download controlled vocabularies in a variety of languages. The service is provided by the Consortium of European Social Science Data Archives (CESSDA). The majority of the source (English) vocabularies included in the service have been created by the DDI Alliance. The Data Documentation Initiative (DDI) is an international standard for describing data produced by surveys and other observational methods in the social, behavioural, economic, and health sciences.\",\"registry\":\"standard\",\"status\":\"ready\"},{\"id\":3633,\"type\":\"terminology_artefact\",\"name\":\"Materials And Molecules Basic Ontology\",\"homepage\":\"https://github.com/daimoners/MAMBO\",\"abbreviation\":\"MAMBO\",\"doi\":\"10.25504/FAIRsharing.36bc7b\",\"description\":\"MAMBO (Materials And Molecules Basic Ontology) is a domain ontology for molecular materials. Its main targets are: i) Allowing the retrieval of structured information regarding molecular materials and related applications (i.e. devices based on molecular materials), ii) Supporting the development of new, complex workflows for modelling systems based on molecular materials (computational modelling and data-driven techniques), iii) Integrating data generated via computational simulations and empirical experiments.\",\"registry\":\"standard\",\"status\":\"ready\"},{\"id\":356,\"type\":\"terminology_artefact\",\"name\":\"Taxonomic Rank Vocabulary\",\"homepage\":\"https://github.com/phenoscape/taxrank\",\"abbreviation\":\"TAXRANK\",\"doi\":\"10.25504/FAIRsharing.p1sejz\",\"description\":\"This is a vocabulary of taxonomic ranks intended to replace the sets of rank terms found in the Teleost Taxonomy Ontology, the OBO translation of the NCBI taxonomy and similar OBO taxonomy ontologies. It provides terms for taxonomic ranks drawn from both the NCBI taxonomy database and from a rank vocabulary developed for the TDWG biodiversity information standards group. Each term contains cross reference links to the resources that use the terms. Consistent with its intended use as a vocabulary, there is no relation specifying an ordering of the rank terms. Likewise, all terms are directly descended from the term 'taxonomic rank' (TAXRANK:0000000).\",\"registry\":\"standard\",\"status\":\"ready\"},{\"id\":827,\"type\":\"terminology_artefact\",\"name\":\"Darwin Core\",\"homepage\":\"http://www.tdwg.org/standards/450\",\"abbreviation\":\"DwC\",\"doi\":\"10.25504/FAIRsharing.xvf5y3\",\"description\":\"Darwin Core (DwC) is a vocabulary that includes a glossary of terms (in other contexts these might be called properties, elements, fields, columns, attributes, or concepts) intended to facilitate the sharing of information about biological diversity by providing identifiers, labels, and definitions. The Darwin Core is primarily based on the observation, specimen and samples of taxa. The Darwin Core standard is comprised of one vocabulary (the Darwin Core vocabulary), and six associated documents. The vocabulary itself is composed of four term lists: Darwin Core terms borrowed from the Dublin Core legacy and terms namespace, Darwin Core IRI-value Term Analogs, and the core terms defined by Darwin Core.\",\"registry\":\"standard\",\"status\":\"ready\"},{\"id\":219,\"type\":\"terminology_artefact\",\"name\":\"Hymenoptera Anatomy Ontology\",\"homepage\":\"http://portal.hymao.org/projects/32/public/ontology/\",\"abbreviation\":\"HAO\",\"doi\":\"10.25504/FAIRsharing.kj3m5n\",\"description\":\"The Hymenoptera Anatomy Ontology is a structured controlled vocabulary of the anatomy of the Hymenoptera (bees, wasps, and ants)\",\"registry\":\"standard\",\"status\":\"ready\"},{\"id\":308,\"type\":\"model_and_format\",\"name\":\"RNA Markup Language\",\"homepage\":\"http://www-lbit.iro.umontreal.ca/rnaml/\",\"abbreviation\":\"RNAML\",\"doi\":\"10.25504/FAIRsharing.e729c4\",\"description\":\"RNAML syntax was designed to facilitate the interoperation of multiple RNA informatics programs and to exchange basic RNA molecular information.\",\"registry\":\"standard\",\"status\":\"ready\"},{\"id\":564,\"type\":\"terminology_artefact\",\"name\":\"Zebrafish anatomy and development\",\"homepage\":\"https://wiki.zfin.org/display/general/Anatomy+Atlases+and+Resources\",\"abbreviation\":\"ZFA\",\"doi\":\"10.25504/FAIRsharing.s3r6sk\",\"description\":\"A structured controlled vocabulary of the anatomy and development of the Zebrafish. If you work on the project responsible for \\\"Zebrafish anatomy and development\\\" then please consider helping us by claiming this record and updating it appropriately.\",\"registry\":\"standard\",\"status\":\"ready\"},{\"id\":1229,\"type\":\"terminology_artefact\",\"name\":\"PRotein Ontology\",\"homepage\":\"https://proconsortium.org/\",\"abbreviation\":\"PRO\",\"doi\":\"10.25504/FAIRsharing.4ndncv\",\"description\":\"Protein Ontology (PRO) provides an ontological representation of protein-related entities by explicitly defining them and showing the relationships between them. Each PRO term represents a distinct class of entities (including specific modified forms, orthologous isoforms, and protein complexes) ranging from the taxon-neutral to the taxon-specific. The ontology has a meta-structure encompassing three areas: proteins based on evolutionary relatedness (ProEvo); protein forms produced from a given gene locus (ProForm); and protein-containing complexes (ProComp).\",\"registry\":\"standard\",\"status\":\"ready\"},{\"id\":1544,\"type\":\"model_and_format\",\"name\":\"Citation File Format\",\"homepage\":\"https://citation-file-format.github.io/\",\"abbreviation\":\"CFF\",\"doi\":\"10.25504/FAIRsharing.m2NU20\",\"description\":\"The Citation File Format (CFF) is a human-centric, machine-readable format for software citation metadata. It is developed to provide an easy way for RSEs, and other developers of software in academia, to ensure that they can receive credit for their work; likewise, it provides researchers with access to the necessary metadata for references to the software they use in their research. The Citation File Format follows the Software Citation Principles, and is compatible with the CodeMeta JSON-LD exchange format for software metadata.\",\"registry\":\"standard\",\"status\":\"ready\"},{\"id\":324,\"type\":\"terminology_artefact\",\"name\":\"NeuroMorpho.Org brain region ontologies\",\"homepage\":\"http://bioportal.bioontology.org/ontologies/NMOBR\",\"abbreviation\":\"NMOBR\",\"doi\":\"10.25504/FAIRsharing.9d08ks\",\"description\":\"The NeuroMorpho.Org brain region ontologies adopts and integrates relevant portions of available taxonomies (or lineages) \\\"as needed\\\" based on the existing knowledge that is openly accessible. For standardization purposes, cell types and other experimental metadata hierarchies are also added to OntoSearch v2.0. Concepts with insufficient knowledge are not classified as hierarchies, such as molecular, firing, and \\\"other\\\" unclassifiable properties of cell types. The species, brain regions and cell types are integrated into a single ontology for enabling OntoSearch functionality to mine NeuroMorpho.Org.\",\"registry\":\"standard\",\"status\":\"ready\"}]","contentType":"application/json","responseType":"SuccessTypeHintResponse","status":200}}},"testVariables":{"changed":true,"value":{"record_type":"reporting_guideline,model_and_format,terminology_artefact","registry":"standard","status":"ready"}},"variables":{"changed":true,"value":["registry","status","record_type"]}},"createdAt":"2025-11-25T12:17:38Z","entityUuid":"f3520558-707e-415a-8878-c7b8d6ccc2fb","parentUuid":"6f6241d9-136c-4770-9d58-8a3f39607052","uuid":"dc30269a-ebe3-43ba-a0bc-d905a3e35a0f"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"integrationUuid":{"changed":false},"questionType":"IntegrationQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"variables":{"changed":true,"value":{"record_type":"","registry":"Standard","status":"ready"}}},"createdAt":"2025-11-25T12:17:39Z","entityUuid":"2e5b1f82-4836-4b49-a0bf-2a2624eeaafb","parentUuid":"f09c417a-3b3d-4dc8-a1a2-93b1c4bcf8fd","uuid":"a7979329-42f9-4fab-949b-c06e43771dca"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"integrationUuid":{"changed":false},"questionType":"IntegrationQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"variables":{"changed":true,"value":{"record_type":"reporting_guideline,model_and_format,terminology_artefact","registry":"Standard","status":"ready"}}},"createdAt":"2025-11-25T12:17:40Z","entityUuid":"f0ca4f37-ef70-452e-b620-434d52fb5924","parentUuid":"e7b6cd51-22a6-4f7a-9ad5-a7234fa436cb","uuid":"67035bb9-6828-4331-97f9-44aec07db803"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"integrationUuid":{"changed":true,"value":"f3520558-707e-415a-8878-c7b8d6ccc2fb"},"questionType":"IntegrationQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"variables":{"changed":false}},"createdAt":"2025-11-25T12:17:41Z","entityUuid":"2e5b1f82-4836-4b49-a0bf-2a2624eeaafb","parentUuid":"f09c417a-3b3d-4dc8-a1a2-93b1c4bcf8fd","uuid":"99a51a50-6d08-48ea-9ae1-41a0f1882a22"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"integrationUuid":{"changed":true,"value":"f3520558-707e-415a-8878-c7b8d6ccc2fb"},"questionType":"IntegrationQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"variables":{"changed":false}},"createdAt":"2025-11-25T12:17:42Z","entityUuid":"f00cf643-5368-458a-97d4-b463c2000c66","parentUuid":"b08fe063-33f8-4380-b3a9-ba1e586dedf2","uuid":"67ac8627-1343-43d7-8e7a-8b3c18b56655"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"integrationUuid":{"changed":true,"value":"f3520558-707e-415a-8878-c7b8d6ccc2fb"},"questionType":"IntegrationQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"variables":{"changed":false}},"createdAt":"2025-11-25T12:17:43Z","entityUuid":"63ed4349-9743-4fd1-96df-73dbb7e4f05b","parentUuid":"a797cab9-0829-4787-a096-1b5cedc9147f","uuid":"386f4eb2-5ff6-450c-a524-2d4ca8c65034"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"integrationUuid":{"changed":true,"value":"f3520558-707e-415a-8878-c7b8d6ccc2fb"},"questionType":"IntegrationQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"variables":{"changed":false}},"createdAt":"2025-11-25T12:17:44Z","entityUuid":"9a7e42c3-eed2-46da-bf45-52acbf1eb50f","parentUuid":"2bac9020-99cf-4463-8d34-0b0eb2781cd1","uuid":"31b9e52a-81eb-4eaa-92c0-a6907000bace"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"integrationUuid":{"changed":true,"value":"f3520558-707e-415a-8878-c7b8d6ccc2fb"},"questionType":"IntegrationQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"variables":{"changed":false}},"createdAt":"2025-11-25T12:17:45Z","entityUuid":"221c322e-dff5-438f-8a2e-90e762681156","parentUuid":"1dc412c6-da92-4cc2-8639-316c0c6ec5ff","uuid":"83ebfae6-cff4-47d1-a9ab-332eae8280f0"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"integrationUuid":{"changed":true,"value":"f3520558-707e-415a-8878-c7b8d6ccc2fb"},"questionType":"IntegrationQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"variables":{"changed":false}},"createdAt":"2025-11-25T12:17:46Z","entityUuid":"371362c3-c2d1-419e-a7d6-b891a976a1fd","parentUuid":"d3886c3e-6cf7-4b3e-8bc7-307b47719871","uuid":"397f338c-ec7e-4ac8-b86f-bf634206704f"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"integrationUuid":{"changed":true,"value":"f3520558-707e-415a-8878-c7b8d6ccc2fb"},"questionType":"IntegrationQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"variables":{"changed":false}},"createdAt":"2025-11-25T12:17:47Z","entityUuid":"a41a57ef-ac45-4f82-96ec-bdb39f54d401","parentUuid":"48e497f3-4b84-4ccf-ba3b-96c8944b72ec","uuid":"996386a2-4b6d-4e6e-93dc-0f5738fe82c5"},{"content":{"eventType":"DeleteIntegrationEvent"},"createdAt":"2025-11-25T12:17:48Z","entityUuid":"aacf9099-8221-4b15-8425-fc356eb16d9b","parentUuid":"6f6241d9-136c-4770-9d58-8a3f39607052","uuid":"8e783506-35ee-438b-9851-3967cb38ddc6"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"integrationUuid":{"changed":false},"questionType":"IntegrationQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"variables":{"changed":true,"value":{"record_type":"reporting_guideline,model_and_format,terminology_artefact","registry":"Standard","status":"ready"}}},"createdAt":"2025-11-25T12:17:49Z","entityUuid":"2e5b1f82-4836-4b49-a0bf-2a2624eeaafb","parentUuid":"f09c417a-3b3d-4dc8-a1a2-93b1c4bcf8fd","uuid":"ac11fae8-8aff-4033-96d2-63c008cacb20"}],"forkOfPackageId":null,"id":"dsw:root:2.7.0","kmId":"root","language":"en","license":"Apache-2.0","mergeCheckpointPackageId":null,"metamodelVersion":20,"name":"Common DSW Knowledge Model","nonEditable":false,"organizationId":"dsw","phase":"ReleasedKnowledgeModelPackagePhase","previousPackageId":"dsw:root:2.6.13","readme":"# Common DSW Knowledge Model\n\nA general-purpose KM designed to guide researchers through key aspects of data management planning.\n\n## Contributors\n\n* **Rob Hooft** <[rob.hooft@health-ri.nl](mailto:rob.hooft@health-ri.nl)>\n  * ORCID: [0000-0001-6825-9439](https://orcid.org/0000-0001-6825-9439)\n  * GitHub: [@rwwh](https://github.com/rwwh)\n* **Marek Suchánek** <[marek.suchanek@ds-wizard.org](mailto:marek.suchanek@ds-wizard.org)>\n  * ORCID: [0000-0001-7525-9218](https://orcid.org/0000-0001-7525-9218)\n  * GitHub: [@MarekSuchanek](https://github.com/MarekSuchanek)\n* **Kryštof Komanec** <[krystof.komanec@ds-wizard.org](mailto:krystof.komanec@ds-wizard.org)>\n  * ORCID: [0000-0003-3856-1682](https://orcid.org/0000-0003-3856-1682)\n  * GitHub: [@krystofkomanec](https://github.com/krystofkomanec)\n* **Jana Martínková** <[jana.martinkova@ds-wizard.org](mailto:jana.martinkova@ds-wizard.org)>\n  * ORCID: [0000-0001-8575-6533](https://orcid.org/0000-0001-8575-6533)\n  * GitHub: [@jmartinkova](https://github.com/jmartinkova)\n\n## Acknowledgements\n\n* Several versions of this KM (between 2.3 and 2.5) were made during workshop with various participants as part of the ELIXIR-CONVERGE project\n* The initial knowledge model has been made based on a mindmap made by Rob Hooft: [Data Stewardship Mindmap](https://zenodo.org/record/3351949)\n\n## Changelog\n\n### 2.7.0\n*Released: 2025-12-18*\n\n* Added \"Other Outputs\" chapter\n* Updated ROR integration to include client ID\n* Updated FAIRsharing integration with record_type\n* Removed FAIRsharing integration for reused datasets name\n\n### 2.6.13\n*Released: 2025-10-06*\n\n* Updated integrations to metamodel version 18\n* Add links to [DMEG](https://dmeg.cessda.eu/)\n\n### 2.6.12\n*Released: 2025-08-04*\n\n* Update ROR integration to version 2\n\n### 2.6.11\n*Released: 2025-07-30*\n\n* Added \"maDMP\" tag to questions related to reusing non-reference datasets and addressing ethical issues\n* Included general-purpose repositories (e.g., Zenodo)\n* Updated ROR integration to reflect support for multiple organization badges\n\n### 2.6.10\n*Released: 2025-03-20*\n\n* Removed images from the Resource Pages in the Resource Collection *Data Stewardship for Open Science*\n* Added ORCID integration\n\n### 2.6.9\n*Released: 2025-01-20*\n\n* Add standard protocol and SW documentation\n* Add ORCID validation\n* Improve integrations (link in response)\n* Add \"Creator of DMP\" to roles\n\n### 2.6.8\n*Released: 2024-09-04*\n\n* Added resource collection *Data Stewardship for Open Science*\n\n### 2.6.7\n*Released*: 2024-07-03\n\n* Updated tags for questions to be added to the following templates: Science Europe, Horizon Europe, Horizon 2020 and maDMP.\n\n### 2.6.6\n*Released*: 2024-05-17\n\n* Incorporate minor change in name conventions for versions (from option question to multichoice question)\n* Add project number\n* Add part for access of personal data\n* Incorporate minor change in indicating what data will be destroyed\n* Add part listing dedicated finances\n\n### 2.6.5\n*Released*: 2024-05-02\n\n* Incorporating change in domain repository example (EBI)\n\n### 2.6.4\n*Released*: 2024-03-25\n\n* Fixed ROR integration items with multiple acronyms would be displayed joined as one.\n\n### 2.6.3\n*Released*: 2023-08-29\n\n* Adapted changed links in RDMkit. To be published synchonously with RDMkit release.\n\n### 2.6.2\n\n*Released*: 2023-07-28\n\n* Fixed tags for document templates\n\n### 2.6.1\n\n*Released*: 2023-07-25\n\n* Fixed tags for ethics questions in Horizon Europe, Horizon 2020 and Science Europe templates\n\n### 2.6.0\n\n*Released*: 2023-06-28\n\n* Add phase descriptions\n* Improve integrations (item templates)\n* Add references to [FAIR Cookbook](https://faircookbook.elixir-europe.org/)\n* ELSI tag and relate questions\n\n### 2.5.0\n\n*Released*: 2023-06-28\n\n* Incorporation changes/restructuring of questions related to human data \n\n### 2.4.5\n\n*Released*: 2023-01-27\n\n* Minor textual changes\n\n### 2.4.4\n\n*Released*: 2022-09-22\n\n* Fix duplicated *Horizon Europe DMP* tags for several questions\n\n### 2.4.3\n\n*Released*: 2022-09-22\n\n* Use of new value-question types (mostly email and URL)\n* New references\n\n### 2.4.2\n\n*Released*: 2022-06-15\n\n* Changes from workshops together with RDMkit on Toxicology, Biomolecular Simulations and    \n   Epitranscriptomics\n  - Small changes to phrasing and clarifications in various locations\n  - New guidance hierarchies added to locate existing data, standards and terminologies\n  - Moved \"provenance\" questions into the rest of the \"metadata\" group\n  - Added guidance summarising how to avoid problems with large amounts of intermediate data\n\n### 2.4.1\n\n*Released*: 2022-04-09\n\n* Fixed several minor typos (missing end of sentence, misspelling, typography etc.)\n\n### 2.4.0\n\n*Released*: 2022-03-15\n\n* KM verified and tested with the **Horizon Europe DMP template**\n\n### 2.3.14\n\n*Released*: 2022-03-10\n\n* Tags for Horizon Europe template generated\n\n### 2.3.13\n\n*Released*: 2022-03-08\n\n* Incorporating changes related to the Data Reuse workshop with RDMkit\n\n### 2.3.12\n\n*Released*: 2022-02-15\n\n* Incorporating changes related to the Data Analytics workshop with RDMkit\n\n### 2.3.11\n\n*Released*: 2022-02-15\n\n* Incorporating changes made in the Plant Sciences workshop with RDMkit\n\n### 2.3.10\n\n*Released*: 2022-02-03\n\n* Added references and questions from an RDMkit/DS Wizard working session on Preserving Data\n\n### 2.3.9\n\n*Released*: 2022-01-27\n\n* Fix missing Yes/No answers and use Text-Value for description of policies\n\n### 2.3.8\n\n*Released*: 2022-01-14\n\n* Questions for Horizon Europe added on budget for data management, other policies that are observed, persistent identifier allocation and archive preservation policies [Marek/Jana Horizon Europe issues 7-9, 11]\n\n### 2.3.7\n\n*Released*: 2022-01-11\n\n* Added references and questions from an RDMkit/DS Wizard working session on Human Data\n\n### 2.3.6\n\n*Released*: 2022-01-10\n\n* Questions about metadata for Horizon Europe added [Marek/Jana Horizon Europe issues 4-6]\n\n### 2.3.5\n\n*Released*: 2022-01-10\n\n* Added Tag for Horizon Europe\n* Moved the new questions from 2.3.4 from \"Science Europe\" to \"Horizon Europe\"\n* Added new question about qualified references from published data sets [Marek/Jana Horizon Europe issue 3]\n\n### 2.3.4\n\n*Released*: 2022-01-10\n\n* Change lists of reused (non-)reference datasets that are reused into lists of considered datasets, and add a question for each detailing whether they are actually reused and what for / why not. This is to be included in the Science Europe template [Marek/Jana Horizon Europe issue 1 and 2].\n\n### 2.3.3\n\n*Released*: 2021-12-14\n\n* Incorporation of changes from a collaborative workshop with RDMkit participants on data processing.\n   * Added links to RDMkit (and some to other external resources) in several places\n   * Clarified some questions\n   * Added question on data versioning for filesystems\n\n### 2.3.2\n\n*Released*: 2021-11-30\n\n* Incorporation of changes from a workshop with the authors of the RDMkit page on data collecting.\n   * Added links to RDMkit in several places\n   * Clarified some questions\n   * Moved questions on quality together\n   * Moved some questions out of the metadata subsection\n\n### 2.3.1\n\n*Released*: 2021-11-02\n\n* Incorporation of changes from a workshop with the authors of the RDMkit page on data sharing.\n    * Attempt to clarify difference between \"open\" and \"accessible\"\n    * Attempt to clarify difference between \"open\" and \"embargoed\"\n    * Added links to RDMkit Data Sharing page in a few places\n    * Added a few relevant questions\n\n### 2.3.0\n\n*Released*: 2020-11-11\n\nActivity during [BioHackathon Europe](biohackathon-europe.org) 2020 ([#BioHackEU20](twitter.com/search?q=%23BioHackEU20))\n\n* Added and tagged questions for Horizon 2020 template\n* Moved questions about collecting metadata to one consistent place\n* Added guidance on semantics in file names and question about using PIDs for identifying files\n* Generic small cleanups and typo fixes\n* Closing many issues of feedback received on the knowledge model (from [DSWGlobal/dsw](https://github.com/DSWGlobal/dsw))\n* Various question updates new options, clarifications, integrations\n* Added highly configurable [Wikidata](https://www.wikidata.org) SPARQL-based integration\n* Added [Research Organization Registry](https://ror.org) integration for contributor's affiliation\n\n### 2.2.0\n\n*Released*: 2020-07-01\n\n* Adjusted for compatibility with [RDA DMP Common Standard for machine-actionable DMPs (1.0)](https://github.com/RDA-DMP-Common/RDA-DMP-Common-Standard)\n  * Updated *Project* and *Funding* questions in *Administrative Details* chapter\n  * Reorganised *Dataset*, *Distribution*, *License* questions in *Data Publishing* chapter\n* Added *maDMP* tag to questions used in the RDA maDMP template\n\n### 2.1.0\n\n*Released*: 2020-05-09\n\n* Added *Science Europe DMP* tag to questions used in the Science Europe template\n\n### 2.0.2\n\n*Released*: 2020-05-09\n\n* Fixed missing and duplicated questions\n\n### 2.0.1\n\n*Released*: 2020-03-24\n\n* Fixed duplicated question in *Creating and collecting data* chapter (5ba53879-eb48-47f2-a73b-f7f7d83bf030)\n\n### 2.0.0\n\n*Released*: 2020-01-04\n\n* Added detailed questions for Science Europe DMPs\n* Fixed several typos and other minor problems\n* Added administrative chapter\n* Moving questions and refactoring according to [ds-km#24](https://github.com/ds-wizard/ds-km/pull/24)\n\n### 1.4.0\n\n*Released*: 2019-06-11\n\n* Adding integration for [FAIRsharing.org](https://fairsharing.org)\n* Adding 5 integration questions according to [ds-km@da5a8fc](https://github.com/ds-wizard/ds-km/commit/da5a8fc95d0a67f9369ce0b7727615115fc3656d)\n\nThe FAIRsharing integration requires configuration to contain `apiUrl` and `apiKey` for integration with id `fairsharing`.\n\n### 1.3.0\n\n*Released*: 2019-06-10\n\n* Refactoring list questions because of **deprecated item title** fields, i.e., a new question for item title created for each list question\n\nWhen using this version and higher, the DS Wizard configuration should have `itemTitleEnabled` set to `false`.\n\n### 1.2.0\n\n*Released*: 2019-06-09\n\n* Adding file naming SOP description question (9ff389f0-2236-48cf-880c-040ea1bb0d2f) to chapter 2 according to [ds-km@d879be0](https://github.com/ds-wizard/ds-km/commit/d879be0fa9d0808868396c649d03c4d783ac6742)\n\n### 1.1.0\n\n*Released*: 2019-06-09\n\n* Adding phases to questions (first draft) according to [ds-km@a6713d1](https://github.com/ds-wizard/ds-km/commit/a6713d1a4b9758bea63b3f7c56af5bd4f500d949) and [ds-km@1123211](https://github.com/ds-wizard/ds-km/commit/1123211bb5af43df8ef435039a2923f48e3e981c)\n\nPrior to this version, all questions were assigned with phase 2 - *Before submitting the DMP*.\n\n### 1.0.3\n\n*Released*: 2019-06-09\n\n* Fix: Removing extra question mark for a question (8018e15f-6c7e-433a-8686-ae0d695c7fc7) in chapter 5 according to: [ds-km@1123211](https://github.com/ds-wizard/ds-km/commit/1123211bb5af43df8ef435039a2923f48e3e981c)\n\n### 1.0.2\n\n*Released*: 2019-06-09\n\n* Fix: Adding some explanation to the list item questions (f5fef09d-ade5-4019-b089-f05bd89c34bc and b642c31d-a512-4ca7-8743-a2e0254006fa) in chapter 3 according to: [ds-km@96e28f4](https://github.com/ds-wizard/ds-km/commit/96e28f478d5dc6b59d384b5127f012dc2fe5f287)\n\n### 1.0.1\n\n*Released*: 2019-06-09\n\n* Fix: Adding forgotten question mark to end of question (39e0cc7c-17fe-4991-88d8-1280c3fe7923) in chapter 1 according to: [ds-km@644a373](https://github.com/ds-wizard/ds-km/commit/644a373685dc4ac15b76e86667a90151ca9c70ca)\n\n### 1.0.0\n\n*Released*: 2018-10-01\n\n* Initial version transformed from the previous DS-KM GitHub repository up to [ds-km@8442837](https://github.com/ds-wizard/ds-km/commit/8442837dbe3ff899b09e7d8d3fc1107e935a876f)\n\n## Configuring External Integrations\n\nTo configure external integrations properly, please refer to the [DSW Guide - Knowledge Model Secrets](https://guide.ds-wizard.org/en/latest/application/knowledge-models/secrets.html#knowledge-model-secrets). The guide provides detailed instructions on setting up secrets required for successful integration.\n\nWhen configuring the integration for **FAIRsharing**, ensure it is set up as follows:\n\n```\nfairsharingApiUrl: https://fairsharing4dsw.ds-wizard.org\nfairsharingApiKey: [BASE64 username:password (basic auth)]\n```\nWhen configuring the integration for **ROR**, ensure it is set up as follows:\n\n```\nrorApiClientID: [client ID]\n```\n\nTo obtain client ID, register [here](https://ror.org/api-client-id).","version":"2.7.0"}],"version":"2.7.0"}