"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["fd4637a2-a117-460a-a7fa-c03760c42629"]},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2020-05-09T12:09:31Z","entityUuid":"43370b85-0ee0-4f0f-b7de-9b04a54a2480","parentUuid":"0cfc22ec-5551-4a37-84ec-308c85440af5","uuid":"40b731d8-e470-4e3b-8843-23106b9a95dd"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["fd4637a2-a117-460a-a7fa-c03760c42629"]},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2020-05-09T12:09:32Z","entityUuid":"c10f9098-5b1c-4abc-adaa-bdef2fb537ca","parentUuid":"b3739ebd-2d8e-42d3-9425-a7d6d1b26c79","uuid":"3b325bef-441d-436e-a281-ebd7c659924e"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["fd4637a2-a117-460a-a7fa-c03760c42629"]},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2020-05-09T12:09:33Z","entityUuid":"b289fdcc-aedc-496e-8169-e0bbe2346d1f","parentUuid":"2b755a90-8a43-41c0-9020-5e2b9ca8f88e","uuid":"b4772abb-200a-48ed-8454-08bc5b76da26"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["fd4637a2-a117-460a-a7fa-c03760c42629"]},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2020-05-09T12:09:34Z","entityUuid":"f5c12fcf-15d0-44ba-a53c-49ea9d7f620f","parentUuid":"b3739ebd-2d8e-42d3-9425-a7d6d1b26c79","uuid":"ad883449-d557-4873-a208-488d264cc2fa"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["fd4637a2-a117-460a-a7fa-c03760c42629"]},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2020-05-09T12:09:35Z","entityUuid":"99a48a1a-5c27-4e15-9da0-515da815b4b8","parentUuid":"1b120967-803b-458b-b565-dbee6a785509","uuid":"3d422cea-233e-4425-aadb-bd08f32057c3"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["fd4637a2-a117-460a-a7fa-c03760c42629"]},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2020-05-09T12:09:36Z","entityUuid":"f5c12fcf-15d0-44ba-a53c-49ea9d7f620f","parentUuid":"b3739ebd-2d8e-42d3-9425-a7d6d1b26c79","uuid":"975d5c2b-ab4c-422d-a57d-b2a53f793318"}],"forkOfPackageId":null,"id":"dsw:root:2.1.0","kmId":"root","language":"en","license":"Apache-2.0","mergeCheckpointPackageId":null,"metamodelVersion":20,"name":"Common DSW Knowledge Model","nonEditable":false,"organizationId":"dsw","phase":"DeprecatedKnowledgeModelPackagePhase","previousPackageId":"dsw:root:2.0.2","readme":"# Common DSW Knowledge Model\n\nCommon DSW Knowledge Model deals with questions that a researcher should answer in order to create a Data Stewardship Plan, as well as other related questionnaire data. It originated from mindmap made by Rob Hooft.\n\n## Changelog\n\n### 2.1.0\n\n* Added *Science Europe DMP* tag to questions used in the Science Europe template\n\n### 2.0.2\n\n* Fixed missing and duplicated questions\n\n### 2.0.1\n\n* Fixed duplicated question in *Creating and collecting data* chapter (5ba53879-eb48-47f2-a73b-f7f7d83bf030)\n\n### 2.0.0\n\n* Added detailed questions for Science Europe DMPs\n* Fixed several typos and other minor problems\n* Added administrative chapter\n* Moving questions and refactoring according to [ds-km#24](https://github.com/ds-wizard/ds-km/pull/24)\n\n### 1.4.0\n\n* Adding integration for [FAIRsharing.org](https://fairsharing.org)\n* Adding 5 integration questions according to [ds-km@da5a8fc](https://github.com/ds-wizard/ds-km/commit/da5a8fc95d0a67f9369ce0b7727615115fc3656d)\n\nThe FAIRsharing integration requires configuration to contain `apiUrl` and `apiKey` for integration with id `fairsharing`.\n\n### 1.3.0\n\n* Refactoring list questions because of **deprecated item title** fields, i.e., a new question for item title created for each list question\n\nWhen using this version and higher, the DS Wizard configuration should have `itemTitleEnabled` set to `false`.\n\n### 1.2.0\n\n* Adding file naming SOP description question (9ff389f0-2236-48cf-880c-040ea1bb0d2f) to chapter 2 according to [ds-km@d879be0](https://github.com/ds-wizard/ds-km/commit/d879be0fa9d0808868396c649d03c4d783ac6742)\n\n### 1.1.0\n\n* Adding phases to questions (first draft) according to [ds-km@a6713d1](https://github.com/ds-wizard/ds-km/commit/a6713d1a4b9758bea63b3f7c56af5bd4f500d949) and [ds-km@1123211](https://github.com/ds-wizard/ds-km/commit/1123211bb5af43df8ef435039a2923f48e3e981c)\n\nPrior to this version, all questions were assigned with phase 2 - *Before submitting the DMP*. \n\n### 1.0.3\n\n* Fix: Removing extra question mark for a question (8018e15f-6c7e-433a-8686-ae0d695c7fc7) in chapter 5 according to: [ds-km@1123211](https://github.com/ds-wizard/ds-km/commit/1123211bb5af43df8ef435039a2923f48e3e981c)\n\n### 1.0.2\n\n* Fix: Adding some explanation to the list item questions (f5fef09d-ade5-4019-b089-f05bd89c34bc and b642c31d-a512-4ca7-8743-a2e0254006fa) in chapter 3 according to: [ds-km@96e28f4](https://github.com/ds-wizard/ds-km/commit/96e28f478d5dc6b59d384b5127f012dc2fe5f287)\n\n### 1.0.1\n\n* Fix: Adding forgotten question mark to end of question (39e0cc7c-17fe-4991-88d8-1280c3fe7923) in chapter 1 according to: [ds-km@644a373](https://github.com/ds-wizard/ds-km/commit/644a373685dc4ac15b76e86667a90151ca9c70ca)\n\n### 1.0.0\n\n* Initial version transformed from the previous DS-KM GitHub repository up to [ds-km@8442837](https://github.com/ds-wizard/ds-km/commit/8442837dbe3ff899b09e7d8d3fc1107e935a876f)","version":"2.1.0"},{"createdAt":"2020-07-01T10:27:01.884Z","description":"DSW Knowledge Model originated from mindmap made by Rob Hooft","events":[{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"ListQuestion","requiredPhaseUuid":"b101f2d0-2476-452d-aa8d-95a41a02b52c","tagUuids":[],"text":null,"title":"Name the project(s) that are you will be working on and for which the data and work are described in this DMP"},"createdAt":"2020-07-01T10:27:02Z","entityUuid":"c3dabaaf-c946-4a0d-889c-ede966f97667","parentUuid":"1e85da40-bbfc-4180-903e-6c569ed2da38","uuid":"18ea223a-96d5-4c99-ae3a-7c82fe46c900"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Name the project(s) that are you will be working on and for which the data and work are described in this DMP. Give each project a small identifying name for yourself."},"title":{"changed":true,"value":"Project"}},"createdAt":"2020-07-01T10:27:03Z","entityUuid":"c3dabaaf-c946-4a0d-889c-ede966f97667","parentUuid":"1e85da40-bbfc-4180-903e-6c569ed2da38","uuid":"299f0d48-4b15-4d61-9e76-eafbdc159742"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Add each of the project(s) that are you will be working on and for which the data and work are described in this DMP. Give each project a small identifying name for yourself."},"title":{"changed":false}},"createdAt":"2020-07-01T10:27:04Z","entityUuid":"c3dabaaf-c946-4a0d-889c-ede966f97667","parentUuid":"1e85da40-bbfc-4180-903e-6c569ed2da38","uuid":"dfb57831-df6c-485f-85f1-976fbcc4769d"},{"content":{"eventType":"MoveQuestionEvent","targetUuid":"c3dabaaf-c946-4a0d-889c-ede966f97667"},"createdAt":"2020-07-01T10:27:05Z","entityUuid":"f0ef08fd-d733-465c-bc66-5de0b826c41b","parentUuid":"1e85da40-bbfc-4180-903e-6c569ed2da38","uuid":"43512c9b-000f-47c7-87a7-226730e82c47"},{"content":{"eventType":"MoveQuestionEvent","targetUuid":"c3dabaaf-c946-4a0d-889c-ede966f97667"},"createdAt":"2020-07-01T10:27:06Z","entityUuid":"22583d74-3c98-4e0a-b363-26d767c88212","parentUuid":"1e85da40-bbfc-4180-903e-6c569ed2da38","uuid":"118f0a2f-5f14-4157-8521-117cfa88bf97"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"ListQuestion","requiredPhaseUuid":"b101f2d0-2476-452d-aa8d-95a41a02b52c","tagUuids":["fd4637a2-a117-460a-a7fa-c03760c42629"],"text":"Add all the funders that are funding part of this project.","title":"Funder"},"createdAt":"2020-07-01T10:27:07Z","entityUuid":"36a87eac-402d-43fb-a0df-ac5963bdf87d","parentUuid":"c3dabaaf-c946-4a0d-889c-ede966f97667","uuid":"801ba26d-a240-41e7-a85b-eebd6a469cf4"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{