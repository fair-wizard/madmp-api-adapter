Uuid":"8a56768a-5c5a-44c0-b21c-46a231fbf6be","uuid":"773154de-fafb-4474-b22e-fe9ea55d3c99"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[]},"createdAt":"2018-10-01T00:15:18Z","entityUuid":"6fd34203-6217-4c1b-a706-c5fa155ea706","parentUuid":"754148c2-6019-4318-8d44-d73becc989f4","uuid":"638e13b7-9b83-4428-9fc7-29899bdd71ac"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes, they must stay in the EU","metricMeasures":[]},"createdAt":"2018-10-01T00:15:19Z","entityUuid":"2f0e4c16-be62-4836-aa0e-b52fd9132ac7","parentUuid":"754148c2-6019-4318-8d44-d73becc989f4","uuid":"08ba3754-bcbe-41d3-8e60-5e1d5bffe835"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes, they must stay in the same country","metricMeasures":[]},"createdAt":"2018-10-01T00:15:20Z","entityUuid":"00bddac1-2375-4554-bb3c-27b261cc22e7","parentUuid":"754148c2-6019-4318-8d44-d73becc989f4","uuid":"eddff4b2-c48a-4e92-bf7b-2c297163a66b"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes, they must stay in the same institute","metricMeasures":[]},"createdAt":"2018-10-01T00:15:21Z","entityUuid":"f6adfe7d-45f5-41a4-ba48-e43cc131c824","parentUuid":"754148c2-6019-4318-8d44-d73becc989f4","uuid":"8920dd08-adc8-45ed-98e8-f57280a894cd"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":"Legally, pseudonymous data (which means that someone has the key to reverse the process) is still considered privacy sensitive information. However, the EU is working on special cases where the data can still be opened as long as the key availability is sufficiently limited.","title":"Could pseudonymization be used to make the data more openly available?"},"createdAt":"2018-10-01T00:15:22Z","entityUuid":"a25b30f4-2d0f-4132-9b8e-0950f0b0ed66","parentUuid":"8a56768a-5c5a-44c0-b21c-46a231fbf6be","uuid":"0550e0b9-1eef-46c5-8322-4a32739b1473"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[]},"createdAt":"2018-10-01T00:15:23Z","entityUuid":"5edeab6e-81a9-4209-b063-8d6fca55a388","parentUuid":"a25b30f4-2d0f-4132-9b8e-0950f0b0ed66","uuid":"5a791d04-703b-4521-a8d3-b5f25765bf7f"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[]},"createdAt":"2018-10-01T00:15:24Z","entityUuid":"49f268a6-9566-4aa4-bec3-44fec2e64548","parentUuid":"a25b30f4-2d0f-4132-9b8e-0950f0b0ed66","uuid":"5df2f2ca-2695-4f8f-89ec-aa7aaf4ebc3c"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":"Making use of the same pseudonymization for different studies makes it possible to integrate information later. Obviously it also raises the risk of re-identification","title":"Can you make use of an existing 'trusted third party' for pseudonymization?"},"createdAt":"2018-10-01T00:15:25Z","entityUuid":"5db6bd58-5d1d-4d02-9497-972cbef64c16","parentUuid":"49f268a6-9566-4aa4-bec3-44fec2e64548","uuid":"913af28f-5559-4731-8fbf-2e80dbef4985"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[{"measure":0,"metricUuid":"cc02c5a0-9754-4432-a7e0-ce0f3cf7a0a0","weight":1}]},"createdAt":"2018-10-01T00:15:26Z","entityUuid":"40be8b9d-0e4d-400f-a982-c0b53bc64b61","parentUuid":"5db6bd58-5d1d-4d02-9497-972cbef64c16","uuid":"9afa2585-1570-4220-80db-8752b3bd9179"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[{"measure":1,"metricUuid":"cc02c5a0-9754-4432-a7e0-ce0f3cf7a0a0","weight":1}]},"createdAt":"2018-10-01T00:15:27Z","entityUuid":"041db1a8-e263-4df0-aea6-337063008b37","parentUuid":"5db6bd58-5d1d-4d02-9497-972cbef64c16","uuid":"75c87f3b-e69a-48de-a01c-99d43983ccb4"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":"Different anonymization techniques exist. Disadvantage of anonymization is that data integration becomes virtually impossible, but it may be the only way to open up your data for other research","title":"Could anonymization be used to make the data more openly available?"},"createdAt":"2018-10-01T00:15:28Z","entityUuid":"15ee1921-1fea-4f22-b462-b3cf7cdd4646","parentUuid":"8a56768a-5c5a-44c0-b21c-46a231fbf6be","uuid":"8133fdc2-fdc7-4e89-aecc-0b711c941900"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[]},"createdAt":"2018-10-01T00:15:29Z","entityUuid":"324dc2d9-df7f-4849-a5c0-91ecf2ef2dbd","parentUuid":"15ee1921-1fea-4f22-b462-b3cf7cdd4646","uuid":"ff5f1c88-887f-436d-bb07-76984e6811b7"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[]},"createdAt":"2018-10-01T00:15:30Z","entityUuid":"c0d7df59-0cf2-4ff1-9dd0-a2f2dd5bed91","parentUuid":"15ee1921-1fea-4f22-b462-b3cf7cdd4646","uuid":"bcb33cd0-e295-48d9-a0d1-e5d2742203f1"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":"Aggregated data, where typically at least 15 individuals are in any data point, are considered sufficiently anonymous. This is an alternative way of making data openly available for future research","title":"Could you use data aggregation to make the data openly available?"},"createdAt":"2018-10-01T00:15:31Z","entityUuid":"69be6695-152b-48ba-a1fd-6662476e39b7","parentUuid":"8a56768a-5c5a-44c0-b21c-46a231fbf6be","uuid":"2df0a5b3-4579-4446-b91f-762989c73703"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[]},"createdAt":"2018-10-01T00:15:32Z","entityUuid":"94811bac-3a00-40cd-acdf-638cd79845a8","parentUuid":"69be6695-152b-48ba-a1fd-6662476e39b7","uuid":"3dd5c11d-3405-4217-bee6-f427a306f4bf"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[]},"createdAt":"2018-10-01T00:15:33Z","entityUuid":"1c1c557c-ef6c-44ff-b618-c1cfe3543057","parentUuid":"69be6695-152b-48ba-a1fd-6662476e39b7","uuid":"1531d1e6-3c8b-4c5c-8946-26d3b6ac4f0c"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":null,"title":"Are there IP reasons why your data can not be open?"},"createdAt":"2018-10-01T00:15:34Z","entityUuid":"a18d79d2-74b1-4524-a3c7-2c1a87b66a75","parentUuid":"aac95530-2978-4759-803b-64721533faf0","uuid":"4a42c54b-dc9a-4c84-89dc-7d6b642f6ef9"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[]},"createdAt":"2018-10-01T00:15:35Z","entityUuid":"cad24d70-f9b5-4159-b352-2f91dbc92ac5","parentUuid":"a18d79d2-74b1-4524-a3c7-2c1a87b66a75","uuid":"fd35ca66-dfba-45b5-b58f-5490a3528fb8"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[]},"createdAt":"2018-10-01T00:15:36Z","entityUuid":"2ffa365d-83f6-4adb-bcc6-377fec82a297","parentUuid":"a18d79d2-74b1-4524-a3c7-2c1a87b66a75","uuid":"0743e29a-751b-42bf-b654-c2de0c2b2828"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":null,"title":"Is it clear who owns data and documents?"},"createdAt":"2018-10-01T00:15:37Z","entityUuid":"b4f9916a-c846-49ff-bfd2-f5d1346de553","parentUuid":"2ffa365d-83f6-4adb-bcc6-377fec82a297","uuid":"d58b9a80-23c9-4bd8-9b9b-90ae31a5e8a8"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[{"measure":0,"metricUuid":"8845fe2b-79df-4138-baea-3a035bf5e249","weight":1}]},"createdAt":"2018-10-01T00:15:38Z","entityUuid":"3de2edc2-c05f-49a7-8d1b-699cdaa98350","parentUuid":"b4f9916a-c846-49ff-bfd2-f5d1346de553","uuid":"9984efb2-27c8-43df-ae0f-5b980c4d9ce4"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[{"measure":1,"metricUuid":"8845fe2b-79df-4138-baea-3a035bf5e249","weight":1}]},"createdAt":"2018-10-01T00:15:39Z","entityUuid":"fc008273-7382-422b-8735-1b75dfb5ba4c","parentUuid":"b4f9916a-c846-49ff-bfd2-f5d1346de553","uuid":"d055b6a0-7313-4a24-8c64-260850e70641"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":"In one case in the past, all documents that had been assembled by a project in a documentation system had to be deleted because not a single person could decide to move them to a new platform when the documentation system was going off-line.","title":"Will someone be given decision power to move documents or data to a new place after the project has finished?"},"createdAt":"2018-10-01T00:15:40Z","entityUuid":"c9ed4379-19e2-4ce3-8962-5c2fca69b6cd","parentUuid":"2ffa365d-83f6-4adb-bcc6-377fec82a297","uuid":"28d3b97c-df7b-4b20-83c6-61156e439e25"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[{"measure":0,"metricUuid":"0feac7e6-add4-4723-abae-be5ce7864c63","weight":1}]},"createdAt":"2018-10-01T00:15:41Z","entityUuid":"46f96ea2-3a3c-43d1-b6a2-394a49034ae2","parentUuid":"c9ed4379-19e2-4ce3-8962-5c2fca69b6cd","uuid":"d0b658b5-4d00-471d-8b9e-7278530636eb"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[{"measure":1,"metricUuid":"0feac7e6-add4-4723-abae-be5ce7864c63","weight":1}]},"createdAt":"2018-10-01T00:15:42Z","entityUuid":"8eff4cfd-65c1-435f-b27c-e805b3d72c5c","parentUuid":"