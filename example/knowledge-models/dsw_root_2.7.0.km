-ff5c-45da-97a8-169ad8c39be6","uuid":"e4463d0d-c2d5-4b9e-ad99-62d767d38234"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2022-02-03T09:21:00Z","entityUuid":"f733a466-0a9f-44ce-a3e9-69573246be41","parentUuid":"d4e6a244-07fb-4573-b93f-c20a9409ac7c","uuid":"75254bd3-d5cb-4854-a062-35195039db21"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"RDMkit on Storage"},"referenceType":"URLReference","url":{"changed":true,"value":"https://rdmkit.elixir-europe.org/storage.html"}},"createdAt":"2022-02-03T09:21:01Z","entityUuid":"f733a466-0a9f-44ce-a3e9-69573246be41","parentUuid":"d4e6a244-07fb-4573-b93f-c20a9409ac7c","uuid":"8ecf527c-00c7-46e2-9e67-e4c1c2e6d9f7"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2022-02-03T09:21:02Z","entityUuid":"a82f95f5-9f70-472a-acfb-613177cd8429","parentUuid":"3b3fbcc6-c405-4151-8dce-e11dbd46b1bd","uuid":"c678b982-dbc7-4f71-a7aa-fef7a6b91436"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"RDMkit on Documentation and Metadata"},"referenceType":"URLReference","url":{"changed":true,"value":"https://rdmkit.elixir-europe.org/metadata_management.html#how-do-you-find-appropriate-standard-metadata-for-datasets-or-samples"}},"createdAt":"2022-02-03T09:21:03Z","entityUuid":"a82f95f5-9f70-472a-acfb-613177cd8429","parentUuid":"3b3fbcc6-c405-4151-8dce-e11dbd46b1bd","uuid":"29928fab-d0b7-4bac-ad09-6968f4120a24"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Will you publish the data set somewhere? Will it be findable for other people, even if not the whole world? What is not meant here is a paper about the interpretation of the data, but the data itself.\n\nNote that this does not necessarily mean that the data set becomes openly available, conditions for access and use may apply. "},"title":{"changed":false}},"createdAt":"2022-02-03T09:21:04Z","entityUuid":"a063da1c-aaea-4e18-85ec-f560d833f292","parentUuid":"4e0c1edf-660c-4ebf-81f5-9fa959dead30","uuid":"56550a0f-8051-4439-bbcd-e36218e052a3"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2022-02-03T09:21:05Z","entityUuid":"7ffcfc57-b4ad-4638-ab19-11fe57b841a0","parentUuid":"4e0c1edf-660c-4ebf-81f5-9fa959dead30","uuid":"ad5920f8-06ae-435a-a30b-78f0dd4f82be"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":true,"value":["b0949d09-d179-4491-9fb4-14b0deb9f862","205a886d-83d7-4359-ae63-7103e05357c3","3a8ed3fc-b1a6-4119-80ed-238804861734","cf727a0a-78c4-45a7-aa9b-cf7650ae873a","7ffcfc57-b4ad-4638-ab19-11fe57b841a0","a063da1c-aaea-4e18-85ec-f560d833f292","d4e6a244-07fb-4573-b93f-c20a9409ac7c","3b3fbcc6-c405-4151-8dce-e11dbd46b1bd","a1d76760-053c-4706-80a2-cfb6c6a061f3","cc95b399-7d8d-4232-bccf-686f78c91bff"]},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2022-02-03T09:21:06Z","entityUuid":"4e0c1edf-660c-4ebf-81f5-9fa959dead30","parentUuid":"d5b27482-b598-4b8c-b534-417d4ad27394","uuid":"feca6e2e-a1a0-4db8-b634-944eaa53aa6e"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Archival is a form of preservation that does not make the data findable for anyone else. It is a very good idea to at least archive those datasets that will not be published.\n\nNote that details about archiving considerations will come in questions below."},"title":{"changed":true,"value":"Wil"}},"createdAt":"2022-02-03T09:21:07Z","entityUuid":"7ffcfc57-b4ad-4638-ab19-11fe57b841a0","parentUuid":"4e0c1edf-660c-4ebf-81f5-9fa959dead30","uuid":"1e08ace5-7f48-4b4d-8bfd-edd860d15124"},{"content":{"eventType":"DeleteQuestionEvent"},"createdAt":"2022-02-03T09:21:08Z","entityUuid":"a84cdefc-8c41-4949-9353-5916532ad50c","parentUuid":"d5b27482-b598-4b8c-b534-417d4ad27394","uuid":"6e74c46d-a641-488e-bf6f-f76dbf594ddb"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-02-03T09:21:09Z","entityUuid":"f040fdff-e9d4-4777-a482-af584fd7b3ba","parentUuid":"2a34dbf7-3a9e-446e-9dfd-695903bd2a07","uuid":"8e17b4b0-bff3-4c36-bb9d-92a7e893e670"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":true,"value":["deff3d55-a7bb-426e-94e7-8b6d46a27f8e","309ee279-cd5a-47dd-ad11-7b111d0ac1ff","cf378a0e-9efe-4221-a7a7-c0631fd71c3e","f9bd9b58-c400-4a0f-b66f-0ce991e0e3e2","f040fdff-e9d4-4777-a482-af584fd7b3ba","9af201fa-bf32-4e44-b44d-efea6f69d631"]},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2022-02-03T09:21:10Z","entityUuid":"2a34dbf7-3a9e-446e-9dfd-695903bd2a07","parentUuid":"771279ea-3ffe-4d22-aeb4-8d656a77c25c","uuid":"3192444d-f8bd-422c-90eb-145cf546a700"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":true,"value":["deff3d55-a7bb-426e-94e7-8b6d46a27f8e","309ee279-cd5a-47dd-ad11-7b111d0ac1ff","cf378a0e-9efe-4221-a7a7-c0631fd71c3e","f040fdff-e9d4-4777-a482-af584fd7b3ba","f9bd9b58-c400-4a0f-b66f-0ce991e0e3e2","9af201fa-bf32-4e44-b44d-efea6f69d631"]},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2022-02-03T09:21:11Z","entityUuid":"2a34dbf7-3a9e-446e-9dfd-695903bd2a07","parentUuid":"771279ea-3ffe-4d22-aeb4-8d656a77c25c","uuid":"b00dd5b6-317f-476c-9b1e-9fdf83d3d59e"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-02-03T09:21:12Z","entityUuid":"c0b6d52a-2fde-4e3f-835f-e49fffc67ccb","parentUuid":"2a34dbf7-3a9e-446e-9dfd-695903bd2a07","uuid":"8040fd7b-8d5e-4a0b-9a1c-2f00ff738294"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"It is too expensive"},"metricMeasures":{"changed":false}},"createdAt":"2022-02-03T09:21:13Z","entityUuid":"c0b6d52a-2fde-4e3f-835f-e49fffc67ccb","parentUuid":"2a34dbf7-3a9e-446e-9dfd-695903bd2a07","uuid":"0f7104d0-3a91-4238-9a45-db2154dd09d5"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":true,"value":["deff3d55-a7bb-426e-94e7-8b6d46a27f8e","309ee279-cd5a-47dd-ad11-7b111d0ac1ff","cf378a0e-9efe-4221-a7a7-c0631fd71c3e","f040fdff-e9d4-4777-a482-af584fd7b3ba","c0b6d52a-2fde-4e3f-835f-e49fffc67ccb","f9bd9b58-c400-4a0f-b66f-0ce991e0e3e2","9af201fa-bf32-4e44-b44d-efea6f69d631"]},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2022-02-03T09:21:14Z","entityUuid":"2a34dbf7-3a9e-446e-9dfd-695903bd2a07","parentUuid":"771279ea-3ffe-4d22-aeb4-8d656a77c25c","uuid":"0c208318-b995-47e8-992c-20ab864b3801"},{"content":{"advice":{"changed":true,"value":"Are you sure? \n\nThere may be very different reasons to reuse a data set than you can think of! E.g. an interview recording can be used for voice analysis or for studying the acoustics of a room, which is not what the interviewer had in mind when it was made."},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"There is no value, nobody will ever reuse it"},"metricMeasures":{"changed":false}},"createdAt":"2022-02-03T09:21:15Z","entityUuid":"f040fdff-e9d4-4777-a482-af584fd7b3ba","parentUuid":"2a34dbf7-3a9e-446e-9dfd-695903bd2a07","uuid":"9c159b95-e9c6-44b5-9822-8c482396db76"}],"forkOfPackageId":null,"id":"dsw:root:2.3.10","kmId":"root","language":"en","license":"Apache-2.0","mergeCheckpointPackageId":null,"metamodelVersion":20,"name":"Common DSW Knowledge Model","nonEditable":false,"organizationId":"dsw","phase":"DeprecatedKnowledgeModelPackagePhase","previousPackageId":"dsw:root:2.3.9","readme":"# Common DSW Knowledge Model\r\n\r\nCommon DSW Knowledge Model deals with questions that a researcher should answer in order to create a Data Stewardship Plan, as well as other related questionnaire data. It originated from mindmap made by Rob Hooft.\r\n\r\n## Changelog\r\n\r\n### 2.3.10\r\n\r\n* Added references and questions from an RDMkit/DS Wizard working session on Preserving Data\r\n\r\n### 2.3.9\r\n\r\n* Fix missing Yes/No answers and use Text-Value for description of policies\r\n\r\n### 2.3.8\r\n\r\n* Questions for Horizon Europe added on budget for data management, other policies that are observed, persistent identifier allocation and archive preservation policies [Marek/Jana Horizon Europe issues 7-9, 11]\r\n\r\n### 2.3.7\r\n\r\n* Added references and questions from an RDMkit/DS Wizard working session on Human Data\r\n\r\n### 2.3.6\r\n\r\n* Questions about metadata for Horizon Europe added [Marek/Jana Horizon Europe issues 4-6]\r\n\r\n### 2.3.5\r\n\r\n* Added Tag for Horizon Europe\r\n* Moved the new questions from 2.3.4 from \"Science Europe\" to \"Horizon Europe\"\r\n* Added new question about qualified references from published data sets [Marek/Jana Horizon Europe issue 3]\r\n\r\n### 2.3.4\r\n\r\n* Change lists of reused (non-)reference datasets that are reused into lists of considered datasets, and add a question for each detailing whether they are actually reused and what for / why not. This is to be included in the Science Europe template [Marek/Jana Horizon Europe issue 1 and 2].\r\n\r\n### 2.3.3\r\n\r\n* Incorporation of changes from a collaborative workshop with RDMkit participants on data processing.\r\n   * Added links to RDMkit (and some to other external resources) in several places\r\n   * Clarified some questions\r\n   * Added question on data versioning for filesystems\r\n\r\n### 2.3.2\r\n\r\n* Incorporation of changes from a workshop with the authors of the RDMkit page on data collecting.\r\n   * Added links to RDMkit in several places\r\n   * Clarified some questions\r\n   * Moved questions on quality together\r\n   * Moved some questions out of the metadata subsection\r\n\r\n### 2.3.1\r\n\r\n* Incorporation of changes from a workshop with the authors of the RDMkit page on data sharing.\r\n    * Attempt to clarify difference between \"open\" and \"accessible\"\r\n    * Attempt to clarify difference between \"open\" and \"embargoed\"\r\n    * Added links to RDMkit Data Sharing page in a few places\r\n    * Added a few relevant questions\r\n\r\n### 2.3.0\r\n\r\nActivity during [BioHackathon Europe](biohackathon-europe.org) 2020 ([#BioHackEU20](twitter.com/search?q=%23BioHackEU20))\r\n\r\n* Added and tagged questions for Horizon 2020 template\r\n* Moved questions about collecting metadata to one consistent place\r\n* Added guidance on semantics in file names and question about using PIDs for identifying files\r\n* Generic small cleanups and typo fixes\r\n* Closing many issues of feedback received on the knowledge model (from [DSWGlobal/dsw](https://github.com/DSWGlobal/dsw))\r\n* Various question updates new options, clarifications, integrations\r\n* Added highly configurable [Wikidata](https://www.wikidata.org) SPARQL-based integration\r\n* Added [Research Organization Registry](https://ror.org) integration for contributor's affiliation\r\n\r\n### 2.2.0\r\n\r\n* Adjusted for compatibility with [RDA DMP Common Standard for machine-actionable DMPs (1.0)](https://github.com/RDA-DMP-Common/RDA-DMP-Common-Standard)\r\n  * Updated *Project* and *Funding* questions in *Administrative Details* chapter\r\n  * Reorganised *Dataset*, *Distribution*, *License* questions in *Data Publishing* chapter\r\n* Added *maDMP* tag to questions used in the RDA maDMP template\r\n\r\n### 2.1.0\r\n\r\n* Added *Science Europe DMP* tag to questions used in the Science Europe template\r\n\r\n### 2.0.2\r\n\r\n* Fixed missing and duplicated questions\r\n\r\n### 2.0.1\r\n\r\n* Fixed duplicated question in *Creating and collecting data* chapter (5ba53879-eb48-47f2-a73b-f7f7d83bf030)\r\n\r\n### 2.0.0\r\n\r\n* Added detailed questions for Science Europe DMPs\r\n* Fixed several typos and other minor problems\r\n* Added administrative chapter\r\n* Moving questions and refactoring according to [ds-km#24](https://github.com/ds-wizard/ds-km/pull/24)\r\n\r\n### 1.4.0\r\n\r\n* Adding integration for [FAIRsharing.org](https://fairsharing.org)\r\n* Adding 5 integration questions according to [ds-km@da5a8fc](https://github.com/ds-wizard/ds-km/commit/da5a8fc95d0a67f9369ce0b7727615115fc3656d)\r\n\r\nThe FAIRsharing integration requires configuration to contain `apiUrl` and `apiKey` for integration with id `fairsharing`.\r\n\r\n### 1.3.0\r\n\r\n* Refactoring list questions because of **deprecated item title** fields, i.e., a new question for item title created for each list question\r\n\r\nWhen using this version and higher, the DS Wizard configuration should have `itemTitleEnabled` set to `false`.\r\n\r\n### 1.2.0\r\n\r\n* Adding file naming SOP description question (9ff389f0-2236-48cf-880c-040ea1bb0d2f) to chapter 2 according to [ds-km@d879be0](https://github.com/ds-wizard/ds-km/commit/d879be0fa9d0808868396c649d03c4d783ac6742)\r\n\r\n### 1.1.0\r\n\r\n* Adding phases to questions (first draft) according to [ds-km@a6713d1](https://github.com/ds-wizard/ds-km/commit/a6713d1a4b9758bea63b3f7c56af5bd4f500d949) and [ds-km@1123211](https://github.com/ds-wizard/ds-km/commit/1123211bb5af43df8ef435039a2923f48e3e981c)\r\n\r\nPrior to this version, all questions were assigned with phase 2 - *Before submitting the DMP*.\r\n\r\n### 1.0.3\r\n\r\n* Fix: Removing extra question mark for a question (8018e15f-6c7e-433a-8686-ae0d695c7fc7) in chapter 5 according to: [ds-km@1123211](https://github.com/ds-wizard/ds-km/commit/1123211bb5af43df8ef435039a2923f48e3e981c)\r\n\r\n### 1.0.2\r\n\r\n* Fix: Adding some explanation to the list item questions (f5fef09d-ade5-4019-b089-f05bd89c34bc and b642c31d-a512-4ca7-8743-a2e0254006fa) in chapter 3 according to: [ds-km@96e28f4](https://github.com/ds-wizard/ds-km/commit/96e28f478d5dc6b59d384b5127f012dc2fe5f287)\r\n\r\n### 1.0.1\r\n\r\n* Fix: Adding forgotten question mark to end of question (39e0cc7c-17fe-4991-88d8-1280c3fe7923) in chapter 1 according to: [ds-km@644a373](https://github.com/ds-wizard/ds-km/commit/644a373685dc4ac15b76e86667a90151ca9c70ca)\r\n\r\n### 1.0.0\r\n\r\n* Initial version transformed from the previous DS-KM GitHub repository up to [ds-km@8442837](https://github.com/ds-wizard/ds-km/commit/8442837dbe3ff899b09e7d8d3fc1107e935a876f)","version":"2.3.10"},{"createdAt":"2022-02-15T06:21:14.460383Z","description":"DSW Knowledge Model originating from mindmap made by Rob Hooft","events":[{"content":{"annotations":{"changed":false},"eventType":"EditChapterEvent","questionUuids":{"changed":true,"value":["b2fb6b4e-2961-40a4-a9ec-faf4e49a978b","0e810343-6026-4992-8ea0-5539cbc77093","8e886b55-3287-48e7-b353-daf6ab40f7d8","b08fe063-33f8-4380-b3a9-ba1e586dedf2","2bac9020-99cf-4463-8d34-0b0eb2781cd1","5ba53879-eb48-47f2-a73b-f7f7d83bf030","8c962e6f-17ee-4b22-8ebb-9f06f779e3b3","f87c331d-794a-42c8-a910-61a2a9110dab","f038bd46-ee4e-4f53-b7ea-482381c2c855","ab4b3f39-dfab-45a5-9489-2d46ceacbb73","49c009cb-a38c-4836-9780-8a8b3dd1cbac","cb7d17a8-30c0-489d-a43c-702b27d97611","02b3fed1-0b50-4a80-b8b6-a225a1107022"]},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2022-02-11T12:44:48Z","entityUuid":"b1df3c74-0b1f-4574-81c4-4cc2d780c1af","parentUuid":"6f6241d9-136c-4770-9d58-8a3f39607052","uuid":"0a25b343-40ea-477a-9ca9-2869149f93b0"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Will you be collecting artefacts like specimens, minerals, biological samples?"},"title":{"changed":true,"value":"Will you be collecting physical samples?"}},"createdAt":"2022-02-11T12:44:49Z","entityUuid":"0e810343-6026-4992-8ea0-5539cbc77093","parentUuid":"b1df3c74-0b1f-4574-81c4-4cc2d780c1af","uuid":"dd2da897-1b7a-4d73-9000-eda703a390f1"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2022-02-11T12:44:50Z","entityUuid":"f67a9910-4ea3-4280-b503-386dff3b8305","parentUuid":"05873934-f03d-4d90-8bfd-291350c14673","uuid":"63d58a2f-373b-4936-83d0-97ce3c52de27"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":true,"value":["f67a9910-4ea3-4280-b503-386dff3b8305","da0d28e6-1c6e-44d8-ba47-d834aeca847b","d488b314-2b5c-4e79-be1e-c5742205d2a5","9e238002-da35-4f9b-a9b7-8fe3613a3c03"]},"label":{"changed":false},"metricMeasures":{"changed":false}},"createdAt":"2022-02-11T12:44:51Z","entityUuid":"05873934-f03d-4d90-8bfd-291350c14673","parentUuid":"0e810343-6026-4992-8ea0-5539cbc77093","uuid":"0dc020fa-3e49-415c-9380-49c671d377ae"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"In some fields, it is considered good practice to deposit samples to a public repository before deriving any digital data from them."},"title":{"changed":true,"value":"Do your samples need to be submitted to a public repository?"}},"createdAt":"2022-02-11T12:44:52Z","entityUuid":"f67a9910-4ea3-4280-b503-386dff3b8305","parentUuid":"05873934-f03d-4d90-8bfd-291350c14673","uuid":"c328e40f-fd4c-48ba-a48d-a24691000000"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-02-11T12:44:53Z","entityUuid":"8095f86a-0456-483e-a9ea-074ebabf3874","parentUuid":"f67a9910-4ea3-4280-b503-386dff3b8305","uuid":"7cf54577-3f5c-4294-a45d-b19d16410c8d"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"No"},"metricMeasures":{"changed":false}},"createdAt":"2022-02-11T12:44:54Z","entityUuid":"8095f86a-0456-483e-a9ea-074ebabf3874","parentUuid":"f67a9910-4ea3-4280-b503-386dff3b8305","uuid":"708ad2ac-adcc-4c6a-b8b1-39dbabf1f47f"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-02-11T12:44:55Z","entityUuid":"a8938dfc-2e79-4268-9ec5-eb6dc54e9795","parentUuid":"f67a9910-4ea3-4280-b503-386dff3b8305","uuid":"51e93003-800f-4cb7-aa17-282e5f516d73"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Yes"},"metricMeasures":{"changed":false}},"createdAt":"2022-02-11T12:44:56Z","entityUuid":"a8938dfc-2e79-4268-9ec5-eb6dc54e9795","parentUuid":"f67a9910-4ea3-4280-b503-386dff3b8305","uuid":"c3af9534-f92b-4f48-b963-a0a9d0f9b74d"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":true,"value":"b101f2d0-2476-452d-aa8d-95a41a02b52c"},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2022-02-11T12:44:57Z","entityUuid":"f67a9910-4ea3-4280-b503-386dff3b8305","parentUuid":"05873934-f03d-4d90-8bfd-291350c14673","uuid":"403d6902-a301-4fb3-9e57-cf0872b9d08b"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2022-02-11T12:44:58Z","entityUuid":"cc57d7c0-49db-4546-958f-e9407eaf93ee","parentUuid":"8095f86a-0456-483e-a9ea-074ebabf3874","uuid":"3835e5a8-533c-4d0b-a4cd-e756c5861650"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Will the samples be stored in a local repository such as a biobank?"}},"createdAt":"2022-02-11T12:44:59Z","entityUuid":"cc57d7c0-49db-4546-958f-e9407eaf93ee","parentUuid":"8095f86a-0456-483e-a9ea-074ebabf3874","uuid":"3a0bff9e-b1ea-4a5d-988e-55a1260d364d"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":true,"value":"b101f2d0-2476-452d-aa8d-95a41a02b52c"},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2022-02-11T12:45:00Z","entityUuid":"cc57d7c0-49db-4546-958f-e9407eaf93ee","parentUuid":"8095f86a-0456-483e-a9ea-074ebabf3874","uuid":"279d0c17-339d-48df-b6c0-856a3b16ecc1"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-02-11T12:45:01Z","entityUuid":"ed957bb8-f38d-4f6e-840a-ff62a444c6d9","parentUuid":"cc57d7c0-49db-4546-958f-e9407eaf93ee","uuid":"db192a01-f588-4e73-92f7-9bb2debb58cf"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"No"},"metricMeasures":{"changed":false}},"createdAt":"2022-02-11T12:45:02Z","entityUuid":"ed957bb8-f38d-4f6e-840a-ff62a444c6d9","parentUuid":"cc57d7c0-49db-4546-958f-e9407eaf93ee","uuid":"068315d1-1846-4d46-b62f-4e1cee798bce"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-02-11T12:45:03Z","entityUuid":"9562c8d0-6d85-49fa-95fd-0a6701ab836a","parentUuid":"cc57d7c0-49db-4546-958f-e9407eaf93ee","uuid":"71469ef5-d95a-441c-aa3d-14c0859ae3e5"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Yes"},"metricMeasures":{"changed":false}},"createdAt":"2022-02-11T12:45:04Z","entityUuid":"9562c8d0-6d85-49fa-95fd-0a6701ab836a","parentUuid":"cc57d7c0-49db-4546-958f-e9407eaf93ee","uuid":"ad6e1402-48fe-40c9-b9f0-598ce09e2b17"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Samples will only get an internal code"},"metricMeasures":{"changed":false}},"createdAt":"2022-02-11T12:45:05Z","entityUuid":"a0ced35d-28f4-4208-b4b1-bb524401939d","parentUuid":"da0d28e6-1c6e-44d8-ba47-d834aeca847b","uuid":"ad6f37da-c9d6-472b-a460-a37baf3f9d0a"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Where will the physical samples be stored"},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2022-02-11T12:45:06Z","entityUuid":"d488b314-2b5c-4e79-be1e-c5742205d2a5","parentUuid":"05873934-f03d-4d90-8bfd-291350c14673","uuid":"96a60fcc-22d1-46a6-b8e4-6daef2202da8"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2022-02-11T12:45:07Z","entityUuid":"5c6e0a81-4a69-4542-a667-f3e67d56392e","parentUuid":"9e238002-da35-4f9b-a9b7-8fe3613a3c03","uuid":"3f54d6cf-0770-4a94-ac51-25f878838880"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"RDMkit on Identifiers"},"referenceType":"URLReference","url":{"changed":true,"value":"https://rdmkit.elixir-europe.org/identifiers.html"}},"createdAt":"2022-02-11T12:45:08Z","entityUuid":"5c6e0a81-4a69-4542-a667-f3e67d56392e","parentUuid":"9e238002-da35-4f9b-a9b7-8fe3613a3c03","uuid":"29e32d99-8763-4db0-b618-ff88a418022a"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":false},"metricMeasures":{"changed":true,"value":[{"measure":0,"metricUuid":"8845fe2b-79df-4138-baea-3a035bf5e249","weight":1}]}},"createdAt":"2022-02-11T12:45:09Z","entityUuid":"c3c74172-5030-44e0-9c04-6c29479ccfdc","parentUuid":"f1609178-599a-4da6-b93b-776e4f9b626c","uuid":"c1cba84f-91f8-4308-8f73-a22470874359"}],"forkOfPackageId":null,"id":"dsw:root:2.3.11","kmId":"root","language":"en","license":"Apache-2.0","mergeCheckpointPackageId":null,"metamodelVersion":20,"name":"Common DSW Knowledge Model","nonEditable":false,"organizationId":"dsw","phase":"DeprecatedKnowledgeModelPackagePhase","previousPackageId":"dsw:root:2.3.10","readme":"# Common DSW Knowledge Model\r\n\r\nCommon DSW Knowledge Model deals with questions that a researcher should answer in order to create a Data Stewardship Plan, as well as other related questionnaire data. It originated from mindmap made by Rob Hooft.\r\n\r\n## Changelog\r\n\r\n### 2.3.11\r\n\r\n* Incorporating changes made in the Plant Sciences workshop with RDMkit\r\n\r\n### 2.3.10\r\n\r\n* Added references and questions from an RDMkit/DS Wizard working session on Preserving Data\r\n\r\n### 2.3.9\r\n\r\n* Fix missing Yes/No answers and use Text-Value for description of policies\r\n\r\n### 2.3.8\r\n\r\n* Questions for Horizon Europe added on budget for data management, other policies that are observed, persistent identifier allocation and archive preservation policies [Marek/Jana Horizon Europe issues 7-9, 11]\r\n\r\n### 2.3.7\r\n\r\n* Added references and questions from an RDMkit/DS Wizard working session on Human Data\r\n\r\n### 2.3.6\r\n\r\n* Questions about metadata for Horizon Europe added [Marek/Jana Horizon Europe issues 4-6]\r\n\r\n### 2.3.5\r\n\r\n* Added Tag for Horizon Europe\r\n* Moved the new questions from 2.3.4 from \"Science Europe\" to \"Horizon Europe\"\r\n* Added new question about qualified references from published data sets [Marek/Jana Horizon Europe issue 3]\r\n\r\n### 2.3.4\r\n\r\n* Change lists of reused (non-)reference datasets that are reused into lists of considered datasets, and add a question for each detailing whether they are actually reused and what for / why not. This is to be included in the Science Europe template [Marek/Jana Horizon Europe issue 1 and 2].\r\n\r\n### 2.3.3\r\n\r\n* Incorporation of changes from a collaborative workshop with RDMkit participants on data processing.\r\n   * Added links to RDMkit (and some to other external resources) in several places\r\n   * Clarified some questions\r\n   * Added question on data versioning for filesystems\r\n\r\n### 2.3.2\r\n\r\n* Incorporation of changes from a workshop with the authors of the RDMkit page on data collecting.\r\n   * Added links to RDMkit in several places\r\n   * Clarified some questions\r\n   * Moved questions on quality together\r\n   * Moved some questions out of the metadata subsection\r\n\r\n### 2.3.1\r\n\r\n* Incorporation of changes from a workshop with the authors of the RDMkit page on data sharing.\r\n    * Attempt to clarify difference between \"open\" and \"accessible\"\r\n    * Attempt to clarify difference between \"open\" and \"embargoed\"\r\n    * Added links to RDMkit Data Sharing page in a few places\r\n    * Added a few relevant questions\r\n\r\n### 2.3.0\r\n\r\nActivity during [BioHackathon Europe](biohackathon-europe.org) 2020 ([#BioHackEU20](twitter.com/search?q=%23BioHackEU20))\r\n\r\n* Added and tagged questions for Horizon 2020 template\r\n* Moved questions about collecting metadata to one consistent place\r\n* Added guidance on semantics in file names and question about using PIDs for identifying files\r\n* Generic small cleanups and typo fixes\r\n* Closing many issues of feedback received on the knowledge model (from [DSWGlobal/dsw](https://github.com/DSWGlobal/dsw))\r\n* Various question updates new options, clarifications, integrations\r\n* Added highly configurable [Wikidata](https://www.wikidata.org) SPARQL-based integration\r\n* Added [Research Organization Registry](https://ror.org) integration for contributor's affiliation\r\n\r\n### 2.2.0\r\n\r\n* Adjusted for compatibility with [RDA DMP Common Standard for machine-actionable DMPs (1.0)](https://github.com/RDA-DMP-Common/RDA-DMP-Common-Standard)\r\n  * Updated *Project* and *Funding* questions in *Administrative Details* chapter\r\n  * Reorganised *Dataset*, *Distribution*, *License* questions in *Data Publishing* chapter\r\n* Added *maDMP* tag to questions used in the RDA maDMP template\r\n\r\n### 2.1.0\r\n\r\n* Added *Science Europe DMP* tag to questions used in the Science Europe template\r\n\r\n### 2.0.2\r\n\r\n* Fixed missing and duplicated questions\r\n\r\n### 2.0.1\r\n\r\n* Fixed duplicated question in *Creating and collecting data* chapter (5ba53879-eb48-47f2-a73b-f7f7d83bf030)\r\n\r\n### 2.0.0\r\n\r\n* Added detailed questions for Science Europe DMPs\r\n* Fixed several typos and other minor problems\r\n* Added administrative chapter\r\n* Moving questions and refactoring according to [ds-km#24](https://github.com/ds-wizard/ds-km/pull/24)\r\n\r\n### 1.4.0\r\n\r\n* Adding integration for [FAIRsharing.org](https://fairsharing.org)\r\n* Adding 5 integration questions according to [ds-km@da5a8fc](https://github.com/ds-wizard/ds-km/commit/da5a8fc95d0a67f9369ce0b7727615115fc3656d)\r\n\r\nThe FAIRsharing integration requires configuration to contain `apiUrl` and `apiKey` for integration with id `fairsharing`.\r\n\r\n### 1.3.0\r\n\r\n* Refactoring list questions because of **deprecated item title** fields, i.e., a new question for item title created for each list question\r\n\r\nWhen using this version and higher, the DS Wizard configuration should have `itemTitleEnabled` set to `false`.\r\n\r\n### 1.2.0\r\n\r\n* Adding file naming SOP description question (9ff389f0-2236-48cf-880c-040ea1bb0d2f) to chapter 2 according to [ds-km@d879be0](https://github.com/ds-wizard/ds-km/commit/d879be0fa9d0808868396c649d03c4d783ac6742)\r\n\r\n### 1.1.0\r\n\r\n* Adding phases to questions (first draft) according to [ds-km@a6713d1](https://github.com/ds-wizard/ds-km/commit/a6713d1a4b9758bea63b3f7c56af5bd4f500d949) and [ds-km@1123211](https://github.com/ds-wizard/ds-km/commit/1123211bb5af43df8ef435039a2923f48e3e981c)\r\n\r\nPrior to this version, all questions were assigned with phase 2 - *Before submitting the DMP*.\r\n\r\n### 1.0.3\r\n\r\n* Fix: Removing extra question mark for a question (8018e15f-6c7e-433a-8686-ae0d695c7fc7) in chapter 5 according to: [ds-km@1123211](https://github.com/ds-wizard/ds-km/commit/1123211bb5af43df8ef435039a2923f48e3e981c)\r\n\r\n### 1.0.2\r\n\r\n* Fix: Adding some explanation to the list item questions (f5fef09d-ade5-4019-b089-f05bd89c34bc and b642c31d-a512-4ca7-8743-a2e0254006fa) in chapter 3 according to: [ds-km@96e28f4](https://github.com/ds-wizard/ds-km/commit/96e28f478d5dc6b59d384b5127f012dc2fe5f287)\r\n\r\n### 1.0.1\r\n\r\n* Fix: Adding forgotten question mark to end of question (39e0cc7c-17fe-4991-88d8-1280c3fe7923) in chapter 1 according to: [ds-km@644a373](https://github.com/ds-wizard/ds-km/commit/644a373685dc4ac15b76e86667a90151ca9c70ca)\r\n\r\n### 1.0.0\r\n\r\n* Initial version transformed from the previous DS-KM GitHub repository up to [ds-km@8442837](https://github.com/ds-wizard/ds-km/commit/8442837dbe3ff899b09e7d8d3fc1107e935a876f)","version":"2.3.11"},{"createdAt":"2022-02-15T21:01:15.102771Z","description":"DSW Knowledge Model originating from mindmap made by Rob Hooft","events":[{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"How will access to the work space be controlled?"}},"createdAt":"2022-02-15T08:25:16Z","entityUuid":"80d403f3-3f29-4f37-9040-b901ae9afa37","parentUuid":"e7324e1a-bfcb-4f2b-855a-35701dfb1ad5","uuid":"213190e9-f3c7-426a-8a4f-23f7a3f37edd"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"List the data formats you will be using for interpretation and describe their structure"}},"createdAt":"2022-02-15T08:25:17Z","entityUuid":"a797cab9-0829-4787-a096-1b5cedc9147f","parentUuid":"83438863-0aa0-4458-b14b-2b2c0d4f811d","uuid":"38bf5433-9013-4002-a405-f33c12816228"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2022-02-15T08:25:18Z","entityUuid":"ae540a5d-7f3c-4bf0-99a4-539d70a1dc6e","parentUuid":"a797cab9-0829-4787-a096-1b5cedc9147f","uuid":"e18f3501-7294-4b5b-a332-1e1cb0d6de21"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"RDMkit on Machine Actionability"},"referenceType":"URLReference","url":{"changed":true,"value":"https://rdmkit.elixir-europe.org/machine_actionability.html"}},"createdAt":"2022-02-15T08:25:19Z","entityUuid":"ae540a5d-7f3c-4bf0-99a4-539d70a1dc6e","parentUuid":"a797cab9-0829-4787-a096-1b5cedc9147f","uuid":"27950a09-9868-45b5-bf40-bf5e5bfaf7b2"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2022-02-15T08:25:20Z","entityUuid":"dddd6258-9d36-4d5c-9fe3-15369f825b04","parentUuid":"a797cab9-0829-4787-a096-1b5cedc9147f","uuid":"a6671a38-8332-431b-b528-475676cfc9a3"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"RDMkit on Data Processing"},"referenceType":"URLReference","url":{"changed":true,"value":"https://rdmkit.elixir-europe.org/processing"}},"createdAt":"2022-02-15T08:25:21Z","entityUuid":"dddd6258-9d36-4d5c-9fe3-15369f825b04","parentUuid":"a797cab9-0829-4787-a096-1b5cedc9147f","uuid":"da78a875-b438-431f-8347-280667c8c63d"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2022-02-15T08:25:22Z","entityUuid":"7aa33891-6563-4cd3-bb08-2f0d3b6f818a","parentUuid":"df36fb68-131c-4f31-a42b-684abf523bbc","uuid":"10a45f40-62d1-4d0a-a769-090067856a49"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"RDMkit on Data Processing"},"referenceType":"URLReference","url":{"changed":true,"value":"https://rdmkit.elixir-europe.org/processing"}},"createdAt":"2022-02-15T08:25:23Z","entityUuid":"7aa33891-6563-4cd3-bb08-2f0d3b6f818a","parentUuid":"df36fb68-131c-4f31-a42b-684abf523bbc","uuid":"bac244af-da92-46ac-8c9f-eb7312243547"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2022-02-15T08:25:24Z","entityUuid":"23a14548-8397-490f-94e9-0d799c01e319","parentUuid":"df36fb68-131c-4f31-a42b-684abf523bbc","uuid":"e06dfc1b-07f1-4730-ba1c-adb4164d5a05"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"RDMkit on Data Analysis"},"referenceType":"URLReference","url":{"changed":true,"value":"https://rdmkit.elixir-europe.org/data_analysis.html"}},"createdAt":"2022-02-15T08:25:25Z","entityUuid":"23a14548-8397-490f-94e9-0d799c01e319","parentUuid":"df36fb68-131c-4f31-a42b-684abf523bbc","uuid":"708fe639-b566-4a59-84fa-72809d8efe7d"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"RDMkit on Data Analysis"},"referenceType":"URLReference","url":{"changed":false}},"createdAt":"2022-02-15T08:25:26Z","entityUuid":"1ba6f1d0-58ee-4722-8d18-da441e66d1ae","parentUuid":"4ba3304e-225c-4916-bbf7-754de381253c","uuid":"cd101baf-c992-4910-bcd8-9931f33b393c"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2022-02-15T08:25:27Z","entityUuid":"257d126a-611d-475d-a86d-752131f7c7e8","parentUuid":"decb7c9c-c6dc-4027-8c0e-18934c852ca6","uuid":"b1031d09-e877-47d0-9539-0e22bb9fa51f"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"RDMkit on Package management systems"},"referenceType":"URLReference","url":{"changed":true,"value":"https://rdmkit.elixir-europe.org/data_analysis.html#how-can-you-use-package-and-environment-management-systems"}},"createdAt":"2022-02-15T08:25:28Z","entityUuid":"257d126a-611d-475d-a86d-752131f7c7e8","parentUuid":"decb7c9c-c6dc-4027-8c0e-18934c852ca6","uuid":"3c4a8bc0-5994-4dd8-a02f-d7d6cbf0eea7"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":null},"title":{"changed":false}},"createdAt":"2022-02-15T08:25:29Z","entityUuid":"7733494c-fd84-4cd0-8463-5806f321f2c9","parentUuid":"83438863-0aa0-4458-b14b-2b2c0d4f811d","uuid":"37ec5e67-4733-4876-a761-b05afe3108a1"},{"content":{"eventType":"DeleteQuestionEvent"},"createdAt":"2022-02-15T08:25:30Z","entityUuid":"7733494c-fd84-4cd0-8463-5806f321f2c9","parentUuid":"83438863-0aa0-4458-b14b-2b2c0d4f811d","uuid":"9cc669b2-6bfb-488d-99c8-3b0c295a361f"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2022-02-15T08:25:31Z","entityUuid":"e1dba221-ad5a-474e-a2e3-9b4e472959fa","parentUuid":"83438863-0aa0-4458-b14b-2b2c0d4f811d","uuid":"35489224-4fd5-48c6-8dcb-5731a9012145"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-02-15T08:25:32Z","entityUuid":"e492d849-cd0b-4526-b876-afabbec36da3","parentUuid":"e1dba221-ad5a-474e-a2e3-9b4e472959fa","uuid":"58eac545-8d6b-4e64-91bb-85513f029a7f"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"No"},"metricMeasures":{"changed":false}},"createdAt":"2022-02-15T08:25:33Z","entityUuid":"e492d849-cd0b-4526-b876-afabbec36da3","parentUuid":"e1dba221-ad5a-474e-a2e3-9b4e472959fa","uuid":"81e76930-bf9e-4550-80ee-1a1f82cf63bb"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-02-15T08:25:34Z","entityUuid":"2d35bf55-4123-4791-bd4d-ef39c57c9729","parentUuid":"e1dba221-ad5a-474e-a2e3-9b4e472959fa","uuid":"ce684a61-681c-4972-b8c4-ad328a1ff929"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Yes"},"metricMeasures":{"changed":false}},"createdAt":"2022-02-15T08:25:35Z","entityUuid":"2d35bf55-4123-4791-bd4d-ef39c57c9729","parentUuid":"e1dba221-ad5a-474e-a2e3-9b4e472959fa","uuid":"8c5731a2-e834-426f-b582-f524a892f58f"},{"content":{"annotations":{"changed":false},"eventType":"EditChapterEvent","questionUuids":{"changed":true,"value":["a797cab9-0829-4787-a096-1b5cedc9147f","109ed7ea-ef1d-4719-b2b4-eb4f7202c65c","f67e1539-5c7d-4df7-8259-e4f2edfa2685","d0306914-c253-472c-869f-19a60578c087","dbb6dcdf-dd2e-4829-8c03-16b2339ebd5a","d5d21ad3-720c-4a6a-bd5a-09f14b15666f","dc4f1dc7-4608-45f9-8503-aa05536f4d97","e1dba221-ad5a-474e-a2e3-9b4e472959fa","460803f2-cc23-4c57-b50e-c5177a3c11d5"]},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2022-02-15T08:25:36Z","entityUuid":"83438863-0aa0-4458-b14b-2b2c0d4f811d","parentUuid":"6f6241d9-136c-4770-9d58-8a3f39607052","uuid":"66ba80cf-4c38-4a49-bc5d-170ac09d5c32"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2022-02-15T08:25:37Z","entityUuid":"5c29bf88-3b5e-4abd-aeaf-64c1a63dcc55","parentUuid":"e1dba221-ad5a-474e-a2e3-9b4e472959fa","uuid":"7e3034ed-9125-49b7-a223-3317cbea263f"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"In some cases it is not practical to bring all data together:\n* It may be legally hard to collect the data in one place for analysis\n* It may be technically hard to transport data to a single place for analysis\n\nIn such cases, a Federated analysis approach may be applicable. Examples of such techniques are DataShield and the Personal Health Train. Secure multi-party computation may be useful too to prevent information leaking between parties."},"title":{"changed":true,"value":"Will you be using a federated analysis approach?"}},"createdAt":"2022-02-15T08:25:38Z","entityUuid":"e1dba221-ad5a-474e-a2e3-9b4e472959fa","parentUuid":"83438863-0aa0-4458-b14b-2b2c0d4f811d","uuid":"91d113a3-bee6-441f-80d3-813e29b3d08e"},{"content":{"annotations":{"changed":false},"eventType":"EditChapterEvent","questionUuids":{"changed":false},"text":{"changed":true,"value":"In the processing phase, the data will be undergoing the mostly automated steps for processing, before the analysis and interpretation.\n\nIn this chapter, many questions are focusing on the compute environment that is used to process the data and make it available for interpretation by project partners. Some of those questions (e.g. on workflow systems and data provenance) are also relevant for the work in the interpretation phase."},"title":{"changed":false}},"createdAt":"2022-02-15T08:25:39Z","entityUuid":"10a10ffd-bfe1-4c6b-bbb6-3dfb1e63a5d5","parentUuid":"6f6241d9-136c-4770-9d58-8a3f39607052","uuid":"0c276bfa-b8bc-44db-a720-f6761ffa738b"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"If sources are using different semantic resources, you will need to plan time to find or make the right mappings."},"title":{"changed":false}},"createdAt":"2022-02-15T08:25:40Z","entityUuid":"532ddc6a-3415-4df8-8fa1-002ee486fd42","parentUuid":"9cea7792-3e4c-42a6-b7e0-1abbdc9e2a5b","uuid":"7d25944e-045d-4e1d-8224-07f7459a0c91"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"If you are getting different types of data from different sources and want to use them together it is likely that you will need to match items and glue everything together. This can be done with traditional table database technology, but it is also possible to use Linked Data and RDF."},"title":{"changed":true,"value":"Will you be doing integration or linking of different data types?"}},"createdAt":"2022-02-15T08:25:41Z","entityUuid":"109ed7ea-ef1d-4719-b2b4-eb4f7202c65c","parentUuid":"83438863-0aa0-4458-b14b-2b2c0d4f811d","uuid":"c05f2178-c471-4b00-8ec4-066c1341598a"},{"content":{"advice":{"changed":true,"value":"Many standard database systems are available and often these are programmable in SQL."},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":false},"metricMeasures":{"changed":false}},"createdAt":"2022-02-15T08:25:42Z","entityUuid":"3c75eb37-03d7-414c-8bd3-0afa8170bfbc","parentUuid":"ff85db18-565c-4177-a397-9a8cf4c7b374","uuid":"df2100ab-f0e5-4c3d-beba-2b3bbcf61997"}],"forkOfPackageId":null,"id":"dsw:root:2.3.12","kmId":"root","language":"en","license":"Apache-2.0","mergeCheckpointPackageId":null,"metamodelVersion":20,"name":"Common DSW Knowledge Model","nonEditable":false,"organizationId":"dsw","phase":"DeprecatedKnowledgeModelPackagePhase","previousPackageId":"dsw:root:2.3.11","readme":"# Common DSW Knowledge Model\r\n\r\nCommon DSW Knowledge Model deals with questions that a researcher should answer in order to create a Data Stewardship Plan, as well as other related questionnaire data. It originated from mindmap made by Rob Hooft.\r\n\r\n## Changelog\r\n\r\n### 2.3.12\r\n\r\n* Incorporating changes related to the Data Analytics workshop with RDMkit\r\n\r\n### 2.3.11\r\n\r\n* Incorporating changes made in the Plant Sciences workshop with RDMkit\r\n\r\n### 2.3.10\r\n\r\n* Added references and questions from an RDMkit/DS Wizard working session on Preserving Data\r\n\r\n### 2.3.9\r\n\r\n* Fix missing Yes/No answers and use Text-Value for description of policies\r\n\r\n### 2.3.8\r\n\r\n* Questions for Horizon Europe added on budget for data management, other policies that are observed, persistent identifier allocation and archive preservation policies [Marek/Jana Horizon Europe issues 7-9, 11]\r\n\r\n### 2.3.7\r\n\r\n* Added references and questions from an RDMkit/DS Wizard working session on Human Data\r\n\r\n### 2.3.6\r\n\r\n* Questions about metadata for Horizon Europe added [Marek/Jana Horizon Europe issues 4-6]\r\n\r\n### 2.3.5\r\n\r\n* Added Tag for Horizon Europe\r\n* Moved the new questions from 2.3.4 from \"Science Europe\" to \"Horizon Europe\"\r\n* Added new question about qualified references from published data sets [Marek/Jana Horizon Europe issue 3]\r\n\r\n### 2.3.4\r\n\r\n* Change lists of reused (non-)reference datasets that are reused into lists of considered datasets, and add a question for each detailing whether they are actually reused and what for / why not. This is to be included in the Science Europe template [Marek/Jana Horizon Europe issue 1 and 2].\r\n\r\n### 2.3.3\r\n\r\n* Incorporation of changes from a collaborative workshop with RDMkit participants on data processing.\r\n   * Added links to RDMkit (and some to other external resources) in several places\r\n   * Clarified some questions\r\n   * Added question on data versioning for filesystems\r\n\r\n### 2.3.2\r\n\r\n* Incorporation of changes from a workshop with the authors of the RDMkit page on data collecting.\r\n   * Added links to RDMkit in several places\r\n   * Clarified some questions\r\n   * Moved questions on quality together\r\n   * Moved some questions out of the metadata subsection\r\n\r\n### 2.3.1\r\n\r\n* Incorporation of changes from a workshop with the authors of the RDMkit page on data sharing.\r\n    * Attempt to clarify difference between \"open\" and \"accessible\"\r\n    * Attempt to clarify difference between \"open\" and \"embargoed\"\r\n    * Added links to RDMkit Data Sharing page in a few places\r\n    * Added a few relevant questions\r\n\r\n### 2.3.0\r\n\r\nActivity during [BioHackathon Europe](biohackathon-europe.org) 2020 ([#BioHackEU20](twitter.com/search?q=%23BioHackEU20))\r\n\r\n* Added and tagged questions for Horizon 2020 template\r\n* Moved questions about collecting metadata to one consistent place\r\n* Added guidance on semantics in file names and question about using PIDs for identifying files\r\n* Generic small cleanups and typo fixes\r\n* Closing many issues of feedback received on the knowledge model (from [DSWGlobal/dsw](https://github.com/DSWGlobal/dsw))\r\n* Various question updates new options, clarifications, integrations\r\n* Added highly configurable [Wikidata](https://www.wikidata.org) SPARQL-based integration\r\n* Added [Research Organization Registry](https://ror.org) integration for contributor's affiliation\r\n\r\n### 2.2.0\r\n\r\n* Adjusted for compatibility with [RDA DMP Common Standard for machine-actionable DMPs (1.0)](https://github.com/RDA-DMP-Common/RDA-DMP-Common-Standard)\r\n  * Updated *Project* and *Funding* questions in *Administrative Details* chapter\r\n  * Reorganised *Dataset*, *Distribution*, *License* questions in *Data Publishing* chapter\r\n* Added *maDMP* tag to questions used in the RDA maDMP template\r\n\r\n### 2.1.0\r\n\r\n* Added *Science Europe DMP* tag to questions used in the Science Europe template\r\n\r\n### 2.0.2\r\n\r\n* Fixed missing and duplicated questions\r\n\r\n### 2.0.1\r\n\r\n* Fixed duplicated question in *Creating and collecting data* chapter (5ba53879-eb48-47f2-a73b-f7f7d83bf030)\r\n\r\n### 2.0.0\r\n\r\n* Added detailed questions for Science Europe DMPs\r\n* Fixed several typos and other minor problems\r\n* Added administrative chapter\r\n* Moving questions and refactoring according to [ds-km#24](https://github.com/ds-wizard/ds-km/pull/24)\r\n\r\n### 1.4.0\r\n\r\n* Adding integration for [FAIRsharing.org](https://fairsharing.org)\r\n* Adding 5 integration questions according to [ds-km@da5a8fc](https://github.com/ds-wizard/ds-km/commit/da5a8fc95d0a67f9369ce0b7727615115fc3656d)\r\n\r\nThe FAIRsharing integration requires configuration to contain `apiUrl` and `apiKey` for integration with id `fairsharing`.\r\n\r\n### 1.3.0\r\n\r\n* Refactoring list questions because of **deprecated item title** fields, i.e., a new question for item title created for each list question\r\n\r\nWhen using this version and higher, the DS Wizard configuration should have `itemTitleEnabled` set to `false`.\r\n\r\n### 1.2.0\r\n\r\n* Adding file naming SOP description question (9ff389f0-2236-48cf-880c-040ea1bb0d2f) to chapter 2 according to [ds-km@d879be0](https://github.com/ds-wizard/ds-km/commit/d879be0fa9d0808868396c649d03c4d783ac6742)\r\n\r\n### 1.1.0\r\n\r\n* Adding phases to questions (first draft) according to [ds-km@a6713d1](https://github.com/ds-wizard/ds-km/commit/a6713d1a4b9758bea63b3f7c56af5bd4f500d949) and [ds-km@1123211](https://github.com/ds-wizard/ds-km/commit/1123211bb5af43df8ef435039a2923f48e3e981c)\r\n\r\nPrior to this version, all questions were assigned with phase 2 - *Before submitting the DMP*.\r\n\r\n### 1.0.3\r\n\r\n* Fix: Removing extra question mark for a question (8018e15f-6c7e-433a-8686-ae0d695c7fc7) in chapter 5 according to: [ds-km@1123211](https://github.com/ds-wizard/ds-km/commit/1123211bb5af43df8ef435039a2923f48e3e981c)\r\n\r\n### 1.0.2\r\n\r\n* Fix: Adding some explanation to the list item questions (f5fef09d-ade5-4019-b089-f05bd89c34bc and b642c31d-a512-4ca7-8743-a2e0254006fa) in chapter 3 according to: [ds-km@96e28f4](https://github.com/ds-wizard/ds-km/commit/96e28f478d5dc6b59d384b5127f012dc2fe5f287)\r\n\r\n### 1.0.1\r\n\r\n* Fix: Adding forgotten question mark to end of question (39e0cc7c-17fe-4991-88d8-1280c3fe7923) in chapter 1 according to: [ds-km@644a373](https://github.com/ds-wizard/ds-km/commit/644a373685dc4ac15b76e86667a90151ca9c70ca)\r\n\r\n### 1.0.0\r\n\r\n* Initial version transformed from the previous DS-KM GitHub repository up to [ds-km@8442837](https://github.com/ds-wizard/ds-km/commit/8442837dbe3ff899b09e7d8d3fc1107e935a876f)","version":"2.3.12"},{"createdAt":"2022-03-08T12:45:58.043647Z","description":"DSW Knowledge Model originating from mindmap made by Rob Hooft","events":[{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Is extension of any consent for personal data needed?"}},"createdAt":"2022-03-08T12:22:12Z","entityUuid":"467ff3ad-156c-4285-9efb-c91072b3544e","parentUuid":"7fc8d3c9-a2d5-4d47-9df4-56af48ca85e1","uuid":"238550c2-8dee-4432-8a62-7f2b34963a8f"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2022-03-08T12:32:28Z","entityUuid":"685b203a-6173-46db-8eaf-9f584222e487","parentUuid":"4a3e9d91-240b-4eae-bc90-02c12a2a4744","uuid":"198f6995-28fa-4bfb-8d4b-d43937967341"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-03-08T12:33:05Z","entityUuid":"aa317b0d-72c4-43b2-8d66-7de926724925","parentUuid":"685b203a-6173-46db-8eaf-9f584222e487","uuid":"24be94c2-0d42-4f7b-a81b-ac6f9f89a377"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"No"},"metricMeasures":{"changed":false}},"createdAt":"2022-03-08T12:33:56Z","entityUuid":"aa317b0d-72c4-43b2-8d66-7de926724925","parentUuid":"685b203a-6173-46db-8eaf-9f584222e487","uuid":"34077440-e520-4f03-8f72-2ff7b257ab04"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-03-08T12:34:00Z","entityUuid":"3fe6d91b-3c48-49b5-93af-93b5fc86eaa7","parentUuid":"685b203a-6173-46db-8eaf-9f584222e487","uuid":"24e5eb6f-8df0-4cda-8946-1b299ef3fe6e"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Yes"},"metricMeasures":{"changed":false}},"createdAt":"2022-03-08T12:34:04Z","entityUuid":"3fe6d91b-3c48-49b5-93af-93b5fc86eaa7","parentUuid":"685b203a-6173-46db-8eaf-9f584222e487","uuid":"105ee581-e232-457f-b5ef-9c69d9d93825"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":true,"value":["685b203a-6173-46db-8eaf-9f584222e487","44b0de3f-b580-4dd0-9e9a-24864c8fe9c8","530124a4-c7e9-4821-b26d-32a8ecd0d978"]},"label":{"changed":false},"metricMeasures":{"changed":false}},"createdAt":"2022-03-08T12:34:31Z","entityUuid":"4a3e9d91-240b-4eae-bc90-02c12a2a4744","parentUuid":"7e77ee02-ce26-4cd9-b07d-3eea03bc35c9","uuid":"c7a7a214-eaa8-4833-83a9-99b77dcf30a1"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"It is advisable to make the result of your efforts available in a standard repository. If you answer 'yes' here, do not forget to mention the dataset under the chapter 'giving access to data'"},"title":{"changed":true,"value":"Will you be making the new computer-readable data available in a repository?"}},"createdAt":"2022-03-08T12:34:40Z","entityUuid":"685b203a-6173-46db-8eaf-9f584222e487","parentUuid":"4a3e9d91-240b-4eae-bc90-02c12a2a4744","uuid":"a0f58d5c-75da-4cb1-8de0-fe325eaa7286"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"It is advisable to make the result of your efforts available in a standard repository. If you answer 'yes' here, do not forget to mention the dataset under the chapter 'giving access to data'"},"title":{"changed":false}},"createdAt":"2022-03-08T12:37:18Z","entityUuid":"530124a4-c7e9-4821-b26d-32a8ecd0d978","parentUuid":"4a3e9d91-240b-4eae-bc90-02c12a2a4744","uuid":"4e09cf73-6151-481b-bf74-a42dc289a443"},{"content":{"eventType":"DeleteQuestionEvent"},"createdAt":"2022-03-08T12:37:20Z","entityUuid":"685b203a-6173-46db-8eaf-9f584222e487","parentUuid":"4a3e9d91-240b-4eae-bc90-02c12a2a4744","uuid":"cb4e1d37-55a8-4924-aedc-9650afd9578d"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":true,"value":["530124a4-c7e9-4821-b26d-32a8ecd0d978","44b0de3f-b580-4dd0-9e9a-24864c8fe9c8"]},"label":{"changed":false},"metricMeasures":{"changed":false}},"createdAt":"2022-03-08T12:37:32Z","entityUuid":"4a3e9d91-240b-4eae-bc90-02c12a2a4744","parentUuid":"7e77ee02-ce26-4cd9-b07d-3eea03bc35c9","uuid":"3b1edd81-7785-4280-b2bf-acadb4c0df44"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Yes, through a standard repository"},"metricMeasures":{"changed":false}},"createdAt":"2022-03-08T12:37:56Z","entityUuid":"dce00426-ea06-4aac-979e-ccefb9ba01f9","parentUuid":"530124a4-c7e9-4821-b26d-32a8ecd0d978","uuid":"119ce4be-50ae-4fa3-bfec-752edd2e6d8d"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-03-08T12:38:07Z","entityUuid":"790dbcb1-69fb-4aac-bffc-4b7dd8b24aaa","parentUuid":"530124a4-c7e9-4821-b26d-32a8ecd0d978","uuid":"8f3b64d3-faee-434e-977b-604e4e21c9dd"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Yes, through other means"},"metricMeasures":{"changed":true,"value":[{"measure":0.5,"metricUuid":"0bafe0c2-a8f2-4c74-80c8-dbf3a5b8e9b7","weight":1}]}},"createdAt":"2022-03-08T12:38:33Z","entityUuid":"790dbcb1-69fb-4aac-bffc-4b7dd8b24aaa","parentUuid":"530124a4-c7e9-4821-b26d-32a8ecd0d978","uuid":"09a588fc-f3e4-44f7-bea1-9f06268e1a45"},{"content":{"advice":{"changed":true,"value":"If the data is published in a standard repository, that repository will tell you which metadata standards to use."},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":false},"metricMeasures":{"changed":false}},"createdAt":"2022-03-08T12:39:25Z","entityUuid":"69b0dc80-4b80-4fe6-b162-2a3eff9e133e","parentUuid":"44b0de3f-b580-4dd0-9e9a-24864c8fe9c8","uuid":"8d5b699f-ef31-41eb-867c-a71d1c6a198f"}],"forkOfPackageId":null,"id":"dsw:root:2.3.13","kmId":"root","language":"en","license":"Apache-2.0","mergeCheckpointPackageId":null,"metamodelVersion":20,"name":"Common DSW Knowledge Model","nonEditable":false,"organizationId":"dsw","phase":"DeprecatedKnowledgeModelPackagePhase","previousPackageId":"dsw:root:2.3.12","readme":"# Common DSW Knowledge Model\r\n\r\nCommon DSW Knowledge Model deals with questions that a researcher should answer in order to create a Data Stewardship Plan, as well as other related questionnaire data. It originated from mindmap made by Rob Hooft.\r\n\r\n## Changelog\r\n\r\n### 2.3.13\r\n\r\n* Incorporating changes related to the Data Reuse workshop with RDMkit\r\n\r\n### 2.3.12\r\n\r\n* Incorporating changes related to the Data Analytics workshop with RDMkit\r\n\r\n### 2.3.11\r\n\r\n* Incorporating changes made in the Plant Sciences workshop with RDMkit\r\n\r\n### 2.3.10\r\n\r\n* Added references and questions from an RDMkit/DS Wizard working session on Preserving Data\r\n\r\n### 2.3.9\r\n\r\n* Fix missing Yes/No answers and use Text-Value for description of policies\r\n\r\n### 2.3.8\r\n\r\n* Questions for Horizon Europe added on budget for data management, other policies that are observed, persistent identifier allocation and archive preservation policies [Marek/Jana Horizon Europe issues 7-9, 11]\r\n\r\n### 2.3.7\r\n\r\n* Added references and questions from an RDMkit/DS Wizard working session on Human Data\r\n\r\n### 2.3.6\r\n\r\n* Questions about metadata for Horizon Europe added [Marek/Jana Horizon Europe issues 4-6]\r\n\r\n### 2.3.5\r\n\r\n* Added Tag for Horizon Europe\r\n* Moved the new questions from 2.3.4 from \"Science Europe\" to \"Horizon Europe\"\r\n* Added new question about qualified references from published data sets [Marek/Jana Horizon Europe issue 3]\r\n\r\n### 2.3.4\r\n\r\n* Change lists of reused (non-)reference datasets that are reused into lists of considered datasets, and add a question for each detailing whether they are actually reused and what for / why not. This is to be included in the Science Europe template [Marek/Jana Horizon Europe issue 1 and 2].\r\n\r\n### 2.3.3\r\n\r\n* Incorporation of changes from a collaborative workshop with RDMkit participants on data processing.\r\n   * Added links to RDMkit (and some to other external resources) in several places\r\n   * Clarified some questions\r\n   * Added question on data versioning for filesystems\r\n\r\n### 2.3.2\r\n\r\n* Incorporation of changes from a workshop with the authors of the RDMkit page on data collecting.\r\n   * Added links to RDMkit in several places\r\n   * Clarified some questions\r\n   * Moved questions on quality together\r\n   * Moved some questions out of the metadata subsection\r\n\r\n### 2.3.1\r\n\r\n* Incorporation of changes from a workshop with the authors of the RDMkit page on data sharing.\r\n    * Attempt to clarify difference between \"open\" and \"accessible\"\r\n    * Attempt to clarify difference between \"open\" and \"embargoed\"\r\n    * Added links to RDMkit Data Sharing page in a few places\r\n    * Added a few relevant questions\r\n\r\n### 2.3.0\r\n\r\nActivity during [BioHackathon Europe](biohackathon-europe.org) 2020 ([#BioHackEU20](twitter.com/search?q=%23BioHackEU20))\r\n\r\n* Added and tagged questions for Horizon 2020 template\r\n* Moved questions about collecting metadata to one consistent place\r\n* Added guidance on semantics in file names and question about using PIDs for identifying files\r\n* Generic small cleanups and typo fixes\r\n* Closing many issues of feedback received on the knowledge model (from [DSWGlobal/dsw](https://github.com/DSWGlobal/dsw))\r\n* Various question updates new options, clarifications, integrations\r\n* Added highly configurable [Wikidata](https://www.wikidata.org) SPARQL-based integration\r\n* Added [Research Organization Registry](https://ror.org) integration for contributor's affiliation\r\n\r\n### 2.2.0\r\n\r\n* Adjusted for compatibility with [RDA DMP Common Standard for machine-actionable DMPs (1.0)](https://github.com/RDA-DMP-Common/RDA-DMP-Common-Standard)\r\n  * Updated *Project* and *Funding* questions in *Administrative Details* chapter\r\n  * Reorganised *Dataset*, *Distribution*, *License* questions in *Data Publishing* chapter\r\n* Added *maDMP* tag to questions used in the RDA maDMP template\r\n\r\n### 2.1.0\r\n\r\n* Added *Science Europe DMP* tag to questions used in the Science Europe template\r\n\r\n### 2.0.2\r\n\r\n* Fixed missing and duplicated questions\r\n\r\n### 2.0.1\r\n\r\n* Fixed duplicated question in *Creating and collecting data* chapter (5ba53879-eb48-47f2-a73b-f7f7d83bf030)\r\n\r\n### 2.0.0\r\n\r\n* Added detailed questions for Science Europe DMPs\r\n* Fixed several typos and other minor problems\r\n* Added administrative chapter\r\n* Moving questions and refactoring according to [ds-km#24](https://github.com/ds-wizard/ds-km/pull/24)\r\n\r\n### 1.4.0\r\n\r\n* Adding integration for [FAIRsharing.org](https://fairsharing.org)\r\n* Adding 5 integration questions according to [ds-km@da5a8fc](https://github.com/ds-wizard/ds-km/commit/da5a8fc95d0a67f9369ce0b7727615115fc3656d)\r\n\r\nThe FAIRsharing integration requires configuration to contain `apiUrl` and `apiKey` for integration with id `fairsharing`.\r\n\r\n### 1.3.0\r\n\r\n* Refactoring list questions because of **deprecated item title** fields, i.e., a new question for item title created for each list question\r\n\r\nWhen using this version and higher, the DS Wizard configuration should have `itemTitleEnabled` set to `false`.\r\n\r\n### 1.2.0\r\n\r\n* Adding file naming SOP description question (9ff389f0-2236-48cf-880c-040ea1bb0d2f) to chapter 2 according to [ds-km@d879be0](https://github.com/ds-wizard/ds-km/commit/d879be0fa9d0808868396c649d03c4d783ac6742)\r\n\r\n### 1.1.0\r\n\r\n* Adding phases to questions (first draft) according to [ds-km@a6713d1](https://github.com/ds-wizard/ds-km/commit/a6713d1a4b9758bea63b3f7c56af5bd4f500d949) and [ds-km@1123211](https://github.com/ds-wizard/ds-km/commit/1123211bb5af43df8ef435039a2923f48e3e981c)\r\n\r\nPrior to this version, all questions were assigned with phase 2 - *Before submitting the DMP*.\r\n\r\n### 1.0.3\r\n\r\n* Fix: Removing extra question mark for a question (8018e15f-6c7e-433a-8686-ae0d695c7fc7) in chapter 5 according to: [ds-km@1123211](https://github.com/ds-wizard/ds-km/commit/1123211bb5af43df8ef435039a2923f48e3e981c)\r\n\r\n### 1.0.2\r\n\r\n* Fix: Adding some explanation to the list item questions (f5fef09d-ade5-4019-b089-f05bd89c34bc and b642c31d-a512-4ca7-8743-a2e0254006fa) in chapter 3 according to: [ds-km@96e28f4](https://github.com/ds-wizard/ds-km/commit/96e28f478d5dc6b59d384b5127f012dc2fe5f287)\r\n\r\n### 1.0.1\r\n\r\n* Fix: Adding forgotten question mark to end of question (39e0cc7c-17fe-4991-88d8-1280c3fe7923) in chapter 1 according to: [ds-km@644a373](https://github.com/ds-wizard/ds-km/commit/644a373685dc4ac15b76e86667a90151ca9c70ca)\r\n\r\n### 1.0.0\r\n\r\n* Initial version transformed from the previous DS-KM GitHub repository up to [ds-km@8442837](https://github.com/ds-wizard/ds-km/commit/8442837dbe3ff899b09e7d8d3fc1107e935a876f)","version":"2.3.13"},{"createdAt":"2022-03-10T12:55:37.12445Z","description":"DSW Knowledge Model originating from mindmap made by Rob Hooft","events":[{"content":{"eventType":"DeleteQuestionEvent"},"createdAt":"2022-02-05T12:00:01Z","entityUuid":"7ffcfc57-b4ad-4638-ab19-11fe57b841a0","parentUuid":"4e0c1edf-660c-4ebf-81f5-9fa959dead30","uuid":"0fde2138-77ce-4d3a-a2ca-8a38e4a1df96"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["3c7bdc90-8ed3-4b34-90ec-7945d14cc443","fd4637a2-a117-460a-a7fa-c03760c42629","87bb2042-8e3c-4733-ba1e-84509d7b1cf4"]},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2022-02-05T12:00:02Z","entityUuid":"c10f9098-5b1c-4abc-adaa-bdef2fb537ca","parentUuid":"b3739ebd-2d8e-42d3-9425-a7d6d1b26c79","uuid":"d5ee8bdd-8e1e-4d43-ba69-2d21e2527a73"},{"content":{"annotations":{"changed"