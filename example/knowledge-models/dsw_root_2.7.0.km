,"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"No"},"metricMeasures":{"changed":false}},"createdAt":"2022-02-28T14:44:46Z","entityUuid":"022c62eb-9591-4290-b84f-e594086c2cd7","parentUuid":"0dda3f9c-7567-47c8-8726-23fdfbe67e33","uuid":"9930c014-affa-4573-93e5-89b1ff9266ed"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-02-28T14:44:47Z","entityUuid":"9723bfe4-d9a7-4f11-9b02-907a5cdb3810","parentUuid":"312ad81e-a274-4523-a6b2-2299e56422b7","uuid":"b5bd40b9-00b1-4c83-9d79-ba84cc274188"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"No, separate for each cohort"},"metricMeasures":{"changed":false}},"createdAt":"2022-02-28T14:44:48Z","entityUuid":"9723bfe4-d9a7-4f11-9b02-907a5cdb3810","parentUuid":"312ad81e-a274-4523-a6b2-2299e56422b7","uuid":"995c125f-7533-4437-8e43-c89def54538f"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Who are the data controller(s) of the personal data processed in the project?"}},"createdAt":"2022-02-28T14:44:49Z","entityUuid":"eccb8305-b78e-4e60-a4ee-094c70003b7a","parentUuid":"7dd7320e-41dd-43b9-b6aa-7622eaa34679","uuid":"bb87c253-3d0e-4d46-aca6-4e6baf8aeef8"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-02-28T14:44:50Z","entityUuid":"57a9a008-d0b0-4716-bf26-13e6eb80dc36","parentUuid":"312ad81e-a274-4523-a6b2-2299e56422b7","uuid":"244fc50a-71bf-4b28-93ee-0c83ba24ea42"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"There is only one controller"},"metricMeasures":{"changed":false}},"createdAt":"2022-02-28T14:44:51Z","entityUuid":"57a9a008-d0b0-4716-bf26-13e6eb80dc36","parentUuid":"312ad81e-a274-4523-a6b2-2299e56422b7","uuid":"57b766aa-7431-44cb-9fed-c971dec0f82b"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Limitations of use / Data use restrictions"}},"createdAt":"2022-02-28T14:44:52Z","entityUuid":"a08da7f5-2530-4c09-82f0-31296d7c7779","parentUuid":"7dd7320e-41dd-43b9-b6aa-7622eaa34679","uuid":"b2fbb963-226d-43aa-a981-919ac22de5cc"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2022-02-28T14:44:53Z","entityUuid":"c6e30ba1-10d6-4f3c-b81a-5f2b362f74cd","parentUuid":"7dd7320e-41dd-43b9-b6aa-7622eaa34679","uuid":"81d4cbf7-3b1c-4a02-b9ae-f82a093e4e9d"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["4fa6f10d-b593-4b00-84cf-00d7f916147f"]},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2022-02-28T14:44:54Z","entityUuid":"71ed370c-aa20-4958-ab23-bb852076d331","parentUuid":"7c215b23-edb9-4fc7-95d1-010ee53f3853","uuid":"3d8a425d-112c-4506-b526-239ed5cadb2a"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["4fa6f10d-b593-4b00-84cf-00d7f916147f"]},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2022-02-28T14:44:55Z","entityUuid":"a08da7f5-2530-4c09-82f0-31296d7c7779","parentUuid":"7dd7320e-41dd-43b9-b6aa-7622eaa34679","uuid":"3d919500-0223-4959-a7eb-c880220868c8"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Will this data set be archived?"}},"createdAt":"2022-02-28T14:44:56Z","entityUuid":"7ffcfc57-b4ad-4638-ab19-11fe57b841a0","parentUuid":"4e0c1edf-660c-4ebf-81f5-9fa959dead30","uuid":"a2680912-2a1e-4304-a23f-1396db269f18"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["4fa6f10d-b593-4b00-84cf-00d7f916147f"]},"text":{"changed":true,"value":"Note: A data processing agreement has to contain the obligatory clauses specified in [Art 28.3 of the\nGDPR](https://gdpr-info.eu/art-28-gdpr/). The agreement should also regulate the use of any sub-processors.\n\n[Article 4](https://gdpr-info.eu/art-4-gdpr/) (8): *“**‘processor’** means a natural or legal person, public authority, agency or other body which processes personal data on behalf of the controller.”* Examples of this is if you use a secure computing environment provided by another organisation to do your analysis or to store the data, along with several other scenarios. In the case that you do, there needs to be a legal agreement established between the controller(s) and processor(s) as defined in [Article 28](https://gdpr-info.eu/art-28-gdpr/) (3): *“Processing by a processor shall be governed by a contract or other legal act under Union or Member State law, that is binding on the processor with regard to the controller and that sets out the subject-matter and duration of the processing, the nature and purpose of the processing, the type of personal data and categories of data subjects and the obligations and rights of the controller. […]”* Article 28 also lists the required contents of such an agreement. Your organisation and/or the processor organisation will probably have agreement templates that you can use."},"title":{"changed":true,"value":"Have data processing agreements been established between the data controller(s) and any data processors?"}},"createdAt":"2022-02-28T14:44:57Z","entityUuid":"c6e30ba1-10d6-4f3c-b81a-5f2b362f74cd","parentUuid":"7dd7320e-41dd-43b9-b6aa-7622eaa34679","uuid":"51ece172-6a06-43d8-97f6-907be43be8fa"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-02-28T14:44:58Z","entityUuid":"9f9124e0-dae8-4405-9e97-64d5e054ae4b","parentUuid":"c6e30ba1-10d6-4f3c-b81a-5f2b362f74cd","uuid":"3dfaf3f5-9627-443a-bf0a-3727bbcd5d74"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Yes"},"metricMeasures":{"changed":false}},"createdAt":"2022-02-28T14:44:59Z","entityUuid":"9f9124e0-dae8-4405-9e97-64d5e054ae4b","parentUuid":"c6e30ba1-10d6-4f3c-b81a-5f2b362f74cd","uuid":"c33b2429-a6db-43d4-ac73-16df5214410c"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2022-02-28T14:45:00Z","entityUuid":"a21efb45-5238-4e9a-a00c-28d3d88d801b","parentUuid":"9f9124e0-dae8-4405-9e97-64d5e054ae4b","uuid":"1bdb3769-c371-4b12-b860-dcfc66307fbc"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["4fa6f10d-b593-4b00-84cf-00d7f916147f"]},"text":{"changed":false},"title":{"changed":true,"value":"List processors and agreements established"}},"createdAt":"2022-02-28T14:45:01Z","entityUuid":"a21efb45-5238-4e9a-a00c-28d3d88d801b","parentUuid":"9f9124e0-dae8-4405-9e97-64d5e054ae4b","uuid":"03f5f9c5-fb0d-4394-8514-f6bfc279ed19"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2022-02-28T14:45:02Z","entityUuid":"8c27e2cc-d2a7-45da-9829-aa22566bb34b","parentUuid":"a21efb45-5238-4e9a-a00c-28d3d88d801b","uuid":"30783ce0-caf6-4828-9b15-e06d941af34f"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Processors"}},"createdAt":"2022-02-28T14:45:03Z","entityUuid":"8c27e2cc-d2a7-45da-9829-aa22566bb34b","parentUuid":"a21efb45-5238-4e9a-a00c-28d3d88d801b","uuid":"d61c0402-c7ab-4c82-b3e9-a835b21d77bb"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["4fa6f10d-b593-4b00-84cf-00d7f916147f"]},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":true,"value":"TextQuestionValueType"}},"createdAt":"2022-02-28T14:45:04Z","entityUuid":"8c27e2cc-d2a7-45da-9829-aa22566bb34b","parentUuid":"a21efb45-5238-4e9a-a00c-28d3d88d801b","uuid":"78088837-68c7-4110-8b75-ce52a0f43eee"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2022-02-28T14:45:05Z","entityUuid":"bd886f8e-7825-4f98-afb2-6079ae15c8ed","parentUuid":"a21efb45-5238-4e9a-a00c-28d3d88d801b","uuid":"c69b7c66-ef18-4586-9435-1f284e0e266b"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["4fa6f10d-b593-4b00-84cf-00d7f916147f"]},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":true,"value":"TextQuestionValueType"}},"createdAt":"2022-02-28T14:45:06Z","entityUuid":"bd886f8e-7825-4f98-afb2-6079ae15c8ed","parentUuid":"a21efb45-5238-4e9a-a00c-28d3d88d801b","uuid":"a496d329-18bb-4084-93cb-cbfaeeff17fb"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-02-28T14:45:07Z","entityUuid":"aa88e146-e460-4611-898d-3f015df27780","parentUuid":"c6e30ba1-10d6-4f3c-b81a-5f2b362f74cd","uuid":"554fdf9b-000f-403d-9a69-c8bef2eb2795"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Not relevant"},"metricMeasures":{"changed":false}},"createdAt":"2022-02-28T14:45:08Z","entityUuid":"aa88e146-e460-4611-898d-3f015df27780","parentUuid":"c6e30ba1-10d6-4f3c-b81a-5f2b362f74cd","uuid":"e777e5ba-5c75-4a50-b840-ef82fe6e1856"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2022-02-28T14:45:09Z","entityUuid":"6cc96576-2535-46b3-8c9b-a12703ee96cc","parentUuid":"7dd7320e-41dd-43b9-b6aa-7622eaa34679","uuid":"2258e5d5-2b86-4683-9a1b-45492a258386"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["4fa6f10d-b593-4b00-84cf-00d7f916147f"]},"text":{"changed":true,"value":"Where a type of processing is likely to result in a high risk to the rights and freedoms of natural persons, the controller shall, prior to the processing, carry out an assessment of the impact of the envisaged processing operations on the protection of personal data, a so called **Data Protection Impact Assessment** (DPIA) - [Article 35](https://gdpr-info.eu/art-35-gdpr/).\n\nNote: Most types of research projects on health or genetic data require a DPIA, especially large-scale processing of sensitive data. The French Data Protection Authority (DPA) has made a [PIA tool](https://www.cnil.fr/en/open-source-pia-software-helps-carry-out-data-protection-impact-assesment) (endorsed by several other DPAs) available that can help in performing these impact assessments. Please also consult your Data Protection Officer of your organisation."},"title":{"changed":true,"value":"Have Data Protection Impact Assessments (DPIA) been performed for the personal data?"}},"createdAt":"2022-02-28T14:45:10Z","entityUuid":"6cc96576-2535-46b3-8c9b-a12703ee96cc","parentUuid":"7dd7320e-41dd-43b9-b6aa-7622eaa34679","uuid":"68d3b301-e886-4e4e-ab75-27098cf0e3b8"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-02-28T14:45:11Z","entityUuid":"af053acd-fc24-4830-8000-bcff8912435b","parentUuid":"6cc96576-2535-46b3-8c9b-a12703ee96cc","uuid":"d867a3f8-50ca-4b9f-836a-0ede45195a9f"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Yes"},"metricMeasures":{"changed":false}},"createdAt":"2022-02-28T14:45:12Z","entityUuid":"af053acd-fc24-4830-8000-bcff8912435b","parentUuid":"6cc96576-2535-46b3-8c9b-a12703ee96cc","uuid":"dc5e299e-9e5c-401e-97bc-f69663cb7da6"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2022-02-28T14:45:13Z","entityUuid":"8cc50031-87d5-4b0e-8c3c-c7ded35fd263","parentUuid":"af053acd-fc24-4830-8000-bcff8912435b","uuid":"243a5364-c380-4348-b17e-f2034ab6e4f8"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"List DPIAs done and for which parts of the data."}},"createdAt":"2022-02-28T14:45:14Z","entityUuid":"8cc50031-87d5-4b0e-8c3c-c7ded35fd263","parentUuid":"af053acd-fc24-4830-8000-bcff8912435b","uuid":"79dc8edd-4181-4ec8-944f-84d869ceb4e1"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["4fa6f10d-b593-4b00-84cf-00d7f916147f"]},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2022-02-28T14:45:15Z","entityUuid":"8cc50031-87d5-4b0e-8c3c-c7ded35fd263","parentUuid":"af053acd-fc24-4830-8000-bcff8912435b","uuid":"1ba3841b-7363-4bad-af1b-4edebb000e61"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2022-02-28T14:45:16Z","entityUuid":"fa72bb87-0403-4953-9536-4ac836843763","parentUuid":"8cc50031-87d5-4b0e-8c3c-c7ded35fd263","uuid":"a482b57e-fd57-47a2-bd33-845a6bd27fce"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["4fa6f10d-b593-4b00-84cf-00d7f916147f"]},"text":{"changed":false},"title":{"changed":true,"value":"Dataset"},"validations":{"changed":false},"valueType":{"changed":true,"value":"TextQuestionValueType"}},"createdAt":"2022-02-28T14:45:17Z","entityUuid":"fa72bb87-0403-4953-9536-4ac836843763","parentUuid":"8cc50031-87d5-4b0e-8c3c-c7ded35fd263","uuid":"e61df8d5-0bd6-4b94-bdf6-a61c5ef6dd44"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2022-02-28T14:45:18Z","entityUuid":"432c867e-8f29-47e6-9078-05bdf3d3fcb0","parentUuid":"8cc50031-87d5-4b0e-8c3c-c7ded35fd263","uuid":"419dd3ae-5bdc-4a35-94ac-b093be9b754e"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["4fa6f10d-b593-4b00-84cf-00d7f916147f"]},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":true,"value":"TextQuestionValueType"}},"createdAt":"2022-02-28T14:45:19Z","entityUuid":"432c867e-8f29-47e6-9078-05bdf3d3fcb0","parentUuid":"8cc50031-87d5-4b0e-8c3c-c7ded35fd263","uuid":"dabea65c-a87d-455b-8fce-3337ae23a4b0"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-02-28T14:45:20Z","entityUuid":"feb5bdea-9317-4fdd-8781-c26ce6e55fbf","parentUuid":"6cc96576-2535-46b3-8c9b-a12703ee96cc","uuid":"cd4d3544-261f-46c4-8e53-6bfa97def5c0"},{"content":{"advice":{"changed":true,"value":"Please reconsider"},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"No"},"metricMeasures":{"changed":false}},"createdAt":"2022-02-28T14:45:21Z","entityUuid":"feb5bdea-9317-4fdd-8781-c26ce6e55fbf","parentUuid":"6cc96576-2535-46b3-8c9b-a12703ee96cc","uuid":"51fc55a4-7d52-4241-895c-96ef8ca731ac"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2022-02-28T14:45:22Z","entityUuid":"3d09f311-07dd-49a0-8445-5eab8f9548fc","parentUuid":"af053acd-fc24-4830-8000-bcff8912435b","uuid":"9a86d1bf-a18c-4907-aed3-6ee99754aae2"},{"content":{"annotations":{"changed":false},"choiceUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"MultiChoiceQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["4fa6f10d-b593-4b00-84cf-00d7f916147f"]},"text":{"changed":true,"value":"Below listed are 9 criteria - provided by the EC - that might indicate that your project constitutes **high risk processing**.  Please check the indicators that apply your project. Consult the linked EC Guideline for explanations of indicators."},"title":{"changed":true,"value":"Why is a DPIA deemed necessary for this project?"}},"createdAt":"2022-02-28T14:45:23Z","entityUuid":"3d09f311-07dd-49a0-8445-5eab8f9548fc","parentUuid":"af053acd-fc24-4830-8000-bcff8912435b","uuid":"f300e326-c0bf-4939-9667-654ee4dbd78f"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2022-02-28T14:45:24Z","entityUuid":"8fe4a165-09a6-4e5d-835d-3255db21d0de","parentUuid":"3d09f311-07dd-49a0-8445-5eab8f9548fc","uuid":"160a6901-1993-4225-952d-ad1ed774122c"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"EC Guidelines on DPIAs"},"referenceType":"URLReference","url":{"changed":true,"value":"https://ec.europa.eu/newsroom/article29/items/611236/en"}},"createdAt":"2022-02-28T14:45:25Z","entityUuid":"8fe4a165-09a6-4e5d-835d-3255db21d0de","parentUuid":"3d09f311-07dd-49a0-8445-5eab8f9548fc","uuid":"bf9cee80-23bd-4949-96c5-cacd17dd7015"},{"content":{"annotations":[],"eventType":"AddChoiceEvent","label":""},"createdAt":"2022-02-28T14:45:26Z","entityUuid":"7dd41e34-b8fb-4d4a-9dde-eb0954d9718f","parentUuid":"3d09f311-07dd-49a0-8445-5eab8f9548fc","uuid":"a5e9ed20-9e07-4de3-b488-89f71c77d206"},{"content":{"annotations":{"changed":false},"eventType":"EditChoiceEvent","label":{"changed":true,"value":"Data concerning vulnerable data subjects including minors, employees, elderly, mentally incapacitated, patients receiving care. "}},"createdAt":"2022-02-28T14:45:27Z","entityUuid":"7dd41e34-b8fb-4d4a-9dde-eb0954d9718f","parentUuid":"3d09f311-07dd-49a0-8445-5eab8f9548fc","uuid":"01a22896-abc2-4872-89eb-03d0334e8914"},{"content":{"annotations":[],"eventType":"AddChoiceEvent","label":""},"createdAt":"2022-02-28T14:45:28Z","entityUuid":"1b4fef4e-73ba-4f59-8234-92879a6f09d9","parentUuid":"3d09f311-07dd-49a0-8445-5eab8f9548fc","uuid":"25fbc492-d91d-4eb1-aa54-39ce9b69fe12"},{"content":{"annotations":{"changed":false},"eventType":"EditChoiceEvent","label":{"changed":true,"value":"Sensitive data or data of a highly personal nature: which includes racial or ethnic origin; political opinions; religious or philosophical beliefs; trade union membership; genetic data; data concerning health; biometric data; sexual orientation. "}},"createdAt":"2022-02-28T14:45:29Z","entityUuid":"1b4fef4e-73ba-4f59-8234-92879a6f09d9","parentUuid":"3d09f311-07dd-49a0-8445-5eab8f9548fc","uuid":"d919bf6a-1a74-445b-bc13-544f37582914"},{"content":{"annotations":[],"eventType":"AddChoiceEvent","label":""},"createdAt":"2022-02-28T14:45:30Z","entityUuid":"63285783-9635-4c55-a781-33f81eff6e9d","parentUuid":"3d09f311-07dd-49a0-8445-5eab8f9548fc","uuid":"f76bb6f4-fec8-4450-8389-975a9ca99499"},{"content":{"annotations":{"changed":false},"eventType":"EditChoiceEvent","label":{"changed":true,"value":"Data processed on a large scale: data of proportion of the relevant population, long term processing, wide geographical scale, large volume or range of data ."}},"createdAt":"2022-02-28T14:45:31Z","entityUuid":"63285783-9635-4c55-a781-33f81eff6e9d","parentUuid":"3d09f311-07dd-49a0-8445-5eab8f9548fc","uuid":"389463cd-e1e7-44d4-8cfb-d6727d561c67"},{"content":{"annotations":[],"eventType":"AddChoiceEvent","label":""},"createdAt":"2022-02-28T14:45:32Z","entityUuid":"cee31df6-624a-4569-ae32-fad3d74dc169","parentUuid":"3d09f311-07dd-49a0-8445-5eab8f9548fc","uuid":"b3692477-a7f3-4b5a-9742-cdfc867df566"},{"content":{"annotations":{"changed":false},"eventType":"EditChoiceEvent","label":{"changed":true,"value":"Automated-decision making with legal or similar significant effect on data subjects."}},"createdAt":"2022-02-28T14:45:33Z","entityUuid":"cee31df6-624a-4569-ae32-fad3d74dc169","parentUuid":"3d09f311-07dd-49a0-8445-5eab8f9548fc","uuid":"7b0b8db6-8e35-4b4a-aa21-52fa2c23a72e"},{"content":{"annotations":[],"eventType":"AddChoiceEvent","label":""},"createdAt":"2022-02-28T14:45:34Z","entityUuid":"5c331845-fc91-40a0-b8b0-4d55a0664b7b","parentUuid":"3d09f311-07dd-49a0-8445-5eab8f9548fc","uuid":"e640c523-a9d5-4a14-9f1c-81774213fa41"},{"content":{"annotations":{"changed":false},"eventType":"EditChoiceEvent","label":{"changed":true,"value":"Evaluation or scoring on aspects concerning the data subject's performance at work, economic situation, health, personal preferences or interests, reliability or behavior, location or movements."}},"createdAt":"2022-02-28T14:45:35Z","entityUuid":"5c331845-fc91-40a0-b8b0-4d55a0664b7b","parentUuid":"3d09f311-07dd-49a0-8445-5eab8f9548fc","uuid":"6e550e3e-2f4d-4f39-9cdd-116273ef77d0"},{"content":{"annotations":[],"eventType":"AddChoiceEvent","label":""},"createdAt":"2022-02-28T14:45:36Z","entityUuid":"41d2caa6-14b5-4536-86d6-63f54999e604","parentUuid":"3d09f311-07dd-49a0-8445-5eab8f9548fc","uuid":"3312df65-ff5f-4898-891b-db8886657ee2"},{"content":{"annotations":{"changed":false},"eventType":"EditChoiceEvent","label":{"changed":true,"value":"Systematic monitoring, processing used to observe, monitor or control data subjects, including data collected through networks."}},"createdAt":"2022-02-28T14:45:37Z","entityUuid":"41d2caa6-14b5-4536-86d6-63f54999e604","parentUuid":"3d09f311-07dd-49a0-8445-5eab8f9548fc","uuid":"403e18ca-375c-4c0b-b915-b114b44a7edb"},{"content":{"annotations":[],"eventType":"AddChoiceEvent","label":""},"createdAt":"2022-02-28T14:45:38Z","entityUuid":"fcf05e2f-b25b-45a3-a2fe-460618e3ee7f","parentUuid":"3d09f311-07dd-49a0-8445-5eab8f9548fc","uuid":"8324a805-7814-4bcf-8fee-36d523780b2b"},{"content":{"annotations":{"changed":false},"eventType":"EditChoiceEvent","label":{"changed":true,"value":"Matching or combining datasets, for example originating from two or more data processing operations performed for different purposes."}},"createdAt":"2022-02-28T14:45:39Z","entityUuid":"fcf05e2f-b25b-45a3-a2fe-460618e3ee7f","parentUuid":"3d09f311-07dd-49a0-8445-5eab8f9548fc","uuid":"3116ce9e-12e0-449d-83b6-9333a54e3e9d"},{"content":{"annotations":[],"eventType":"AddChoiceEvent","label":""},"createdAt":"2022-02-28T14:45:40Z","entityUuid":"f2919725-27cf-4c43-a04b-69a47eb1f852","parentUuid":"3d09f311-07dd-49a0-8445-5eab8f9548fc","uuid":"e41ebac4-b2c8-42c5-a96e-6b7e2a64ae37"},{"content":{"annotations":{"changed":false},"eventType":"EditChoiceEvent","label":{"changed":true,"value":"Innovative use or applying new technological or organisational solutions, like combining the use of finger print and face recognition for physical access control.  "}},"createdAt":"2022-02-28T14:45:41Z","entityUuid":"f2919725-27cf-4c43-a04b-69a47eb1f852","parentUuid":"3d09f311-07dd-49a0-8445-5eab8f9548fc","uuid":"177de6ef-be25-41ed-8a5b-8ea7dfeacc9d"},{"content":{"annotations":[],"eventType":"AddChoiceEvent","label":""},"createdAt":"2022-02-28T14:45:42Z","entityUuid":"9e3d02c8-3a93-4e95-b724-36ed315efb69","parentUuid":"3d09f311-07dd-49a0-8445-5eab8f9548fc","uuid":"eddc8b8b-941e-47a6-ab49-f4b89ad6c0e0"},{"content":{"annotations":{"changed":false},"eventType":"EditChoiceEvent","label":{"changed":true,"value":"Processing that prevents data subjects from exercising a right or using a service or a contract."}},"createdAt":"2022-02-28T14:45:43Z","entityUuid":"9e3d02c8-3a93-4e95-b724-36ed315efb69","parentUuid":"3d09f311-07dd-49a0-8445-5eab8f9548fc","uuid":"f995cd90-5615-4bac-8ebc-d86687b5f819"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2022-02-28T14:45:44Z","entityUuid":"a30f5047-33c1-45a7-8b3f-b1b90c364fc9","parentUuid":"7dd7320e-41dd-43b9-b6aa-7622eaa34679","uuid":"5ea052e5-64ab-4e20-8e18-9bb2531eb965"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["4fa6f10d-b593-4b00-84cf-00d7f916147f"]},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":true,"value":"TextQuestionValueType"}},"createdAt":"2022-02-28T14:45:45Z","entityUuid":"a30f5047-33c1-45a7-8b3f-b1b90c364fc9","parentUuid":"7dd7320e-41dd-43b9-b6aa-7622eaa34679","uuid":"ac61851f-7ef8-4ece-aa79-5055f27f5920"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2022-02-28T14:45:46Z","entityUuid":"ed5c4f40-0c07-4bc3-bfdc-10ded3e8a6a8","parentUuid":"7dd7320e-41dd-43b9-b6aa-7622eaa34679","uuid":"2b39be06-66b4-4b7c-b601-5d8add021028"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["4fa6f10d-b593-4b00-84cf-00d7f916147f"]},"text":{"changed":true,"value":"The GDPR states that the processing (including storing) of personal data should stop when the intended purpose of the processing is done. There are, however, exemptions to this e.g. when the processing is done for research purposes. Also, from a research ethics point of view, research data should be kept to make it possible for others to validate published research findings and reuse data for new discoveries. This is also governed by what the data subjects have been informed about regarding how you will treat the data after project completion. The recommendation is to deposit the sensitive data in the appropriate controlled access repositories if such are available, but this requires that the data subjects are informed and have agreed to this."},"title":{"changed":true,"value":"What happens with the data after project completion?"}},"createdAt":"2022-02-28T14:45:47Z","entityUuid":"ed5c4f40-0c07-4bc3-bfdc-10ded3e8a6a8","parentUuid":"7dd7320e-41dd-43b9-b6aa-7622eaa34679","uuid":"7ffd6b92-ea0d-4794-9530-ae9ca1da8002"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2022-02-28T14:45:48Z","entityUuid":"3d071155-85d7-4a08-bdaa-5aa64fac0cef","parentUuid":"ed5c4f40-0c07-4bc3-bfdc-10ded3e8a6a8","uuid":"df401695-3d85-46ed-9b5f-6ed89ebe81a4"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Select action"}},"createdAt":"2022-02-28T14:45:49Z","entityUuid":"3d071155-85d7-4a08-bdaa-5aa64fac0cef","parentUuid":"ed5c4f40-0c07-4bc3-bfdc-10ded3e8a6a8","uuid":"01440c2e-4caf-49f0-9735-aa260d400255"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-02-28T14:45:50Z","entityUuid":"c70eeb16-2c8f-4672-95a2-6aebaad174c8","parentUuid":"3d071155-85d7-4a08-bdaa-5aa64fac0cef","uuid":"c6cabb88-55d1-45dc-8da5-706b781b137d"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"The dataset(s) will be deleted"},"metricMeasures":{"changed":false}},"createdAt":"2022-02-28T14:45:51Z","entityUuid":"c70eeb16-2c8f-4672-95a2-6aebaad174c8","parentUuid":"3d071155-85d7-4a08-bdaa-5aa64fac0cef","uuid":"191e6e69-6485-4626-ae49-441c69260365"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2022-02-28T14:45:52Z","entityUuid":"2b2d7f1e-06d0-4900-84ce-9eb9ccc37076","parentUuid":"c70eeb16-2c8f-4672-95a2-6aebaad174c8","uuid":"a358eed8-f85b-4078-aa88-5a55643600a3"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Dataset(s)"}},"createdAt":"2022-02-28T14:45:53Z","entityUuid":"2b2d7f1e-06d0-4900-84ce-9eb9ccc37076","parentUuid":"c70eeb16-2c8f-4672-95a2-6aebaad174c8","uuid":"c999e4f2-6594-4af3-b823-6b5ddc70bc4d"},{"content":{"annotations":{"changed":false},"eventType":