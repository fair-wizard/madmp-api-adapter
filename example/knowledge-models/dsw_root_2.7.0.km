:51:48Z","entityUuid":"ff85db18-565c-4177-a397-9a8cf4c7b374","parentUuid":"238ace4b-22bb-4a9d-a312-e30d82d4382d","uuid":"fc5668c7-a8cf-42c8-88c7-aed2d53b1161"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"We have another approach","metricMeasures":[]},"createdAt":"2020-11-11T10:51:49Z","entityUuid":"11d2fd0d-59f2-42ce-a34a-84fac3f51862","parentUuid":"ff85db18-565c-4177-a397-9a8cf4c7b374","uuid":"783cd3cb-70b8-4563-9054-b5c9a5343b00"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"ValueQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":"What approach?","validations":[],"valueType":"TextQuestionValueType"},"createdAt":"2020-11-11T10:51:50Z","entityUuid":"266bcba8-9e8a-457c-8c2f-5a992a32512c","parentUuid":"11d2fd0d-59f2-42ce-a34a-84fac3f51862","uuid":"1baba4fb-ace0-495c-9b98-b959e61ea85e"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":true,"value":"1796fa3c-9f53-475f-89ff-c66a0453c42e"},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2020-11-11T10:51:51Z","entityUuid":"266bcba8-9e8a-457c-8c2f-5a992a32512c","parentUuid":"11d2fd0d-59f2-42ce-a34a-84fac3f51862","uuid":"583cdc6d-b072-46e0-9a2e-35f2c9b44286"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"The FAIR principles do not contain any direction towards \"Openness\". This is done on purpose, because there can be compelling reasons not to make data \"Open\", such as privacy, other sensitive data, or intellectual property protection.\n\nThe true goal of funding agencies is to create the maximum value for society from their investments. They therefore often add \"As open as possible, as closed as necessary\" to the requirements for funding."},"title":{"changed":false}},"createdAt":"2020-11-11T10:51:52Z","entityUuid":"6516eae1-98b2-48f2-9862-b5fb140cfad7","parentUuid":"6be88f7c-f868-460f-bba7-91e1c659adfd","uuid":"d7d823a8-0cdb-48ad-a7c8-f23bd5d3f168"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Some data may be subject to a temporary embargo, or need to stay closed for specific reasons. "},"title":{"changed":false}},"createdAt":"2020-11-11T10:51:53Z","entityUuid":"a549d10b-aa46-4c0c-863f-30219ac5ecce","parentUuid":"6be88f7c-f868-460f-bba7-91e1c659adfd","uuid":"74ad5f79-52e9-4322-8e4c-0e8ea74d69e7"},{"content":{"allowCustomReply":true,"annotations":[],"eventType":"AddIntegrationEvent","integrationType":"ApiIntegration","name":"ROR (organizations)","requestAllowEmptySearch":true,"requestBody":"","requestHeaders":[{"key":"Accept","value":"application/json"}],"requestMethod":"GET","requestUrl":"https://api.ror.org/organizations?query=+${q}","responseItemTemplate":"{{item.name}}","responseItemTemplateForSelection":null,"responseListField":"items","testQ":"","testResponse":null,"testVariables":{},"variables":[]},"createdAt":"2020-11-11T10:51:54Z","entityUuid":"266649ea-0f32-4b00-b5b9-32fc72fcb21d","parentUuid":"6f6241d9-136c-4770-9d58-8a3f39607052","uuid":"65f69a85-d4dd-4865-bb16-a3d620217d6d"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"integrationUuid":{"changed":true,"value":"266649ea-0f32-4b00-b5b9-32fc72fcb21d"},"questionType":"IntegrationQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"variables":{"changed":true,"value":{}}},"createdAt":"2020-11-11T10:51:55Z","entityUuid":"68530470-1f1c-4448-8593-63a288713a66","parentUuid":"73d686bd-7939-412e-8631-502ee6d9ea7b","uuid":"4391192d-33f9-42bb-aa54-d20d05cfb3ed"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"We will use cluster computing"},"metricMeasures":{"changed":false}},"createdAt":"2020-11-11T10:51:56Z","entityUuid":"75be8d48-34ba-4ac5-ba2c-b9fd435fe705","parentUuid":"dd918787-ffb1-499e-98f8-42050758c7ce","uuid":"4bf252ce-8a55-49ae-99ee-c3862dab167d"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Data is sometimes difficult to locate, especially if it is not in a domain-specific repository. Data catalogues may increase findability: they put the metadata for data sets that are located in different places together in one location that is well known to researchers in a particular field. \n\nData sets can be mentioned in multiple data catalogues without the need for duplicating the data: the data catalogues point to where the actual data can be found.\n\nAn example is [Narcis](https://dans.knaw.nl/nl/over/diensten/narcis) (for research data in the Netherlands)."},"title":{"changed":false}},"createdAt":"2020-11-11T10:51:57Z","entityUuid":"46039bea-87e6-4c61-8567-4e819404b4d0","parentUuid":"8d1b07a7-f177-41f5-9532-05536223a8d6","uuid":"bd010b39-3c81-49ca-8963-58d78176daf4"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"What is a data catalog (Dataversity)","referenceType":"URLReference","url":"https://www.dataversity.net/what-is-a-data-catalog/"},"createdAt":"2020-11-11T10:51:58Z","entityUuid":"b128903f-a545-4323-b127-f4a0ff998608","parentUuid":"46039bea-87e6-4c61-8567-4e819404b4d0","uuid":"e57b3302-f115-46a7-bb1a-13a09c71a695"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":true,"value":["0224af28-8272-4360-b8b2-0fcc835832e9","9e39ea26-cdaf-483b-9502-d47fc4f69bab"]},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2020-11-11T10:51:59Z","entityUuid":"46039bea-87e6-4c61-8567-4e819404b4d0","parentUuid":"8d1b07a7-f177-41f5-9532-05536223a8d6","uuid":"ab0c5d03-d2ba-4d1b-bf09-984a3b8ce3c0"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No, the data will be stored in a repository that is the prime source of data for re-use in the field","metricMeasures":[]},"createdAt":"2020-11-11T10:52:00Z","entityUuid":"aaae5c5b-0aa9-4619-bb68-de0cd27f14da","parentUuid":"46039bea-87e6-4c61-8567-4e819404b4d0","uuid":"8e2a9700-e106-4ec1-8607-c95817f4336e"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":true,"value":["0224af28-8272-4360-b8b2-0fcc835832e9","aaae5c5b-0aa9-4619-bb68-de0cd27f14da","9e39ea26-cdaf-483b-9502-d47fc4f69bab"]},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2020-11-11T10:52:01Z","entityUuid":"46039bea-87e6-4c61-8567-4e819404b4d0","parentUuid":"8d1b07a7-f177-41f5-9532-05536223a8d6","uuid":"75a44474-3522-484f-a908-d5afa7a89afa"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","