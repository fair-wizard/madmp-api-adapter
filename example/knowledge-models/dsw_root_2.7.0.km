,"uuid":"eb07ebb1-6f2f-4e16-bb6d-7cc413cb8190"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":true,"value":"b101f2d0-2476-452d-aa8d-95a41a02b52c"},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2022-02-28T14:54:10Z","entityUuid":"28e7c4f7-7ade-42b2-a68e-63ab4f67b960","parentUuid":"eb17ff9a-c57e-4fd4-b3bd-89edb31c6568","uuid":"659cd510-64e1-41dc-9c7d-2c03116c7776"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":true,"value":"b101f2d0-2476-452d-aa8d-95a41a02b52c"},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2022-02-28T14:54:11Z","entityUuid":"c15710f6-1c7f-43a0-97e7-ab70f6b5a115","parentUuid":"7fc8d3c9-a2d5-4d47-9df4-56af48ca85e1","uuid":"9592148c-a75c-4e13-b543-f6e4c17567c8"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"[Article 6](https://gdpr-info.eu/art-6-gdpr/) (1) lists under what conditions the processing is considered lawful. Of these, **Consent** or **Public** interest are relevant when it comes to research. You should determine what legal basis (or bases) you have for processing the personal data in your project. \n\nTraditionally, *consent* has been the basis for processing personal data for research, but under the GDPR there cannot be an imbalance between the processor and the data subject for it to be considered to be freely given. In some countries the use of *consent* as the legal basis for processing by universities for research purposes is therefore not recommended. In those cases, public interest should probably be your legal basis. Note that if your legal basis for processing is consent, [a number of requirements](https://gdpr-info.eu/issues/consent/) exists for the consent to be considered valid under the GDPR. Consents given before the GDPR might not live up to this. \n\nAlso note that even if *public interest* is the legal basis, other laws and research ethics standards might still require you to have consent from the subjects for performing the research."},"title":{"changed":false}},"createdAt":"2022-02-28T14:54:12Z","entityUuid":"c2da0410-ede1-4b0a-a750-09e6e6bd38cf","parentUuid":"1bbafc04-e527-481b-ad1f-521cc48de186","uuid":"c9e9cc01-9097-48ad-9d90-b3189cdecb87"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":[]},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2022-02-28T14:54:13Z","entityUuid":"de1b1a0f-58ea-4859-91b0-aa2b52090395","parentUuid":"6d18bfff-0f53-469b-934e-9806dda9d4fb","uuid":"32c98e04-634c-40dd-86b6-9a886c5ab19d"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":[]},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2022-02-28T14:54:14Z","entityUuid":"0ebd660b-364a-4357-9044-c4dc0293a9ba","parentUuid":"065a500b-53c0-487f-9096-00fd6f7234a6","uuid":"2a840f3c-605b-4caf-9399-11608058091a"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"If the data that you will re-use is coupled to people, the informed consent that was originally obtained from those people may not be covering your current research. In that case re-consent may be necessary."},"title":{"changed":false}},"createdAt":"2022-02-28T14:54:15Z","entityUuid":"28e7c4f7-7ade-42b2-a68e-63ab4f67b960","parentUuid":"eb17ff9a-c57e-4fd4-b3bd-89edb31c6568","uuid":"7f48a72c-f2bb-4d55-bf84-3ee7de0c8b7e"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"If the data that you will re-use is coupled to people, the ethical approval that was originally obtained may not be covering your current research. In that case an extension of the original approval may be necessary."},"title":{"changed":false}},"createdAt":"2022-02-28T14:54:16Z","entityUuid":"c15710f6-1c7f-43a0-97e7-ab70f6b5a115","parentUuid":"7fc8d3c9-a2d5-4d47-9df4-56af48ca85e1","uuid":"349969d2-853b-43aa-8f72-fe86e690d66b"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Explain how data subjects will be informed and how data subject's requests will be handled.\n\nData subjects must be informed of the purpose, the interest of the study, the type of collected data, and the potential risks to which they will be exposed.\n\nIf the processing operation is exempted from the right to information according to the GDPR, provide a justification.\nMention the relevant document in which the responsibilities regarding the information of data subjects are indicated."},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2022-02-28T14:54:17Z","entityUuid":"61d21b4f-332b-4257-a345-bbf51b10d357","parentUuid":"73cd2dda-41ba-456b-9a4e-aa34c78f2fcf","uuid":"996d3e6e-5a9b-4898-a152-efe0cd6673b0"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"We require the processing to fulfil our contract with the data subjects"},"metricMeasures":{"changed":false}},"createdAt":"2022-02-28T14:54:18Z","entityUuid":"bfb7a92c-5eec-497e-8a0f-ef7b12f353c2","parentUuid":"40ea30cc-ea49-4407-8bba-c511a9fb1786","uuid":"1494a1dc-80a3-44bc-b179-2fe383d42ef0"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":true,"value":["57a9a008-d0b0-4716-bf26-13e6eb80dc36","039bdd6f-51f5-47a3-8b15-0ad95098866e"]},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2022-02-28T14:54:19Z","entityUuid":"312ad81e-a274-4523-a6b2-2299e56422b7","parentUuid":"42a0b857-00e1-4389-bd26-cb5b924ab462","uuid":"500ea6d5-3ff6-4301-a539-ab9f8114530c"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":true,"value":["7ece1b60-7f44-4124-afa9-8fcee7cd7024","6a670985-1998-4397-a693-fcc8905753e6"]},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2022-02-28T14:54:20Z","entityUuid":"bdb07de8-6b54-41ac-b89d-21e089f01597","parentUuid":"039bdd6f-51f5-47a3-8b15-0ad95098866e","uuid":"48f1b729-2a7f-4620-9e61-1a18e13bb7f8"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":true,"value":["022c62eb-9591-4290-b84f-e594086c2cd7","e09fbe99-08bc-4cb9-95f2-f438b3381541"]},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2022-02-28T14:54:21Z","entityUuid":"0dda3f9c-7567-47c8-8726-23fdfbe67e33","parentUuid":"6a670985-1998-4397-a693-fcc8905753e6","uuid":"af151027-6fb7-4b89-9d74-1ab2b9c04c0c"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Under what GDPR category does the project data fall?"}},"createdAt":"2022-02-28T14:54:22Z","entityUuid":"9e0fb0fd-0268-4cf3-8dfa-ba0b2a1e8e89","parentUuid":"d8ecede2-f952-4b08-8a68-20d97849733f","uuid":"5f9a607e-e209-447f-b30a-22baa5897660"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":true,"value":"b101f2d0-2476-452d-aa8d-95a41a02b52c"},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2022-02-28T14:54:23Z","entityUuid":"aee03da5-b399-4274-8db4-fac82c6210d3","parentUuid":"8a1937d8-39dc-4efd-a3f6-b62e789f225b","uuid":"94847a1c-be7f-4141-a2b1-3134fbd3e363"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":true,"value":"b101f2d0-2476-452d-aa8d-95a41a02b52c"},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2022-02-28T14:54:24Z","entityUuid":"b141a560-a823-48a7-9ed2-933eee397ae2","parentUuid":"7fc8d3c9-a2d5-4d47-9df4-56af48ca85e1","uuid":"03ea95a1-e271-4ad2-afed-45d3edd01036"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":true,"value":null},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2022-02-28T14:54:25Z","entityUuid":"69999c2c-2710-480e-b8ac-8a8fc6f582e5","parentUuid":"7fc8d3c9-a2d5-4d47-9df4-56af48ca85e1","uuid":"fd54e2d8-57f7-4a0d-9bdb-205d57718ab4"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":true,"value":null},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2022-02-28T14:54:26Z","entityUuid":"b141a560-a823-48a7-9ed2-933eee397ae2","parentUuid":"7fc8d3c9-a2d5-4d47-9df4-56af48ca85e1","uuid":"fe55d265-ee8b-4e1e-96b4-e9c3541cd6ab"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":true,"value":null},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2022-02-28T14:54:27Z","entityUuid":"aee03da5-b399-4274-8db4-fac82c6210d3","parentUuid":"8a1937d8-39dc-4efd-a3f6-b62e789f225b","uuid":"31b1b297-bc52-475a-9aa1-aa226ba4897c"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"We will collect consent for our use of the data and for anonymization; We will anonymize the data afterwards for reuse"},"metricMeasures":{"changed":false}},"createdAt":"2022-02-28T14:54:28Z","entityUuid":"3a77595a-87ae-484d-a9a6-052f312453ee","parentUuid":"f5e162ee-1077-4ebe-a932-192bc7f67e98","uuid":"1f3e7631-8732-4857-af4e-c3d9c67fba2e"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"We ask for consent for anonymization; We will anonymize first and all further processing is on the anonymous data"},"metricMeasures":{"changed":false}},"createdAt":"2022-02-28T14:54:29Z","entityUuid":"e7e4f219-5edd-468f-b042-b5f88a559c3a","parentUuid":"f5e162ee-1077-4ebe-a932-192bc7f67e98","uuid":"fd335a56-0c68-4fb4-aca1-5e0a05a3116b"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Describe the procedure for obtaining consent from data subjects"},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2022-02-28T14:54:30Z","entityUuid":"c6579da8-496a-4468-b567-9fb6ce472bf9","parentUuid":"73cd2dda-41ba-456b-9a4e-aa34c78f2fcf","uuid":"a4fc359e-7501-4028-b6e5-8ebb38c63785"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Where a type of processing is likely to result in a high risk to the rights and freedoms of natural persons, the controller shall, prior to the processing, carry out an assessment of the impact of the envisaged processing operations on the protection of personal data, a so called Data Protection Impact Assessment (DPIA) - [Article 35](https://gdpr-info.eu/art-35-gdpr/). Note: Most types of research projects on health or genetic data require a DPIA, especially large-scale processing of sensitive data. "},"title":{"changed":false}},"createdAt":"2022-02-28T14:54:31Z","entityUuid":"8915bd25-db22-4ed6-bcc8-b1bbdc52989e","parentUuid":"d8ecede2-f952-4b08-8a68-20d97849733f","uuid":"856aa222-ee92-4b36-824a-5f844851dc53"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"The French Data Protection Authority (DPA) has made a [PIA tool](https://www.cnil.fr/en/open-source-pia-software-helps-carry-out-data-protection-impact-assesment) (endorsed by several other DPAs) available that can help in performing these impact assessments. Please also consult your Data Protection Officer of your organization."},"title":{"changed":false}},"createdAt":"2022-02-28T14:54:32Z","entityUuid":"6cc96576-2535-46b3-8c9b-a12703ee96cc","parentUuid":"c3914e43-cca1-4180-8960-228b7022bae6","uuid":"f96b6d07-8d66-4a5e-98b1-b61cc966749e"},{"content":{"annotations":{"changed":false},"eventType":"EditChoiceEvent","label":{"changed":true,"value":"Innovative use or applying new technological or organizational solutions, like combining the use of fingerprint and face recognition for physical access control.  "}},"createdAt":"2022-02-28T14:54:33Z","entityUuid":"f2919725-27cf-4c43-a04b-69a47eb1f852","parentUuid":"3d09f311-07dd-49a0-8445-5eab8f9548fc","uuid":"47542898-32d4-4695-ace8-eb8247a44b93"},{"content":{"eventType":"MoveReferenceEvent","targetUuid":"6cc96576-2535-46b3-8c9b-a12703ee96cc"},"createdAt":"2022-02-28T14:54:34Z","entityUuid":"8fe4a165-09a6-4e5d-835d-3255db21d0de","parentUuid":"3d09f311-07dd-49a0-8445-5eab8f9548fc","uuid":"6c9fe54c-e480-431a-b70a-a9ad36e56660"},{"content":{"eventType":"DeleteReferenceEvent"},"createdAt":"2022-02-28T14:54:35Z","entityUuid":"bcb58c41-7df6-427d-8931-01dc1b0a9316","parentUuid":"6cc96576-2535-46b3-8c9b-a12703ee96cc","uuid":"ac3438ae-abc5-4679-b7c2-74526d07e464"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Where personal data are transferred to a third country or to an international organization, appropriate measures (technical and organizational) must be put in place to protect the data.\nIf sufficient protection levels are not offered by the countries, the addition of specific data protection clauses must be added to contracts.\n\nKeep in mind that, processor, shall not transfer data outside the EU/EEA without the data provider’s approval and instructions and subject to contractual agreements as imposed by the data provider."},"title":{"changed":false}},"createdAt":"2022-02-28T14:54:36Z","entityUuid":"15ade1cb-af43-40be-b8b1-2b801812dab1","parentUuid":"22e612e0-c72d-42fa-9a37-a55232e72c72","uuid":"f832a8fa-4570-41d6-8b1c-c26e91221471"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2022-02-28T14:54:37Z","entityUuid":"f093edb7-f08c-4742-8b0e-8abe0bf6c34f","parentUuid":"361c38f0-ce75-4157-94f1-804e4d7986c2","uuid":"a210853b-b746-4d9f-8ba3-ea762a3e3ac3"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"GDPR Chapter 3: Rights of the data subject"},"referenceType":"URLReference","url":{"changed":true,"value":"https://gdpr-info.eu/chapter-3/"}},"createdAt":"2022-02-28T14:54:38Z","entityUuid":"f093edb7-f08c-4742-8b0e-8abe0bf6c34f","parentUuid":"361c38f0-ce75-4157-94f1-804e4d7986c2","uuid":"dd145ddb-6b7b-48a5-a06c-762a401fba1a"},{"content":{"annotations":{"changed":false},"choiceUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"MultiChoiceQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"For projects involving data collection from subjects, it must be ensured the subjects can exercise all their rights."},"title":{"changed":true,"value":"Describe how data subjects exercise their rights to their data"}},"createdAt":"2022-02-28T14:54:39Z","entityUuid":"361c38f0-ce75-4157-94f1-804e4d7986c2","parentUuid":"73cd2dda-41ba-456b-9a4e-aa34c78f2fcf","uuid":"3efec7ef-0cc0-4e49-9bc0-9b0cdde5e56b"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"What are the exemptions to the prohibition for processing of special categories of data (such as health and genetic data) under Art. 9 GDPR used? State cohort/dataset for each type of exemption."}},"createdAt":"2022-02-28T14:54:40Z","entityUuid":"de72effc-807a-4081-b842-1e77ecc9c43f","parentUuid":"4c42e36b-f70a-4c2d-b13a-66294bc22459","uuid":"e902c8c2-0734-46e3-b40b-ae1a16b5aa1f"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2022-02-28T14:54:41Z","entityUuid":"b2db3b93-3ce7-4c3c-a80e-866671a9103a","parentUuid":"63b6e695-2371-412c-bed3-f13e157da0b4","uuid":"0f80c7a4-3182-4685-8afb-c29e3acc2cc6"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"Data Use Ontology"},"referenceType":"URLReference","url":{"changed":true,"value":"https://github.com/EBISPOT/DUO#readme"}},"createdAt":"2022-02-28T14:54:42Z","entityUuid":"b2db3b93-3ce7-4c3c-a80e-866671a9103a","parentUuid":"63b6e695-2371-412c-bed3-f13e157da0b4","uuid":"638a899c-a366-46b2-97f9-97dd94d4ab7a"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Making use of the same pseudonymization for different studies makes it possible to integrate information later. Obviously it also raises the risk of re-identification."},"title":{"changed":false}},"createdAt":"2022-02-28T14:54:43Z","entityUuid":"5db6bd58-5d1d-4d02-9497-972cbef64c16","parentUuid":"49f268a6-9566-4aa4-bec3-44fec2e64548","uuid":"54f1da84-fe19-4103-8375-fc79376452f7"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Different anonymization techniques exist. Disadvantage of anonymization is that data integration becomes virtually impossible, but it may be the only way to open up your data for other research."},"title":{"changed":false}},"createdAt":"2022-02-28T14:54:44Z","entityUuid":"15ee1921-1fea-4f22-b462-b3cf7cdd4646","parentUuid":"8a56768a-5c5a-44c0-b21c-46a231fbf6be","uuid":"aeb2b64e-89b2-403a-b917-2faf9588ec03"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Aggregated data, where typically at least 15 individuals are in any data point, are considered sufficiently anonymous. This is an alternative way of making data openly available for future research."},"title":{"changed":false}},"createdAt":"2022-02-28T14:54:45Z","entityUuid":"69be6695-152b-48ba-a1fd-6662476e39b7","parentUuid":"8a56768a-5c5a-44c0-b21c-46a231fbf6be","uuid":"dabaf992-c821-4b49-81e7-5f7fbf542268"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Is a new approval or extension of any existing approval under research ethics laws needed for re-use of the data?"}},"createdAt":"2022-02-28T14:54:46Z","entityUuid":"c15710f6-1c7f-43a0-97e7-ab70f6b5a115","parentUuid":"7fc8d3c9-a2d5-4d47-9df4-56af48ca85e1","uuid":"88082c70-db00-4a42-af77-820f895b1d37"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":[]},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2022-02-28T14:54:47Z","entityUuid":"a5dbea23-b7d6-4e31-a1a5-ec5007ec7848","parentUuid":"62b8c25d-380d-4d43-81b4-945e93e40c41","uuid":"21545352-c41a-4d82-89ae-c4c0238c4e93"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Where the processing is under consent, appropriate measures should be take to demonstrate how the data subjects have consented.\nMention the documents where the consent is established (e.g., data information sheet)."},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2022-02-28T14:54:48Z","entityUuid":"c6579da8-496a-4468-b567-9fb6ce472bf9","parentUuid":"73cd2dda-41ba-456b-9a4e-aa34c78f2fcf","uuid":"aa322778-489c-482a-a5de-b24f997bbc0d"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":true,"value":"1796fa3c-9f53-475f-89ff-c66a0453c42e"},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Have data processing agreements been (or will they be) established between the data controller(s) and any data processors?"}},"createdAt":"2022-02-28T14:54:49Z","entityUuid":"c6e30ba1-10d6-4f3c-b81a-5f2b362f74cd","parentUuid":"d8ecede2-f952-4b08-8a68-20d97849733f","uuid":"346d8b71-4afe-436a-b1ad-527dee6c0530"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-02-28T14:54:50Z","entityUuid":"e722d0dc-7a57-4634-8250-7c177664765a","parentUuid":"c6e30ba1-10d6-4f3c-b81a-5f2b362f74cd","uuid":"3aa4bf5a-6ddd-4c38-95a6-697a878a9975"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Not yet, but they will be established before processing starts"},"metricMeasures":{"changed":false}},"createdAt":"2022-02-28T14:54:51Z","entityUuid":"e722d0dc-7a57-4634-8250-7c177664765a","parentUuid":"c6e30ba1-10d6-4f3c-b81a-5f2b362f74cd","uuid":"090eb345-f793-462c-b1f5-3f10856b5859"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Processor"},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2022-02-28T14:54:52Z","entityUuid":"8c27e2cc-d2a7-45da-9829-aa22566bb34b","parentUuid":"a21efb45-5238-4e9a-a00c-28d3d88d801b","uuid":"62096ad1-ab92-495f-b818-1f34ab5ad752"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Add reference to established agreement."},"title":{"changed":true,"value":"Agreement"},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2022-02-28T14:54:53Z","entityUuid":"bd886f8e-7825-4f98-afb2-6079ae15c8ed","parentUuid":"a21efb45-5238-4e9a-a00c-28d3d88d801b","uuid":"f44b8ecd-c339-4325-b97f-5b70bbcad951"},{"content":{"eventType":"DeleteQuestionEvent"},"createdAt":"2022-02-28T14:54:54Z","entityUuid":"2ce7668b-b009-4f46-9d27-22def3f19bf4","parentUuid":"9f9124e0-dae8-4405-9e97-64d5e054ae4b","uuid":"7a9af7b1-7798-4730-bf36-63b94d9e2db7"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":true,"value":["aa88e146-e460-4611-898d-3f015df27780","e722d0dc-7a57-4634-8250-7c177664765a","9f9124e0-dae8-4405-9e97-64d5e054ae4b"]},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2022-02-28T14:54:55Z","entityUuid":"c6e30ba1-10d6-4f3c-b81a-5f2b362f74cd","parentUuid":"d8ecede2-f952-4b08-8a68-20d97849733f","uuid":"ddac76c0-039b-4656-8ebe-91dd66294441"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"What technical and procedural safeguards have been established for processing the data?"}},"createdAt":"2022-02-28T14:54:56Z","entityUuid":"a30f5047-33c1-45a7-8b3f-b1b90c364fc9","parentUuid":"d8ecede2-f952-4b08-8a68-20d97849733f","uuid":"b80c3ce3-eced-4566-b616-fe6a23d3afea"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"List technical and procedural safeguards to ensure the privacy protection of the research subjects."},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2022-02-28T14:54:57Z","entityUuid":"f646ba6e-21bc-4e66-8265-c8fdbe115c1f","parentUuid":"22e612e0-c72d-42fa-9a37-a55232e72c72","uuid":"6435a7ac-d112-4542-9af6-96f80d90e46d"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Where personal data are transferred to a third country or to an international organization, appropriate measures (technical and organizational) must be put in place to protect the data.\nIf sufficient protection levels are not offered by the countries, the addition of specific data protection clauses must be added to contracts.\n\nKeep in mind that a processor shall not transfer data outside the EU/EEA without the data controller’s approval and instructions, and that it should be subject to contractual agreements as imposed by the data controller."},"title":{"changed":false}},"createdAt":"2022-02-28T14:54:58Z","entityUuid":"15ade1cb-af43-40be-b8b1-2b801812dab1","parentUuid":"22e612e0-c72d-42fa-9a37-a55232e72c72","uuid":"fd6f8c0a-eeaf-48f6-bef7-b6b5268fda47"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Are there any limitations on the data use e.g. only for research on certain types of diseases, sharing only within certain geographical boundaries, etc.?\n\nDescribing data use in a formalised way by using the data use ontology (DUO) greatly improves the data reusability."},"title":{"changed":false}},"createdAt":"2022-02-28T14:54:59Z","entityUuid":"63b6e695-2371-412c-bed3-f13e157da0b4","parentUuid":"b1df3c74-0b1f-4574-81c4-4cc2d780c1af","uuid":"dc40beba-41df-4e47-8116-f694c6e38bbf"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Could the coupling of data create a danger of re-identification of pseudo- or anonymized personal data?"}},"createdAt":"2022-02-28T14:55:00Z","entityUuid":"6b3d62a5-1d4d-49e1-aaf1-0a8b398a7ac3","parentUuid":"61d05101-2eaa-4ebb-8be7-2fcac50f2fb2","uuid":"4457d670-62ac-4044-b839-118e85638d87"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":true,"value":"StringQuestionValueType"}},"createdAt":"2022-02-28T14:55:01Z","entityUuid":"bd0dd2d0-b3ef-410d-be1f-8f4bf0bbd9d5","parentUuid":"40005844-f7bb-493a-af6d-76c17a2f7eeb","uuid":"17eda52e-3fae-4b14-bac5-3097a4842560"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Public interest"},"metricMeasures":{"changed":false}},"createdAt":"2022-02-28T14:55:02Z","entityUuid":"597d2547-4e97-4045-8605-3b5249f2b412","parentUuid":"c2da0410-ede1-4b0a-a750-09e6e6bd38cf","uuid":"4e8a132e-dbf8-4b37-bc01-5303ad742a54"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"The following legal bases are unlikely for processing personal data when doing research.\n\nThe meaning of the different options are as follows:\n* Legal requirement: we are legally obliged to do this data processing\n* Vital interest: we need to do this to protect the vital interests of the data subject\n* We have a legitimate interest: data subjects all expect us to do this data processing because of who we are"},"title":{"changed":false}},"createdAt":"2022-02-28T14:55:03Z","entityUuid":"40ea30cc-ea49-4407-8bba-c511a9fb1786","parentUuid":"ef396bbf-daa7-4d61-b4d7-ab66900b2598","uuid":"13ab26a5-c8c6-4dac-b750-b352ce7d9868"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Legal requirement"},"metricMeasures":{"changed":false}},"createdAt":"2022-02-28T14:55:04Z","entityUuid":"18db88c7-97c9-416e-b1ae-763bf018345e","parentUuid":"40ea30cc-ea49-4407-8bba-c511a9fb1786","uuid":"9f9f6dc5-48be-4e03-a0e3-138506c286e8"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Vital interest"},"metricMeasures":{"changed":false}},"createdAt":"2022-02-28T14:55:05Z","entityUuid":"8caeb960-7c5e-457c-ae9e-1a2e038a466a","parentUuid":"40ea30cc-ea49-4407-8bba-c511a9fb1786","uuid":"245ede86-690f-4608-b9e7-e93403eed515"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"We have a legitimate interest"},"metricMeasures":{"changed":false}},"createdAt":"2022-02-28T14:55:06Z","entityUuid":"34bf8a67-6bba-4eab-8264-8d76f97e66c8","parentUuid":"40ea30cc-ea49-4407-8bba-c511a9fb1786","uuid":"ae610a56-a4f3-4d0c-a169-1e8de240eaea"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-02-28T14:55:07Z","entityUuid":"12ae8bdc-a6eb-4db9-9a1a-7e6fed7f9ace","parentUuid":"c15710f6-1c7f-43a0-97e7-ab70f6b5a115","uuid":"96551ad3-433b-4ab1-812a-6c8df950985d"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"An extension of existing ethical approval under research ethics laws will be needed"},"metricMeasures":{"changed":false}},"createdAt":"2022-02-28T14:55:08Z","entityUuid":"12ae8bdc-a6eb-4db9-9a1a-7e6fed7f9ace","parentUuid":"c15710f6-1c7f-43a0-97e7-ab70f6b5a115","uuid":"1c833e09-43fa-463d-bfe6-917e058aba2c"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":true,"value":["ad44fec7-d244-4bb1-9028-8d6856a06d6b","284110a8-66b4-4ba5-9e7a-edb77b1f2b3a","12ae8bdc-a6eb-4db9-9a1a-7e6fed7f9ace","6dd1142d-f76f-4d0b-9c38-999f7d8a229b"]},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"If the data that you will re-use is coupled to people, the ethical approval that was originally obtained may not be covering your current research. In that case an extension of the original approval, or a new approval, may be necessary."},"title":{"changed":false}},"createdAt":"2022-02-28T14:55:09Z","entityUuid":"c15710f6-1c7f-43a0-97e7-ab70f6b5a115","parentUuid":"7fc8d3c9-a2d5-4d47-9df4-56af48ca85e1","uuid":"7e359dc2-fef2-41b2-a47b-fd5d896587e5"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":true,"value":"1796fa3c-9f53-475f-89ff-c66a0453c42e"},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2022-02-28T14:55:10Z","entityUuid":"69999c2c-2710-480e-b8ac-8a8fc6f582e5","parentUuid":"7fc8d3c9-a2d5-4d47-9df4-56af48ca85e1","uuid":"6fc80c0c-c326-4899-9468-dbff33cd0ac2"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":true,"value":"1796fa3c-9f53-475f-89ff-c66a0453c42e"},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2022-02-28T14:55:11Z","entityUuid":"283abe36-207b-42c3-8d8e-ec9343d6f6fd","parentUuid":"97dc091d-8103-4119-87a2-c46a277ea303","uuid":"3558118e-6c3c-4407-b749-999faabaf5d0"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":true,"value":"1796fa3c-9f53-475f-89ff-c66a0453c42e"},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2022-02-28T14:55:12Z","entityUuid":"aee03da5-b399-4274-8db4-fac82c6210d3","parentUuid":"8a1937d8-39dc-4efd-a3f6-b62e789f225b","uuid":"52e98e3a-f09b-4af2-8260-1c3a7d7118ac"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":true,"value":"1796fa3c-9f53-475f-89ff-c66a0453c42e"},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2022-02-28T14:55:13Z","entityUuid":"dce3e924-717a-4b50-bdac-1b247e9ac18a","parentUuid":"85dcd5ee-002b-4db7-a0de-241a4b2f0688","uuid":"4733e8b2-7e51-4d95-899a-9ca89f36a541"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Exemption"},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2022-02-28T14:55:14Z","entityUuid":"595978f2-2973-4658-afa0-7efd004d16b4","parentUuid":"5fa61693-3750-4fcb-b8c2-ca003ecb5d62","uuid":"f2de8e83-92f9-404d-bc46-9435f99d126a"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":true,"value":"1796fa3c-9f53-475f-89ff-c66a0453c42e"},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2022-02-28T14:55:15Z","entityUuid":"f646ba6e-21bc-4e66-8265-c8fdbe115c1f","parentUuid":"22e612e0-c72d-42fa-9a37-a55232e72c72","uuid":"172ea1ec-0d2e-4383-a6a1-71edf960fd34"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":true,"value":"1796fa3c-9f53-475f-89ff-c66a0453c42e"},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2022-02-28T14:55:16Z","entityUuid":"cc95b399-7d8d-4232-bccf-686f78c91bff","parentUuid":"4e0c1edf-660c-4ebf-81f5-9fa959dead30","uuid":"df29ae88-b21a-4ffa-8c25-abe09bd7e504"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Public interest"},"metricMeasures":{"changed":false}},"createdAt":"2022-02-28T14:55:17Z","entityUuid":"c732f0b9-2f66-47f4-902f-724a44cdfd4b","parentUuid":"be4651c9-9a8c-4e10-a158-61b94ca0e139","uuid":"bdc7e8b5-354a-4d39-9eb7-69e331dcd73e"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Is there more than one controller of the personal data processed in the project?"}},"createdAt":"2022-02-28T14:55:18Z","entityUuid":"312ad81e-a274-4523-a6b2-2299e56422b7","parentUuid":"42a0b857-00e1-4389-bd26-cb5b924ab462","uuid":"aa0e9274-b932-40ed-8771-276817568d4e"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"The GDPR defines (sub)categories for personal data and expects data processors to be aware of and to document the categories of data that they process.\n\nStandard personal data  includes e.g. name, date of birth, address, (online) identifiers, contact info, account/personnel/customer or other ID numbers, appearance.\n\nSpecial  category data includes: data concerning health, Genetic data, racial or ethnic origin, sexual orientation, political opinions, religious or ideological convictions or trade union membership, criminal convictions and offences"},"title":{"changed":false}},"createdAt":"2022-02-28T14:55:19Z","entityUuid":"9e0fb0fd-0268-4cf3-8dfa-ba0b2a1e8e89","parentUuid":"d8ecede2-f952-4b08-8a68-20d97849733f","uuid":"401f7e74-09b4-4477-9a3a-d6a211a6fec9"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Standard personal data"},"metricMeasures":{"changed":false}},"createdAt":"2022-02-28T14:55:20Z","entityUuid":"9d5a52da-221f-4cfb-9727-8564a3a0d15b","parentUuid":"9e0fb0fd-0268-4cf3-8dfa-ba0b2a1e8e89","uuid":"1cc608dd-a067-4ec2-9c2b-478564aa0fdb"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Fulfil contract"},"metricMeasures":{"changed":false}},"createdAt":"2022-02-28T14:55:21Z","entityUuid":"1dfe0a6d-4281-4d5e-bcaa-5e20fa28a591","parentUuid":"b307cc44-7896-4383-b9b0-11cf4a58f531","uuid":"da48892b-36d4-4d38-9d3b-d5f6bd2ad388"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Legitimate interest"},"metricMeasures":{"changed":false}},"createdAt":"2022-02-28T14:55:22Z","entityUuid":"9d5e3104-2b6b-4d95-848e-253ef069d8b3","parentUuid":"b307cc44-7896-4383-b9b0-11cf4a58f531","uuid":"47222a2b-a01e-4968-bd44-bc6c9027201e"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Legal requirement"},"metricMeasures":{"changed":false}},"createdAt":"2022-02-28T14:55:23Z","entityUuid":"f10de3a8-2751-42c7-afaa-92eed4833f8e","parentUuid":"b307cc44-7896-4383-b9b0-11cf4a58f531","uuid":"d52e9915-a1d9-43d9-9d33-fd786db05806"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Vital interest"},"metricMeasures":{"changed":false}},"createdAt":"2022-02-28T14:55:24Z","entityUuid":"557a5401-a94a-4a37-af2e-a21829557bfa","parentUuid":"b307cc44-7896-4383-b9b0-11cf4a58f531","uuid":"255f2faa-3227-4ee6-ac43-ce94d103a8fa"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"The following legal bases are unlikely for processing personal data when doing research.\n\nThe meaning of the different options are as follows:\n* Fulfil contract: we require the processing in order to fulfil our contract with the data subjects.\n* Legitimate interest: data subjects all expect us to do this data processing because of who we are.\n* Vital interest: we need to do this to protect the vital interests of the data subject.\n* Legal requirement: we are legally obliged to do this data processing.\n"},"title":{"changed":false}},"createdAt":"2022-02-28T14:55:25Z","entityUuid":"b307cc44-7896-4383-b9b0-11cf4a58f531","parentUuid":"2a84c15c-f5ca-4471-b1fe-10f3d1231f24","uuid":"6dcd1f33-4d11-4f0b-92e2-0288ef546c25"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"State the purpose of processing the personal data"},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2022-02-28T14:55:26Z","entityUuid":"c7496ece-4535-4f5d-bcf7-7845989906e9","parentUuid":"d8ecede2-f952-4b08-8a68-20d97849733f","uuid":"17cd8c55-3cc4-40f2-9d9d-e4487e61a5e4"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"DPIA"},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2022-02-28T14:55:27Z","entityUuid":"432c867e-8f29-47e6-9078-05bdf3d3fcb0","parentUuid":"8cc50031-87d5-4b0e-8c3c-c7ded35fd263","uuid":"cd00b5bb-03e7-401d-83e3-fc554e1c0285"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":false},"referenceType":"URLReference","url":{"changed":true,"value":"https://rdmkit.elixir-europe.org/data_protection"}},"createdAt":"2022-02-28T14:55:28Z","entityUuid":"ba4eb06a-2d61-4755-bb51-8232b349d0a1","parentUuid":"8915bd25-db22-4ed6-bcc8-b1bbdc52989e","uuid":"d1c65309-2902-415e-9efe-c603d33b211b"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-02-28T14:55:29Z","entityUuid":"a670980a-1305-4349-8f41-6a0395f694d0","parentUuid":"7ffcfc57-b4ad-4638-ab19-11fe57b841a0","uuid":"ffc97596-0bb8-4b7f-babe-7eda6654b84f"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"No"},"metricMeasures":{"changed":false}},"createdAt":"2022-02-28T14:55:30Z","entityUuid":"a670980a-1305-4349-8f41-6a0395f694d0","parentUuid":"7ffcfc57-b4ad-4638-ab19-11fe57b841a0","uuid":"e7a61acb-98ea-4dbc-bb88-8924edbfa96d"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-02-28T14:55:31Z","entityUuid":"b8fad243-c585-423b-8e66-a47adc45d215","parentUuid":"7ffcfc57-b4ad-4638-ab19-11fe57b841a0","uuid":"fb365ddb-b59b-43e4-ad81-ec77e29b5568"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Yes"},"metricMeasures":{"changed":false}},"createdAt":"2022-02-28T14:55:32Z","entityUuid":"b8fad243-c585-423b-8e66-a47adc45d215","parentUuid":"7ffcfc57-b4ad-4638-ab19-11fe57b841a0","uuid":"82ccf353-43b8-48e6-864b-80c74eeba242"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2022-02-28T14:55:33Z","entityUuid":"b43c5770-d447-4183-b480-559faa44bffe","parentUuid":"7ffcfc57-b4ad-4638-ab19-11fe57b841a0","uuid":"96b00b6a-d44a-4841-98b5-206b1b2f99fa"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","referenceType":"ResourcePageReference","resourcePageUuid":{"changed":false}},"createdAt":"2022-02-28T14:55:34Z","entityUuid":"b43c5770-d447-4183-b480-559faa44bffe","parentUuid":"7ffcfc57-b4ad-4638-ab19-11fe57b841a0","uuid":"e9e9d07c-1810-4027-89ca-ed1b9d5b42b5"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2022-02-28T14:55:35Z","entityUuid":"d932e09c-ce37-49e3-93da-83022a87c012","parentUuid":"7ffcfc57-b4ad-4638-ab19-11fe57b841a0","uuid":"636328a4-eda7-499e-87a0-6ad4036b6731"},{"content":{"eventType":"DeleteReferenceEvent"},"createdAt":"2022-02-28T14:55:36Z","entityUuid":"d932e09c-ce37-49e3-93da-83022a87c012","parentUuid":"7ffcfc57-b4ad-4638-ab19-11fe57b841a0","uuid":"73761a79-cc84-4fa4-a15f-2cc3c4446893"},{"content":{"annotations":{"changed":true,"value":[{"key":"crossreference[1]","value":"7d1b6960-92db-4074-b908-74132bce1444"}]},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2022-02-28T14:55:37Z","entityUuid":"7ffcfc57-b4ad-4638-ab19-11fe57b841a0","parentUuid":"4e0c1edf-660c-4ebf-81f5-9fa959dead30","uuid":"acec9850-6276-4ecc-8f11-74c9f880e3e2"},{"content":{"eventType":"DeleteReferenceEvent"},"createdAt":"2022-02-28T14:55:38Z","entityUuid":"5c29bf88-3b5e-4abd-aeaf-64c1a63dcc55","parentUuid":"e1dba221-ad5a-474e-a2e3-9b4e472959fa","uuid":"d0fcedcb-5065-43e6-9b83-cbdd09c85a65"},{"content":{"allowCustomReply":{"changed":false},"annotations":{"changed":false},"eventType":"EditIntegrationEvent","integrationType":"ApiIntegration","name":{"changed":false},"requestAllowEmptySearch":{"changed":false},"requestBody":{"changed":false},"requestHeaders":{"changed":true,"value":[{"key":"Accept","value":"application/json"},{"key":"Api-Key","value":"${apiKey}"}]},"requestMethod":{"changed":false},"requestUrl":{"changed":true,"value":"${apiUrl}/search/?q=${q}&registry=${registry}"},"responseItemTemplate":{"changed":false},"responseItemTemplateForSelection":{"changed":false},"responseListField":{"changed":false},"testQ":{"changed":false},"testResponse":{"changed":false},"testVariables":{"changed":false},"variables":{"changed":false}},"createdAt":"2022-02-28T14:55:39Z","entityUuid":"f3520558-707e-415a-8878-c7b8d6ccc2fb","parentUuid":"6f6241d9-136c-4770-9d58-8a3f39607052","uuid":"c630bf85-8385-4dc1-a63c-e22c4e68c7d9"},{"content":{"annotations":{"changed":true,"value":[]},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2022-02-28T14:55:40Z","entityUuid":"c3dabaaf-c946-4a0d-889c-ede966f97667","parentUuid":"1e85da40-bbfc-4180-903e-6c569ed2da38","uuid":"aedb0866-0a12-46c6-8bd4-89d1dd34354b"}],"forkOfPackageId":null,"id":"dsw:root:2.5.0","kmId":"root","language":"en","license":"Apache-2.0","mergeCheckpointPackageId":null,"metamodelVersion":20,"name":"Common DSW Knowledge Model","nonEditable":false,"organizationId":"dsw","phase":"ReleasedKnowledgeModelPackagePhase","previousPackageId":"dsw:root:2.4.5","readme":"# Common DSW Knowledge Model\n\nCommon DSW Knowledge Model deals with questions that a researcher should answer in order to create a Data Stewardship Plan, as well as other related questionnaire data. It originated from mindmap made by Rob Hooft.\n\n## Changelog\n\n### 2.5.0\n\n* Incorporation changes/restructuring of questions related to human data \n\n### 2.4.5\n\n* Minor textual changes\n\n### 2.4.4\n\n* Fix duplicated *Horizon Europe DMP* tags for several questions\n\n### 2.4.3\n\n* Use of new value-question types (mostly email and URL)\n* New references\n\n### 2.4.2\n\n* Changes from workshops together with RDMkit on Toxicology, Biomolecular Simulations and    \n   Epitranscriptomics\n  - Small changes to phrasing and clarifications in various locations\n  - New guidance hierarchies added to locate existing data, standards and terminologies\n  - Moved \"provenance\" questions into the rest of the \"metadata\" group\n  - Added guidance summarising how to avoid problems with large amounts of intermediate data\n\n### 2.4.1\n\n* Fixed several minor typos (missing end of sentence, misspelling, typography etc.)\n\n### 2.4.0\n\n* KM verified and tested with the **Horizon Europe DMP template**\n\n### 2.3.14\n\n* Tags for Horizon Europe template generated\n\n### 2.3.13\n\n* Incorporating changes related to the Data Reuse workshop with RDMkit\n\n### 2.3.12\n\n* Incorporating changes related to the Data Analytics workshop with RDMkit\n\n### 2.3.11\n\n* Incorporating changes made in the Plant Sciences workshop with RDMkit\n\n### 2.3.10\n\n* Added references and questions from an RDMkit/DS Wizard working session on Preserving Data\n\n### 2.3.9\n\n* Fix missing Yes/No answers and use Text-Value for description of policies\n\n### 2.3.8\n\n* Questions for Horizon Europe added on budget for data management, other policies that are observed, persistent identifier allocation and archive preservation policies [Marek/Jana Horizon Europe issues 7-9, 11]\n\n### 2.3.7\n\n* Added references and questions from an RDMkit/DS Wizard working session on Human Data\n\n### 2.3.6\n\n* Questions about metadata for Horizon Europe added [Marek/Jana Horizon Europe issues 4-6]\n\n### 2.3.5\n\n* Added Tag for Horizon Europe\n* Moved the new questions from 2.3.4 from \"Science Europe\" to \"Horizon Europe\"\n* Added new question about qualified references from published data sets [Marek/Jana Horizon Europe issue 3]\n\n### 2.3.4\n\n* Change lists of reused (non-)reference datasets that are reused into lists of considered datasets, and add a question for each detailing whether they are actually reused and what for / why not. This is to be included in the Science Europe template [Marek/Jana Horizon Europe issue 1 and 2].\n\n### 2.3.3\n\n* Incorporation of changes from a collaborative workshop with RDMkit participants on data processing.\n   * Added links to RDMkit (and some to other external resources) in several places\n   * Clarified some questions\n   * Added question on data versioning for filesystems\n\n### 2.3.2\n\n* Incorporation of changes from a workshop with the authors of the RDMkit page on data collecting.\n   * Added links to RDMkit in several places\n   * Clarified some questions\n   * Moved questions on quality together\n   * Moved some questions out of the metadata subsection\n\n### 2.3.1\n\n* Incorporation of changes from a workshop with the authors of the RDMkit page on data sharing.\n    * Attempt to clarify difference between \"open\" and \"accessible\"\n    * Attempt to clarify difference between \"open\" and \"embargoed\"\n    * Added links to RDMkit Data Sharing page in a few places\n    * Added a few relevant questions\n\n### 2.3.0\n\nActivity during [BioHackathon Europe](biohackathon-europe.org) 2020 ([#BioHackEU20](twitter.com/search?q=%23BioHackEU20))\n\n* Added and tagged questions for Horizon 2020 template\n* Moved questions about collecting metadata to one consistent place\n* Added guidance on semantics in file names and question about using PIDs for identifying files\n* Generic small cleanups and typo fixes\n* Closing many issues of feedback received on the knowledge model (from [DSWGlobal/dsw](https://github.com/DSWGlobal/dsw))\n* Various question updates new options, clarifications, integrations\n* Added highly configurable [Wikidata](https://www.wikidata.org) SPARQL-based integration\n* Added [Research Organization Registry](https://ror.org) integration for contributor's affiliation\n\n### 2.2.0\n\n* Adjusted for compatibility with [RDA DMP Common Standard for machine-actionable DMPs (1.0)](https://github.com/RDA-DMP-Common/RDA-DMP-Common-Standard)\n  * Updated *Project* and *Funding* questions in *Administrative Details* chapter\n  * Reorganised *Dataset*, *Distribution*, *License* questions in *Data Publishing* chapter\n* Added *maDMP* tag to questions used in the RDA maDMP template\n\n### 2.1.0\n\n* Added *Science Europe DMP* tag to questions used in the Science Europe template\n\n### 2.0.2\n\n* Fixed missing and duplicated questions\n\n### 2.0.1\n\n* Fixed duplicated question in *Creating and collecting data* chapter (5ba53879-eb48-47f2-a73b-f7f7d83bf030)\n\n### 2.0.0\n\n* Added detailed questions for Science Europe DMPs\n* Fixed several typos and other minor problems\n* Added administrative chapter\n* Moving questions and refactoring according to [ds-km#24](https://github.com/ds-wizard/ds-km/pull/24)\n\n### 1.4.0\n\n* Adding integration for [FAIRsharing.org](https://fairsharing.org)\n* Adding 5 integration questions according to [ds-km@da5a8fc](https://github.com/ds-wizard/ds-km/commit/da5a8fc95d0a67f9369ce0b7727615115fc3656d)\n\nThe FAIRsharing integration requires configuration to contain `apiUrl` and `apiKey` for integration with id `fairsharing`.\n\n### 1.3.0\n\n* Refactoring list questions because of **deprecated item title** fields, i.e., a new question for item title created for each list question\n\nWhen using this version and higher, the DS Wizard configuration should have `itemTitleEnabled` set to `false`.\n\n### 1.2.0\n\n* Adding file naming SOP description question (9ff389f0-2236-48cf-880c-040ea1bb0d2f) to chapter 2 according to [ds-km@d879be0](https://github.com/ds-wizard/ds-km/commit/d879be0fa9d0808868396c649d03c4d783ac6742)\n\n### 1.1.0\n\n* Adding phases to questions (first draft) according to [ds-km@a6713d1](https://github.com/ds-wizard/ds-km/commit/a6713d1a4b9758bea63b3f7c56af5bd4f500d949) and [ds-km@1123211](https://github.com/ds-wizard/ds-km/commit/1123211bb5af43df8ef435039a2923f48e3e981c)\n\nPrior to this version, all questions were assigned with phase 2 - *Before submitting the DMP*.\n\n### 1.0.3\n\n* Fix: Removing extra question mark for a question (8018e15f-6c7e-433a-8686-ae0d695c7fc7) in chapter 5 according to: [ds-km@1123211](https://github.com/ds-wizard/ds-km/commit/1123211bb5af43df8ef435039a2923f48e3e981c)\n\n### 1.0.2\n\n* Fix: Adding some explanation to the list item questions (f5fef09d-ade5-4019-b089-f05bd89c34bc and b642c31d-a512-4ca7-8743-a2e0254006fa) in chapter 3 according to: [ds-km@96e28f4](https://github.com/ds-wizard/ds-km/commit/96e28f478d5dc6b59d384b5127f012dc2fe5f287)\n\n### 1.0.1\n\n* Fix: Adding forgotten question mark to end of question (39e0cc7c-17fe-4991-88d8-1280c3fe7923) in chapter 1 according to: [ds-km@644a373](https://github.com/ds-wizard/ds-km/commit/644a373685dc4ac15b76e86667a90151ca9c70ca)\n\n### 1.0.0\n\n* Initial version transformed from the previous DS-KM GitHub repository up to [ds-km@8442837](https://github.com/ds-wizard/ds-km/commit/8442837dbe3ff899b09e7d8d3fc1107e935a876f)","version":"2.5.0"},{"createdAt":"2023-06-28T12:06:36.488019Z","description":"DSW Knowledge Model originating from mindmap made by Rob Hooft","events":[{"content":{"annotations":{"changed":false},"chapterUuids":{"changed":true,"value":["1e85da40-bbfc-4180-903e-6c569ed2da38","82fd0cce-2b41-423f-92ad-636d0872045c","b1df3c74-0b1f-4574-81c4-4cc2d780c1af","10a10ffd-bfe1-4c6b-bbb6-3dfb1e63a5d5","83438863-0aa0-4458-b14b-2b2c0d4f811d","d5b27482-b598-4b8c-b534-417d4ad27394","6be88f7c-f868-460f-bba7-91e1c659adfd"]},"eventType":"EditKnowledgeModelEvent","integrationUuids":{"changed":false},"metricUuids":{"changed":false},"phaseUuids":{"changed":false},"resourceCollectionUuids":{"changed":false},"tagUuids":{"changed":false}},"createdAt":"2023-03-01T08:08:42Z","entityUuid":"6f6241d9-136c-4770-9d58-8a3f39607052","parentUuid":"00000000-0000-0000-0000-000000000000","uuid":"08e849eb-5e57-427e-9174-debc8cc48ebc"},{"content":{"allowCustomReply":{"changed":false},"annotations":{"changed":false},"eventType":"EditIntegrationEvent","integrationType":"ApiIntegration","name":{"changed":false},"requestAllowEmptySearch":{"changed":false},"requestBody":{"changed":false},"requestHeaders":{"changed":false},"requestMethod":{"changed":false},"requestUrl":{"changed":false},"responseItemTemplate":{"changed":false},"responseItemTemplateForSelection":{"changed":false},"responseListField":{"changed":false},"testQ":{"changed":false},"testResponse":{"changed":false},"testVariables":{"changed":false},"variables":{"changed":true,"value":["registry"]}},"createdAt":"2023-03-09T13:58:34Z","entityUuid":"f3520558-707e-415a-8878-c7b8d6ccc2fb","parentUuid":"6f6241d9-136c-4770-9d58-8a3f39607052","uuid":"21aeef21-7792-404c-b6d0-1f3397deb46a"},{"content":{"allowCustomReply":{"changed":false},"annotations":{"changed":false},"eventType":"EditIntegrationEvent","integrationType":"ApiIntegration","name":{"changed":false},"requestAllowEmptySearch":{"changed":false},"requestBody":{"changed":false},"requestHeaders":{"changed":false},"requestMethod":{"changed":false},"requestUrl":{"changed":false},"responseItemTemplate":{"changed":true,"value":"{{item.name}}"},"responseItemTemplateForSelection":{"changed":false},"responseListField":{"changed":false},"testQ":{"changed":false},"testResponse":{"changed":false},"testVariables":{"changed":false},"variables":{"changed":false}},"createdAt":"2023-03-16T13:34:28Z","entityUuid":"f3520558-707e-415a-8878-c7b8d6ccc2fb","parentUuid":"6f6241d9-136c-4770-9d58-8a3f39607052","uuid":"1f8745f0-9e28-4a4c-81d1-690a07cf3f76"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2023-04-17T03:57:31Z","entityUuid":"06211161-75e4-43b7-8e80-c470fccb2893","parentUuid":"2bac9020-99cf-4463-8d34-0b0eb2781cd1","uuid":"7890d7fc-20b2-4bf2-8b54-d416ca56f06a"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"FAIRCookbook on Selecting an ontology lookup service"},"referenceType":"URLReference","url":{"changed":true,"value":"https://w3id.org/faircookbook/FCB004"}},"createdAt":"2023-04-17T03:58:16Z","entityUuid":"06211161-75e4-43b7-8e80-c470fccb2893","parentUuid":"2bac9020-99cf-4463-8d34-0b0eb2781cd1","uuid":"c866e399-7457-490c-9c51-4dde98fef75e"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"integrationUuid":{"changed":true,"value":"266649ea-0f32-4b00-b5b9-32fc72fcb21d"},"questionType":"IntegrationQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"variables":{"changed":false}},"createdAt":"2023-04-17T03:59:12Z","entityUuid":"b9619bee-6d69-4111-b1e0-6c3ea50e01f8","parentUuid":"6cc336d2-2ae1-4ba7-92bf-00307c48dbdf","uuid":"7e340f52-dd4f-4ce8-a4c2-46fc38d886a7"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2023-04-17T04:00:33Z","entityUuid":"ae26faa3-f8ad-4f5d-8bd3-b3d16c526ceb","parentUuid":"b211f896-b363-4978-9423-212644ff5d72","uuid":"4bb5fe1a-bc58-4497-8247-78d53af47401"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"FAIRCookBook on Selecting an ontology lookup service"},"referenceType":"URLReference","url":{"changed":true,"value":"https://w3id.org/faircookbook/FCB004"}},"createdAt":"2023-04-17T04:00:58Z","entityUuid":"ae26faa3-f8ad-4f5d-8bd3-b3d16c526ceb","parentUuid":"b211f896-b363-4978-9423-212644ff5d72","uuid":"fa9b7ed1-dd15-4f59-8ffa-711ac7e31838"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2023-04-17T04:01:28Z","entityUuid":"bc1a7f76-a2e4-426b-a360-48ea0a6cce80","parentUuid":"f67e1539-5c7d-4df7-8259-e4f2edfa2685","uuid":"e6cabb4d-57cf-46a7-b12c-8e39fb2e9b15"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"FAIRCookBook on selecting an ontology lookup service"},"referenceType":"URLReference","url":{"changed":true,"value":"https://w3id.org/faircookbook/FCB004"}},"createdAt":"2023-04-17T04:01:43Z","entityUuid":"bc1a7f76-a2e4-426b-a360-48ea0a6cce80","parentUuid":"f67e1539-5c7d-4df7-8259-e4f2edfa2685","uuid":"ff861e62-a050-4986-82e1-7d8c16326b11"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2023-04-17T04:31:58Z","entityUuid":"b07291f6-fc6d-4e05-8d72-0a41ea5fa6ba","parentUuid":"80a682bd-8a5c-4a52-935d-680509838a4e","uuid":"25d74e1b-f0c0-461b-a693-3cdf18ec90b2"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"FAIRCookBook on depositing to a generic repository like Zenodo"},"referenceType":"URLReference","url":{"changed":true,"value":"https://w3id.org/faircookbook/FCB009"}},"createdAt":"2023-04-17T04:32:51Z","entityUuid":"b07291f6-fc6d-4e05-8d72-0a41ea5fa6ba","parentUuid":"80a682bd-8a5c-4a52-935d-680509838a4e","uuid":"677cc013-60f3-4e59-809a-80edfb1cd54c"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"If you are getting different types of data from different sources and want to use them together it is likely that you will need to match items and glue everything together. This can be done with traditional table database technology, but it is also possible to use Linked Data and RDF.\n\nYou may also need to use \"mappings\" to match data together."},"title":{"changed":false}},"createdAt":"2023-04-17T04:36:42Z","entityUuid":"109ed7ea-ef1d-4719-b2b4-eb4f7202c65c","parentUuid":"83438863-0aa0-4458-b14b-2b2c0d4f811d","uuid":"3d28b8e6-584f-4c80-aa83-d98f6fc2badd"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2023-04-17T04:36:47Z","entityUuid":"412739e0-2dd4-475d-b4aa-0c5cb2e3d3bc","parentUuid":"109ed7ea-ef1d-4719-b2b4-eb4f7202c65c","uuid":"521e7846-d187-4ad5-b2c3-d491b65ab183"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"FAIRCookBook on Interlinking data using mappings"},"referenceType":"URLReference","url":{"changed":true,"value":"https://w3id.org/faircookbook/FCB016"}},"createdAt":"2023-04-17T04:37:11Z","entityUuid":"412739e0-2dd4-475d-b4aa-0c5cb2e3d3bc","parentUuid":"109ed7ea-ef1d-4719-b2b4-eb4f7202c65c","uuid":"f83e2397-5c18-4dae-8076-5b3730ccffe7"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"If you want to facilitate interoperability of your data with data you get from elsewhere, and facilitate re-use of your own data later, it is handy if you use standard ways to encode certain data. Such standard encodings are sometimes called terminologies or ontologies."},"title":{"changed":false}},"createdAt":"2023-04-17T04:52:32Z","entityUuid":"2bac9020-99cf-4463-8d34-0b0eb2781cd1","parentUuid":"b1df3c74-0b1f-4574-81c4-4cc2d780c1af","uuid":"c006bc95-daa0-4e2c-a6a4-61e93ecf344d"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2023-04-17T04:53:21Z","entityUuid":"c0f78b3d-af6c-4083-8398-688984178536","parentUuid":"2bac9020-99cf-4463-8d34-0b0eb2781cd1","uuid":"ea262fcd-34a2-4ce2-8d5f-e5aef5492ad3"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"FAIRCookBook introduction to terminologies and ontologies"},"referenceType":"URLReference","url":{"changed":true,"value":"https://w3id.org/faircookbook/FCB019"}},"createdAt":"2023-04-17T04:53:45Z","entityUuid":"c0f78b3d-af6c-4083-8398-688984178536","parentUuid":"2bac9020-99cf-4463-8d34-0b0eb2781cd1","uuid":"d25603f6-51ff-45d9-93cf-5fe86df418dd"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":true,"value":["c0f78b3d-af6c-4083-8398-688984178536","06211161-75e4-43b7-8e80-c470fccb2893"]},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2023-04-17T04:53:55Z","entityUuid":"2bac9020-99cf-4463-8d34-0b0eb2781cd1","parentUuid":"b1df3c74-0b1f-4574-81c4-4cc2d780c1af","uuid":"49b0dc0c-d905-4ac9-8e72-bda24c4c0fc1"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2023-04-17T04:55:36Z","entityUuid":"5669ca15-3bab-46b5-9b0d-9e1013e6172b","parentUuid":"2bac9020-99cf-4463-8d34-0b0eb2781cd1","uuid":"ceee3918-85fd-40a1-a18e-4edd9537652f"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"FAIRCookBook on selecting terminologies and ontologies"},"referenceType":"URLReference","url":{"changed":true,"value":"https://w3id.org/faircookbook/FCB020"}},"createdAt":"2023-04-17T04:57:17Z","entityUuid":"5669ca15-3bab-46b5-9b0d-9e1013e6172b","parentUuid":"2bac9020-99cf-4463-8d34-0b0eb2781cd1","uuid":"a170fc93-56de-43dc-adf1-2a27d334bc46"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":true,"value":["c0f78b3d-af6c-4083-8398-688984178536","5669ca15-3bab-46b5-9b0d-9e1013e6172b","06211161-75e4-43b7-8e80-c470fccb2893"]},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2023-04-17T04:57:25Z","entityUuid":"2bac9020-99cf-4463-8d34-0b0eb2781cd1","parentUuid":"b1df3c74-0b1f-4574-81c4-4cc2d780c1af","uuid":"b85aa6e2-e859-4e70-9649-1c2c6cc6a4b5"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2023-04-17T05:01:53Z","entityUuid":"434b28c1-dbc0-4dd0-bb53-6d6ad51b86f4","parentUuid":"6d18bfff-0f53-469b-934e-9806dda9d4fb","uuid":"f7efef6a-7a2f-4149-b38a-78a4b53501ec"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"If anyone wants to see whether they can re-use your data, it must be possible to see what information in contains. For this, a data dictionary can play an important role."},"title":{"changed":true,"value":"Will you be creating a data/variable dictionary?"}},"createdAt":"2023-04-17T05:03:23Z","entityUuid":"434b28c1-dbc0-4dd0-bb53-6d6ad51b86f4","parentUuid":"6d18bfff-0f53-469b-934e-9806dda9d4fb","uuid":"4f8c8534-feab-4d6d-8290-4f2c84338990"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2023-04-17T05:03:29Z","entityUuid":"93d19bdb-a977-42d6-9ecd-edfaed543281","parentUuid":"434b28c1-dbc0-4dd0-bb53-6d6ad51b86f4","uuid":"bf93d5aa-2128-473d-a936-3c1425a19629"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2023-04-17T05:03:35Z","entityUuid":"c6efc94b-68e0-4d1c-a8c9-f02bd736623c","parentUuid":"434b28c1-dbc0-4dd0-bb53-6d6ad51b86f4","uuid":"3d2c0412-ea1a-4537-aea9-026a73c7319e"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2023-04-17T05:03:43Z","entityUuid":"7be357bc-b820-42af-a512-95d68cb78d79","parentUuid":"434b28c1-dbc0-4dd0-bb53-6d6ad51b86f4","uuid":"a1a2e56e-6512-4112-9cbf-86b6410e6777"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"FAIRCookBook on creating a data/variable dictionary"},"referenceType":"URLReference","url":{"changed":true,"value":"https://w3id.org/faircookbook/FCB025"}},"createdAt":"2023-04-17T05:04:14Z","entityUuid":"7be357bc-b820-42af-a512-95d68cb78d79","parentUuid":"434b28c1-dbc0-4dd0-bb53-6d6ad51b86f4","uuid":"62a10809-beb3-418c-82a0-ea000990eea8"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":true,"value":["1440af