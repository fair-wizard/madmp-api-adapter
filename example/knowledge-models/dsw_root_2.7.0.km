tations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Not yet"},"metricMeasures":{"changed":false}},"createdAt":"2020-01-04T14:37:59Z","entityUuid":"4dd69e44-097b-42fc-98a4-4ce379453d46","parentUuid":"f691ad73-1284-4c7d-999d-34bb0612dd42","uuid":"0af6dd23-fe16-4804-ad74-323f6f5b1dab"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":"Are any personal data sufficiently protected?"},"createdAt":"2020-01-04T14:38:00Z","entityUuid":"d5990471-0618-42cd-92cb-bbbfd4f61532","parentUuid":"b2f76c0a-847a-403c-9ed6-09cad10e625e","uuid":"f643ed07-c0d3-4d0d-a574-b94bd4a9bbc6"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"We are not using any personal information","metricMeasures":[]},"createdAt":"2020-01-04T14:38:01Z","entityUuid":"5d518250-a5d3-47f1-ada8-aa64c9ce3370","parentUuid":"d5990471-0618-42cd-92cb-bbbfd4f61532","uuid":"32e324e4-d1a7-4356-8012-e055655908d9"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes, all personal information will be processed in pseudonymized  form only","metricMeasures":[]},"createdAt":"2020-01-04T14:38:02Z","entityUuid":"75b86c10-4aeb-4f1a-89cd-8b380a2287b1","parentUuid":"d5990471-0618-42cd-92cb-bbbfd4f61532","uuid":"27902693-9030-442c-8310-155aa096e1a3"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":"How is pseudonymization handled?"},"createdAt":"2020-01-04T14:38:03Z","entityUuid":"59748a7b-f729-404d-babe-3147e2c6b247","parentUuid":"75b86c10-4aeb-4f1a-89cd-8b380a2287b1","uuid":"a4395601-2030-4793-91eb-b1ba23cd6764"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"We pseudonymize inside the project, only limited people can access the keys","metricMeasures":[]},"created