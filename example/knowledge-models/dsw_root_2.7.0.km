","uuid":"6086fa22-5f29-49a2-89eb-358e0caaa905"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-06-15T14:20:29Z","entityUuid":"ef15f149-40e2-47b6-9375-4abed6f4a4f3","parentUuid":"340d766a-69ec-4805-8f73-6d2631dafe90","uuid":"cdb1696d-2526-4eb1-8121-f635b883a188"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"No"},"metricMeasures":{"changed":false}},"createdAt":"2022-06-15T14:20:31Z","entityUuid":"ef15f149-40e2-47b6-9375-4abed6f4a4f3","parentUuid":"340d766a-69ec-4805-8f73-6d2631dafe90","uuid":"d66b4dcb-e2b8-4bf1-924d-55ca29b13a13"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-06-15T14:20:39Z","entityUuid":"0048b0e2-24af-4cbd-9683-46910ce190d3","parentUuid":"340d766a-69ec-4805-8f73-6d2631dafe90","uuid":"58788b90-38b9-4879-9f3d-9918ac02019c"},{"content":{"advice":{"changed":true,"value":"_We are interested to receive your expertise on this topic. You can use the feedback button if you have resources that we could list here_"},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Yes"},"metricMeasures":{"changed":false}},"createdAt":"2022-06-15T14:20:48Z","entityUuid":"0048b0e2-24af-4cbd-9683-46910ce190d3","parentUuid":"340d766a-69ec-4805-8f73-6d2631dafe90","uuid":"406a3e0c-ffac-4043-be9a-92c50b9abd3b"},{"content":{"advice":{"changed":true,"value":"Biomedical ontologies can be found at:\n* [BioPortal](https://www.bioontology.org/)\n* [EBI Ontology Lookup Service](https://www.ebi.ac.uk/ols/index)"},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":false},"metricMeasures":{"changed":false}},"createdAt":"2022-06-15T14:22:38Z","entityUuid":"72fa7784-6b46-45a1-8b06-53b325388376","parentUuid":"884585e3-85f7-4620-bf1e-5f302f9599b8","uuid":"a0006169-cc5b-4907-9555-ca8ef32e8d33"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Research funding organisations more and more demand that you search for existing data sets that could have information that you need, before assuming you need to collect all data yourself. You are asked to list what you have been able to locate, and whether you have found it suitable to use in your research. Do you need pointers to find such existing data sets?"},"title":{"changed":false}},"createdAt":"2022-06-15T14:36:25Z","entityUuid":"726e4a24-6d81-440b-8a70-5d36fa65c3a9","parentUuid":"82fd0cce-2b41-423f-92ad-636d0872045c","uuid":"751fabda-0987-45e1-8358-ea077a77d5e5"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"In many research fields there are standard file formats and types that have been established by disciplinary standards organisations. Using such standards can help increase the interoperability of your data with other data and tools. Do you need help finding the right standards to use in your research?"},"title":{"changed":false}},"createdAt":"2022-06-15T14:38:21Z","entityUuid":"d4a879f1-0bad-4d6e-8ecc-07ae28e0848b","parentUuid":"b1df3c74-0b1f-4574-81c4-4cc2d780c1af","uuid":"f5c31fb6-1408-4081-ab25-356ef52074cf"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2022-06-15T14:41:00Z","entityUuid":"8dc09427-dcee-4df7-89c1-bb2515cfd95b","parentUuid":"0342a980-db05-4e10-9e0b-7b15564b0152","uuid":"3d6c652e-c43f-46ef-8afb-88cca0ac61fb"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Will you need data formats for Humanities?"}},"createdAt":"2022-06-15T14:41:11Z","entityUuid":"8dc09427-dcee-4df7-89c1-bb2515cfd95b","parentUuid":"0342a980-db05-4e10-9e0b-7b15564b0152","uuid":"5479c6b5-007d-4a20-863a-dbd6c554beb9"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Will you need data formats for Social Sciences?"}},"createdAt":"2022-06-15T14:41:14Z","entityUuid":"d34f2b16-77f0-425a-9e83-7b28095a58ca","parentUuid":"0342a980-db05-4e10-9e0b-7b15564b0152","uuid":"3418a8a8-be63-4da2-9438-08683f008c3f"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":null},"title":{"changed":true,"value":"Will you need data formats for Agricultural Sciences?"}},"createdAt":"2022-06-15T14:41:18Z","entityUuid":"76a5112d-229f-4de2-8274-af20137f9553","parentUuid":"0342a980-db05-4e10-9e0b-7b15564b0152","uuid":"b83b3ed9-50ee-44d4-be9d-5db9ca3db55b"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-06-15T14:44:11Z","entityUuid":"559ed1cf-42e4-40c7-b600-63afe1a2c607","parentUuid":"8dc09427-dcee-4df7-89c1-bb2515cfd95b","uuid":"02142fac-1891-4df2-9066-48cec5466afb"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"No"},"metricMeasures":{"changed":false}},"createdAt":"2022-06-15T14:44:13Z","entityUuid":"559ed1cf-42e4-40c7-b600-63afe1a2c607","parentUuid":"8dc09427-dcee-4df7-89c1-bb2515cfd95b","uuid":"4ea13241-4ce1-46ae-9a12-5d39a09f9f46"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-06-15T14:44:16Z","entityUuid":"5894e2b2-f38b-486f-aae0-64fd61497a44","parentUuid":"8dc09427-dcee-4df7-89c1-bb2515cfd95b","uuid":"e4b02fce-f06b-4c28-9283-9e8f090a3c95"},{"content":{"advice":{"changed":true,"value":"_We are interested to receive your expertise on this topic. You can use the feedback button if you have resources that we could list here_"},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Yes"},"metricMeasures":{"changed":false}},"createdAt":"2022-06-15T14:44:26Z","entityUuid":"5894e2b2-f38b-486f-aae0-64fd61497a44","parentUuid":"8dc09427-dcee-4df7-89c1-bb2515cfd95b","uuid":"19fb4195-d145-4b3f-99c9-0e0f746eda41"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Did you make appointments in the project on how to name files and folders?"}},"createdAt":"2022-06-15T14:52:01Z","entityUuid":"d4fe0b55-4aee-4d05-88d4-a3f4cad2cfa9","parentUuid":"c05f27a2-30ac-44fd-9ac9-cd6f62b16d0c","uuid":"bbdea1df-6824-47bc-b21b-ae157dac52ac"}],"forkOfPackageId":null,"id":"dsw:root:2.4.2","kmId":"root","language":"en","license":"Apache-2.0","mergeCheckpointPackageId":null,"metamodelVersion":20,"name":"Common DSW Knowledge Model","nonEditable":false,"organizationId":"dsw","phase":"DeprecatedKnowledgeModelPackagePhase","previousPackageId":"dsw:root:2.4.1","readme":"# Common DSW Knowledge Model\r\n\r\nCommon DSW Knowledge Model deals with questions that a researcher should answer in order to create a Data Stewardship Plan, as well as other related questionnaire data. It originated from mindmap made by Rob Hooft.\r\n\r\n## Changelog\r\n\r\n### 2.4.2\r\n\r\n* Changes from workshops together with RDMkit on Toxicology, Biomolecular Simulations and\r\n   Epitranscriptomics\r\n  - Small changes to phrasing and clarifications in various locations\r\n  - New guidance hierarchies added to locate existing data, standards and terminologies\r\n  - Moved \"provenance\" questions into the rest of the \"metadata\" group\r\n  - Added guidance summarising how to avoid problems with large amounts of intermediate data\r\n\r\n### 2.4.1\r\n\r\n* Fixed several minor typos (missing end of sentence, misspelling, typography etc.)\r\n\r\n### 2.4.0\r\n\r\n* KM verified and tested with the **Horizon Europe DMP template**\r\n\r\n### 2.3.14\r\n\r\n* Tags for Horizon Europe template generated\r\n\r\n### 2.3.13\r\n\r\n* Incorporating changes related to the Data Reuse workshop with RDMkit\r\n\r\n### 2.3.12\r\n\r\n* Incorporating changes related to the Data Analytics workshop with RDMkit\r\n\r\n### 2.3.11\r\n\r\n* Incorporating changes made in the Plant Sciences workshop with RDMkit\r\n\r\n### 2.3.10\r\n\r\n* Added references and questions from an RDMkit/DS Wizard working session on Preserving Data\r\n\r\n### 2.3.9\r\n\r\n* Fix missing Yes/No answers and use Text-Value for description of policies\r\n\r\n### 2.3.8\r\n\r\n* Questions for Horizon Europe added on budget for data management, other policies that are observed, persistent identifier allocation and archive preservation policies [Marek/Jana Horizon Europe issues 7-9, 11]\r\n\r\n### 2.3.7\r\n\r\n* Added references and questions from an RDMkit/DS Wizard working session on Human Data\r\n\r\n### 2.3.6\r\n\r\n* Questions about metadata for Horizon Europe added [Marek/Jana Horizon Europe issues 4-6]\r\n\r\n### 2.3.5\r\n\r\n* Added Tag for Horizon Europe\r\n* Moved the new questions from 2.3.4 from \"Science Europe\" to \"Horizon Europe\"\r\n* Added new question about qualified references from published data sets [Marek/Jana Horizon Europe issue 3]\r\n\r\n### 2.3.4\r\n\r\n* Change lists of reused (non-)reference datasets that are reused into lists of considered datasets, and add a question for each detailing whether they are actually reused and what for / why not. This is to be included in the Science Europe template [Marek/Jana Horizon Europe issue 1 and 2].\r\n\r\n### 2.3.3\r\n\r\n* Incorporation of changes from a collaborative workshop with RDMkit participants on data processing.\r\n   * Added links to RDMkit (and some to other external resources) in several places\r\n   * Clarified some questions\r\n   * Added question on data versioning for filesystems\r\n\r\n### 2.3.2\r\n\r\n* Incorporation of changes from a workshop with the authors of the RDMkit page on data collecting.\r\n   * Added links to RDMkit in several places\r\n   * Clarified some questions\r\n   * Moved questions on quality together\r\n   * Moved some questions out of the metadata subsection\r\n\r\n### 2.3.1\r\n\r\n* Incorporation of changes from a workshop with the authors of the RDMkit page on data sharing.\r\n    * Attempt to clarify difference between \"open\" and \"accessible\"\r\n    * Attempt to clarify difference between \"open\" and \"embargoed\"\r\n    * Added links to RDMkit Data Sharing page in a few places\r\n    * Added a few relevant questions\r\n\r\n### 2.3.0\r\n\r\nActivity during [BioHackathon Europe](biohackathon-europe.org) 2020 ([#BioHackEU20](twitter.com/search?q=%23BioHackEU20))\r\n\r\n* Added and tagged questions for Horizon 2020 template\r\n* Moved questions about collecting metadata to one consistent place\r\n* Added guidance on semantics in file names and question about using PIDs for identifying files\r\n* Generic small cleanups and typo fixes\r\n* Closing many issues of feedback received on the knowledge model (from [DSWGlobal/dsw](https://github.com/DSWGlobal/dsw))\r\n* Various question updates new options, clarifications, integrations\r\n* Added highly configurable [Wikidata](https://www.wikidata.org) SPARQL-based integration\r\n* Added [Research Organization Registry](https://ror.org) integration for contributor's affiliation\r\n\r\n### 2.2.0\r\n\r\n* Adjusted for compatibility with [RDA DMP Common Standard for machine-actionable DMPs (1.0)](https://github.com/RDA-DMP-Common/RDA-DMP-Common-Standard)\r\n  * Updated *Project* and *Funding* questions in *Administrative Details* chapter\r\n  * Reorganised *Dataset*, *Distribution*, *License* questions in *Data Publishing* chapter\r\n* Added *maDMP* tag to questions used in the RDA maDMP template\r\n\r\n### 2.1.0\r\n\r\n* Added *Science Europe DMP* tag to questions used in the Science Europe template\r\n\r\n### 2.0.2\r\n\r\n* Fixed missing and duplicated questions\r\n\r\n### 2.0.1\r\n\r\n* Fixed duplicated question in *Creating and collecting data* chapter (5ba53879-eb48-47f2-a73b-f7f7d83bf030)\r\n\r\n### 2.0.0\r\n\r\n* Added detailed questions for Science Europe DMPs\r\n* Fixed several typos and other minor problems\r\n* Added administrative chapter\r\n* Moving questions and refactoring according to [ds-km#24](https://github.com/ds-wizard/ds-km/pull/24)\r\n\r\n### 1.4.0\r\n\r\n* Adding integration for [FAIRsharing.org](https://fairsharing.org)\r\n* Adding 5 integration questions according to [ds-km@da5a8fc](https://github.com/ds-wizard/ds-km/commit/da5a8fc95d0a67f9369ce0b7727615115fc3656d)\r\n\r\nThe FAIRsharing integration requires configuration to contain `apiUrl` and `apiKey` for integration with id `fairsharing`.\r\n\r\n### 1.3.0\r\n\r\n* Refactoring list questions because of **deprecated item title** fields, i.e., a new question for item title created for each list question\r\n\r\nWhen using this version and higher, the DS Wizard configuration should have `itemTitleEnabled` set to `false`.\r\n\r\n### 1.2.0\r\n\r\n* Adding file naming SOP description question (9ff389f0-2236-48cf-880c-040ea1bb0d2f) to chapter 2 according to [ds-km@d879be0](https://github.com/ds-wizard/ds-km/commit/d879be0fa9d0808868396c649d03c4d783ac6742)\r\n\r\n### 1.1.0\r\n\r\n* Adding phases to questions (first draft) according to [ds-km@a6713d1](https://github.com/ds-wizard/ds-km/commit/a6713d1a4b9758bea63b3f7c56af5bd4f500d949) and [ds-km@1123211](https://github.com/ds-wizard/ds-km/commit/1123211bb5af43df8ef435039a2923f48e3e981c)\r\n\r\nPrior to this version, all questions were assigned with phase 2 - *Before submitting the DMP*.\r\n\r\n### 1.0.3\r\n\r\n* Fix: Removing extra question mark for a question (8018e15f-6c7e-433a-8686-ae0d695c7fc7) in chapter 5 according to: [ds-km@1123211](https://github.com/ds-wizard/ds-km/commit/1123211bb5af43df8ef435039a2923f48e3e981c)\r\n\r\n### 1.0.2\r\n\r\n* Fix: Adding some explanation to the list item questions (f5fef09d-ade5-4019-b089-f05bd89c34bc and b642c31d-a512-4ca7-8743-a2e0254006fa) in chapter 3 according to: [ds-km@96e28f4](https://github.com/ds-wizard/ds-km/commit/96e28f478d5dc6b59d384b5127f012dc2fe5f287)\r\n\r\n### 1.0.1\r\n\r\n* Fix: Adding forgotten question mark to end of question (39e0cc7c-17fe-4991-88d8-1280c3fe7923) in chapter 1 according to: [ds-km@644a373](https://github.com/ds-wizard/ds-km/commit/644a373685dc4ac15b76e86667a90151ca9c70ca)\r\n\r\n### 1.0.0\r\n\r\n* Initial version transformed from the previous DS-KM GitHub repository up to [ds-km@8442837](https://github.com/ds-wizard/ds-km/commit/8442837dbe3ff899b09e7d8d3fc1107e935a876f)","version":"2.4.2"},{"createdAt":"2022-09-22T15:17:37.273584Z","description":"DSW Knowledge Model originating from mindmap made by Rob Hooft","events":[{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":true,"value":"EmailQuestionValueType"}},"createdAt":"2022-06-15T15:01:15Z","entityUuid":"3a2ffc13-6a0e-4976-bb34-14ab6d938348","parentUuid":"73d686bd-7939-412e-8631-502ee6d9ea7b","uuid":"f6f7f7dc-7120-4195-bcda-ade05ecdd889"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2022-06-16T15:11:38Z","entityUuid":"91440234-5fb8-4342-909e-39196dfbb143","parentUuid":"8c962e6f-17ee-4b22-8ebb-9f06f779e3b3","uuid":"6c85fdcd-ed96-43d7-8bf7-3131e1f6d947"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"Metadata Standards Catalogue (RDA)"},"referenceType":"URLReference","url":{"changed":true,"value":"https://rdamsc.bath.ac.uk/"}},"createdAt":"2022-06-16T15:11:52Z","entityUuid":"91440234-5fb8-4342-909e-39196dfbb143","parentUuid":"8c962e6f-17ee-4b22-8ebb-9f06f779e3b3","uuid":"12f0aac8-6f79-4edc-95ba-664a1551f4a2"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":true,"value":"UrlQuestionValueType"}},"createdAt":"2022-09-22T15:13:13Z","entityUuid":"a00ae929-d5cf-43c0-8e9e-cdb12ebde717","parentUuid":"c3dabaaf-c946-4a0d-889c-ede966f97667","uuid":"1e3908b0-259a-4e6f-81b3-52baefb5d58e"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":true,"value":"UrlQuestionValueType"}},"createdAt":"2022-09-22T15:13:31Z","entityUuid":"e13bf3cb-cf78-486e-b844-2c12320919c4","parentUuid":"87964502-4401-45e5-9084-d6c84a417acf","uuid":"85ac8b00-ba23-4bf0-ad37-a5bb3f00eb5c"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":true,"value":"UrlQuestionValueType"}},"createdAt":"2022-09-22T15:13:44Z","entityUuid":"7801fe70-a2ac-432b-9470-e326646c249f","parentUuid":"fcc51962-08df-4f4c-85ad-6bb932107010","uuid":"e8ddf84e-9e7b-4cd5-8ff2-f68f967e20b5"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":true,"value":"UrlQuestionValueType"}},"createdAt":"2022-09-22T15:14:09Z","entityUuid":"5f73797c-268a-4862-b48b-75719ff47709","parentUuid":"be872000-cb98-442f-999c-ca3ef58dcfe8","uuid":"1a7b7988-2751-4d61-9154-0209719b5918"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":true,"value":"UrlQuestionValueType"}},"createdAt":"2022-09-22T15:14:53Z","entityUuid":"c00627a4-40e3-48c2-b481-a0cff5e00080","parentUuid":"2bac9020-99cf-4463-8d34-0b0eb2781cd1","uuid":"d73d96a6-c796-438d-b016-9756fb65500b"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":true,"value":"UrlQuestionValueType"}},"createdAt":"2022-09-22T15:15:44Z","entityUuid":"6cf69cc9-bd6c-4e51-98a2-817d1d211720","parentUuid":"9d44b89e-300d-4227-8642-c6b38b8b882d","uuid":"db043004-5a20-4807-a696-232991d8fd96"},{"content":{"eventType":"DeleteReferenceEvent"},"createdAt":"2022-09-22T15:15:54Z","entityUuid":"5c29bf88-3b5e-4abd-aeaf-64c1a63dcc55","parentUuid":"e1dba221-ad5a-474e-a2e3-9b4e472959fa","uuid":"ddccb3f6-1b80-4407-b7f3-2157ea6ec43b"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":true,"value":"UrlQuestionValueType"}},"createdAt":"2022-09-22T15:16:20Z","entityUuid":"375792f1-d7c3-4c8d-bf9e-f15ffa38e2fb","parentUuid":"734d5f4e-91c0-4019-8164-8c70c2e0c8f2","uuid":"b3aaff74-00be-4c88-b703-8ad5b662dcd5"}],"forkOfPackageId":null,"id":"dsw:root:2.4.3","kmId":"root","language":"en","license":"Apache-2.0","mergeCheckpointPackageId":null,"metamodelVersion":20,"name":"Common DSW Knowledge Model","nonEditable":false,"organizationId":"dsw","phase":"DeprecatedKnowledgeModelPackagePhase","previousPackageId":"dsw:root:2.4.2","readme":"# Common DSW Knowledge Model\r\n\r\nCommon DSW Knowledge Model deals with questions that a researcher should answer in order to create a Data Stewardship Plan, as well as other related questionnaire data. It originated from mindmap made by Rob Hooft.\r\n\r\n## Changelog\r\n\r\n### 2.4.3\r\n\r\n* Use of new value-question types (mostly email and URL)\r\n* New references\r\n\r\n### 2.4.2\r\n\r\n* Changes from workshops together with RDMkit on Toxicology, Biomolecular Simulations and\r\n   Epitranscriptomics\r\n  - Small changes to phrasing and clarifications in various locations\r\n  - New guidance hierarchies added to locate existing data, standards and terminologies\r\n  - Moved \"provenance\" questions into the rest of the \"metadata\" group\r\n  - Added guidance summarising how to avoid problems with large amounts of intermediate data\r\n\r\n### 2.4.1\r\n\r\n* Fixed several minor typos (missing end of sentence, misspelling, typography etc.)\r\n\r\n### 2.4.0\r\n\r\n* KM verified and tested with the **Horizon Europe DMP template**\r\n\r\n### 2.3.14\r\n\r\n* Tags for Horizon Europe template generated\r\n\r\n### 2.3.13\r\n\r\n* Incorporating changes related to the Data Reuse workshop with RDMkit\r\n\r\n### 2.3.12\r\n\r\n* Incorporating changes related to the Data Analytics workshop with RDMkit\r\n\r\n### 2.3.11\r\n\r\n* Incorporating changes made in the Plant Sciences workshop with RDMkit\r\n\r\n### 2.3.10\r\n\r\n* Added references and questions from an RDMkit/DS Wizard working session on Preserving Data\r\n\r\n### 2.3.9\r\n\r\n* Fix missing Yes/No answers and use Text-Value for description of policies\r\n\r\n### 2.3.8\r\n\r\n* Questions for Horizon Europe added on budget for data management, other policies that are observed, persistent identifier allocation and archive preservation policies [Marek/Jana Horizon Europe issues 7-9, 11]\r\n\r\n### 2.3.7\r\n\r\n* Added references and questions from an RDMkit/DS Wizard working session on Human Data\r\n\r\n### 2.3.6\r\n\r\n* Questions about metadata for Horizon Europe added [Marek/Jana Horizon Europe issues 4-6]\r\n\r\n### 2.3.5\r\n\r\n* Added Tag for Horizon Europe\r\n* Moved the new questions from 2.3.4 from \"Science Europe\" to \"Horizon Europe\"\r\n* Added new question about qualified references from published data sets [Marek/Jana Horizon Europe issue 3]\r\n\r\n### 2.3.4\r\n\r\n* Change lists of reused (non-)reference datasets that are reused into lists of considered datasets, and add a question for each detailing whether they are actually reused and what for / why not. This is to be included in the Science Europe template [Marek/Jana Horizon Europe issue 1 and 2].\r\n\r\n### 2.3.3\r\n\r\n* Incorporation of changes from a collaborative workshop with RDMkit participants on data processing.\r\n   * Added links to RDMkit (and some to other external resources) in several places\r\n   * Clarified some questions\r\n   * Added question on data versioning for filesystems\r\n\r\n### 2.3.2\r\n\r\n* Incorporation of changes from a workshop with the authors of the RDMkit page on data collecting.\r\n   * Added links to RDMkit in several places\r\n   * Clarified some questions\r\n   * Moved questions on quality together\r\n   * Moved some questions out of the metadata subsection\r\n\r\n### 2.3.1\r\n\r\n* Incorporation of changes from a workshop with the authors of the RDMkit page on data sharing.\r\n    * Attempt to clarify difference between \"open\" and \"accessible\"\r\n    * Attempt to clarify difference between \"open\" and \"embargoed\"\r\n    * Added links to RDMkit Data Sharing page in a few places\r\n    * Added a few relevant questions\r\n\r\n### 2.3.0\r\n\r\nActivity during [BioHackathon Europe](biohackathon-europe.org) 2020 ([#BioHackEU20](twitter.com/search?q=%23BioHackEU20))\r\n\r\n* Added and tagged questions for Horizon 2020 template\r\n* Moved questions about collecting metadata to one consistent place\r\n* Added guidance on semantics in file names and question about using PIDs for identifying files\r\n* Generic small cleanups and typo fixes\r\n* Closing many issues of feedback received on the knowledge model (from [DSWGlobal/dsw](https://github.com/DSWGlobal/dsw))\r\n* Various question updates new options, clarifications, integrations\r\n* Added highly configurable [Wikidata](https://www.wikidata.org) SPARQL-based integration\r\n* Added [Research Organization Registry](https://ror.org) integration for contributor's affiliation\r\n\r\n### 2.2.0\r\n\r\n* Adjusted for compatibility with [RDA DMP Common Standard for machine-actionable DMPs (1.0)](https://github.com/RDA-DMP-Common/RDA-DMP-Common-Standard)\r\n  * Updated *Project* and *Funding* questions in *Administrative Details* chapter\r\n  * Reorganised *Dataset*, *Distribution*, *License* questions in *Data Publishing* chapter\r\n* Added *maDMP* tag to questions used in the RDA maDMP template\r\n\r\n### 2.1.0\r\n\r\n* Added *Science Europe DMP* tag to questions used in the Science Europe template\r\n\r\n### 2.0.2\r\n\r\n* Fixed missing and duplicated questions\r\n\r\n### 2.0.1\r\n\r\n* Fixed duplicated question in *Creating and collecting data* chapter (5ba53879-eb48-47f2-a73b-f7f7d83bf030)\r\n\r\n### 2.0.0\r\n\r\n* Added detailed questions for Science Europe DMPs\r\n* Fixed several typos and other minor problems\r\n* Added administrative chapter\r\n* Moving questions and refactoring according to [ds-km#24](https://github.com/ds-wizard/ds-km/pull/24)\r\n\r\n### 1.4.0\r\n\r\n* Adding integration for [FAIRsharing.org](https://fairsharing.org)\r\n* Adding 5 integration questions according to [ds-km@da5a8fc](https://github.com/ds-wizard/ds-km/commit/da5a8fc95d0a67f9369ce0b7727615115fc3656d)\r\n\r\nThe FAIRsharing integration requires configuration to contain `apiUrl` and `apiKey` for integration with id `fairsharing`.\r\n\r\n### 1.3.0\r\n\r\n* Refactoring list questions because of **deprecated item title** fields, i.e., a new question for item title created for each list question\r\n\r\nWhen using this version and higher, the DS Wizard configuration should have `itemTitleEnabled` set to `false`.\r\n\r\n### 1.2.0\r\n\r\n* Adding file naming SOP description question (9ff389f0-2236-48cf-880c-040ea1bb0d2f) to chapter 2 according to [ds-km@d879be0](https://github.com/ds-wizard/ds-km/commit/d879be0fa9d0808868396c649d03c4d783ac6742)\r\n\r\n### 1.1.0\r\n\r\n* Adding phases to questions (first draft) according to [ds-km@a6713d1](https://github.com/ds-wizard/ds-km/commit/a6713d1a4b9758bea63b3f7c56af5bd4f500d949) and [ds-km@1123211](https://github.com/ds-wizard/ds-km/commit/1123211bb5af43df8ef435039a2923f48e3e981c)\r\n\r\nPrior to this version, all questions were assigned with phase 2 - *Before submitting the DMP*.\r\n\r\n### 1.0.3\r\n\r\n* Fix: Removing extra question mark for a question (8018e15f-6c7e-433a-8686-ae0d695c7fc7) in chapter 5 according to: [ds-km@1123211](https://github.com/ds-wizard/ds-km/commit/1123211bb5af43df8ef435039a2923f48e3e981c)\r\n\r\n### 1.0.2\r\n\r\n* Fix: Adding some explanation to the list item questions (f5fef09d-ade5-4019-b089-f05bd89c34bc and b642c31d-a512-4ca7-8743-a2e0254006fa) in chapter 3 according to: [ds-km@96e28f4](https://github.com/ds-wizard/ds-km/commit/96e28f478d5dc6b59d384b5127f012dc2fe5f287)\r\n\r\n### 1.0.1\r\n\r\n* Fix: Adding forgotten question mark to end of question (39e0cc7c-17fe-4991-88d8-1280c3fe7923) in chapter 1 according to: [ds-km@644a373](https://github.com/ds-wizard/ds-km/commit/644a373685dc4ac15b76e86667a90151ca9c70ca)\r\n\r\n### 1.0.0\r\n\r\n* Initial version transformed from the previous DS-KM GitHub repository up to [ds-km@8442837](https://github.com/ds-wizard/ds-km/commit/8442837dbe3ff899b09e7d8d3fc1107e935a876f)","version":"2.4.3"},{"createdAt":"2022-09-22T15:56:32.545442Z","description":"DSW Knowledge Model originating from mindmap made by Rob Hooft","events":[{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["87bb2042-8e3c-4733-ba1e-84509d7b1cf4","3c7bdc90-8ed3-4b34-90ec-7945d14cc443","19b0fe70-a884-4539-96b9-a0aaf8c9b884","fd4637a2-a117-460a-a7fa-c03760c42629"]},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2022-09-22T15:51:39Z","entityUuid":"efc80cc8-8318-4f8c-acb7-dc1c60e491c1","parentUuid":"82fd0cce-2b41-423f-92ad-636d0872045c","uuid":"c6ae8b9d-4415-4fe0-b776-687cf1d8ef85"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["87bb2042-8e3c-4733-ba1e-84509d7b1cf4","3c7bdc90-8ed3-4b34-90ec-7945d14cc443","fd4637a2-a117-460a-a7fa-c03760c42629"]},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2022-09-22T15:51:49Z","entityUuid":"fcc51962-08df-4f4c-85ad-6bb932107010","parentUuid":"2663b978-5125-4224-9930-0a50dbe895c9","uuid":"b6f78d53-12dd-4b36-808e-9f7ebb1b5e34"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["87bb2042-8e3c-4733-ba1e-84509d7b1cf4","3c7bdc90-8ed3-4b34-90ec-7945d14cc443","fd4637a2-a117-460a-a7fa-c03760c42629"]},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2022-09-22T15:51:59Z","entityUuid":"58401091-2d48-4231-983a-c972d11d9f6e","parentUuid":"fcc51962-08df-4f4c-85ad-6bb932107010","uuid":"cf491f61-3df8-4d32-ae47-8bd356bd3276"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["87bb2042-8e3c-4733-ba1e-84509d7b1cf4"]},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2022-09-22T15:52:16Z","entityUuid":"d45ad247-19d4-4919-9a6c-094f696168b6","parentUuid":"81642493-5919-42c6-b9b7-af4cdbe1937b","uuid":"9155689b-07a3-484a-87d1-f69d1b2b34b8"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["87bb2042-8e3c-4733-ba1e-84509d7b1cf4","3c7bdc90-8ed3-4b34-90ec-7945d14cc443","19b0fe70-a884-4539-96b9-a0aaf8c9b884","fd4637a2-a117-460a-a7fa-c03760c42629"]},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2022-09-22T15:52:25Z","entityUuid":"be872000-cb98-442f-999c-ca3ef58dcfe8","parentUuid":"2663b978-5125-4224-9930-0a50dbe895c9","uuid":"494539e1-20cc-40d2-bf08-12082fcc4086"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["87bb2042-8e3c-4733-ba1e-84509d7b1cf4","3c7bdc90-8ed3-4b34-90ec-7945d14cc443","fd4637a2-a117-460a-a7fa-c03760c42629"]},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2022-09-22T15:52:34Z","entityUuid":"f5e129dc-d59d-4352-a5ed-25efe1d83811","parentUuid":"be872000-cb98-442f-999c-ca3ef58dcfe8","uuid":"d5017b9f-4e32-439d-8f8f-c3167a3320f8"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["87bb2042-8e3c-4733-ba1e-84509d7b1cf4"]},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2022-09-22T15:52:40Z","entityUuid":"4e0141ae-bec4-492e-98f4-b79a32c7e946","parentUuid":"042540a6-5b4a-483d-af23-f33b486d85f5","uuid":"fcd9d241-6b52-4445-8f9e-e0e15114d30c"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["87bb2042-8e3c-4733-ba1e-84509d7b1cf4"]},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2022-09-22T15:53:44Z","entityUuid":"7828d3a0-29bf-450e-aee9-473457a225fd","parentUuid":"8d1b07a7-f177-41f5-9532-05536223a8d6","uuid":"70cb8521-a149-46e5-adc3-148246cab6a6"}],"forkOfPackageId":null,"id":"dsw:root:2.4.4","kmId":"root","language":"en","license":"Apache-2.0","mergeCheckpointPackageId":null,"metamodelVersion":20,"name":"Common DSW Knowledge Model","nonEditable":false,"organizationId":"dsw","phase":"ReleasedKnowledgeModelPackagePhase","previousPackageId":"dsw:root:2.4.3","readme":"# Common DSW Knowledge Model\r\n\r\nCommon DSW Knowledge Model deals with questions that a researcher should answer in order to create a Data Stewardship Plan, as well as other related questionnaire data. It originated from mindmap made by Rob Hooft.\r\n\r\n## Changelog\r\n\r\n### 2.4.4\r\n\r\n* Fix duplicated *Horizon Europe DMP* tags for several questions\r\n\r\n### 2.4.3\r\n\r\n* Use of new value-question types (mostly email and URL)\r\n* New references\r\n\r\n### 2.4.2\r\n\r\n* Changes from workshops together with RDMkit on Toxicology, Biomolecular Simulations and\r\n   Epitranscriptomics\r\n  - Small changes to phrasing and clarifications in various locations\r\n  - New guidance hierarchies added to locate existing data, standards and terminologies\r\n  - Moved \"provenance\" questions into the rest of the \"metadata\" group\r\n  - Added guidance summarising how to avoid problems with large amounts of intermediate data\r\n\r\n### 2.4.1\r\n\r\n* Fixed several minor typos (missing end of sentence, misspelling, typography etc.)\r\n\r\n### 2.4.0\r\n\r\n* KM verified and tested with the **Horizon Europe DMP template**\r\n\r\n### 2.3.14\r\n\r\n* Tags for Horizon Europe template generated\r\n\r\n### 2.3.13\r\n\r\n* Incorporating changes related to the Data Reuse workshop with RDMkit\r\n\r\n### 2.3.12\r\n\r\n* Incorporating changes related to the Data Analytics workshop with RDMkit\r\n\r\n### 2.3.11\r\n\r\n* Incorporating changes made in the Plant Sciences workshop with RDMkit\r\n\r\n### 2.3.10\r\n\r\n* Added references and questions from an RDMkit/DS Wizard working session on Preserving Data\r\n\r\n### 2.3.9\r\n\r\n* Fix missing Yes/No answers and use Text-Value for description of policies\r\n\r\n### 2.3.8\r\n\r\n* Questions for Horizon Europe added on budget for data management, other policies that are observed, persistent identifier allocation and archive preservation policies [Marek/Jana Horizon Europe issues 7-9, 11]\r\n\r\n### 2.3.7\r\n\r\n* Added references and questions from an RDMkit/DS Wizard working session on Human Data\r\n\r\n### 2.3.6\r\n\r\n* Questions about metadata for Horizon Europe added [Marek/Jana Horizon Europe issues 4-6]\r\n\r\n### 2.3.5\r\n\r\n* Added Tag for Horizon Europe\r\n* Moved the new questions from 2.3.4 from \"Science Europe\" to \"Horizon Europe\"\r\n* Added new question about qualified references from published data sets [Marek/Jana Horizon Europe issue 3]\r\n\r\n### 2.3.4\r\n\r\n* Change lists of reused (non-)reference datasets that are reused into lists of considered datasets, and add a question for each detailing whether they are actually reused and what for / why not. This is to be included in the Science Europe template [Marek/Jana Horizon Europe issue 1 and 2].\r\n\r\n### 2.3.3\r\n\r\n* Incorporation of changes from a collaborative workshop with RDMkit participants on data processing.\r\n   * Added links to RDMkit (and some to other external resources) in several places\r\n   * Clarified some questions\r\n   * Added question on data versioning for filesystems\r\n\r\n### 2.3.2\r\n\r\n* Incorporation of changes from a workshop with the authors of the RDMkit page on data collecting.\r\n   * Added links to RDMkit in several places\r\n   * Clarified some questions\r\n   * Moved questions on quality together\r\n   * Moved some questions out of the metadata subsection\r\n\r\n### 2.3.1\r\n\r\n* Incorporation of changes from a workshop with the authors of the RDMkit page on data sharing.\r\n    * Attempt to clarify difference between \"open\" and \"accessible\"\r\n    * Attempt to clarify difference between \"open\" and \"embargoed\"\r\n    * Added links to RDMkit Data Sharing page in a few places\r\n    * Added a few relevant questions\r\n\r\n### 2.3.0\r\n\r\nActivity during [BioHackathon Europe](biohackathon-europe.org) 2020 ([#BioHackEU20](twitter.com/search?q=%23BioHackEU20))\r\n\r\n* Added and tagged questions for Horizon 2020 template\r\n* Moved questions about collecting metadata to one consistent place\r\n* Added guidance on semantics in file names and question about using PIDs for identifying files\r\n* Generic small cleanups and typo fixes\r\n* Closing many issues of feedback received on the knowledge model (from [DSWGlobal/dsw](https://github.com/DSWGlobal/dsw))\r\n* Various question updates new options, clarifications, integrations\r\n* Added highly configurable [Wikidata](https://www.wikidata.org) SPARQL-based integration\r\n* Added [Research Organization Registry](https://ror.org) integration for contributor's affiliation\r\n\r\n### 2.2.0\r\n\r\n* Adjusted for compatibility with [RDA DMP Common Standard for machine-actionable DMPs (1.0)](https://github.com/RDA-DMP-Common/RDA-DMP-Common-Standard)\r\n  * Updated *Project* and *Funding* questions in *Administrative Details* chapter\r\n  * Reorganised *Dataset*, *Distribution*, *License* questions in *Data Publishing* chapter\r\n* Added *maDMP* tag to questions used in the RDA maDMP template\r\n\r\n### 2.1.0\r\n\r\n* Added *Science Europe DMP* tag to questions used in the Science Europe template\r\n\r\n### 2.0.2\r\n\r\n* Fixed missing and duplicated questions\r\n\r\n### 2.0.1\r\n\r\n* Fixed duplicated question in *Creating and collecting data* chapter (5ba53879-eb48-47f2-a73b-f7f7d83bf030)\r\n\r\n### 2.0.0\r\n\r\n* Added detailed questions for Science Europe DMPs\r\n* Fixed several typos and other minor problems\r\n* Added administrative chapter\r\n* Moving questions and refactoring according to [ds-km#24](https://github.com/ds-wizard/ds-km/pull/24)\r\n\r\n### 1.4.0\r\n\r\n* Adding integration for [FAIRsharing.org](https://fairsharing.org)\r\n* Adding 5 integration questions according to [ds-km@da5a8fc](https://github.com/ds-wizard/ds-km/commit/da5a8fc95d0a67f9369ce0b7727615115fc3656d)\r\n\r\nThe FAIRsharing integration requires configuration to contain `apiUrl` and `apiKey` for integration with id `fairsharing`.\r\n\r\n### 1.3.0\r\n\r\n* Refactoring list questions because of **deprecated item title** fields, i.e., a new question for item title created for each list question\r\n\r\nWhen using this version and higher, the DS Wizard configuration should have `itemTitleEnabled` set to `false`.\r\n\r\n### 1.2.0\r\n\r\n* Adding file naming SOP description question (9ff389f0-2236-48cf-880c-040ea1bb0d2f) to chapter 2 according to [ds-km@d879be0](https://github.com/ds-wizard/ds-km/commit/d879be0fa9d0808868396c649d03c4d783ac6742)\r\n\r\n### 1.1.0\r\n\r\n* Adding phases to questions (first draft) according to [ds-km@a6713d1](https://github.com/ds-wizard/ds-km/commit/a6713d1a4b9758bea63b3f7c56af5bd4f500d949) and [ds-km@1123211](https://github.com/ds-wizard/ds-km/commit/1123211bb5af43df8ef435039a2923f48e3e981c)\r\n\r\nPrior to this version, all questions were assigned with phase 2 - *Before submitting the DMP*.\r\n\r\n### 1.0.3\r\n\r\n* Fix: Removing extra question mark for a question (8018e15f-6c7e-433a-8686-ae0d695c7fc7) in chapter 5 according to: [ds-km@1123211](https://github.com/ds-wizard/ds-km/commit/1123211bb5af43df8ef435039a2923f48e3e981c)\r\n\r\n### 1.0.2\r\n\r\n* Fix: Adding some explanation to the list item questions (f5fef09d-ade5-4019-b089-f05bd89c34bc and b642c31d-a512-4ca7-8743-a2e0254006fa) in chapter 3 according to: [ds-km@96e28f4](https://github.com/ds-wizard/ds-km/commit/96e28f478d5dc6b59d384b5127f012dc2fe5f287)\r\n\r\n### 1.0.1\r\n\r\n* Fix: Adding forgotten question mark to end of question (39e0cc7c-17fe-4991-88d8-1280c3fe7923) in chapter 1 according to: [ds-km@644a373](https://github.com/ds-wizard/ds-km/commit/644a373685dc4ac15b76e86667a90151ca9c70ca)\r\n\r\n### 1.0.0\r\n\r\n* Initial version transformed from the previous DS-KM GitHub repository up to [ds-km@8442837](https://github.com/ds-wizard/ds-km/commit/8442837dbe3ff899b09e7d8d3fc1107e935a876f)","version":"2.4.4"},{"createdAt":"2023-01-27T07:44:38.045236Z","description":"DSW Knowledge Model originating from mindmap made by Rob Hooft","events":[{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["87bb2042-8e3c-4733-ba1e-84509d7b1cf4"]},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2022-11-10T13:16:20Z","entityUuid":"d21fdb06-22bf-418e-aa40-dc5ef1485f56","parentUuid":"81d3095e-a530-40a4-878e-ced42fabc4cd","uuid":"2d8d6a3b-f585-4964-815d-d86d366f842a"},{"content":{"annotations":{"changed":true,"value":[{"key":"","value":""}]},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2023-01-05T06:34:31Z","entityUuid":"d5784d24-0e66-4821-bd62-a711fb6d7a40","parentUuid":"d5b27482-b598-4b8c-b534-417d4ad27394","uuid":"a9a217dc-2321-4095-bee4-972a4817136f"},{"content":{"annotations":{"changed":true,"value":[]},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2023-01-26T13:48:14Z","entityUuid":"d5784d24-0e66-4821-bd62-a711fb6d7a40","parentUuid":"d5b27482-b598-4b8c-b534-417d4ad27394","uuid":"9dcdd835-db62-4cf7-b78b-81b81214b76d"}],"forkOfPackageId":null,"id":"dsw:root:2.4.5","kmId":"root","language":"en","license":"Apache-2.0","mergeCheckpointPackageId":null,"metamodelVersion":20,"name":"Common DSW Knowledge Model","nonEditable":false,"organizationId":"dsw","phase":"ReleasedKnowledgeModelPackagePhase","previousPackageId":"dsw:root:2.4.4","readme":"# Common DSW Knowledge Model\n\nCommon DSW Knowledge Model deals with questions that a researcher should answer in order to create a Data Stewardship Plan, as well as other related questionnaire data. It originated from mindmap made by Rob Hooft.\n\n## Changelog\n\n### 2.4.5\n\n* Minor textual changes\n\n### 2.4.4\n\n* Fix duplicated *Horizon Europe DMP* tags for several questions\n\n### 2.4.3\n\n* Use of new value-question types (mostly email and URL)\n* New references\n\n### 2.4.2\n\n* Changes from workshops together with RDMkit on Toxicology, Biomolecular Simulations and    \n   Epitranscriptomics\n  - Small changes to phrasing and clarifications in various locations\n  - New guidance hierarchies added to locate existing data, standards and terminologies\n  - Moved \"provenance\" questions into the rest of the \"metadata\" group\n  - Added guidance summarising how to avoid problems with large amounts of intermediate data\n\n### 2.4.1\n\n* Fixed several minor typos (missing end of sentence, misspelling, typography etc.)\n\n### 2.4.0\n\n* KM verified and tested with the **Horizon Europe DMP template**\n\n### 2.3.14\n\n* Tags for Horizon Europe template generated\n\n### 2.3.13\n\n* Incorporating changes related to the Data Reuse workshop with RDMkit\n\n### 2.3.12\n\n* Incorporating changes related to the Data Analytics workshop with RDMkit\n\n### 2.3.11\n\n* Incorporating changes made in the Plant Sciences workshop with RDMkit\n\n### 2.3.10\n\n* Added references and questions from an RDMkit/DS Wizard working session on Preserving Data\n\n### 2.3.9\n\n* Fix missing Yes/No answers and use Text-Value for description of policies\n\n### 2.3.8\n\n* Questions for Horizon Europe added on budget for data management, other policies that are observed, persistent identifier allocation and archive preservation policies [Marek/Jana Horizon Europe issues 7-9, 11]\n\n### 2.3.7\n\n* Added references and questions from an RDMkit/DS Wizard working session on Human Data\n\n### 2.3.6\n\n* Questions about metadata for Horizon Europe added [Marek/Jana Horizon Europe issues 4-6]\n\n### 2.3.5\n\n* Added Tag for Horizon Europe\n* Moved the new questions from 2.3.4 from \"Science Europe\" to \"Horizon Europe\"\n* Added new question about qualified references from published data sets [Marek/Jana Horizon Europe issue 3]\n\n### 2.3.4\n\n* Change lists of reused (non-)reference datasets that are reused into lists of considered datasets, and add a question for each detailing whether they are actually reused and what for / why not. This is to be included in the Science Europe template [Marek/Jana Horizon Europe issue 1 and 2].\n\n### 2.3.3\n\n* Incorporation of changes from a collaborative workshop with RDMkit participants on data processing.\n   * Added links to RDMkit (and some to other external resources) in several places\n   * Clarified some questions\n   * Added question on data versioning for filesystems\n\n### 2.3.2\n\n* Incorporation of changes from a workshop with the authors of the RDMkit page on data collecting.\n   * Added links to RDMkit in several places\n   * Clarified some questions\n   * Moved questions on quality together\n   * Moved some questions out of the metadata subsection\n\n### 2.3.1\n\n* Incorporation of changes from a workshop with the authors of the RDMkit page on data sharing.\n    * Attempt to clarify difference between \"open\" and \"accessible\"\n    * Attempt to clarify difference between \"open\" and \"embargoed\"\n    * Added links to RDMkit Data Sharing page in a few places\n    * Added a few relevant questions\n\n### 2.3.0\n\nActivity during [BioHackathon Europe](biohackathon-europe.org) 2020 ([#BioHackEU20](twitter.com/search?q=%23BioHackEU20))\n\n* Added and tagged questions for Horizon 2020 template\n* Moved questions about collecting metadata to one consistent place\n* Added guidance on semantics in file names and question about using PIDs for identifying files\n* Generic small cleanups and typo fixes\n* Closing many issues of feedback received on the knowledge model (from [DSWGlobal/dsw](https://github.com/DSWGlobal/dsw))\n* Various question updates new options, clarifications, integrations\n* Added highly configurable [Wikidata](https://www.wikidata.org) SPARQL-based integration\n* Added [Research Organization Registry](https://ror.org) integration for contributor's affiliation\n\n### 2.2.0\n\n* Adjusted for compatibility with [RDA DMP Common Standard for machine-actionable DMPs (1.0)](https://github.com/RDA-DMP-Common/RDA-DMP-Common-Standard)\n  * Updated *Project* and *Funding* questions in *Administrative Details* chapter\n  * Reorganised *Dataset*, *Distribution*, *License* questions in *Data Publishing* chapter\n* Added *maDMP* tag to questions used in the RDA maDMP template\n\n### 2.1.0\n\n* Added *Science Europe DMP* tag to questions used in the Science Europe template\n\n### 2.0.2\n\n* Fixed missing and duplicated questions\n\n### 2.0.1\n\n* Fixed duplicated question in *Creating and collecting data* chapter (5ba53879-eb48-47f2-a73b-f7f7d83bf030)\n\n### 2.0.0\n\n* Added detailed questions for Science Europe DMPs\n* Fixed several typos and other minor problems\n* Added administrative chapter\n* Moving questions and refactoring according to [ds-km#24](https://github.com/ds-wizard/ds-km/pull/24)\n\n### 1.4.0\n\n* Adding integration for [FAIRsharing.org](https://fairsharing.org)\n* Adding 5 integration questions according to [ds-km@da5a8fc](https://github.com/ds-wizard/ds-km/commit/da5a8fc95d0a67f9369ce0b7727615115fc3656d)\n\nThe FAIRsharing integration requires configuration to contain `apiUrl` and `apiKey` for integration with id `fairsharing`.\n\n### 1.3.0\n\n* Refactoring list questions because of **deprecated item title** fields, i.e., a new question for item title created for each list question\n\nWhen using this version and higher, the DS Wizard configuration should have `itemTitleEnabled` set to `false`.\n\n### 1.2.0\n\n* Adding file naming SOP description question (9ff389f0-2236-48cf-880c-040ea1bb0d2f) to chapter 2 according to [ds-km@d879be0](https://github.com/ds-wizard/ds-km/commit/d879be0fa9d0808868396c649d03c4d783ac6742)\n\n### 1.1.0\n\n* Adding phases to questions (first draft) according to [ds-km@a6713d1](https://github.com/ds-wizard/ds-km/commit/a6713d1a4b9758bea63b3f7c56af5bd4f500d949) and [ds-km@1123211](https://github.com/ds-wizard/ds-km/commit/1123211bb5af43df8ef435039a2923f48e3e981c)\n\nPrior to this version, all questions were assigned with phase 2 - *Before submitting the DMP*.\n\n### 1.0.3\n\n* Fix: Removing extra question mark for a question (8018e15f-6c7e-433a-8686-ae0d695c7fc7) in chapter 5 according to: [ds-km@1123211](https://github.com/ds-wizard/ds-km/commit/1123211bb5af43df8ef435039a2923f48e3e981c)\n\n### 1.0.2\n\n* Fix: Adding some explanation to the list item questions (f5fef09d-ade5-4019-b089-f05bd89c34bc and b642c31d-a512-4ca7-8743-a2e0254006fa) in chapter 3 according to: [ds-km@96e28f4](https://github.com/ds-wizard/ds-km/commit/96e28f478d5dc6b59d384b5127f012dc2fe5f287)\n\n### 1.0.1\n\n* Fix: Adding forgotten question mark to end of question (39e0cc7c-17fe-4991-88d8-1280c3fe7923) in chapter 1 according to: [ds-km@644a373](https://github.com/ds-wizard/ds-km/commit/644a373685dc4ac15b76e86667a90151ca9c70ca)\n\n### 1.0.0\n\n* Initial version transformed from the previous DS-KM GitHub repository up to [ds-km@8442837](https://github.com/ds-wizard/ds-km/commit/8442837dbe3ff899b09e7d8d3fc1107e935a876f)","version":"2.4.5"},{"createdAt":"2023-02-17T13:07:12.794586Z","description":"DSW Knowledge Model originating from mindmap made by Rob Hooft","events":[{"content":{"annotations":[],"color":"","description":null,"eventType":"AddTagEvent","name":""},"createdAt":"2022-02-28T14:41:34Z","entityUuid":"4fa6f10d-b593-4b00-84cf-00d7f916147f","parentUuid":"6f6241d9-136c-4770-9d58-8a3f39607052","uuid":"0dda0f8a-c2e8-497e-a45a-305959f78449"},{"content":{"annotations":{"changed":false},"color":{"changed":true,"value":"#D35400"},"description":{"changed":true,"value":"Ethical and Legal aspects"},"eventType":"EditTagEvent","name":{"changed":true,"value":"ELSI"}},"createdAt":"2022-02-28T14:41:35Z","entityUuid":"4fa6f10d-b593-4b00-84cf-00d7f916147f","parentUuid":"6f6241d9-136c-4770-9d58-8a3f39607052","uuid":"7bae337e-fb88-41d4-a3d3-dc6cfb53a228"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["4fa6f10d-b593-4b00-84cf-00d7f916147f"]},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2022-02-28T14:41:36Z","entityUuid":"49c009cb-a38c-4836-9780-8a8b3dd1cbac","parentUuid":"b1df3c74-0b1f-4574-81c4-4cc2d780c1af","uuid":"8f759858-f1ab-4ef1-a7f6-ffa08f4335c0"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"Ed