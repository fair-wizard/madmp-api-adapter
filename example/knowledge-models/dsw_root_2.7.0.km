icMeasures":[]},"createdAt":"2018-10-01T00:14:30Z","entityUuid":"cce50ae0-08ff-43f3-835c-a494d5a56222","parentUuid":"18f9b8ec-bf1b-4035-8eac-3fd329613a7c","uuid":"4597dde7-c106-45ca-a42b-6bbb0bef3ce7"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":null,"title":"Will you be integrating different data sources in order to get more information for each sample or data point?"},"createdAt":"2018-10-01T00:14:31Z","entityUuid":"d5d21ad3-720c-4a6a-bd5a-09f14b15666f","parentUuid":"83438863-0aa0-4458-b14b-2b2c0d4f811d","uuid":"4dea0f7d-2c3b-4626-a4a6-139bd27d2dde"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[]},"createdAt":"2018-10-01T00:14:32Z","entityUuid":"4ba2c122-b948-4e41-9e48-6e052e2dc77e","parentUuid":"d5d21ad3-720c-4a6a-bd5a-09f14b15666f","uuid":"383cc9b2-5bc3-4d54-b825-19b39cc8261c"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[]},"createdAt":"2018-10-01T00:14:33Z","entityUuid":"61d05101-2eaa-4ebb-8be7-2fcac50f2fb2","parentUuid":"d5d21ad3-720c-4a6a-bd5a-09f14b15666f","uuid":"1c3c3d5b-4f95-4cb2-b002-6b891bce2646"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":null,"title":"Did you already select the variables on which you will join the data sets?"},"createdAt":"2018-10-01T00:14:34Z","entityUuid":"63b020de-664a-4271-807c-a6f4361d6439","parentUuid":"61d05101-2eaa-4ebb-8be7-2fcac50f2fb2","uuid":"ddd50ef5-fa7a-4d8c-ab66-1b3b7eed581a"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[]},"createdAt":"2018-10-01T00:14:35Z","entityUuid":"176cf769-81db-4298-bfae-c1e96e8bbecf","parentUuid":"63b020de-664a-4271-807c-a6f4361d6439","uuid":"9d2e3967-4141-4f57-8627-7941cbde5a1d"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[]},"createdAt":"2018-10-01T00:14:36Z","entityUuid":"f8f49bdc-670b-495f-9a4b-5300db71cfe2","parentUuid":"63b020de-664a-4271-807c-a6f4361d6439","uuid":"b87e7b70-010a-42b5-924e-d22e42b0a6cf"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":"Some parameters you select on may have been collected only for a subset of the subjects or data points. An obvious example is if you match on secondary education type, you will bias to people over 18 years old because younger people do not have this field. In many cases the selection bias may be a lot less obvious and special measures exist to verify that the diversity of the sample is not reduced by the integration step.","title":"Will you make sure that you do not inadvertently create a biased subset?"},"createdAt":"2018-10-01T00:14:37Z","entityUuid":"c6fdeacb-4a1f-4948-988a-0c6458cdf7b9","parentUuid":"61d05101-2eaa-4ebb-8be7-2fcac50f2fb2","uuid":"742b6682-8445-49fc-b960-d9f0dfcf870e"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[{"measure":0,"metricUuid":"8845fe2b-79df-4138-baea-3a035bf5e249","weight":1}]},"createdAt":"2018-10-01T00:14:38Z","entityUuid":"0cf3e92f-4cdf-4446-b2c6-1801338ec432","parentUuid":"c6fdeacb-4a1f-4948-988a-0c6458cdf7b9","uuid":"296a8012-fe36-41f6-bde7-f2daf89c7960"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[{"measure":1,"metricUuid":"8845fe2b-79df-4138-baea-3a035bf5e249","weight":1}]},"createdAt":"2018-10-01T00:14:39Z","entityUuid":"26f64599-467a-4339-a971-74ac638f4c37","parentUuid":"c6fdeacb-4a1f-4948-988a-0c6458cdf7b9","uuid":"5b874c6f-2f52-48d7-b6ea-b977a0d64e67"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":null,"title":"Could the coupling of data create a danger of re-identification of anonymized privacy sensitive data?"},"createdAt":"2018-10-01T00:14:40Z","entityUuid":"6b3d62a5-1d4d-49e1-aaf1-0a8b398a7ac3","parentUuid":"61d05101-2eaa-4ebb-8be7-2fcac50f2fb2","uuid":"629591a3-bb5c-48a1-b7b2-5d40645c2813"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[]},"createdAt":"2018-10-01T00:14:41Z","entityUuid":"04fe8749-82a5-4b06-a7f8-58e634e5cd86","parentUuid":"6b3d62a5-1d4d-49e1-aaf1-0a8b398a7ac3","uuid":"942c2821-934e-4dbb-afaa-92e4e510a9e4"},{"content":{"advice":"Plan either preventative or corrective measures","annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[]},"createdAt":"2018-10-01T00:14:42Z","entityUuid":"aad55658-91c1-4fb8-8869-c0dc1b02b96d","parentUuid":"6b3d62a5-1d4d-49e1-aaf1-0a8b398a7ac3","uuid":"2bac5bbb-55e1-48e5-85aa-c592cef6f997"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":"If the coupling parameters are lenient, you will find more connections than when they are strict. But you may find that they are less accurate. This is a balance.","title":"Did you make a conscious decision to be either accurate or complete?"},"createdAt":"2018-10-01T00:14:43Z","entityUuid":"15eb6fe6-7b21-493b-a5a0-09ac63212ab6","parentUuid":"61d05101-2eaa-4ebb-8be7-2fcac50f2fb2","uuid":"49dda3d0-428d-4446-8c25-5bf3a42e7279"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Accurate is more important","metricMeasures":[]},"createdAt":"2018-10-01T00:14:44Z","entityUuid":"d12bd4e1-2fed-4ea0-b428-fe6f735d740a","parentUuid":"15eb6fe6-7b21-493b-a5a0-09ac63212ab6","uuid":"965d9e14-fda1-4d69-81ed-ff4f65974147"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"We can balance the two","metricMeasures":[]},"createdAt":"2018-10-01T00:14:45Z","entityUuid":"ced5f19d-eaa9-4576-82d4-7ef97741a7e0","parentUuid":"15eb6fe6-7b21-493b-a5a0-09ac63212ab6","uuid":"a72097d9-e277-442d-87fa-bb955d114cc4"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Completeness of the mapping is most important","metricMeasures":[]},"createdAt":"2018-10-01T00:14:46Z","entityUuid":"626fd6e7-8f74-4675-a097-5416f40685e2","parentUuid":"15eb6fe6-7b21-493b-a5a0-09ac63212ab6","uuid":"a3942060-452d-47b2-ab7f-a42b51bff8ca"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":null,"title":"Do you have all tools to couple the necessary data types?"},"createdAt":"2018-10-01T00:14:47Z","entityUuid":"dc4f1dc7-4608-45f9-8503-aa05536f4d97","parentUuid":"83438863-0aa0-4458-b14b-2b2c0d4f811d","uuid":"77221204-615b-4893-9b0e-51d05a9ec489"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[]},"createdAt":"2018-10-01T00:14:48Z","entityUuid":"45169011-2336-4eb4-8026-fa7fa9ca9649","parentUuid":"dc4f1dc7-4608-45f9-8503-aa05536f4d97","uuid":"68e65a4a-0b32-439b-b2a6-9236f306e2cc"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[]},"createdAt":"2018-10-01T00:14:49Z","entityUuid":"fa0f8ecf-9cd5-4395-9228-0aeca4339ea4","parentUuid":"dc4f1dc7-4608-45f9-8503-aa05536f4d97","uuid":"8a285a77-a386-4bec-9915-bf97de160912"},{"content":{"annotations":[],"eventType":"AddChapterEvent","text":"","title":"Data interpretation"},"createdAt":"2018-10-01T00:14:50Z","entityUuid":"d5b27482-b598-4b8c-b534-417d4ad27394","parentUuid":"6f6241d9-136c-4770-9d58-8a3f39607052","uuid":"6f333ab0-4174-4ea5-ad34-2ec24f69fdcc"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":null,"title":"Will data interpretation and modeling require significant compute infrastructure capacity?"},"createdAt":"2018-10-01T00:14:51Z","entityUuid":"c8e35b21-9911-43f4-bb5e-0df3de1cd727","parentUuid":"d5b27482-b598-4b8c-b534-417d4ad27394","uuid":"988c1c7a-293d-4306-9e38-5765d8db105c"},{"content":{"annotations":[],"description":"Compute capacity planning","eventType":"AddReferenceEvent","referenceType":"CrossReference","targetUuid":"e87ef779-2c4b-4c0d-a1f1-821290123a3c"},"createdAt":"2018-10-01T00:14:52Z","entityUuid":"a981b60d-2870-4a40-83ad-436395876f06","parentUuid":"c8e35b21-9911-43f4-bb5e-0df3de1cd727","uuid":"2451f69a-8fff-4c84-b370-170ee618284f"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[]},"createdAt":"2018-10-01T00:14:53Z","entityUuid":"5905c733-5113-401f-9343-24911af54e05","parentUuid":"c8e35b21-9911-43f4-bb5e-0df3de1cd727","uuid":"adda9e2c-8096-4a6b-bd3c-962326181d8f"},{"content":{"advice":"Make sure this has been taken into account in the capacity planning under 'Data design and planning'","annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[]},"createdAt":"2018-10-01T00:14:54Z","entityUuid":"b5c79d03-4f0f-4714-91a8-9b04a8f3980f","parentUuid":"c8e35b21-9911-43f4-bb5e-0df3de1cd727","uuid":"25d4e47d-cb80-434f-8014-247381f914ad"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":"Data analysis is normally done manually on a step-by-step basis. It is essential to make sure all steps are properly documented, otherwise results will not be reproducible.","title":"How will you be making sure there is good provenance of the data analysis?"},"createdAt":"2018-10-01T00:14:55Z","entityUuid":"948b5fd8-c1bd-457d-8f81-ea2fd093f541","parentUuid":"d5b27482-b598-4b8c-b534-417d4ad27394","uuid":"ca841081-6ebf-4c5a-9a8e-39813827a4ec"},{"content":{"advice":"Make sure to make the notes available in electronic form along with your data","annotations":[],"eventType":"AddAnswerEvent","label":"We use lab notebooks","metricMeasures":[{"measure":0.5,"metricUuid":"0bafe0c2-a8f2-4c74-80c8-dbf3a5b8e9b7","weight":1}]},"createdAt":"2018-10-01T00:14:56Z","entityUuid":"7b450ee7-8783-4adc-9955-fd667fac5a56","parentUuid":"948b5fd8-c1bd-457d-8f81-ea2fd093f541","uuid":"7cc74daf-2074-42b8-8054-6538310c02ec"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"We use an electronic lab notebook","metricMeasures":[{"measure":1,"metricUuid":"0bafe0c2-a8f2-4c74-80c8-dbf3a5b8e9b7","weight":1}]},"createdAt":"2018-10-01T00:14:57Z","entityUuid":"a1e67aee-77dd-486f-ab51-e5a6f39a32cc","parentUuid":"948b5fd8-c1bd-457d-8f81-ea2fd093f541","uuid":"01b51afa-353d-4293-b819-944cac9b7d49"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"We use other arrangements","metricMeasures":[]},"createdAt":"2018-10-01T00:14:58Z","entityUuid":"ccdb5296-919c-44ac-89df-351fd2e564ae","parentUuid":"948b5fd8-c1bd-457d-8f81-ea2fd093f541","uuid":"76303291-817a-457c-9c01-79492d43bcd4"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"ValueQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":null,"title":"What other arrangements?","validations":[],"valueType":"TextQuestionValueType"},"createdAt":"2018-10-01T00:14:59Z","entityUuid":"b73b8310-3b4f-49c8-a5c0-4208883754ac","parentUuid":"ccdb5296-919c-44ac-89df-351fd2e564ae","uuid":"7d082750-5d07-47ad-8e40-5f840aedf675"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":"1796fa3c-9f53-475f-89ff-c66a0453c42e","tagUuids":[],"text":null,"title":"Will you be doing (automated) knowledge discovery?"},"createdAt":"2018-10-01T00:15:00Z","entityUuid":"460803f2-cc23-4c57-b50e-c5177a3c11d5","parent