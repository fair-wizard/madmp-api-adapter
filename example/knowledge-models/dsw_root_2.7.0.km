},"metricMeasures":{"changed":true,"value":[{"measure":1,"metricUuid":"8db30660-d4e5-4c0a-bf3e-553f3f0f997a","weight":1},{"measure":1,"metricUuid":"0bafe0c2-a8f2-4c74-80c8-dbf3a5b8e9b7","weight":0.1}]}},"createdAt":"2020-11-11T10:51:18Z","entityUuid":"8f537593-c01d-4df0-bc68-fbc2f397d527","parentUuid":"9320bf04-824b-46b3-ae8b-55240e2d04b9","uuid":"684a3223-4221-41da-b247-9d751a63a500"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":false},"metricMeasures":{"changed":true,"value":[{"measure":0,"metricUuid":"8db30660-d4e5-4c0a-bf3e-553f3f0f997a","weight":1},{"measure":0,"metricUuid":"0bafe0c2-a8f2-4c74-80c8-dbf3a5b8e9b7","weight":0.1}]}},"createdAt":"2020-11-11T10:51:19Z","entityUuid":"f01c23ee-d3d9-4b18-8753-02619ba79c97","parentUuid":"9320bf04-824b-46b3-ae8b-55240e2d04b9","uuid":"27e63d2c-f3a6-4c7a-8225-99e3630be6ef"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"DDI metadata is more extensive than Dublin Core and DataCite, it details more of what is in the data and really can help other researchers locate your data set as an interesting source."},"title":{"changed":false}},"createdAt":"2020-11-11T10:51:20Z","entityUuid":"9320bf04-824b-46b3-ae8b-55240e2d04b9","parentUuid":"aec37b0d-490d-4d75-8814-8ed78ea5b8dd","uuid":"33bf8d59-375f-43bd-84dc-821e4dbe3a43"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"What standard(s) will you use to specify author/title/keyword information?"}},"createdAt":"2020-11-11T10:51:21Z","entityUuid":"1440afd6-d516-44f6-9c02-6abb13900b66","parentUuid":"6d18bfff-0f53-469b-934e-9806dda9d4fb","uuid":"e3b6551c-f104-41b8-b925-216ce9b8c239"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"If you are getting different types of data from different sources and want to use them together it is likely that you will need to match items and glue everything together. This can be done with traditional table database technology, but it is also possible to use Linked Data and RDF.\n\nThis is an advanced subject that you may want to skip if this is not an issue for you. On the other hand, if this is your expertise we would like your help in improving the questions in this section."},"title":{"changed":true,"value":"Will you be doing the integration of different data sources?"}},"createdAt":"2020-11-11T10:51:22Z","entityUuid":"109ed7ea-ef1d-4719-b2b4-eb4f7202c65c","parentUuid":"83438863-0aa0-4458-b14b-2b2c0d4f811d","uuid":"ccb29973-6943-43e8-b579-1fe250ded3f1"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"This helps you to get an overview of the structure of the data sources that you are integrating."},"title":{"changed":false}},"createdAt":"2020-11-11T10:51:23Z","entityUuid":"a797cab9-0829-4787-a096-1b5cedc9147f","parentUuid":"238ace4b-22bb-4a9d-a312-e30d82d4382d","uuid":"f2a3dfa4-b6b9-4e53-a342-0d64f7e5a905"},{"content":{"advice":null,"annotations":[],"eve