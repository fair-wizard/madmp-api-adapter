alse},"valueType":{"changed":false}},"createdAt":"2023-07-26T13:33:56Z","entityUuid":"6b5a6334-fbb3-4c88-995a-6d899e30da1e","parentUuid":"1dc216a6-77df-4f75-8bab-8e4f082fdab2","uuid":"e7d349d6-3730-4fd8-83bb-882f12ccdc18"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["3c7bdc90-8ed3-4b34-90ec-7945d14cc443","fd4637a2-a117-460a-a7fa-c03760c42629","87bb2042-8e3c-4733-ba1e-84509d7b1cf4"]},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2023-07-26T13:34:01Z","entityUuid":"26b2afa6-99e8-4337-b380-5642bc807ad8","parentUuid":"cb148cc8-f15f-494f-a197-f01e3111ec60","uuid":"9ab15f29-5eb9-4052-8070-531313d00c14"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["3c7bdc90-8ed3-4b34-90ec-7945d14cc443","fd4637a2-a117-460a-a7fa-c03760c42629","87bb2042-8e3c-4733-ba1e-84509d7b1cf4"]},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2023-07-26T13:34:06Z","entityUuid":"1270ea5a-92a2-46ce-b658-9bf2862b9b57","parentUuid":"cb148cc8-f15f-494f-a197-f01e3111ec60","uuid":"fb0f2f61-10fc-49dd-8881-e49ed79e74af"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["87bb2042-8e3c-4733-ba1e-84509d7b1cf4","fd4637a2-a117-460a-a7fa-c03760c42629"]},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2023-07-26T14:00:31Z","entityUuid":"80d403f3-3f29-4f37-9040-b901ae9afa37","parentUuid":"e7324e1a-bfcb-4f2b-855a-35701dfb1ad5","uuid":"4b195bb8-a557-4bdc-8113-aa2423f497ba"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["87bb2042-8e3c-4733-ba1e-84509d7b1cf4","3c7bdc90-8ed3-4b34-90ec-7945d14cc443","fd4637a2-a117-460a-a7fa-c03760c42629","4fa6f10d-b593-4b00-84cf-00d7f916147f"]},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2023-07-26T14:05:00Z","entityUuid":"b2fb6b4e-2961-40a4-a9ec-faf4e49a978b","parentUuid":"b1df3c74-0b1f-4574-81c4-4cc2d780c1af","uuid":"adda13f9-260c-40f8-878c-5f8cfd6b9b5b"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["87bb2042-8e3c-4733-ba1e-84509d7b1cf4","3c7bdc90-8ed3-4b34-90ec-7945d14cc443","fd4637a2-a117-460a-a7fa-c03760c42629"]},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2023-07-26T14:07:15Z","entityUuid":"a5dbea23-b7d6-4e31-a1a5-ec5007ec7848","parentUuid":"62b8c25d-380d-4d43-81b4-945e93e40c41","uuid":"55db9814-eb10-4376-a836-bb85f917c826"}],"forkOfPackageId":null,"id":"dsw:root:2.6.2","kmId":"root","language":"en","license":"Apache-2.0","mergeCheckpointPackageId":null,"metamodelVersion":20,"name":"Common DSW Knowledge Model","nonEditable":false,"organizationId":"dsw","phase":"ReleasedKnowledgeModelPackagePhase","previousPackageId":"dsw:root:2.6.1","readme":"# Common DSW Knowledge Model\n\nCommon DSW Knowledge Model deals with questions that a researcher should answer in order to create a Data Stewardship Plan, as well as other related questionnaire data.\n\n## Contributors\n\n* **Rob Hooft** <[rob.hooft@health-ri.nl](mailto:rob.hooft@health-ri.nl)>\n  * ORCID: [0000-0001-6825-9439](https://orcid.org/0000-0001-6825-9439)\n  * GitHub: [@rwwh](https://github.com/rwwh)\n* **Marek Suchánek** <[marek.suchanek@ds-wizard.org](mailto:marek.suchanek@ds-wizard.org)>\n  * ORCID: [0000-0001-7525-9218](https://orcid.org/0000-0001-7525-9218)\n  * GitHub: [@MarekSuchanek](https://github.com/MarekSuchanek)\n* **Kryštof Komanec** <[krystof.komanec@ds-wizard.org](mailto:krystof.komanec@ds-wizard.org)>\n  * ORCID: [0000-0003-3856-1682](https://orcid.org/0000-0003-3856-1682)\n  * GitHub: [@krystofkomanec](https://github.com/krystofkomanec)\n\n## Acknowledgements\n\n* Several versions of this KM (between 2.3 and 2.5) were made during workshop with various participants as part of the ELIXIR-CONVERGE project\n* The initial knowledge model has been made based on a mindmap made by Rob Hooft: [Data Stewardship Mindmap](https://zenodo.org/record/3351949)\n\n## Changelog\n\n### 2.6.2\n\n*Released*: 2023-07-28\n\n* Fixed tags for document templates\n\n### 2.6.1\n\n*Released*: 2023-07-25\n\n* Fixed tags for ethics questions in Horizon Europe, Horizon 2020 and Science Europe templates\n\n### 2.6.0\n\n*Released*: 2023-06-28\n\n* Add phase descriptions\n* Improve integrations (item templates)\n* Add references to [FAIR Cookbook](https://faircookbook.elixir-europe.org/)\n* ELSI tag and relate questions\n\n### 2.5.0\n\n*Released*: 2023-06-28\n\n* Incorporation changes/restructuring of questions related to human data \n\n### 2.4.5\n\n*Released*: 2023-01-27\n\n* Minor textual changes\n\n### 2.4.4\n\n*Released*: 2022-09-22\n\n* Fix duplicated *Horizon Europe DMP* tags for several questions\n\n### 2.4.3\n\n*Released*: 2022-09-22\n\n* Use of new value-question types (mostly email and URL)\n* New references\n\n### 2.4.2\n\n*Released*: 2022-06-15\n\n* Changes from workshops together with RDMkit on Toxicology, Biomolecular Simulations and    \n   Epitranscriptomics\n  - Small changes to phrasing and clarifications in various locations\n  - New guidance hierarchies added to locate existing data, standards and terminologies\n  - Moved \"provenance\" questions into the rest of the \"metadata\" group\n  - Added guidance summarising how to avoid problems with large amounts of intermediate data\n\n### 2.4.1\n\n*Released*: 2022-04-09\n\n* Fixed several minor typos (missing end of sentence, misspelling, typography etc.)\n\n### 2.4.0\n\n*Released*: 2022-03-15\n\n* KM verified and tested with the **Horizon Europe DMP template**\n\n### 2.3.14\n\n*Released*: 2022-03-10\n\n* Tags for Horizon Europe template generated\n\n### 2.3.13\n\n*Released*: 2022-03-08\n\n* Incorporating changes related to the Data Reuse workshop with RDMkit\n\n### 2.3.12\n\n*Released*: 2022-02-15\n\n* Incorporating changes related to the Data Analytics workshop with RDMkit\n\n### 2.3.11\n\n*Released*: 2022-02-15\n\n* Incorporating changes made in the Plant Sciences workshop with RDMkit\n\n### 2.3.10\n\n*Released*: 2022-02-03\n\n* Added references and questions from an RDMkit/DS Wizard working session on Preserving Data\n\n### 2.3.9\n\n*Released*: 2022-01-27\n\n* Fix missing Yes/No answers and use Text-Value for description of policies\n\n### 2.3.8\n\n*Released*: 2022-01-14\n\n* Questions for Horizon Europe added on budget for data management, other policies that are observed, persistent identifier allocation and archive preservation policies [Marek/Jana Horizon Europe issues 7-9, 11]\n\n### 2.3.7\n\n*Released*: 2022-01-11\n\n* Added references and questions from an RDMkit/DS Wizard working session on Human Data\n\n### 2.3.6\n\n*Released*: 2022-01-10\n\n* Questions about metadata for Horizon Europe added [Marek/Jana Horizon Europe issues 4-6]\n\n### 2.3.5\n\n*Released*: 2022-01-10\n\n* Added Tag for Horizon Europe\n* Moved the new questions from 2.3.4 from \"Science Europe\" to \"Horizon Europe\"\n* Added new question about qualified references from published data sets [Marek/Jana Horizon Europe issue 3]\n\n### 2.3.4\n\n*Released*: 2022-01-10\n\n* Change lists of reused (non-)reference datasets that are reused into lists of considered datasets, and add a question for each detailing whether they are actually reused and what for / why not. This is to be included in the Science Europe template [Marek/Jana Horizon Europe issue 1 and 2].\n\n### 2.3.3\n\n*Released*: 2021-12-14\n\n* Incorporation of changes from a collaborative workshop with RDMkit participants on data processing.\n   * Added links to RDMkit (and some to other external resources) in several places\n   * Clarified some questions\n   * Added question on data versioning for filesystems\n\n### 2.3.2\n\n*Released*: 2021-11-30\n\n* Incorporation of changes from a workshop with the authors of the RDMkit page on data collecting.\n   * Added links to RDMkit in several places\n   * Clarified some questions\n   * Moved questions on quality together\n   * Moved some questions out of the metadata subsection\n\n### 2.3.1\n\n*Released*: 2021-11-02\n\n* Incorporation of changes from a workshop with the authors of the RDMkit page on data sharing.\n    * Attempt to clarify difference between \"open\" and \"accessible\"\n    * Attempt to clarify difference between \"open\" and \"embargoed\"\n    * Added links to RDMkit Data Sharing page in a few places\n    * Added a few relevant questions\n\n### 2.3.0\n\n*Released*: 2020-11-11\n\nActivity during [BioHackathon Europe](biohackathon-europe.org) 2020 ([#BioHackEU20](twitter.com/search?q=%23BioHackEU20))\n\n* Added and tagged questions for Horizon 2020 template\n* Moved questions about collecting metadata to one consistent place\n* Added guidance on semantics in file names and question about using PIDs for identifying files\n* Generic small cleanups and typo fixes\n* Closing many issues of feedback received on the knowledge model (from [DSWGlobal/dsw](https://github.com/DSWGlobal/dsw))\n* Various question updates new options, clarifications, integrations\n* Added highly configurable [Wikidata](https://www.wikidata.org) SPARQL-based integration\n* Added [Research Organization Registry](https://ror.org) integration for contributor's affiliation\n\n### 2.2.0\n\n*Released*: 2020-07-01\n\n* Adjusted for compatibility with [RDA DMP Common Standard for machine-actionable DMPs (1.0)](https://github.com/RDA-DMP-Common/RDA-DMP-Common-Standard)\n  * Updated *Project* and *Funding* questions in *Administrative Details* chapter\n  * Reorganised *Dataset*, *Distribution*, *License* questions in *Data Publishing* chapter\n* Added *maDMP* tag to questions used in the RDA maDMP template\n\n### 2.1.0\n\n*Released*: 2020-05-09\n\n* Added *Science Europe DMP* tag to questions used in the Science Europe template\n\n### 2.0.2\n\n*Released*: 2020-05-09\n\n* Fixed missing and duplicated questions\n\n### 2.0.1\n\n*Released*: 2020-03-24\n\n* Fixed duplicated question in *Creating and collecting data* chapter (5ba53879-eb48-47f2-a73b-f7f7d83bf030)\n\n### 2.0.0\n\n*Released*: 2020-01-04\n\n* Added detailed questions for Science Europe DMPs\n* Fixed several typos and other minor problems\n* Added administrative chapter\n* Moving questions and refactoring according to [ds-km#24](https://github.com/ds-wizard/ds-km/pull/24)\n\n### 1.4.0\n\n*Released*: 2019-06-11\n\n* Adding integration for [FAIRsharing.org](https://fairsharing.org)\n* Adding 5 integration questions according to [ds-km@da5a8fc](https://github.com/ds-wizard/ds-km/commit/da5a8fc95d0a67f9369ce0b7727615115fc3656d)\n\nThe FAIRsharing integration requires configuration to contain `apiUrl` and `apiKey` for integration with id `fairsharing`.\n\n### 1.3.0\n\n*Released*: 2019-06-10\n\n* Refactoring list questions because of **deprecated item title** fields, i.e., a new question for item title created for each list question\n\nWhen using this version and higher, the DS Wizard configuration should have `itemTitleEnabled` set to `false`.\n\n### 1.2.0\n\n*Released*: 2019-06-09\n\n* Adding file naming SOP description question (9ff389f0-2236-48cf-880c-040ea1bb0d2f) to chapter 2 according to [ds-km@d879be0](https://github.com/ds-wizard/ds-km/commit/d879be0fa9d0808868396c649d03c4d783ac6742)\n\n### 1.1.0\n\n*Released*: 2019-06-09\n\n* Adding phases to questions (first draft) according to [ds-km@a6713d1](https://github.com/ds-wizard/ds-km/commit/a6713d1a4b9758bea63b3f7c56af5bd4f500d949) and [ds-km@1123211](https://github.com/ds-wizard/ds-km/commit/1123211bb5af43df8ef435039a2923f48e3e981c)\n\nPrior to this version, all questions were assigned with phase 2 - *Before submitting the DMP*.\n\n### 1.0.3\n\n*Released*: 2019-06-09\n\n* Fix: Removing extra question mark for a question (8018e15f-6c7e-433a-8686-ae0d695c7fc7) in chapter 5 according to: [ds-km@1123211](https://github.com/ds-wizard/ds-km/commit/1123211bb5af43df8ef435039a2923f48e3e981c)\n\n### 1.0.2\n\n*Released*: 2019-06-09\n\n* Fix: Adding some explanation to the list item questions (f5fef09d-ade5-4019-b089-f05bd89c34bc and b642c31d-a512-4ca7-8743-a2e0254006fa) in chapter 3 according to: [ds-km@96e28f4](https://github.com/ds-wizard/ds-km/commit/96e28f478d5dc6b59d384b5127f012dc2fe5f287)\n\n### 1.0.1\n\n*Released*: 2019-06-09\n\n* Fix: Adding forgotten question mark to end of question (39e0cc7c-17fe-4991-88d8-1280c3fe7923) in chapter 1 according to: [ds-km@644a373](https://github.com/ds-wizard/ds-km/commit/644a373685dc4ac15b76e86667a90151ca9c70ca)\n\n### 1.0.0\n\n*Released*: 2018-10-01\n\n* Initial version transformed from the previous DS-KM GitHub repository up to [ds-km@8442837](https://github.com/ds-wizard/ds-km/commit/8442837dbe3ff899b09e7d8d3fc1107e935a876f)","version":"2.6.2"},{"createdAt":"2023-08-29T08:05:56.418969Z","description":"DSW Knowledge Model originating from mindmap made by Rob Hooft","events":[{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"RDMkit on GDPR Compliance"},"referenceType":"URLReference","url":{"changed":true,"value":"https://rdmkit.elixir-europe.org/gdpr_compliance.html"}},"createdAt":"2023-08-29T07:48:57Z","entityUuid":"42a7b822-5644-48f5-aa9a-9a9e3119a028","parentUuid":"49c009cb-a38c-4836-9780-8a8b3dd1cbac","uuid":"353b140c-b823-4b0e-b7b1-e8da964384fd"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"RDMkit on GDPR Compliance"},"referenceType":"URLReference","url":{"changed":true,"value":"https://rdmkit.elixir-europe.org/gdpr_compliance"}},"createdAt":"2023-08-29T07:48:58Z","entityUuid":"ba4eb06a-2d61-4755-bb51-8232b349d0a1","parentUuid":"8915bd25-db22-4ed6-bcc8-b1bbdc52989e","uuid":"1fb178f4-604c-47ba-a483-ed887011ef18"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"RDMkit on Data Security"},"referenceType":"URLReference","url":{"changed":true,"value":"https://rdmkit.elixir-europe.org/data_security"}},"createdAt":"2023-08-29T07:48:59Z","entityUuid":"0b460273-3e3b-4289-8194-19c7cf1b05b1","parentUuid":"a30f5047-33c1-45a7-8b3f-b1b90c364fc9","uuid":"f70bf693-5e43-4cb5-b60b-1aa9b60a5fc9"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"RDMkit on Data Sensitivity"},"referenceType":"URLReference","url":{"changed":true,"value":"https://rdmkit.elixir-europe.org/data_sensitivity.html"}},"createdAt":"2023-08-29T07:49:00Z","entityUuid":"f22531ad-862e-48fa-a521-18e6998b1f7d","parentUuid":"019db0b3-9067-4134-8bfd-76db3cfc572a","uuid":"089f2d5d-19ef-4e77-ab01-802b8e266923"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"RDMkit about Data Sensitivity"},"referenceType":"URLReference","url":{"changed":true,"value":"https://rdmkit.elixir-europe.org/data_sensitivity.html"}},"createdAt":"2023-08-29T07:49:01Z","entityUuid":"df93fa41-88cb-451a-aa05-95a18cf02e73","parentUuid":"49c009cb-a38c-4836-9780-8a8b3dd1cbac","uuid":"5a7bc84e-0470-4f09-b340-ff81ae4ac9f8"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"RDMkit on Data Sensitivity"},"referenceType":"URLReference","url":{"changed":true,"value":"https://rdmkit.elixir-europe.org/data_sensitivity.html"}},"createdAt":"2023-08-29T07:49:02Z","entityUuid":"3fe12009-cd7c-4e4e-a7f8-2617c25c33c7","parentUuid":"d5990471-0618-42cd-92cb-bbbfd4f61532","uuid":"091b1561-1d8d-4f97-9ee1-f21b7c7beaaa"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":true,"value":["00af9ed1-2627-45d7-89e8-63876fd92a2f"]},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2023-08-29T07:49:03Z","entityUuid":"6b3d62a5-1d4d-49e1-aaf1-0a8b398a7ac3","parentUuid":"61d05101-2eaa-4ebb-8be7-2fcac50f2fb2","uuid":"86106209-197e-48f2-a9a7-12dcbb38de30"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"RDMkit on Data Sensitivity"},"referenceType":"URLReference","url":{"changed":true,"value":"https://rdmkit.elixir-europe.org/data_sensitivity.html"}},"createdAt":"2023-08-29T07:49:04Z","entityUuid":"00af9ed1-2627-45d7-89e8-63876fd92a2f","parentUuid":"6b3d62a5-1d4d-49e1-aaf1-0a8b398a7ac3","uuid":"d050d3d7-58ed-45f4-acb6-bc12d83e6b9e"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"RDMkit on Data Sensitivity"},"referenceType":"URLReference","url":{"changed":true,"value":"https://rdmkit.elixir-europe.org/data_sensitivity.html"}},"createdAt":"2023-08-29T07:49:05Z","entityUuid":"4302bc15-31f1-42c0-b921-183847404605","parentUuid":"cc95b399-7d8d-4232-bccf-686f78c91bff","uuid":"e0995b6a-67e4-4f7f-ba24-338a69effbaa"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"RDMkit on Data Sensitivity"},"referenceType":"URLReference","url":{"changed":true,"value":"https://rdmkit.elixir-europe.org/data_sensitivity.html"}},"createdAt":"2023-08-29T07:49:06Z","entityUuid":"68a9e378-e7ef-48bd-9e65-62937f7804d0","parentUuid":"a1d76760-053c-4706-80a2-cfb6c6a061f3","uuid":"9728568d-c2ab-4ea6-bc23-09c0181cb49c"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"RDMkit on Data Sensitivity"},"referenceType":"URLReference","url":{"changed":true,"value":"https://rdmkit.elixir-europe.org/data_sensitivity.html"}},"createdAt":"2023-08-29T07:49:07Z","entityUuid":"86f7c739-cfdf-4b3a-a032-3bda9bbf6404","parentUuid":"59748a7b-f729-404d-babe-3147e2c6b247","uuid":"c7e8ee1f-1b28-4847-a424-71faa72b49b2"}],"forkOfPackageId":null,"id":"dsw:root:2.6.3","kmId":"root","language":"en","license":"Apache-2.0","mergeCheckpointPackageId":null,"metamodelVersion":20,"name":"Common DSW Knowledge Model","nonEditable":false,"organizationId":"dsw","phase":"ReleasedKnowledgeModelPackagePhase","previousPackageId":"dsw:root:2.6.2","readme":"# Common DSW Knowledge Model\n\nCommon DSW Knowledge Model deals with questions that a researcher should answer in order to create a Data Stewardship Plan, as well as other related questionnaire data.\n\n## Contributors\n\n* **Rob Hooft** <[rob.hooft@health-ri.nl](mailto:rob.hooft@health-ri.nl)>\n  * ORCID: [0000-0001-6825-9439](https://orcid.org/0000-0001-6825-9439)\n  * GitHub: [@rwwh](https://github.com/rwwh)\n* **Marek Suchánek** <[marek.suchanek@ds-wizard.org](mailto:marek.suchanek@ds-wizard.org)>\n  * ORCID: [0000-0001-7525-9218](https://orcid.org/0000-0001-7525-9218)\n  * GitHub: [@MarekSuchanek](https://github.com/MarekSuchanek)\n* **Kryštof Komanec** <[krystof.komanec@ds-wizard.org](mailto:krystof.komanec@ds-wizard.org)>\n  * ORCID: [0000-0003-3856-1682](https://orcid.org/0000-0003-3856-1682)\n  * GitHub: [@krystofkomanec](https://github.com/krystofkomanec)\n\n## Acknowledgements\n\n* Several versions of this KM (between 2.3 and 2.5) were made during workshop with various participants as part of the ELIXIR-CONVERGE project\n* The initial knowledge model has been made based on a mindmap made by Rob Hooft: [Data Stewardship Mindmap](https://zenodo.org/record/3351949)\n\n## Changelog\n\n### 2.6.3\n*Released*: 2023-08-29\n\n* Adapted changed links in RDMkit. To be published synchonously with RDMkit release.\n\n### 2.6.2\n\n*Released*: 2023-07-28\n\n* Fixed tags for document templates\n\n### 2.6.1\n\n*Released*: 2023-07-25\n\n* Fixed tags for ethics questions in Horizon Europe, Horizon 2020 and Science Europe templates\n\n### 2.6.0\n\n*Released*: 2023-06-28\n\n* Add phase descriptions\n* Improve integrations (item templates)\n* Add references to [FAIR Cookbook](https://faircookbook.elixir-europe.org/)\n* ELSI tag and relate questions\n\n### 2.5.0\n\n*Released*: 2023-06-28\n\n* Incorporation changes/restructuring of questions related to human data \n\n### 2.4.5\n\n*Released*: 2023-01-27\n\n* Minor textual changes\n\n### 2.4.4\n\n*Released*: 2022-09-22\n\n* Fix duplicated *Horizon Europe DMP* tags for several questions\n\n### 2.4.3\n\n*Released*: 2022-09-22\n\n* Use of new value-question types (mostly email and URL)\n* New references\n\n### 2.4.2\n\n*Released*: 2022-06-15\n\n* Changes from workshops together with RDMkit on Toxicology, Biomolecular Simulations and    \n   Epitranscriptomics\n  - Small changes to phrasing and clarifications in various locations\n  - New guidance hierarchies added to locate existing data, standards and terminologies\n  - Moved \"provenance\" questions into the rest of the \"metadata\" group\n  - Added guidance summarising how to avoid problems with large amounts of intermediate data\n\n### 2.4.1\n\n*Released*: 2022-04-09\n\n* Fixed several minor typos (missing end of sentence, misspelling, typography etc.)\n\n### 2.4.0\n\n*Released*: 2022-03-15\n\n* KM verified and tested with the **Horizon Europe DMP template**\n\n### 2.3.14\n\n*Released*: 2022-03-10\n\n* Tags for Horizon Europe template generated\n\n### 2.3.13\n\n*Released*: 2022-03-08\n\n* Incorporating changes related to the Data Reuse workshop with RDMkit\n\n### 2.3.12\n\n*Released*: 2022-02-15\n\n* Incorporating changes related to the Data Analytics workshop with RDMkit\n\n### 2.3.11\n\n*Released*: 2022-02-15\n\n* Incorporating changes made in the Plant Sciences workshop with RDMkit\n\n### 2.3.10\n\n*Released*: 2022-02-03\n\n* Added references and questions from an RDMkit/DS Wizard working session on Preserving Data\n\n### 2.3.9\n\n*Released*: 2022-01-27\n\n* Fix missing Yes/No answers and use Text-Value for description of policies\n\n### 2.3.8\n\n*Released*: 2022-01-14\n\n* Questions for Horizon Europe added on budget for data management, other policies that are observed, persistent identifier allocation and archive preservation policies [Marek/Jana Horizon Europe issues 7-9, 11]\n\n### 2.3.7\n\n*Released*: 2022-01-11\n\n* Added references and questions from an RDMkit/DS Wizard working session on Human Data\n\n### 2.3.6\n\n*Released*: 2022-01-10\n\n* Questions about metadata for Horizon Europe added [Marek/Jana Horizon Europe issues 4-6]\n\n### 2.3.5\n\n*Released*: 2022-01-10\n\n* Added Tag for Horizon Europe\n* Moved the new questions from 2.3.4 from \"Science Europe\" to \"Horizon Europe\"\n* Added new question about qualified references from published data sets [Marek/Jana Horizon Europe issue 3]\n\n### 2.3.4\n\n*Released*: 2022-01-10\n\n* Change lists of reused (non-)reference datasets that are reused into lists of considered datasets, and add a question for each detailing whether they are actually reused and what for / why not. This is to be included in the Science Europe template [Marek/Jana Horizon Europe issue 1 and 2].\n\n### 2.3.3\n\n*Released*: 2021-12-14\n\n* Incorporation of changes from a collaborative workshop with RDMkit participants on data processing.\n   * Added links to RDMkit (and some to other external resources) in several places\n   * Clarified some questions\n   * Added question on data versioning for filesystems\n\n### 2.3.2\n\n*Released*: 2021-11-30\n\n* Incorporation of changes from a workshop with the authors of the RDMkit page on data collecting.\n   * Added links to RDMkit in several places\n   * Clarified some questions\n   * Moved questions on quality together\n   * Moved some questions out of the metadata subsection\n\n### 2.3.1\n\n*Released*: 2021-11-02\n\n* Incorporation of changes from a workshop with the authors of the RDMkit page on data sharing.\n    * Attempt to clarify difference between \"open\" and \"accessible\"\n    * Attempt to clarify difference between \"open\" and \"embargoed\"\n    * Added links to RDMkit Data Sharing page in a few places\n    * Added a few relevant questions\n\n### 2.3.0\n\n*Released*: 2020-11-11\n\nActivity during [BioHackathon Europe](biohackathon-europe.org) 2020 ([#BioHackEU20](twitter.com/search?q=%23BioHackEU20))\n\n* Added and tagged questions for Horizon 2020 template\n* Moved questions about collecting metadata to one consistent place\n* Added guidance on semantics in file names and question about using PIDs for identifying files\n* Generic small cleanups and typo fixes\n* Closing many issues of feedback received on the knowledge model (from [DSWGlobal/dsw](https://github.com/DSWGlobal/dsw))\n* Various question updates new options, clarifications, integrations\n* Added highly configurable [Wikidata](https://www.wikidata.org) SPARQL-based integration\n* Added [Research Organization Registry](https://ror.org) integration for contributor's affiliation\n\n### 2.2.0\n\n*Released*: 2020-07-01\n\n* Adjusted for compatibility with [RDA DMP Common Standard for machine-actionable DMPs (1.0)](https://github.com/RDA-DMP-Common/RDA-DMP-Common-Standard)\n  * Updated *Project* and *Funding* questions in *Administrative Details* chapter\n  * Reorganised *Dataset*, *Distribution*, *License* questions in *Data Publishing* chapter\n* Added *maDMP* tag to questions used in the RDA maDMP template\n\n### 2.1.0\n\n*Released*: 2020-05-09\n\n* Added *Science Europe DMP* tag to questions used in the Science Europe template\n\n### 2.0.2\n\n*Released*: 2020-05-09\n\n* Fixed missing and duplicated questions\n\n### 2.0.1\n\n*Released*: 2020-03-24\n\n* Fixed duplicated question in *Creating and collecting data* chapter (5ba53879-eb48-47f2-a73b-f7f7d83bf030)\n\n### 2.0.0\n\n*Released*: 2020-01-04\n\n* Added detailed questions for Science Europe DMPs\n* Fixed several typos and other minor problems\n* Added administrative chapter\n* Moving questions and refactoring according to [ds-km#24](https://github.com/ds-wizard/ds-km/pull/24)\n\n### 1.4.0\n\n*Released*: 2019-06-11\n\n* Adding integration for [FAIRsharing.org](https://fairsharing.org)\n* Adding 5 integration questions according to [ds-km@da5a8fc](https://github.com/ds-wizard/ds-km/commit/da5a8fc95d0a67f9369ce0b7727615115fc3656d)\n\nThe FAIRsharing integration requires configuration to contain `apiUrl` and `apiKey` for integration with id `fairsharing`.\n\n### 1.3.0\n\n*Released*: 2019-06-10\n\n* Refactoring list questions because of **deprecated item title** fields, i.e., a new question for item title created for each list question\n\nWhen using this version and higher, the DS Wizard configuration should have `itemTitleEnabled` set to `false`.\n\n### 1.2.0\n\n*Released*: 2019-06-09\n\n* Adding file naming SOP description question (9ff389f0-2236-48cf-880c-040ea1bb0d2f) to chapter 2 according to [ds-km@d879be0](https://github.com/ds-wizard/ds-km/commit/d879be0fa9d0808868396c649d03c4d783ac6742)\n\n### 1.1.0\n\n*Released*: 2019-06-09\n\n* Adding phases to questions (first draft) according to [ds-km@a6713d1](https://github.com/ds-wizard/ds-km/commit/a6713d1a4b9758bea63b3f7c56af5bd4f500d949) and [ds-km@1123211](https://github.com/ds-wizard/ds-km/commit/1123211bb5af43df8ef435039a2923f48e3e981c)\n\nPrior to this version, all questions were assigned with phase 2 - *Before submitting the DMP*.\n\n### 1.0.3\n\n*Released*: 2019-06-09\n\n* Fix: Removing extra question mark for a question (8018e15f-6c7e-433a-8686-ae0d695c7fc7) in chapter 5 according to: [ds-km@1123211](https://github.com/ds-wizard/ds-km/commit/1123211bb5af43df8ef435039a2923f48e3e981c)\n\n### 1.0.2\n\n*Released*: 2019-06-09\n\n* Fix: Adding some explanation to the list item questions (f5fef09d-ade5-4019-b089-f05bd89c34bc and b642c31d-a512-4ca7-8743-a2e0254006fa) in chapter 3 according to: [ds-km@96e28f4](https://github.com/ds-wizard/ds-km/commit/96e28f478d5dc6b59d384b5127f012dc2fe5f287)\n\n### 1.0.1\n\n*Released*: 2019-06-09\n\n* Fix: Adding forgotten question mark to end of question (39e0cc7c-17fe-4991-88d8-1280c3fe7923) in chapter 1 according to: [ds-km@644a373](https://github.com/ds-wizard/ds-km/commit/644a373685dc4ac15b76e86667a90151ca9c70ca)\n\n### 1.0.0\n\n*Released*: 2018-10-01\n\n* Initial version transformed from the previous DS-KM GitHub repository up to [ds-km@8442837](https://github.com/ds-wizard/ds-km/commit/8442837dbe3ff899b09e7d8d3fc1107e935a876f)","version":"2.6.3"},{"createdAt":"2024-03-25T14:58:11.654664Z","description":"DSW Knowledge Model originating from mindmap made by Rob Hooft","events":[{"content":{"eventType":"DeleteChoiceEvent"},"createdAt":"2023-09-14T12:33:52Z","entityUuid":"e675045b-39a8-424c-9b92-5e24d076329d","parentUuid":"361c38f0-ce75-4157-94f1-804e4d7986c2","uuid":"7e6d4a66-1484-468f-b351-4c17b30e41a8"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":true,"value":["58b49591-a1f7-4733-bc92-a87cb786b128","761d20f2-d2ce-496b-8a91-a52ff0513e7b"]},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2023-09-14T15:24:49Z","entityUuid":"b464593d-fb92-4ad9-88e1-764306bb3051","parentUuid":"9310b639-4cf7-4f94-8fbe-c1afc50afe4b","uuid":"656a18d4-9f69-4999-9626-c1b2fe43174f"},{"content":{"allowCustomReply":{"changed":false},"annotations":{"changed":false},"eventType":"EditIntegrationEvent","integrationType":"ApiIntegration","name":{"changed":false},"requestAllowEmptySearch":{"changed":false},"requestBody":{"changed":false},"requestHeaders":{"changed":false},"requestMethod":{"changed":false},"requestUrl":{"changed":false},"responseItemTemplate":{"changed":true,"value":"**{{ item.name }}** {% if item.acronyms %}({{ item.acronyms[0] }}) {% endif %}![](https://img.shields.io/badge/type-{{ item.types }}-blue)"},"responseItemTemplateForSelection":{"changed":false},"responseListField":{"changed":false},"testQ":{"changed":false},"testResponse":{"changed":false},"testVariables":{"changed":false},"variables":{"changed":false}},"createdAt":"2024-03-25T14:52:08Z","entityUuid":"266649ea-0f32-4b00-b5b9-32fc72fcb21d","parentUuid":"6f6241d9-136c-4770-9d58-8a3f39607052","uuid":"09b20445-06df-4a4c-9e53-832a8dad4da4"}],"forkOfPackageId":null,"id":"dsw:root:2.6.4","kmId":"root","language":"en","license":"Apache-2.0","mergeCheckpointPackageId":null,"metamodelVersion":20,"name":"Common DSW Knowledge Model","nonEditable":false,"organizationId":"dsw","phase":"ReleasedKnowledgeModelPackagePhase","previousPackageId":"dsw:root:2.6.3","readme":"# Common DSW Knowledge Model\n\nCommon DSW Knowledge Model deals with questions that a researcher should answer in order to create a Data Stewardship Plan, as well as other related questionnaire data.\n\n## Contributors\n\n* **Rob Hooft** <[rob.hooft@health-ri.nl](mailto:rob.hooft@health-ri.nl)>\n  * ORCID: [0000-0001-6825-9439](https://orcid.org/0000-0001-6825-9439)\n  * GitHub: [@rwwh](https://github.com/rwwh)\n* **Marek Suchánek** <[marek.suchanek@ds-wizard.org](mailto:marek.suchanek@ds-wizard.org)>\n  * ORCID: [0000-0001-7525-9218](https://orcid.org/0000-0001-7525-9218)\n  * GitHub: [@MarekSuchanek](https://github.com/MarekSuchanek)\n* **Kryštof Komanec** <[krystof.komanec@ds-wizard.org](mailto:krystof.komanec@ds-wizard.org)>\n  * ORCID: [0000-0003-3856-1682](https://orcid.org/0000-0003-3856-1682)\n  * GitHub: [@krystofkomanec](https://github.com/krystofkomanec)\n\n## Acknowledgements\n\n* Several versions of this KM (between 2.3 and 2.5) were made during workshop with various participants as part of the ELIXIR-CONVERGE project\n* The initial knowledge model has been made based on a mindmap made by Rob Hooft: [Data Stewardship Mindmap](https://zenodo.org/record/3351949)\n\n## Changelog\n\n### 2.6.4\n*Released*: 2024-03-25\n\n* Fixed ROR integration items with multiple acronyms would be displayed joined as one.\n\n### 2.6.3\n*Released*: 2023-08-29\n\n* Adapted changed links in RDMkit. To be published synchonously with RDMkit release.\n\n### 2.6.2\n\n*Released*: 2023-07-28\n\n* Fixed tags for document templates\n\n### 2.6.1\n\n*Released*: 2023-07-25\n\n* Fixed tags for ethics questions in Horizon Europe, Horizon 2020 and Science Europe templates\n\n### 2.6.0\n\n*Released*: 2023-06-28\n\n* Add phase descriptions\n* Improve integrations (item templates)\n* Add references to [FAIR Cookbook](https://faircookbook.elixir-europe.org/)\n* ELSI tag and relate questions\n\n### 2.5.0\n\n*Released*: 2023-06-28\n\n* Incorporation changes/restructuring of questions related to human data \n\n### 2.4.5\n\n*Released*: 2023-01-27\n\n* Minor textual changes\n\n### 2.4.4\n\n*Released*: 2022-09-22\n\n* Fix duplicated *Horizon Europe DMP* tags for several questions\n\n### 2.4.3\n\n*Released*: 2022-09-22\n\n* Use of new value-question types (mostly email and URL)\n* New references\n\n### 2.4.2\n\n*Released*: 2022-06-15\n\n* Changes from workshops together with RDMkit on Toxicology, Biomolecular Simulations and    \n   Epitranscriptomics\n  - Small changes to phrasing and clarifications in various locations\n  - New guidance hierarchies added to locate existing data, standards and terminologies\n  - Moved \"provenance\" questions into the rest of the \"metadata\" group\n  - Added guidance summarising how to avoid problems with large amounts of intermediate data\n\n### 2.4.1\n\n*Released*: 2022-04-09\n\n* Fixed several minor typos (missing end of sentence, misspelling, typography etc.)\n\n### 2.4.0\n\n*Released*: 2022-03-15\n\n* KM verified and tested with the **Horizon Europe DMP template**\n\n### 2.3.14\n\n*Released*: 2022-03-10\n\n* Tags for Horizon Europe template generated\n\n### 2.3.13\n\n*Released*: 2022-03-08\n\n* Incorporating changes related to the Data Reuse workshop with RDMkit\n\n### 2.3.12\n\n*Released*: 2022-02-15\n\n* Incorporating changes related to the Data Analytics workshop with RDMkit\n\n### 2.3.11\n\n*Released*: 2022-02-15\n\n* Incorporating changes made in the Plant Sciences workshop with RDMkit\n\n### 2.3.10\n\n*Released*: 2022-02-03\n\n* Added references and questions from an RDMkit/DS Wizard working session on Preserving Data\n\n### 2.3.9\n\n*Released*: 2022-01-27\n\n* Fix missing Yes/No answers and use Text-Value for description of policies\n\n### 2.3.8\n\n*Released*: 2022-01-14\n\n* Questions for Horizon Europe added on budget for data management, other policies that are observed, persistent identifier allocation and archive preservation policies [Marek/Jana Horizon Europe issues 7-9, 11]\n\n### 2.3.7\n\n*Released*: 2022-01-11\n\n* Added references and questions from an RDMkit/DS Wizard working session on Human Data\n\n### 2.3.6\n\n*Released*: 2022-01-10\n\n* Questions about metadata for Horizon Europe added [Marek/Jana Horizon Europe issues 4-6]\n\n### 2.3.5\n\n*Released*: 2022-01-10\n\n* Added Tag for Horizon Europe\n* Moved the new questions from 2.3.4 from \"Science Europe\" to \"Horizon Europe\"\n* Added new question about qualified references from published data sets [Marek/Jana Horizon Europe issue 3]\n\n### 2.3.4\n\n*Released*: 2022-01-10\n\n* Change lists of reused (non-)reference datasets that are reused into lists of considered datasets, and add a question for each detailing whether they are actually reused and what for / why not. This is to be included in the Science Europe template [Marek/Jana Horizon Europe issue 1 and 2].\n\n### 2.3.3\n\n*Released*: 2021-12-14\n\n* Incorporation of changes from a collaborative workshop with RDMkit participants on data processing.\n   * Added links to RDMkit (and some to other external resources) in several places\n   * Clarified some questions\n   * Added question on data versioning for filesystems\n\n### 2.3.2\n\n*Released*: 2021-11-30\n\n* Incorporation of changes from a workshop with the authors of the RDMkit page on data collecting.\n   * Added links to RDMkit in several places\n   * Clarified some questions\n   * Moved questions on quality together\n   * Moved some questions out of the metadata subsection\n\n### 2.3.1\n\n*Released*: 2021-11-02\n\n* Incorporation of changes from a workshop with the authors of the RDMkit page on data sharing.\n    * Attempt to clarify difference between \"open\" and \"accessible\"\n    * Attempt to clarify difference between \"open\" and \"embargoed\"\n    * Added links to RDMkit Data Sharing page in a few places\n    * Added a few relevant questions\n\n### 2.3.0\n\n*Released*: 2020-11-11\n\nActivity during [BioHackathon Europe](biohackathon-europe.org) 2020 ([#BioHackEU20](twitter.com/search?q=%23BioHackEU20))\n\n* Added and tagged questions for Horizon 2020 template\n* Moved questions about collecting metadata to one consistent place\n* Added guidance on semantics in file names and question about using PIDs for identifying files\n* Generic small cleanups and typo fixes\n* Closing many issues of feedback received on the knowledge model (from [DSWGlobal/dsw](https://github.com/DSWGlobal/dsw))\n* Various question updates new options, clarifications, integrations\n* Added highly configurable [Wikidata](https://www.wikidata.org) SPARQL-based integration\n* Added [Research Organization Registry](https://ror.org) integration for contributor's affiliation\n\n### 2.2.0\n\n*Released*: 2020-07-01\n\n* Adjusted for compatibility with [RDA DMP Common Standard for machine-actionable DMPs (1.0)](https://github.com/RDA-DMP-Common/RDA-DMP-Common-Standard)\n  * Updated *Project* and *Funding* questions in *Administrative Details* chapter\n  * Reorganised *Dataset*, *Distribution*, *License* questions in *Data Publishing* chapter\n* Added *maDMP* tag to questions used in the RDA maDMP template\n\n### 2.1.0\n\n*Released*: 2020-05-09\n\n* Added *Science Europe DMP* tag to questions used in the Science Europe template\n\n### 2.0.2\n\n*Released*: 2020-05-09\n\n* Fixed missing and duplicated questions\n\n### 2.0.1\n\n*Released*: 2020-03-24\n\n* Fixed duplicated question in *Creating and collecting data* chapter (5ba53879-eb48-47f2-a73b-f7f7d83bf030)\n\n### 2.0.0\n\n*Released*: 2020-01-04\n\n* Added detailed questions for Science Europe DMPs\n* Fixed several typos and other minor problems\n* Added administrative chapter\n* Moving questions and refactoring according to [ds-km#24](https://github.com/ds-wizard/ds-km/pull/24)\n\n### 1.4.0\n\n*Released*: 2019-06-11\n\n* Adding integration for [FAIRsharing.org](https://fairsharing.org)\n* Adding 5 integration questions according to [ds-km@da5a8fc](https://github.com/ds-wizard/ds-km/commit/da5a8fc95d0a67f9369ce0b7727615115fc3656d)\n\nThe FAIRsharing integration requires configuration to contain `apiUrl` and `apiKey` for integration with id `fairsharing`.\n\n### 1.3.0\n\n*Released*: 2019-06-10\n\n* Refactoring list questions because of **deprecated item title** fields, i.e., a new question for item title created for each list question\n\nWhen using this version and higher, the DS Wizard configuration should have `itemTitleEnabled` set to `false`.\n\n### 1.2.0\n\n*Released*: 2019-06-09\n\n* Adding file naming SOP description question (9ff389f0-2236-48cf-880c-040ea1bb0d2f) to chapter 2 according to [ds-km@d879be0](https://github.com/ds-wizard/ds-km/commit/d879be0fa9d0808868396c649d03c4d783ac6742)\n\n### 1.1.0\n\n*Released*: 2019-06-09\n\n* Adding phases to questions (first draft) according to [ds-km@a6713d1](https://github.com/ds-wizard/ds-km/commit/a6713d1a4b9758bea63b3f7c56af5bd4f500d949) and [ds-km@1123211](https://github.com/ds-wizard/ds-km/commit/1123211bb5af43df8ef435039a2923f48e3e981c)\n\nPrior to this version, all questions were assigned with phase 2 - *Before submitting the DMP*.\n\n### 1.0.3\n\n*Released*: 2019-06-09\n\n* Fix: Removing extra question mark for a question (8018e15f-6c7e-433a-8686-ae0d695c7fc7) in chapter 5 according to: [ds-km@1123211](https://github.com/ds-wizard/ds-km/commit/1123211bb5af43df8ef435039a2923f48e3e981c)\n\n### 1.0.2\n\n*Released*: 2019-06-09\n\n* Fix: Adding some explanation to the list item questions (f5fef09d-ade5-4019-b089-f05bd89c34bc and b642c31d-a512-4ca7-8743-a2e0254006fa) in chapter 3 according to: [ds-km@96e28f4](https://github.com/ds-wizard/ds-km/commit/96e28f478d5dc6b59d384b5127f012dc2fe5f287)\n\n### 1.0.1\n\n*Released*: 2019-06-09\n\n* Fix: Adding forgotten question mark to end of question (39e0cc7c-17fe-4991-88d8-1280c3fe7923) in chapter 1 according to: [ds-km@644a373](https://github.com/ds-wizard/ds-km/commit/644a373685dc4ac15b76e86667a90151ca9c70ca)\n\n### 1.0.0\n\n*Released*: 2018-10-01\n\n* Initial version transformed from the previous DS-KM GitHub repository up to [ds-km@8442837](https://github.com/ds-wizard/ds-km/commit/8442837dbe3ff899b09e7d8d3fc1107e935a876f)","version":"2.6.4"},{"createdAt":"2024-05-02T06:59:15.29123Z","description":"DSW Knowledge Model originating from mindmap made by Rob Hooft","events":[{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"In a domain repository (like EBI's and CRG's EGA) that arranges restricted access"},"metricMeasures":{"changed":false}},"createdAt":"2024-05-02T06:55:23Z","entityUuid":"09f8f08d-04ae-463a-bbe0-f5ce05595777","parentUuid":"baed9cce-91ab-45d0-a272-92246b2e6c72","uuid":"989804a5-b77d-4603-8a22-a87989fc4534"}],"forkOfPackageId":null,"id":"dsw:root:2.6.5","kmId":"root","language":"en","license":"Apache-2.0","mergeCheckpointPackageId":null,"metamodelVersion":20,"name":"Common DSW Knowledge Model","nonEditable":false,"organizationId":"dsw","phase":"ReleasedKnowledgeModelPackagePhase","previousPackageId":"dsw:root:2.6.4","readme":"# Common DSW Knowledge Model\n\nCommon DSW Knowledge Model deals with questions that a researcher should answer in order to create a Data Stewardship Plan, as well as other related questionnaire data.\n\n## Contributors\n\n* **Rob Hooft** <[rob.hooft@health-ri.nl](mailto:rob.hooft@health-ri.nl)>\n  * ORCID: [0000-0001-6825-9439](https://orcid.org/0000-0001-6825-9439)\n  * GitHub: [@rwwh](https://github.com/rwwh)\n* **Marek Suchánek** <[marek.suchanek@ds-wizard.org](mailto:marek.suchanek@ds-wizard.org)>\n  * ORCID: [0000-0001-7525-9218](https://orcid.org/0000-0001-7525-9218)\n  * GitHub: [@MarekSuchanek](https://github.com/MarekSuchanek)\n* **Kryštof Komanec** <[krystof.komanec@ds-wizard.org](mailto:krystof.komanec@ds-wizard.org)>\n  * ORCID: [0000-0003-3856-1682](https://orcid.org/0000-0003-3856-1682)\n  * GitHub: [@krystofkomanec](https://github.com/krystofkomanec)\n* **Jana Martínková** <[jana.martinkova@ds-wizard.org](mailto:jana.martinkova@ds-wizard.org)>\n  * ORCID: [0000-0001-8575-6533](https://orcid.org/0000-0001-8575-6533)\n  * GitHub: [@jmartinkova](https://github.com/jmartinkova)\n\n## Acknowledgements\n\n* Several versions of this KM (between 2.3 and 2.5) were made during workshop with various participants as part of the ELIXIR-CONVERGE project\n* The initial knowledge model has been made based on a mindmap made by Rob Hooft: [Data Stewardship Mindmap](https://zenodo.org/record/3351949)\n\n## Changelog\n\n### 2.6.5\n*Released*: 2024-05-02\n\n* Incorporating change in domain repository example (EBI)\n\n### 2.6.4\n*Released*: 2024-03-25\n\n* Fixed ROR integration items with multiple acronyms would be displayed joined as one.\n\n### 2.6.3\n*Released*: 2023-08-29\n\n* Adapted changed links in RDMkit. To be published synchonously with RDMkit release.\n\n### 2.6.2\n\n*Released*: 2023-07-28\n\n* Fixed tags for document templates\n\n### 2.6.1\n\n*Released*: 2023-07-25\n\n* Fixed tags for ethics questions in Horizon Europe, Horizon 2020 and Science Europe templates\n\n### 2.6.0\n\n*Released*: 2023-06-28\n\n* Add phase descriptions\n* Improve integrations (item templates)\n* Add references to [FAIR Cookbook](https://faircookbook.elixir-europe.org/)\n* ELSI tag and relate questions\n\n### 2.5.0\n\n*Released*: 2023-06-28\n\n* Incorporation changes/restructuring of questions related to human data \n\n### 2.4.5\n\n*Released*: 2023-01-27\n\n* Minor textual changes\n\n### 2.4.4\n\n*Released*: 2022-09-22\n\n* Fix duplicated *Horizon Europe DMP* tags for several questions\n\n### 2.4.3\n\n*Released*: 2022-09-22\n\n* Use of new value-question types (mostly email and URL)\n* New references\n\n### 2.4.2\n\n*Released*: 2022-06-15\n\n* Changes from workshops together with RDMkit on Toxicology, Biomolecular Simulations and    \n   Epitranscriptomics\n  - Small changes to phrasing and clarifications in various locations\n  - New guidance hierarchies added to locate existing data, standards and terminologies\n  - Moved \"provenance\" questions into the rest of the \"metadata\" group\n  - Added guidance summarising how to avoid problems with large amounts of intermediate data\n\n### 2.4.1\n\n*Released*: 2022-04-09\n\n* Fixed several minor typos (missing end of sentence, misspelling, typography etc.)\n\n### 2.4.0\n\n*Released*: 2022-03-15\n\n* KM verified and tested with the **Horizon Europe DMP template**\n\n### 2.3.14\n\n*Released*: 2022-03-10\n\n* Tags for Horizon Europe template generated\n\n### 2.3.13\n\n*Released*: 2022-03-08\n\n* Incorporating changes related to the Data Reuse workshop with RDMkit\n\n### 2.3.12\n\n*Released*: 2022-02-15\n\n* Incorporating changes related to the Data Analytics workshop with RDMkit\n\n### 2.3.11\n\n*Released*: 2022-02-15\n\n* Incorporating changes made in the Plant Sciences workshop with RDMkit\n\n### 2.3.10\n\n*Released*: 2022-02-03\n\n* Added references and questions from an RDMkit/DS Wizard working session on Preserving Data\n\n### 2.3.9\n\n*Released*: 2022-01-27\n\n* Fix missing Yes/No answers and use Text-Value for description of policies\n\n### 2.3.8\n\n*Released*: 2022-01-14\n\n* Questions for Horizon Europe added on budget for data management, other policies that are observed, persistent identifier allocation and archive preservation policies [Marek/Jana Horizon Europe issues 7-9, 11]\n\n### 2.3.7\n\n*Released*: 2022-01-11\n\n* Added references and questions from an RDMkit/DS Wizard working session on Human Data\n\n### 2.3.6\n\n*Released*: 2022-01-10\n\n* Questions about metadata for Horizon Europe added [Marek/Jana Horizon Europe issues 4-6]\n\n### 2.3.5\n\n*Released*: 2022-01-10\n\n* Added Tag for Horizon Europe\n* Moved the new questions from 2.3.4 from \"Science Europe\" to \"Horizon Europe\"\n* Added new question about qualified references from published data sets [Marek/Jana Horizon Europe issue 3]\n\n### 2.3.4\n\n*Released*: 2022-01-10\n\n* Change lists of reused (non-)reference datasets that are reused into lists of considered datasets, and add a question for each detailing whether they are actually reused and what for / why not. This is to be included in the Science Europe template [Marek/Jana Horizon Europe issue 1 and 2].\n\n### 2.3.3\n\n*Released*: 2021-12-14\n\n* Incorporation of changes from a collaborative workshop with RDMkit participants on data processing.\n   * Added links to RDMkit (and some to other external resources) in several places\n   * Clarified some questions\n   * Added question on data versioning for filesystems\n\n### 2.3.2\n\n*Released*: 2021-11-30\n\n* Incorporation of changes from a workshop with the authors of the RDMkit page on data collecting.\n   * Added links to RDMkit in several places\n   * Clarified some questions\n   * Moved questions on quality together\n   * Moved some questions out of the metadata subsection\n\n### 2.3.1\n\n*Released*: 2021-11-02\n\n* Incorporation of changes from a workshop with the authors of the RDMkit page on data sharing.\n    * Attempt to clarify difference between \"open\" and \"accessible\"\n    * Attempt to clarify difference between \"open\" and \"embargoed\"\n    * Added links to RDMkit Data Sharing page in a few places\n    * Added a few relevant questions\n\n### 2.3.0\n\n*Released*: 2020-11-11\n\nActivity during [BioHackathon Europe](biohackathon-europe.org) 2020 ([#BioHackEU20](twitter.com/search?q=%23BioHackEU20))\n\n* Added and tagged questions for Horizon 2020 template\n* Moved questions about collecting metadata to one consistent place\n* Added guidance on semantics in file names and question about using PIDs for identifying files\n* Generic small cleanups and typo fixes\n* Closing many issues of feedback received on the knowledge model (from [DSWGlobal/dsw](https://github.com/DSWGlobal/dsw))\n* Various question updates new options, clarifications, integrations\n* Added highly configurable [Wikidata](https://www.wikidata.org) SPARQL-based integration\n* Added [Research Organization Registry](https://ror.org) integration for contributor's affiliation\n\n### 2.2.0\n\n*Released*: 2020-07-01\n\n* Adjusted for compatibility with [RDA DMP Common Standard for machine-actionable DMPs (1.0)](https://github.com/RDA-DMP-Common/RDA-DMP-Common-Standard)\n  * Updated *Project* and *Funding* questions in *Administrative Details* chapter\n  * Reorganised *Dataset*, *Distribution*, *License* questions in *Data Publishing* chapter\n* Added *maDMP* tag to questions used in the RDA maDMP template\n\n### 2.1.0\n\n*Released*: 2020-05-09\n\n* Added *Science Europe DMP* tag to questions used in the Science Europe template\n\n### 2.0.2\n\n*Released*: 2020-05-09\n\n* Fixed missing and duplicated questions\n\n### 2.0.1\n\n*Released*: 2020-03-24\n\n* Fixed duplicated question in *Creating and collecting data* chapter (5ba53879-eb48-47f2-a73b-f7f7d83bf030)\n\n### 2.0.0\n\n*Released*: 2020-01-04\n\n* Added detailed questions for Science Europe DMPs\n* Fixed several typos and other minor problems\n* Added administrative chapter\n* Moving questions and refactoring according to [ds-km#24](https://github.com/ds-wizard/ds-km/pull/24)\n\n### 1.4.0\n\n*Released*: 2019-06-11\n\n* Adding integration for [FAIRsharing.org](https://fairsharing.org)\n* Adding 5 integration questions according to [ds-km@da5a8fc](https://github.com/ds-wizard/ds-km/commit/da5a8fc95d0a67f9369ce0b7727615115fc3656d)\n\nThe FAIRsharing integration requires configuration to contain `apiUrl` and `apiKey` for integration with id `fairsharing`.\n\n### 1.3.0\n\n*Released*: 2019-06-10\n\n* Refactoring list questions because of **deprecated item title** fields, i.e., a new question for item title created for each list question\n\nWhen using this version and higher, the DS Wizard configuration should have `itemTitleEnabled` set to `false`.\n\n### 1.2.0\n\n*Released*: 2019-06-09\n\n* Adding file naming SOP description question (9ff389f0-2236-48cf-880c-040ea1bb0d2f) to chapter 2 according to [ds-km@d879be0](https://github.com/ds-wizard/ds-km/commit/d879be0fa9d0808868396c649d03c4d783ac6742)\n\n### 1.1.0\n\n*Released*: 2019-06-09\n\n* Adding phases to questions (first draft) according to [ds-km@a6713d1](https://github.com/ds-wizard/ds-km/commit/a6713d1a4b9758bea63b3f7c56af5bd4f500d949) and [ds-km@1123211](https://github.com/ds-wizard/ds-km/commit/1123211bb5af43df8ef435039a2923f48e3e981c)\n\nPrior to this version, all questions were assigned with phase 2 - *Before submitting the DMP*.\n\n### 1.0.3\n\n*Released*: 2019-06-09\n\n* Fix: Removing extra question mark for a question (8018e15f-6c7e-433a-8686-ae0d695c7fc7) in chapter 5 according to: [ds-km@1123211](https://github.com/ds-wizard/ds-km/commit/1123211bb5af43df8ef435039a2923f48e3e981c)\n\n### 1.0.2\n\n*Released*: 2019-06-09\n\n* Fix: Adding some explanation to the list item questions (f5fef09d-ade5-4019-b089-f05bd89c34bc and b642c31d-a512-4ca7-8743-a2e0254006fa) in chapter 3 according to: [ds-km@96e28f4](https://github.com/ds-wizard/ds-km/commit/96e28f478d5dc6b59d384b5127f012dc2fe5f287)\n\n### 1.0.1\n\n*Released*: 2019-06-09\n\n* Fix: Adding forgotten question mark to end of question (39e0cc7c-17fe-4991-88d8-1280c3fe7923) in chapter 1 according to: [ds-km@644a373](https://github.com/ds-wizard/ds-km/commit/644a373685dc4ac15b76e86667a90151ca9c70ca)\n\n### 1.0.0\n\n*Released*: 2018-10-01\n\n* Initial version transformed from the previous DS-KM GitHub repository up to [ds-km@8442837](https://github.com/ds-wizard/ds-km/commit/8442837dbe3ff899b09e7d8d3fc1107e935a876f)","version":"2.6.5"},{"createdAt":"2024-05-17T10:40:41.660546Z","description":"DSW Knowledge Model originating from mindmap made by Rob Hooft","events":[{"content":{"annotations":{"changed":false},"choiceUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"MultiChoiceQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2024-05-16T14:09:41Z","entityUuid":"05655914-e1f4-4578-a7d4-bae17579fce8","parentUuid":"facde7e9-8711-4ced-a6f8-5fbacf929381","uuid":"8ffe36ea-a38c-462d-a3aa-65f1b392fd63"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2024-05-16T14:09:44Z","entityUuid":"cabdaf99-9bbb-4fb9-b54e-dadff61e5774","parentUuid":"facde7e9-8711-4ced-a6f8-5fbacf929381","uuid":"2af09fd5-0e3a-4b41-9f35-3f5974e5f2de"},{"content":{"eventType":"DeleteQuestionEvent"},"createdAt":"2024-05-16T14:09:50Z","entityUuid":"cabdaf99-9bbb-4fb9-b54e-dadff61e5774","parentUuid":"facde7e9-8711-4ced-a6f8-5fbacf929381","uuid":"375fc972-213f-4ce8-9de2-15ac4b181325"},{"content":{"annotations":[],"eventType":"AddChoiceEvent","label":""},"createdAt":"2024-05-16T14:10:02Z","entityUuid":"74158bea-966b-4c53-ba0d-1c9c47536f57","parentUuid":"05655914-e1f4-4578-a7d4-bae17579fce8","uuid":"1a4ba06f-d92e-4286-9f96-d862967644f5"},{"content":{"annotations":{"changed":false},"eventType":"EditChoiceEvent","label":{"changed":true,"value":"They will be dated"}},"createdAt":"2024-05-16T14:10:05Z","entityUuid":"74158bea-966b-4c53-ba0d-1c9c47536f57","parentUuid":"05655914-e1f4-4578-a7d4-bae17579fce8","uuid":"a0e8cf53-a722-400f-9b5c-9fae7cbe68a8"},{"content":{"annotations":[],"eventType":"AddChoiceEvent","label":""},"createdAt":"2024-05-16T14:10:09Z","entityUuid":"b509d5d3-81e1-450a-86ab-cec423091181","parentUuid":"05655914-e1f4-4578-a7d4-bae17579fce8","uuid":"2d999eb2-3a1a-4208-82b7-900bf517b433"},{"content":{"annotations":{"changed":false},"eventType":"EditChoiceEvent","label":{"changed":true,"value":"They will be clearly numbered"}},"createdAt":"2024-05-16T14:10:12Z","entityUuid":"b509d5d3-81e1-450a-86ab-cec423091181","parentUuid":"05655914-e1f4-4578-a7d4-bae17579fce8","uuid":"c616797c-70c5-4cf7-b1af-be2c41df77e4"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2024-05-16T14:11:39Z","entityUuid":"56163eb0-0101-40b4-b1c1-580875196b5c","parentUuid":"c3dabaaf-c946-4a0d-889c-ede966f97667","uuid":"5d8392b0-bc2b-4ddd-a5c9-531d5f5e5a11"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Project number"}},"createdAt":"2024-05-16T14:11:59Z","entityUuid":"56163eb0-0101-40b4-b1c1-580875196b5c","parentUuid":"c3dabaaf-c946-4a0d-889c-ede966f97667","uuid":"6f8936c4-ebb9-4900-b46c-475e50e96865"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":true,"value":"StringQuestionValueType"}},"createdAt":"2024-05-16T14:12:02Z","entityUuid":"56163eb0-0101-40b4-b1c1-580875196b5c","parentUuid":"c3dabaaf-c946-4a0d-889c-ede966f97667","uuid":"a19d7e5c-1f49-44cf-9c11-332692c76363"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":true,"value":["f0ef08fd-d733-465c-bc66-5de0b826c41b","5b765df9-299f-4855-9e99-aa844903f8f6","56163eb0-0101-40b4-b1c1-580875196b5c","22583d74-3c98-4e0a-b363-26d767c88212","a00ae929-d5cf-43c0-8e9e-cdb12ebde717","de84b9b5-bcd0-4954-8370-72ea83916b8c","cabc6f07-6015-454e-b97a-c34db4ec0c60","36a87eac-402d-43fb-a0df-ac5963bdf87d","dbb99f35-bdd9-4637-890e-23ba5bc19d6a"]},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2024-05-16T14:12:10Z","entityUuid":"c3dabaaf-c946-4a0d-889c-ede966f97667","parentUuid":"1e85da40-bbfc-4180-903e-6c569ed2da38","uuid":"8c64cf1b-0a89-4e6b-96a9-58b41b986e7e"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2024-05-16T14:17:00Z","entityUuid":"ecca7dd6-62f2-4714-a85a-8d79bbca402a","parentUuid":"8a56768a-5c5a-44c0-b21c-46a231fbf6be","uuid":"c4538c8e-2b07-4c92-9cb7-a6c79b537c11"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Explain the access procedure for"},"title":{"changed":true,"value":"Is there a managed access procedure for authorised users of personal data?"}},"createdAt":"2024-05-16T14:30:57Z","entityUuid":"ecca7dd6-62f2-4714-a85a-8d79bbca402a","parentUuid":"8a56768a-5c5a-44c0-b21c-46a231fbf6be","uuid":"95eb273d-7a43-4d99-b5a4-fd4eb1df5ec3"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Explain the procedure for authorized users to access private (e.g., personal) data (who is allowed to access it, what is required from them, etc.)."},"title":{"changed":true,"value":"Describe the procedure for users to access private data"},"validations":{"changed":false},"valueType":{"changed":true,"value":"StringQuestionValueType"}},"createdAt":"2024-05-17T05:56:23Z","entityUuid":"ecca7dd6-62f2-4714-a85a-8d79bbca402a","parentUuid":"8a56768a-5c5a-44c0-b21c-46a231fbf6be","uuid":"49823fbb-a9c7-4e80-8104-ddf0290421de"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Until it needs to be deleted for legal, contractual or regulatory reasons"},"metricMeasures":{"changed":false}},"createdAt":"2024-05-17T06:01:03Z","entityUuid":"bb6b4f0a-9908-4473-9982-30084ff4f6ab","parentUuid":"d4e6a244-07fb-4573-b93f-c20a9409ac7c","uuid":"0149c561-2592-4d55-a0e2-756fc3336d9e"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2024-05-17T06:06: