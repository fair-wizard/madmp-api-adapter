ecede2-f952-4b08-8a68-20d97849733f","parentUuid":"c8687abf-ac88-4bef-b1cc-7070bd039a07","uuid":"bff2724c-5058-48c8-b68d-812a684b243e"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":true,"value":["ebcbf4c6-ce25-4a0b-9e82-039a88498203","c8687abf-ac88-4bef-b1cc-7070bd039a07","be4651c9-9a8c-4e10-a158-61b94ca0e139","8915bd25-db22-4ed6-bcc8-b1bbdc52989e"]},"label":{"changed":false},"metricMeasures":{"changed":false}},"createdAt":"2022-02-28T14:48:21Z","entityUuid":"421e2d3e-c95c-4244-9465-de8f1cb8aeba","parentUuid":"49c009cb-a38c-4836-9780-8a8b3dd1cbac","uuid":"e5a5f443-3f0c-4284-800c-cf3b46279cca"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-02-28T14:48:22Z","entityUuid":"48ec1902-dad1-4f4b-8a37-76c5e44ecfb7","parentUuid":"c8687abf-ac88-4bef-b1cc-7070bd039a07","uuid":"742d1e19-13ab-4b30-8eee-03e38c4efd25"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"No"},"metricMeasures":{"changed":false}},"createdAt":"2022-02-28T14:48:23Z","entityUuid":"48ec1902-dad1-4f4b-8a37-76c5e44ecfb7","parentUuid":"c8687abf-ac88-4bef-b1cc-7070bd039a07","uuid":"72056fbe-4640-403e-a564-cbb99495aae5"},{"content":{"eventType":"MoveQuestionEvent","targetUuid":"d8ecede2-f952-4b08-8a68-20d97849733f"},"createdAt":"2022-02-28T14:48:24Z","entityUuid":"be4651c9-9a8c-4e10-a158-61b94ca0e139","parentUuid":"421e2d3e-c95c-4244-9465-de8f1cb8aeba","uuid":"f1197b20-1632-4c5a-95a8-0c2b452d7a34"},{"content":{"advice":{"changed":true,"value":"Traditionally, *consent* has been the basis for processing personal data for research, but under the GDPR there cannot be an imbalance between the processor and the data subject for it to be considered to be freely given. In some countries the use of *consent* as the legal basis for processing by universities for research purposes is therefore not recommended. In those cases, public interest should probably be your legal basis. Note that if your legal basis for processing is consent, [a number of requirements](https://gdpr-info.eu/issues/consent/) exists for the consent to be considered valid under the GDPR. Consents given before the GDPR might not live up to this. \n\nNote that consent needs to be completely voluntary. If the subject gets any service or good in return for their permission, this is not considered consent. Also note that in European (GDPR) law, a data subject should be able to retract their consent at any moment."},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":false},"metricMeasures":{"changed":false}},"createdAt":"2022-02-28T14:48:25Z","entityUuid":"73cd2dda-41ba-456b-9a4e-aa34c78f2fcf","parentUuid":"be4651c9-9a8c-4e10-a158-61b94ca0e139","uuid":"9454ad9e-b089-40d2-a493-b1be026ae78a"},{"content":{"eventType":"MoveQuestionEvent","targetUuid":"d8ecede2-f952-4b08-8a68-20d97849733f"},"createdAt":"2022-02-28T14:48:26Z","entityUuid":"8915bd25-db22-4ed6-bcc8-b1bbdc52989e","parentUuid":"421e2d3e-c95c-4244-9465-de8f1cb8aeba","uuid":"3dc902da-afa4-4f2c-9f20-64b18764ddb0"},{"content":{"eventType":"DeleteAnswerEvent"},"createdAt":"2022-02-28T14:48:27Z","entityUuid":"48ec1902-dad1-4f4b-8a37-76c5e44ecfb7","parentUuid":"c8687abf-ac88-4bef-b1cc-7070bd039a07","uuid":"f77aafd0-bed7-4088-a08b-30b1a59d1348"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Explore"},"metricMeasures":{"changed":false}},"createdAt":"2022-02-28T14:48:28Z","entityUuid":"d8ecede2-f952-4b08-8a68-20d97849733f","parentUuid":"c8687abf-ac88-4bef-b1cc-7070bd039a07","uuid":"b11f42f7-18fa-4aa5-8f47-edc9d32bd34c"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestio