:57:41Z","entityUuid":"85a9d872-3d41-4560-82c4-b850a6e2d5ac","parentUuid":"b3739ebd-2d8e-42d3-9425-a7d6d1b26c79","uuid":"8882f28e-efd2-4fdf-965e-e7a3230d69fa"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["3c7bdc90-8ed3-4b34-90ec-7945d14cc443","fd4637a2-a117-460a-a7fa-c03760c42629"]},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2020-11-11T10:57:42Z","entityUuid":"43370b85-0ee0-4f0f-b7de-9b04a54a2480","parentUuid":"0cfc22ec-5551-4a37-84ec-308c85440af5","uuid":"304f200d-417e-4644-87a9-4b3cb42c63ab"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["3c7bdc90-8ed3-4b34-90ec-7945d14cc443","fd4637a2-a117-460a-a7fa-c03760c42629"]},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2020-11-11T10:57:43Z","entityUuid":"c10f9098-5b1c-4abc-adaa-bdef2fb537ca","parentUuid":"b3739ebd-2d8e-42d3-9425-a7d6d1b26c79","uuid":"53308e47-0fe8-4502-94bb-a7adb2526f8f"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["3c7bdc90-8ed3-4b34-90ec-7945d14cc443","fd4637a2-a117-460a-a7fa-c03760c42629"]},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2020-11-11T10:57:44Z","entityUuid":"b289fdcc-aedc-496e-8169-e0bbe2346d1f","parentUuid":"2b755a90-8a43-41c0-9020-5e2b9ca8f88e","uuid":"e4ef6839-9cd8-49e2-95b4-cb8b2eca1537"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["3c7bdc90-8ed3-4b34-90ec-7945d14cc443","fd4637a2-a117-460a-a7fa-c03760c42629"]},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2020-11-11T10:57:45Z","entityUuid":"f5c12fcf-15d0-44ba-a53c-49ea9d7f620f","parentUuid":"b3739ebd-2d8e-42d3-9425-a7d6d1b26c79","uuid":"82aecfcf-f7d7-4254-8bc5-1824f9838e20"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["3c7bdc90-8ed3-4b34-90ec-7945d14cc443","fd4637a2-a117-460a-a7fa-c03760c42629"]},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2020-11-11T10:57:46Z","entityUuid":"99a48a1a-5c27-4e15-9da0-515da815b4b8","parentUuid":"1b120967-803b-458b-b565-dbee6a785509","uuid":"0b762aa4-4c53-40b8-81c8-3c7dbc88bcb0"},{"content":{"annotations":{"changed":false},"color":{"changed":false},"description":{"changed":false},"eventType":"EditTagEvent","name":{"changed":true,"value":"Horizon 2020 DMP"}},"createdAt":"2020-11-11T10:57:47Z","entityUuid":"3c7bdc90-8ed3-4b34-90ec-7945d14cc443","parentUuid":"6f6241d9-136c-4770-9d58-8a3f39607052","uuid":"5aa1e34d-2ca2-4614-b608-eb7449b5dc49"},{"content":{"annotations":{"changed":false},"color":{"changed":false},"description":{"changed":true,"value":"Questions related to Horizon 2020 DMP."},"eventType":"EditTagEvent","name":{"changed":false}},"createdAt":"2020-11-11T10:57:48Z","entityUuid":"3c7bdc90-8ed3-4b34-90ec-7945d14cc443","parentUuid":"6f6241d9-136c-4770-9d58-8a3f39607052","uuid":"3bb128db-ccf0-49d4-ada7-800b204a4fc4"},{"content":{"annotations":{"changed":false},"color":{"changed":false},"description":{"changed":true,"value":"Questions related to Science Europe DMP."},"eventType":"EditTagEvent","name":{"changed":false}},"createdAt":"2020-11-11T10:57:49Z","entityUuid":"fd4637a2-a117-460a-a7fa-c03760c42629","parentUuid":"6f6241d9-136c-4770-9d58-8a3f39607052","uuid":"5cd4463a-daff-4b17-87d4-cc31b348ef38"}],"forkOfPackageId":null,"id":"dsw:root:2.3.0","kmId":"root","language":"en","license":"Apache-2.0","mergeCheckpointPackageId":null,"metamodelVersion":20,"name":"Common DSW Knowledge Model","nonEditable":false,"organizationId":"dsw","phase":"DeprecatedKnowledgeModelPackagePhase","previousPackageId":"dsw:root:2.2.0","readme":"# Common DSW Knowledge Model\n\nCommon DSW Knowledge Model deals with questions that a researcher should answer in order to create a Data Stewardship Plan, as well as other related questionnaire data. It originated from mindmap made by Rob Hooft.\n\n## Changelog\n\n### 2.3.0\n\nActivity during [BioHackathon Europe](biohackathon-europe.org) 2020 ([#BioHackEU20](twitter.com/search?q=%23BioHackEU20))\n\n* Added and tagged questions for Horizon 2020 template\n* Moved questions about collecting metadata to one consistent place\n* Added guidance on semantics in file names and question about using PIDs for identifying files\n* Generic small cleanups and typo fixes\n* Closing many issues of feedback received on the knowledge model (from [DSWGlobal/dsw](https://github.com/DSWGlobal/dsw))\n* Various question updates new options, clarifications, integrations\n* Added highly configurable [Wikidata](https://www.wikidata.org) SPARQL-based integration\n* Added [Research Organization Registry](https://ror.org) integration for contributor's affiliation\n\n### 2.2.0\n\n* Adjusted for compatibility with [RDA DMP Common Standard for machine-actionable DMPs (1.0)](https://github.com/RDA-DMP-Common/RDA-DMP-Common-Standard)\n  * Updated *Project* and *Funding* questions in *Administrative Details* chapter\n  * Reorganised *Dataset*, *Distribution*, *License* questions in *Data Publishing* chapter\n* Added *maDMP* tag to questions used in the RDA maDMP template\n\n### 2.1.0\n\n* Added *Science Europe DMP* tag to questions used in the Science Europe template\n\n### 2.0.2\n\n* Fixed missing and duplicated questions\n\n### 2.0.1\n\n* Fixed duplicated question in *Creating and collecting data* chapter (5ba53879-eb48-47f2-a73b-f7f7d83bf030)\n\n### 2.0.0\n\n* Added detailed questions for Science Europe DMPs\n* Fixed several typos and other minor problems\n* Added administrative chapter\n* Moving questions and refactoring according to [ds-km#24](https://github.com/ds-wizard/ds-km/pull/24)\n\n### 1.4.0\n\n* Adding integration for [FAIRsharing.org](https://fairsharing.org)\n* Adding 5 integration questions according to [ds-km@da5a8fc](https://github.com/ds-wizard/ds-km/commit/da5a8fc95d0a67f9369ce0b7727615115fc3656d)\n\nThe FAIRsharing integration requires configuration to contain `apiUrl` and `apiKey` for integration with id `fairsharing`.\n\n### 1.3.0\n\n* Refactoring list questions because of **deprecated item title** fields, i.e., a new question for item title created for each list question\n\nWhen using this version and higher, the DS Wizard configuration should have `itemTitleEnabled` set to `false`.\n\n### 1.2.0\n\n* Adding file naming SOP description question (9ff389f0-2236-48cf-880c-040ea1bb0d2f) to chapter 2 according to [ds-km@d879be0](https://github.com/ds-wizard/ds-km/commit/d879be0fa9d0808868396c649d03c4d783ac6742)\n\n### 1.1.0\n\n* Adding phases to questions (first draft) according to [ds-km@a6713d1](https://github.com/ds-wizard/ds-km/commit/a6713d1a4b9758bea63b3f7c56af5bd4f500d949) and [ds-km@1123211](https://github.com/ds-wizard/ds-km/commit/1123211bb5af43df8ef435039a2923f48e3e981c)\n\nPrior to this version, all questions were assigned with phase 2 - *Before submitting the DMP*. \n\n### 1.0.3\n\n* Fix: Removing extra question mark for a question (8018e15f-6c7e-433a-8686-ae0d695c7fc7) in chapter 5 according to: [ds-km@1123211](https://github.com/ds-wizard/ds-km/commit/1123211bb5af43df8ef435039a2923f48e3e981c)\n\n### 1.0.2\n\n* Fix: Adding some explanation to the list item questions (f5fef09d-ade5-4019-b089-f05bd89c34bc and b642c31d-a512-4ca7-8743-a2e0254006fa) in chapter 3 according to: [ds-km@96e28f4](https://github.com/ds-wizard/ds-km/commit/96e28f478d5dc6b59d384b5127f012dc2fe5f287)\n\n### 1.0.1\n\n* Fix: Adding forgotten question mark to end of question (39e0cc7c-17fe-4991-88d8-1280c3fe7923) in chapter 1 according to: [ds-km@644a373](https://github.com/ds-wizard/ds-km/commit/644a373685dc4ac15b76e86667a90151ca9c70ca)\n\n### 1.0.0\n\n* Initial version transformed from the previous DS-KM GitHub repository up to [ds-km@8442837](https://github.com/ds-wizard/ds-km/commit/8442837dbe3ff899b09e7d8d3fc1107e935a876f)","version":"2.3.0"},{"createdAt":"2021-11-02T10:22:46.775632Z","description":"DSW Knowledge Model originated from mindmap made by Rob Hooft","events":[{"content":{"annotations":{"changed":false},"eventType":"EditChapterEvent","questionUuids":{"changed":false},"text":{"changed":true,"value":"We will make sure that we know what data will be coming together in the project, when it will be coming. We also need to make sure that we have adequate storage space to deal with it, and that all the responsibilities have been taken care of.\n\nSee also [Collecting in RDMKit](https://rdmkit.elixir-europe.org/collecting)"},"title":{"changed":false}},"createdAt":"2021-11-02T10:22:47Z","entityUuid":"b1df3c74-0b1f-4574-81c4-4cc2d780c1af","parentUuid":"6f6241d9-136c-4770-9d58-8a3f39607052","uuid":"d8e93d3f-741f-466e-b285-d1173d36bbf8"},{"content":{"annotations":{"changed":false},"eventType":"EditChapterEvent","questionUuids":{"changed":false},"text":{"changed":true,"value":"In this chapter we describe all the sources of data: they can e.g. come from instruments or from questionnaires; data can be newly collected as part of the current project, but it can also be pre-existing data that may need proper contracts with the maintainer, some pre-processing, and quality checks. It can also be reference data that is part of curated resources and (public) databases. \n\nFor more information see [Collecting in RDMKit](https://rdmkit.elixir-europe.org/collecting)"},"title":{"changed":false}},"createdAt":"2021-11-02T10:22:48Z","entityUuid":"b1df3c74-0b1f-4574-81c4-4cc2d780c1af","parentUuid":"6f6241d9-136c-4770-9d58-8a3f39607052","uuid":"bf8fde5e-e357-4722-9822-ef72a26e7216"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Data analysis is normally done step-by-step.  It is important that for all data the origin and all processing and filtering steps are documented, otherwise results will not be reproducible. \n\nRe-users of the data also need this information to decide whether the data can be used for their purpose."},"title":{"changed":false}},"createdAt":"2021-11-02T10:22:49Z","entityUuid":"948b5fd8-c1bd-457d-8f81-ea2fd093f541","parentUuid":"6d18bfff-0f53-469b-934e-9806dda9d4fb","uuid":"9c341560-a1cf-4e56-a600-813955ddcc02"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"For the re-usability of your data by yourself or others at a later stage, a lot of information about the data --for example how it was collected and how it can be used-- should be stored with the data. Such *data about the data* is called **metadata**, and this set of questions are about this metadata."},"title":{"changed":false}},"createdAt":"2021-11-02T10:22:50Z","entityUuid":"8c962e6f-17ee-4b22-8ebb-9f06f779e3b3","parentUuid":"b1df3c74-0b1f-4574-81c4-4cc2d780c1af","uuid":"840c2fc4-9424-4ea3-a067-f7bd7861f512"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":"In the design of your experiment, there are many considerations and techniques that cab be used to ensure and monitor data quality.","title":"What techniques are you using to ensure data quality?"},"createdAt":"2021-11-02T10:22:51Z","entityUuid":"59cd7bb6-8b24-4a4b-9baa-e7147807c58d","parentUuid":"b1df3c74-0b1f-4574-81c4-4cc2d780c1af","uuid":"1b8e9ffe-fefe-4cd0-b3bd-99f7955e2bc1"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Explore","metricMeasures":[]},"createdAt":"2021-11-02T10:22:52Z","entityUuid":"f55f2b65-40ea-428c-99e3-f78b9e8032a0","parentUuid":"59cd7bb6-8b24-4a4b-9baa-e7147807c58d","uuid":"3b5b3804-fee0-413c-809f-5805b6906075"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":"Will you be repeating experiments to monitor consistency of the results?"},"createdAt":"2021-11-02T10:22:53Z","entityUuid":"9a4050de-5264-4de6-933c-3cfff3684119","parentUuid":"f55f2b65-40ea-428c-99e3-f78b9e8032a0","uuid":"539a33ca-d8c5-4a88-a7c1-ee9ce93e138c"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[]},"createdAt":"2021-11-02T10:22:54Z","entityUuid":"33e6d62f-a1a8-4cee-ad93-dea427405722","parentUuid":"9a4050de-5264-4de6-933c-3cfff3684119","uuid":"2b83b4d6-4f6f-49cb-90c1-185e57442174"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[]},"createdAt":"2021-11-02T10:22:55Z","entityUuid":"faad6703-7c7a-43e7-9b38-33ea5fed66c2","parentUuid":"9a4050de-5264-4de6-933c-3cfff3684119","uuid":"70610b9c-a94a-4cfe-989d-9be4876ab7c7"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":"Will you include experiments for which the outcome is known to monitor consistency of the results?"},"createdAt":"2021-11-02T10:22:56Z","entityUuid":"691f896d-c28f-4da8-b648-9dab7066d454","parentUuid":"f55f2b65-40ea-428c-99e3-f78b9e8032a0","uuid":"baf34381-6384-4ea7-aa8c-d4d746612809"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[]},"createdAt":"2021-11-02T10:22:57Z","entityUuid":"40f366d2-57b8-4113-b597-ad2fd2376c0c","parentUuid":"691f896d-c28f-4da8-b648-9dab7066d454","uuid":"7b25e7b7-8914-4426-a18e-7ac4a61aba7b"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[]},"createdAt":"2021-11-02T10:22:58Z","entityUuid":"d791892c-efe1-48b0-bb5f-86660c0fabed","parentUuid":"691f896d-c28f-4da8-b648-9dab7066d454","uuid":"246dd1ba-7299-4fc5-ba2e-e27e17d03059"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":"Are you using any other techniques to monitor data quality?"},"createdAt":"2021-11-02T10:22:59Z","entityUuid":"aec4bc32-9a52-4903-a17d-cb8d69bb8417","parentUuid":"f55f2b65-40ea-428c-99e3-f78b9e8032a0","uuid":"2ac189f4-c0f0-426a-b9da-4cdd27ca320c"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[]},"createdAt":"2021-11-02T10:23:00Z","entityUuid":"0f714535-c6a3-4697-a3e4-525bfded85f7","parentUuid":"aec4bc32-9a52-4903-a17d-cb8d69bb8417","uuid":"28817ae5-9a82-4c03-a9c1-2f850c1b17fd"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[]},"createdAt":"2021-11-02T10:23:01Z","entityUuid":"faa94ef2-24b4-435c-9a5d-972ee698e157","parentUuid":"aec4bc32-9a52-4903-a17d-cb8d69bb8417","uuid":"9b381d4b-afa9-4060-95ae-f61eb0399891"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"ValueQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":"What other techniques do you use to monitor data quality?","validations":[],"valueType":"TextQuestionValueType"},"createdAt":"2021-11-02T10:23:02Z","entityUuid":"51e61d30-3837-4ab5-b5e5-7a832d456d63","parentUuid":"faa94ef2-24b4-435c-9a5d-972ee698e157","uuid":"b86ecdde-daf2-4419-879a-eb9dd121315e"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"The ownership for the data is arranged in another way"},"metricMeasures":{"changed":false}},"createdAt":"2021-11-02T10:23:03Z","entityUuid":"0fd3cd1c-e0e8-41d5-9beb-3f1faba0fb91","parentUuid":"cb7d17a8-30c0-489d-a43c-702b27d97611","uuid":"7d32397e-8b48-4079-ba1e-98e4efc8c611"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":"Very many kinds of data are connected to people. If there could be a way for someone, including yourself, to find out who that person is, that is considered personal data.\n\nSimple examples are name, birth day or address; but there are many other data that can be personal: for example a combination of a location and a time, genetic information, or an X-ray of the skull.","title":"Will you collect any data connected to a person, \"personal data\"?"},"createdAt":"2021-11-02T10:23:04Z","entityUuid":"49c009cb-a38c-4836-9780-8a8b3dd1cbac","parentUuid":"b1df3c74-0b1f-4574-81c4-4cc2d780c1af","uuid":"4e64fff0-1177-4d76-8421-963720fae346"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"No","metricMeasures":[]},"createdAt":"2021-11-02T10:23:05Z","entityUuid":"4bdc319d-282a-4a80-9cdd-78d2081e812b","parentUuid":"49c009cb-a38c-4836-9780-8a8b3dd1cbac","uuid":"2eda9560-888d-430e-a492-8730ec2bd920"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Yes","metricMeasures":[]},"createdAt":"2021-11-02T10:23:06Z","entityUuid":"421e2d3e-c95c-4244-9465-de8f1cb8aeba","parentUuid":"49c009cb-a38c-4836-9780-8a8b3dd1cbac","uuid":"3153bef8-52a4-4b23-bf16-0e5750dc9dc1"},{"content":{"annotations":{"changed":false},"eventType":"EditChapterEvent","questionUuids":{"changed":true,"value":["b08fe063-33f8-4380-b3a9-ba1e586dedf2","2bac9020-99cf-4463-8d34-0b0eb2781cd1","5ba53879-eb48-47f2-a73b-f7f7d83bf030","8c962e6f-17ee-4b22-8ebb-9f06f779e3b3","f87c331d-794a-42c8-a910-61a2a9110dab","f038bd46-ee4e-4f53-b7ea-482381c2c855","ab4b3f39-dfab-45a5-9489-2d46ceacbb73","0e810343-6026-4992-8ea0-5539cbc77093","49c009cb-a38c-4836-9780-8a8b3dd1cbac","f5e162ee-1077-4ebe-a932-192bc7f67e98","cb7d17a8-30c0-489d-a43c-702b27d97611","59cd7bb6-8b24-4a4b-9baa-e7147807c58d"]},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2021-11-02T10:23:07Z","entityUuid":"b1df3c74-0b1f-4574-81c4-4cc2d780c1af","parentUuid":"6f6241d9-136c-4770-9d58-8a3f39607052","uuid":"151cf109-fb1c-405b-b2c2-44f7e59a40a5"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":"Many countries, including the European Union, have strict laws that require anyone who processes personal data to do so only with a good reason. The allowed \"good reasons\" are called \"legal base\" for the processing of the data.","title":"What legal basis are you using to collect and process the personal data?"},"createdAt":"2021-11-02T10:23:08Z","entityUuid":"be4651c9-9a8c-4e10-a158-61b94ca0e139","parentUuid":"421e2d3e-c95c-4244-9465-de8f1cb8aeba","uuid":"52d0f3ff-63b8-4077-8e44-bd20c72e5c31"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"We ask the data subjects for their consent","metricMeasures":[]},"createdAt":"2021-11-02T10:23:09Z","entityUuid":"73cd2dda-41ba-456b-9a4e-aa34c78f2fcf","parentUuid":"be4651c9-9a8c-4e10-a158-61b94ca0e139","uuid":"4af8fab5-5602-4b3d-9855-56d235557511"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"We require the processing to fulfil our contract with the data subjects","metricMeasures":[]},"createdAt":"2021-11-02T10:23:10Z","entityUuid":"1dfe0a6d-4281-4d5e-bcaa-5e20fa28a591","parentUuid":"be4651c9-9a8c-4e10-a158-61b94ca0e139","uuid":"6ef53ca2-5a54-4a51-8382-913704489a7b"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"We have a legitimate interest: data subjects all expect us to do this data processing because of who we are","metricMeasures":[]},"createdAt":"2021-11-02T10:23:11Z","entityUuid":"9d5e3104-2b6b-4d95-848e-253ef069d8b3","parentUuid":"be4651c9-9a8c-4e10-a158-61b94ca0e139","uuid":"ede368d4-1dbe-49fa-a2cd-957daf8773ba"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Vital interest: we need to do this to save the data subject","metricMeasures":[]},"createdAt":"2021-11-02T10:23:12Z","entityUuid":"557a5401-a94a-4a37-af2e-a21829557bfa","parentUuid":"be4651c9-9a8c-4e10-a158-61b94ca0e139","uuid":"47712b38-767f-49d8-9ea4-01ba2969f8e5"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"Legal requirement: We are legally obliged to do this data processing","metricMeasures":[]},"createdAt":"2021-11-02T10:23:13Z","entityUuid":"f10de3a8-2751-42c7-afaa-92eed4833f8e","parentUuid":"be4651c9-9a8c-4e10-a158-61b94ca0e139","uuid":"3e82cdfd-e0c3-458f-8737-506daf37d709"},{"content":{"advice":"Note that scientific research is not considered public interest in many jurisdictions.","annotations":[],"eventType":"AddAnswerEvent","label":"Public interest: We do this for the benefit of society, and this is more important than the privacy of the subjects","metricMeasures":[]},"createdAt":"2021-11-02T10:23:14Z","entityUuid":"c732f0b9-2f66-47f4-902f-724a44cdfd4b","parentUuid":"be4651c9-9a8c-4e10-a158-61b94ca0e139","uuid":"bbe002a2-fb73-4039-89cf-8e2311e6ef29"},{"content":{"advice":{"changed":true,"value":"Note that consent needs to be completely voluntary. If the subject gets any service or good in return for their permission, this is not considered consent. Also note that in European (GDPR) law, a data subject should be able to retract their consent at any moment."},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":false},"metricMeasures":{"changed":false}},"createdAt":"2021-11-02T10:23:15Z","entityUuid":"73cd2dda-41ba-456b-9a4e-aa34c78f2fcf","parentUuid":"be4651c9-9a8c-4e10-a158-61b94ca0e139","uuid":"8cb76056-d197-48cd-a3bc-3c80250b205a"},{"content":{"eventType":"MoveQuestionEvent","targetUuid":"73cd2dda-41ba-456b-9a4e-aa34c78f2fcf"},"createdAt":"2021-11-02T10:23:16Z","entityUuid":"f5e162ee-1077-4ebe-a932-192bc7f67e98","parentUuid":"b1df3c74-0b1f-4574-81c4-4cc2d780c1af","uuid":"ccf6eafa-4ecf-408a-b524-60db0b7a007c"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"What kind of consent will you be acquiring?"}},"createdAt":"2021-11-02T10:23:17Z","entityUuid":"f5e162ee-1077-4ebe-a932-192bc7f67e98","parentUuid":"73cd2dda-41ba-456b-9a4e-aa34c78f2fcf","uuid":"3a9c1846-ab31-45c8-b4c3-cdc231773c0c"},{"content":{"eventType":"DeleteAnswerEvent"},"createdAt":"2021-11-02T10:23:18Z","entityUuid":"d4375763-1af3-48a0-8738-f216b5ceeff0","parentUuid":"f5e162ee-1077-4ebe-a932-192bc7f67e98","uuid":"1fe7b43e-f8f7-445d-85b7-4b8c2277f21d"},{"content":{"eventType":"DeleteAnswerEvent"},"createdAt":"2021-11-02T10:23:19Z","entityUuid":"e1ae38ed-14fb-4143-8a76-3883bd794b9b","parentUuid":"f5e162ee-1077-4ebe-a932-192bc7f67e98","uuid":"4fef1214-0cee-4cc9-b2cf-13b6d896d515"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"We will collect consent for our specific use of the data"},"metricMeasures":{"changed":false}},"createdAt":"2021-11-02T10:23:20Z","entityUuid":"a484287c-fd7f-47ca-8dea-cdb36f48616d","parentUuid":"f5e162ee-1077-4ebe-a932-192bc7f67e98","uuid":"ab6c128a-27ca-4d82-b0f4-405cb2a2c88f"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"We collect consent for our use as well as reuse of the data"},"metricMeasures":{"changed":false}},"createdAt":"2021-11-02T10:23:21Z","entityUuid":"08014631-8a8a-4efa-bd58-3766cc40c7ed","parentUuid":"f5e162ee-1077-4ebe-a932-192bc7f67e98","uuid":"a4f26143-d149-4353-abd7-c360757b1a86"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"We collect consent for our specific use of the data"},"metricMeasures":{"changed":false}},"createdAt":"2021-11-02T10:23:22Z","entityUuid":"a484287c-fd7f-47ca-8dea-cdb36f48616d","parentUuid":"f5e162ee-1077-4ebe-a932-192bc7f67e98","uuid":"e8557061-6b25-4482-a7b0-6b08052b22a1"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"We collect consent for our use as well as for reuse of the data"},"metricMeasures":{"changed":false}},"createdAt":"2021-11-02T10:23:23Z","entityUuid":"08014631-8a8a-4efa-bd58-3766cc40c7ed","parentUuid":"f5e162ee-1077-4ebe-a932-192bc7f67e98","uuid":"f9af03dc-fc7c-4339-be28-fd960d088cbf"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"We will collect consent for our use of the data and for anonymization; We will anonymize the data afterwards for reuse."},"metricMeasures":{"changed":false}},"createdAt":"2021-11-02T10:23:24Z","entityUuid":"3a77595a-87ae-484d-a9a6-052f312453ee","parentUuid":"f5e162ee-1077-4ebe-a932-192bc7f67e98","uuid":"6d794bc2-b4b7-4317-9dc5-2e4ea9af0a23"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"RDMkit about sensitive data","referenceType":"URLReference","url":"https://rdmkit.elixir-europe.org/sensitive_data.html"},"createdAt":"2021-11-02T10:23:25Z","entityUuid":"df93fa41-88cb-451a-aa05-95a18cf02e73","parentUuid":"49c009cb-a38c-4836-9780-8a8b3dd1cbac","uuid":"e9bcd9dd-776a-4bc3-aecc-c58ee4935964"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Very many kinds of data are connected to people. If there could be a way for someone, including yourself, to find out who that person is, that is considered personal data.\n\nSimple examples are name, birth day or address; but there are many other data that can be personal: for example a voice recording, a combination of a location and a time (traffic flow), genetic information, or an X-ray of the skull."},"title":{"changed":false}},"createdAt":"2021-11-02T10:23:26Z","entityUuid":"49c009cb-a38c-4836-9780-8a8b3dd1cbac","parentUuid":"b1df3c74-0b1f-4574-81c4-4cc2d780c1af","uuid":"a4f90676-39f1-4290-b547-379e16753d4d"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"We ask for consent for anonymization; we will anonymise first and all further processing is on the anonymous data.","metricMeasures":[]},"createdAt":"2021-11-02T10:23:27Z","entityUuid":"e7e4f219-5edd-468f-b042-b5f88a559c3a","parentUuid":"f5e162ee-1077-4ebe-a932-192bc7f67e98",