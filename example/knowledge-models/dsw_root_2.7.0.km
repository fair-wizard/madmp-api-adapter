:"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["4fa6f10d-b593-4b00-84cf-00d7f916147f"]},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2022-02-28T14:53:28Z","entityUuid":"0ac70ded-3864-4c7e-90a1-ea13a5fc9975","parentUuid":"03704872-aa57-4d0a-b977-89bdb4331853","uuid":"2d55c8cb-93a3-47f9-b17a-38f03f6608ff"},{"content":{"annotations":{"changed":false},"eventType":"EditChoiceEvent","label":{"changed":true,"value":"Other"}},"createdAt":"2022-02-28T14:53:29Z","entityUuid":"64f2af8d-6703-4b76-b4d1-4786d0bdc995","parentUuid":"81f18ab3-ab64-46a7-bf26-9e7d663d4362","uuid":"13455e12-b16b-4c7a-83b6-e7c10435b908"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Please specify what the restrictions are"},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2022-02-28T14:53:30Z","entityUuid":"0ac70ded-3864-4c7e-90a1-ea13a5fc9975","parentUuid":"03704872-aa57-4d0a-b977-89bdb4331853","uuid":"f64a621d-0fb6-4163-ad75-03b0c2987f4d"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Will the rightsholder of this dataset work with you on this study?"}},"createdAt":"2022-02-28T14:53:31Z","entityUuid":"39e0cc7c-17fe-4991-88d8-1280c3fe7923","parentUuid":"7fc8d3c9-a2d5-4d47-9df4-56af48ca85e1","uuid":"fe37dd77-1693-48f6-a185-6e638be294b6"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Is there anything in this dataset that could be tied to a person? This could be a physical characteristic, but also behavior of a person, movements, communications. Note that e.g. readouts about the performance of an airplane are considered to contain personal data of the pilot!\n\nThe GDPR states that the processing (including storing) of personal data should stop when the intended purpose of the processing is done. There are, however, exemptions to this e.g. when the processing is done for research purposes. Also, from a research ethics point of view, research data should be kept to make it possible for others to validate published research findings and reuse data for new discoveries. This is also governed by what the data subjects have been informed about regarding how you will treat the data after project completion. The recommendation is to deposit the sensitive data in the appropriate controlled access repositories if such are available, but this requires that the data subjects are informed and have agreed to this."},"title":{"changed":false}},"createdAt":"2022-02-28T14:53:32Z","entityUuid":"a1d76760-053c-4706-80a2-cfb6c6a061f3","parentUuid":"4e0c1edf-660c-4ebf-81f5-9fa959dead30","uuid":"92ae2fec-adcb-4254-86ee-ab442f0a9600"},{"content":{"eventType":"DeleteQuestionEvent"},"createdAt":"2022-02-28T14:53:33Z","entityUuid":"ed5c4f40-0c07-4bc3-bfdc-10ded3e8a6a8","parentUuid":"7dd7320e-41dd-43b9-b6aa-7622eaa34679","uuid":"d7cea1d2-3b0c-4158-ae01-3145613c363f"},{"content":{"eventType":"MoveQuestionEvent","targetUuid":"22e612e0-c72d-42fa-9a37-a55232e72c72"},"createdAt":"2022-02-28T14:53:34Z","entityUuid":"15ade1cb-af43-40be-b8b1-2b801812dab1","parentUuid":"7dd7320e-41dd-43b9-b6aa-7622eaa34679","uuid":"d1359787-0407-4dd2-9fba-a36940f38e08"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"To ensure that the personal data that you process in the project is protected at an appropriate level, you should apply technical and procedural safeguards to ensure that the rights of the data subjects are not violated. Examples of such measures include, but are not limited to, pseudonymisation and encryption of data, the use of computing and storage environments with heightened security, and clear and documented procedures for project members to follow."},"title":{"changed":false}},"createdAt":"2022-02-28T14:53:35Z","entityUuid":"a30f5047-33c1-45a7-8b3f-b1b90c364fc9","parentUuid":"d8ecede2-f952-4b08-8a68-20d97849733f","uuid":"e6ad8531-de43-4d9a-a5ea-2ce8adcc6c66"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":true,"value":"1796fa3c-9f53-475f-89ff-c66a0453c42e"},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2022-02-28T14:53:36Z","entityUuid":"db902645-6aef-426a-aa2c-30e96a4b3afb","parentUuid":"92b8a6ea-124f-43dd-95ab-13b8ce955bac","uuid":"8e3366b1-1d6b-4e9a-9574-fe39f1acc8fd"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":true,"value":"1796fa3c-9f53-475f-89ff-c66a0453c42e"},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2022-02-28T14:53:37Z"