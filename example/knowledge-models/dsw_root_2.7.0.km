ght_id\": 4,\n    \"length_name\": 54\n  },\n  {\n    \"id\": \"CC-BY-NC-SA 4.0\",\n    \"name\": \"Attribution-NonCommercial-ShareAlike 4.0 International\",\n    \"url\": \"https://creativecommons.org/licenses/by-nc-sa/4.0/\",\n    \"version\": \"4.0\",\n    \"type\": \"CreativeCommons\",\n    \"rights\": [\n      \"Adapt\",\n      \"Share\",\n      \"Attribution\",\n      \"non-commercial\",\n      \"ShareAlike\"\n    ],\n    \"main_license\": \"\",\n    \"main_license_url\": \"https://creativecommons.org/licenses/by-nd/4.0/\",\n    \"lenght_id\": 15,\n    \"length_name\": 54\n  },\n  {\n    \"id\": \"CC-BY-NC-ND 4.0\",\n    \"name\": \"Attribution-NonCommercial-NoDerivatives 4.0 International\",\n    \"url\": \"https://creativecommons.org/licenses/by-nc-nd/4.0/\",\n    \"version\": \"4.0\",\n    \"type\": \"CreativeCommons\",\n    \"rights\": [\n      \"Share\",\n      \"Indicate change\",\n      \"Attribution\",\n      \"Notice\",\n      \"non-commercial\",\n      \"No derivatives\"\n    ],\n    \"main_license\": \"\",\n    \"main_license_url\": \"https://creativecommons.org/licenses/by-nd/4.0/\",\n    \"lenght_id\": 15,\n    \"length_name\": 57\n  }\n]","contentType":"application/json; charset=utf-8","responseType":"SuccessTypeHintResponse","status":200}}},"testVariables":{"changed":false},"variables":{"changed":false}},"createdAt":"2025-11-25T12:16:47Z","entityUuid":"45d02648-d4bc-4ceb-8e98-a1235f2e7d3f","parentUuid":"6f6241d9-136c-4770-9d58-8a3f39607052","uuid":"77bf36be-3693-4480-8b77-99f663727a47"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"integrationUuid":{"changed":true,"value":"45d02648-d4bc-4ceb-8e98-a1235f2e7d3f"},"questionType":"IntegrationQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Choose from the predefined list of licenses. If you cannot find the one you need, please fill it in manually."},"title":{"changed":false},"variables":{"changed":false}},"createdAt":"2025-11-25T12:16:48Z","entityUuid":"0184bfcc-69ab-48c8-9d62-e23ae73a60be","parentUuid":"0a779591-6b8e-4e65-96b6-e3782f71532c","uuid":"dc1881cf-f82d-488b-b07d-e7308009e507"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Are there any other outputs of your project, besides software, that could be valuable to other entities (such as researchers, research groups, or institutes)?\n\n"},"title":{"changed":false}},"createdAt":"2025-11-25T12:16:49Z","entityUuid":"ee81402b-aefa-4cb6-9743-bb5de655e76d","parentUuid":"18060a91-447f-4be0-a9e9-b40b6e3ba7d3","uuid":"28ae2982-eae5-47a5-a868-52d43ee7630c"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"What other outputs are there besides software?"}},"createdAt":"2025-11-25T12:16:50Z","entityUuid":"82359337-0a92-4446-a7bb-dcf1c01a350a","parentUuid":"34eae7bf-c554-4031-ad06-5180e581fa9a","uuid":"6be8eae0-3257-41f1-b630-06fbdfe02e12"},{"content":{"allowCustomReply":{"changed":false},"annotations":{"changed":false},"eventType":"EditIntegrationEvent","integrationType":"ApiIntegration","name":{"changed":false},"requestAllowEmptySearch":{"changed":false},"requestBody":{"changed":false},"requestHeaders":{"changed":false},"requestMethod":{"changed":false},"requestUrl":{"changed":false},"responseItemTemplate":{"changed":true,"value":"![Logo](data:image/svg+xml;base64,) [**{{ item.name }}**]({{ item.url }}) ([{{ item.homepage }}]({{ item.homepage }}))\n\n{% if item.description %}\n {{ item.description | truncate(300, True, '...')}}\n{% endif %}"},"responseItemTemplateForSelection":{"changed":true,"value":"[**{{ item.name }}**]({{ item.url }}) ([{{ item.homepage }}]({{ item.homepage }}))\n\n{%- if item.shortname %}\n ({{ item.shortname }})\n{% endif %}\n\n{% if item.description %}\n {{ item.description | truncate(300, True, '...')}}\n{% endif %}"},"responseListField":{"changed":false},"testQ":{"changed":true,"value":"Czech"},"testResponse":{"changed":true,"value":{"request":{"body":"","headers":[{"key":"Accept","value":"application/json"},{"key":"Authorization","value":"[SECRET:fairsharingApiKey]"}],"method":"GET","url":"[SECRET:fairsharingApiUrl]/search?registry=standard&q=Czech&status=ready"},"response":{"body":"{\"data\":[{\"id\":\"865\",\"registry\":\"standard\",\"record_type\":\"reporting_guideline\",\"name\":\"Minimum Information for Publication of Quantitative Real-Time PCR Experiments\",\"abbreviation\":\"MIQE\",\"description\":\"The aim of MIQE is to provide authors, reviewers and editors with specifications for the minimum information that must be reported for a qPCR experiment in order to ensure its relevance, accuracy, correct interpretation and repeatability.\",\"doi\":\"10.25504/FAIRsharing.mxz4jy\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.mxz4jy\",\"homepage\":\"https://rdml.org/miqe.html\",\"countries\":[\"Belgium\",\"Czech Republic\",\"Germany\",\"Sweden\",\"United Kingdom\",\"United States\"],\"disciplines\":[\"Biology\"],\"domains\":[\"deoxyribonucleic acid\",\"ribonucleic acid\",\"gene expression\",\"assay\",\"real time polymerase chain reaction assay\"],\"taxonomies\":[\"All\"],\"user_defined_tags\":[],\"legacy_ids\":[\"bsg-000185\",\"bsg-s000185\"],\"created_at\":\"2014-11-04T15:23:40.000Z\",\"updated_at\":\"2024-03-21T13:59:13.144Z\"},{\"id\":\"581\",\"registry\":\"standard\",\"record_type\":\"terminology_artefact\",\"name\":\"European Language Social Science Thesaurus\",\"abbreviation\":\"ELSST\",\"description\":\"The European Language Social Science Thesaurus (ELSST) is a broad-based, multilingual thesaurus for the social sciences. It is owned and published by the Consortium of European Social Science Data Archives (CESSDA) and its national Service Providers. The thesaurus consists of over 3,300 concepts and covers the core social science disciplines: politics, sociology, economics, education, law, crime, demography, health, employment, information, communication technology, and environmental science.\\nELSST is used for data discovery within CESSDA and facilitates access to data resources across Europe, independent of domain, resource, language, or vocabulary.\\n\\nELSST is currently available in 16 languages: Danish, Dutch, Czech, English, Finnish, French, German, Greek, Hungarian, Icelandic, Lithuanian, Norwegian, Romanian, Slovenian, Spanish, and Swedish\",\"doi\":\"10.25504/FAIRsharing.acd824\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.acd824\",\"homepage\":\"https://thesauri.cessda.eu/en/\",\"countries\":[\"Norway\",\"United Kingdom\"],\"disciplines\":[\"Economics\",\"Social Science\"],\"domains\":[],\"taxonomies\":[\"Not applicable\"],\"user_defined_tags\":[],\"legacy_ids\":[\"bsg-001466\",\"bsg-s001466\"],\"created_at\":\"2020-04-25T14:40:14.000Z\",\"updated_at\":\"2025-10-14T13:11:01.379Z\"},{\"id\":\"5073\",\"registry\":\"standard\",\"record_type\":\"model_and_format\",\"name\":\"Global Soil Information System Web Ontology\",\"abbreviation\":\"GloSIS\",\"description\":\"The Global Soil Information System (GloSIS) v1.0 ontology network, derived from the source UML data model, and modelled in line with best practices and methodologies, reusing existing standard models and ontologies.\",\"doi\":\"10.25504/FAIRsharing.af87a1\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.af87a1\",\"homepage\":\"http://w3id.org/glosis/model\",\"countries\":[\"Worldwide\"],\"disciplines\":[\"Agriculture\",\"Agronomy\",\"Soil Science\"],\"domains\":[\"Sustainability\",\"Agroecosystem\"],\"taxonomies\":[\"Not applicable\"],\"user_defined_tags\":[\"soil carbon\",\"Soil pH\",\"Soil texture\"],\"legacy_ids\":[],\"created_at\":\"2023-10-30T12:57:08.062Z\",\"updated_at\":\"2024-03-21T13:58:06.421Z\"},{\"id\":\"927\",\"registry\":\"standard\",\"record_type\":\"terminology_artefact\",\"name\":\"Stroke Scale Ontology\",\"abbreviation\":\"nihss\",\"description\":\"Domain ontology for describing the standardized neurological examination of stroke patients according to the National Institutes of Health Stroke Scale (NIHSS). The ontology is intended for describing the assessment of a patient after a stroke. A patient with more limitations is evaluated with more points (worse condition). An evaluation (score) with a value of 0 (zero) indicates a normal state.\",\"doi\":\"10.25504/FAIRsharing.jprvcd\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.jprvcd\",\"homepage\":\"http://bioportal.bioontology.org/ontologies/NIHSS\",\"countries\":[\"Czech Republic\"],\"disciplines\":[\"Health Science\",\"Neuroscience\"],\"domains\":[\"cardiovascular disease\"],\"taxonomies\":[\"All\"],\"user_defined_tags\":[\"stroke\"],\"legacy_ids\":[\"bsg-000816\",\"bsg-s000816\"],\"created_at\":\"2017-10-24T08:41:26.000Z\",\"updated_at\":\"2024-06-21T16:29:54.650Z\"},{\"id\":\"817\",\"registry\":\"standard\",\"record_type\":\"terminology_artefact\",\"name\":\"FOODIE core ontology\",\"abbreviation\":\"FOODIE\",\"description\":\"The FOODIE project is focused on building an open and interoperable agricultural specialized platform on the cloud for the management, discovery and large-scale integration of data relevant for farming production. The FOODIE ontology is an INSPIRE-based vocabulary for the publication of Agricultural Linked Data. The ontology provides a semantic representation of the FOODIE core data model, which was specified in UML by extending and specializing the INSPIRE data model for Agricultural and Aquaculture Facilities (AF), which is in turn based on the ISO/OGC standards for geographical information.\",\"doi\":\"10.25504/FAIRsharing.tepvv5\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.tepvv5\",\"homepage\":\"http://foodie-cloud.github.io/model/FOODIE.html\",\"countries\":[\"Czech Republic\",\"Poland\",\"Spain\"],\"disciplines\":[\"Farming Systems Research\",\"Agriculture\"],\"domains\":[\"food\"],\"taxonomies\":[\"Plantae\"],\"user_defined_tags\":[],\"legacy_ids\":[\"bsg-001114\",\"bsg-s001114\"],\"created_at\":\"2018-01-18T15:41:07.000Z\",\"updated_at\":\"2023-01-27T20:30:05.298Z\"},{\"id\":\"4810\",\"registry\":\"standard\",\"record_type\":\"model_and_format\",\"name\":\"NIfTI extension for magnetic resonance spectroscopy\",\"abbreviation\":\"NIfTI-MRS\",\"description\":\"NIfTI-MRS is proposed as a standard spectroscopy data format, implemented as an extension to the Neuroimaging informatics technology initiative (NIfTI) format.\",\"doi\":\"10.25504/FAIRsharing.85d5e8\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.85d5e8\",\"homepage\":\"https://wtclarke.github.io/mrs_nifti_standard/\",\"countries\":[\"Canada\",\"Czech Republic\",\"United Kingdom\",\"United States\"],\"disciplines\":[\"Neurobiology\"],\"domains\":[\"Medical imaging\",\"neuroimaging measurement\"],\"taxonomies\":[\"Homo sapiens\"],\"user_defined_tags\":[],\"legacy_ids\":[],\"created_at\":\"2023-05-31T12:23:30.934Z\",\"updated_at\":\"2025-06-17T09:04:40.708Z\"},{\"id\":\"6542\",\"registry\":\"standard\",\"record_type\":\"model_and_format\",\"name\":\"Global Alliance for Genomics and Health Authorisation and Authentication Infrastructure Specification\",\"abbreviation\":\"GA4GH AAI\",\"description\":\"The GA4GH AAI Specification is used to help enable secure data sharing by communicating the permissions needed to conduct research. Developed by the GA4GH Data Security Work Stream in collaboration with the Data Use & Researcher Identities (DURI) Work Stream, the Authorisation and Authentication Infrastructure (AAI) specification can help automate the data access process by providing a mechanism to confirm a researcher’s digital identity and check their data access permissions. This specification defines a profile for using the OpenID Connect protocol [OIDC-Core] to provide federated multilateral authorization infrastructure for greater interoperability between biomedical institutions sharing restricted datasets.\",\"doi\":\"10.25504/FAIRsharing.6f1ef0\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.6f1ef0\",\"homepage\":\"https://www.ga4gh.org/product/aai/\",\"countries\":[\"Canada\",\"Czech Republic\",\"Finland\",\"Spain\",\"Switzerland\",\"United Kingdom\",\"United States\",\"European Union\"],\"disciplines\":[\"Health Science\"],\"domains\":[],\"taxonomies\":[\"Homo sapiens\"],\"user_defined_tags\":[],\"legacy_ids\":[],\"created_at\":\"2025-06-26T13:26:34.081Z\",\"updated_at\":\"2025-07-01T08:35:35.080Z\"},{\"id\":\"6543\",\"registry\":\"standard\",\"record_type\":\"model_and_format\",\"name\":\"Global Alliance for Genomics and Health Passports Specification\",\"abbreviation\":\"GA4GH Passports\",\"description\":\"The GA4GH Passports Specification is a standard to provide a researcher’s securely-encoded “Visas,” which in turn allow access to genomic datasets within GA4GH. To streamline the data access process and support data access committees (DACs), the GA4GH Data Use & Researcher Identities (DURI) Work Stream developed the Passports specification. Passports contain a researcher’s “Visas,” which unlock datasets they are authorised to access. The passports specification provides a data model for encoding information about the researcher, along with their acquired data access permissions, in a way that cannot be tampered with.\",\"doi\":\"10.25504/FAIRsharing.75a2eb\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.75a2eb\",\"homepage\":\"https://www.ga4gh.org/product/ga4gh-passports/\",\"countries\":[\"Australia\",\"Canada\",\"Czech Republic\",\"Finland\",\"Spain\",\"United Kingdom\",\"United States\",\"European Union\"],\"disciplines\":[\"Health Science\",\"Genomics\"],\"domains\":[],\"taxonomies\":[\"Homo sapiens\"],\"user_defined_tags\":[],\"legacy_ids\":[],\"created_at\":\"2025-06-26T13:53:02.471Z\",\"updated_at\":\"2025-07-01T08:36:03.839Z\"},{\"id\":\"146\",\"registry\":\"standard\",\"record_type\":\"terminology_artefact\",\"name\":\"Functional Therapeutic Chemical Classification System\",\"abbreviation\":\"FTC\",\"description\":\"The Functional Therapeutic Chemical Classification System (FTC) defines over 20,000 mechanisms and modes of action for approved drugs. The resource abstracts away from the traditional chemical structure-based approach and focuses solely on the mode of action of drugs. The classification sorts therapeutic agents based on their function in the human body. Please note that this resource is no longer actively maintained (source: https://github.com/loopasam/ftc/issues/1).\",\"doi\":\"10.25504/FAIRsharing.spjjv8\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.spjjv8\",\"homepage\":\"https://github.com/loopasam/ftc\",\"countries\":[\"Austria\",\"Belgium\",\"Croatia\",\"Czech Republic\",\"Denmark\",\"Finland\",\"France\",\"Germany\",\"Greece\",\"Hungary\",\"Iceland\",\"Ireland\",\"Israel\",\"Italy\",\"Lithuania\",\"Luxembourg\",\"Malta\",\"Montenegro\",\"Netherlands\",\"Norway\",\"Portugal\",\"Slovakia\",\"Spain\",\"Sweden\",\"Switzerland\",\"United Kingdom\"],\"disciplines\":[\"Drug Repositioning\"],\"domains\":[\"drug\",\"Classification\",\"Approved drug\"],\"taxonomies\":[\"All\"],\"user_defined_tags\":[],\"legacy_ids\":[\"bsg-000851\",\"bsg-s000851\"],\"created_at\":\"2017-10-24T08:41:28.000Z\",\"updated_at\":\"2025-03-25T11:01:52.120Z\"},{\"id\":\"458\",\"registry\":\"standard\",\"record_type\":\"model_and_format\",\"name\":\"PRIDE XML Format\",\"abbreviation\":\"PRIDE XML Format\",\"description\":\"XML submission format for the PRIDE repository at the EBI.\",\"doi\":\"10.25504/FAIRsharing.975659\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.975659\",\"homepage\":\"http://www.ebi.ac.uk/pride/help/archive/submission/pridexml\",\"countries\":[\"Austria\",\"Belgium\",\"Croatia\",\"Czech Republic\",\"Denmark\",\"Finland\",\"France\",\"Germany\",\"Greece\",\"Hungary\",\"Iceland\",\"Ireland\",\"Israel\",\"Italy\",\"Lithuania\",\"Luxembourg\",\"Malta\",\"Montenegro\",\"Netherlands\",\"Norway\",\"Portugal\",\"Slovakia\",\"Spain\",\"Sweden\",\"Switzerland\",\"United Kingdom\"],\"disciplines\":[\"Proteomics\"],\"domains\":[\"Mass spectrum\",\"protein expression profiling assay\"],\"taxonomies\":[\"All\"],\"user_defined_tags\":[],\"legacy_ids\":[\"bsg-000561\",\"bsg-s000561\"],\"created_at\":\"2014-11-04T15:23:40.000Z\",\"updated_at\":\"2024-11-13T11:39:14.412Z\"},{\"id\":\"681\",\"registry\":\"standard\",\"record_type\":\"terminology_artefact\",\"name\":\"Human Ancestry Ontology\",\"abbreviation\":\"HANCESTRO\",\"description\":\"The Human Ancestry Ontology (HANCESTRO) provides a systematic description of the ancestry concepts used in the NHGRI-EBI Catalog of published genome-wide association studies.\",\"doi\":\"10.25504/FAIRsharing.rja8qp\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.rja8qp\",\"homepage\":\"https://github.com/EBISPOT/hancestro\",\"countries\":[\"Austria\",\"Belgium\",\"Croatia\",\"Czech Republic\",\"Denmark\",\"Finland\",\"France\",\"Germany\",\"Greece\",\"Hungary\",\"Iceland\",\"Ireland\",\"Israel\",\"Italy\",\"Lithuania\",\"Luxembourg\",\"Malta\",\"Montenegro\",\"Netherlands\",\"Norway\",\"Portugal\",\"Slovakia\",\"Spain\",\"Sweden\",\"Switzerland\",\"United Kingdom\"],\"disciplines\":[\"Population Genetics\",\"Human Genetics\",\"Demographics\"],\"domains\":[\"genome-wide association study\"],\"taxonomies\":[\"Homo sapiens\"],\"user_defined_tags\":[],\"legacy_ids\":[\"bsg-000819\",\"bsg-s000819\"],\"created_at\":\"2017-10-24T08:41:27.000Z\",\"updated_at\":\"2025-07-23T09:21:44.338Z\"},{\"id\":\"735\",\"registry\":\"standard\",\"record_type\":\"model_and_format\",\"name\":\"EBI BioSamples JSON Format\",\"abbreviation\":null,\"description\":\"The EBI BioSamples JSON Format is a JSON schema used for submitting data to the EBI BioSamples database. This format can also be used to update or curate existing samples.\",\"doi\":\"10.25504/FAIRsharing.NYAjYd\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.NYAjYd\",\"homepage\":\"https://www.ebi.ac.uk/biosamples/docs/references/api/submit\",\"countries\":[\"Austria\",\"Belgium\",\"Croatia\",\"Czech Republic\",\"Denmark\",\"Finland\",\"France\",\"Germany\",\"Greece\",\"Hungary\",\"Iceland\",\"Ireland\",\"Israel\",\"Italy\",\"Lithuania\",\"Luxembourg\",\"Malta\",\"Montenegro\",\"Netherlands\",\"Norway\",\"Portugal\",\"Slovakia\",\"Spain\",\"Sweden\",\"Switzerland\",\"United Kingdom\"],\"disciplines\":[\"Biology\"],\"domains\":[\"Experimental measurement\",\"Sample annotation\",\"Biospecimen\"],\"taxonomies\":[\"All\"],\"user_defined_tags\":[],\"legacy_ids\":[\"bsg-001455\",\"bsg-s001455\"],\"created_at\":\"2020-03-09T10:19:37.000Z\",\"updated_at\":\"2024-06-06T10:29:32.100Z\"},{\"id\":\"1036\",\"registry\":\"standard\",\"record_type\":\"terminology_artefact\",\"name\":\"Chemical Entities of Biological Interest\",\"abbreviation\":\"ChEBI\",\"description\":\"Chemical Entities of Biological Interest (ChEBI) is a free dictionary that describes 'small’ chemical compounds. These compound includes distinct synthetic or natural atoms, molecules, ions, ion pair, radicals, radical ions, complexes, conformers, etc.. These molecular entities can interact with or affect the processes of living organisms.\",\"doi\":\"10.25504/FAIRsharing.62qk8w\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.62qk8w\",\"homepage\":\"http://www.ebi.ac.uk/chebi/\",\"countries\":[\"Austria\",\"Belgium\",\"Croatia\",\"Czech Republic\",\"Denmark\",\"Finland\",\"France\",\"Germany\",\"Greece\",\"Hungary\",\"Iceland\",\"Ireland\",\"Israel\",\"Italy\",\"Lithuania\",\"Luxembourg\",\"Malta\",\"Montenegro\",\"Netherlands\",\"Norway\",\"Portugal\",\"Slovakia\",\"Spain\",\"Sweden\",\"Switzerland\",\"United Kingdom\"],\"disciplines\":[\"Lipidomics\",\"Metabolomics\",\"Biochemistry\",\"Chemistry\",\"Proteomics\"],\"domains\":[\"Structure\",\"Taxonomic classification\",\"molecular entity\",\"small molecule\",\"Natural Product\"],\"taxonomies\":[\"All\"],\"user_defined_tags\":[],\"legacy_ids\":[\"bsg-000039\",\"bsg-s000039\"],\"created_at\":\"2014-11-04T15:23:40.000Z\",\"updated_at\":\"2025-07-11T09:36:33.543Z\"},{\"id\":\"1061\",\"registry\":\"standard\",\"record_type\":\"model_and_format\",\"name\":\"ENA Sequence XML Schema\",\"abbreviation\":\"ENA EMBL XSD\",\"description\":\"ENA Sequence XML Schema is a standardised XML schema for nucleotide sequences. All assembled and annotated sequences must conform to this schema.\",\"doi\":\"10.25504/FAIRsharing.9ed958\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.9ed958\",\"homepage\":\"https://ena-docs.readthedocs.io/en/latest/submit/general-guide/programmatic.html\",\"countries\":[\"Austria\",\"Belgium\",\"Croatia\",\"Czech Republic\",\"Denmark\",\"Finland\",\"France\",\"Germany\",\"Greece\",\"Hungary\",\"Iceland\",\"Ireland\",\"Israel\",\"Italy\",\"Lithuania\",\"Luxembourg\",\"Malta\",\"Montenegro\",\"Netherlands\",\"Norway\",\"Portugal\",\"Slovakia\",\"Spain\",\"Sweden\",\"Switzerland\",\"United Kingdom\"],\"disciplines\":[\"Transcriptomics\",\"Genetics\",\"Bioinformatics\",\"Genomics\"],\"domains\":[\"Nucleic acid sequence\",\"deoxyribonucleic acid\",\"nucleic acid\",\"genome\"],\"taxonomies\":[\"All\"],\"user_defined_tags\":[],\"legacy_ids\":[\"bsg-001452\",\"bsg-s001452\"],\"created_at\":\"2020-02-26T11:49:41.000Z\",\"updated_at\":\"2025-07-11T09:35:56.027Z\"},{\"id\":\"1280\",\"registry\":\"standard\",\"record_type\":\"model_and_format\",\"name\":\"Short Read Archive eXtensible Markup Language\",\"abbreviation\":\"SRA-XML\",\"description\":\"The SRA data model contains the following objects: Study: information about the sequencing project Sample: information about the sequenced samples Experiment: information about the libraries, platform; associated with study, sample(s) and run(s) Run: contains the raw data files Analysis: contains the analysis data files; associated with study, sample and run objects Submission: information about the submission actions include release date. It is used by The Sequence Read Archive (SRA) and the European Nucleotide Archive (ENA) to store raw sequencing data from the next generation of sequencing platforms including Roche 454 GS System, Illumina Genome Analyzer, Applied Biosystems SOLiD System, Helicos Heliscope, Complete Genomics, and Pacific Biosciences SMRT. Please note that the SRA-XML webpage states that \\\"This page has been deprecated and may be removed without further notice.\\\"\",\"doi\":\"10.25504/FAIRsharing.q72e3w\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.q72e3w\",\"homepage\":\"https://www.ebi.ac.uk/ena/submit/read-xml-format-1-5\",\"countries\":[\"Austria\",\"Belgium\",\"Croatia\",\"Czech Republic\",\"Denmark\",\"Finland\",\"France\",\"Germany\",\"Greece\",\"Hungary\",\"Iceland\",\"Ireland\",\"Israel\",\"Italy\",\"Lithuania\",\"Luxembourg\",\"Malta\",\"Montenegro\",\"Netherlands\",\"Norway\",\"Portugal\",\"Slovakia\",\"Spain\",\"Sweden\",\"Switzerland\",\"United Kingdom\"],\"disciplines\":[\"Life Science\",\"Functional Genomics\",\"Transcriptomics\"],\"domains\":[\"Nucleic acid sequence\",\"DNA sequence\",\"assay\",\"region\"],\"taxonomies\":[\"All\"],\"user_defined_tags\":[],\"legacy_ids\":[\"bsg-000084\",\"bsg-s000084\"],\"created_at\":\"2014-11-04T15:23:40.000Z\",\"updated_at\":\"2023-01-27T21:39:46.096Z\"},{\"id\":\"1478\",\"registry\":\"standard\",\"record_type\":\"model_and_format\",\"name\":\"ENA Sequence Flat File Format\",\"abbreviation\":null,\"description\":\"ENA Sequence Flat File Format is a standardised plain text format for nucleotide sequences. This format was previously called the EMBL Sequence Flat File Format.\",\"doi\":\"10.25504/FAIRsharing.q9nh66\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.q9nh66\",\"homepage\":\"https://ena-docs.readthedocs.io/en/latest/submit/fileprep/flat-file-example.html\",\"countries\":[\"Austria\",\"Belgium\",\"Croatia\",\"Czech Republic\",\"Denmark\",\"Finland\",\"France\",\"Germany\",\"Greece\",\"Hungary\",\"Iceland\",\"Ireland\",\"Israel\",\"Italy\",\"Lithuania\",\"Luxembourg\",\"Malta\",\"Montenegro\",\"Netherlands\",\"Norway\",\"Portugal\",\"Slovakia\",\"Spain\",\"Sweden\",\"Switzerland\",\"United Kingdom\"],\"disciplines\":[\"Genetics\",\"Bioinformatics\",\"Genomics\"],\"domains\":[\"Nucleic acid sequence\",\"deoxyribonucleic acid\",\"region\",\"genome\"],\"taxonomies\":[\"All\"],\"user_defined_tags\":[],\"legacy_ids\":[\"bsg-000226\",\"bsg-s000226\"],\"created_at\":\"2014-11-04T15:23:40.000Z\",\"updated_at\":\"2023-01-27T22:46:30.435Z\"},{\"id\":\"1498\",\"registry\":\"standard\",\"record_type\":\"terminology_artefact\",\"name\":\"Experimental Factor Ontology\",\"abbreviation\":\"EFO\",\"description\":\"The Experimental Factor Ontology (EFO) is an application focused ontology modelling the experimental variables in multiple resources at the EBI and the Centre for Therapeutic Target Validation. The ontology has been developed to increase the richness of the annotations that are currently made in resources and to promote consistent annotation, to facilitate automatic annotation and to integrate external data. The ontology pulls together classes from reference ontologies such as disease, cell line, cell type and anatomy and adds axiomatisation as necessary to connect areas such as disease to phenotype.\",\"doi\":\"10.25504/FAIRsharing.1gr4tz\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.1gr4tz\",\"homepage\":\"https://www.ebi.ac.uk/efo/\",\"countries\":[\"Austria\",\"Belgium\",\"Croatia\",\"Czech Republic\",\"Denmark\",\"Finland\",\"France\",\"Germany\",\"Greece\",\"Hungary\",\"Iceland\",\"Ireland\",\"Israel\",\"Italy\",\"Lithuania\",\"Luxembourg\",\"Malta\",\"Montenegro\",\"Netherlands\",\"Norway\",\"Portugal\",\"Slovakia\",\"Spain\",\"Sweden\",\"Switzerland\",\"United Kingdom\"],\"disciplines\":[\"Omics\",\"Proteomics\",\"Genomics\"],\"domains\":[\"Experimental measurement\",\"assay\",\"study design independent variable\",\"study design\",\"genome-wide association study\"],\"taxonomies\":[\"All\"],\"user_defined_tags\":[\"Experimental condition\"],\"legacy_ids\":[\"bsg-000082\",\"bsg-s000082\"],\"created_at\":\"2014-11-04T15:23:40.000Z\",\"updated_at\":\"2025-04-14T10:48:48.839Z\"},{\"id\":\"1351\",\"registry\":\"standard\",\"record_type\":\"reporting_guideline\",\"name\":\"Minimum Information about a Biosynthetic Gene cluster\",\"abbreviation\":\"MIBiG\",\"description\":\"The Minimum Information about a Biosynthetic Gene cluster (MIBiG) data standard was created to facilitate consistent and systematic deposition and retrieval of data on biosynthetic gene clusters. A wide variety of enzymatic pathways that produce specialized metabolites in bacteria, fungi and plants are known to be encoded in biosynthetic gene clusters. Information about these clusters, pathways and metabolites is currently dispersed throughout the literature, making it difficult to exploit.\",\"doi\":\"10.25504/FAIRsharing.jqfgxs\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.jqfgxs\",\"homepage\":\"https://mibig.secondarymetabolites.org\",\"countries\":[\"Australia\",\"Austria\",\"Belgium\",\"Canada\",\"China\",\"Czech Republic\",\"Denmark\",\"Finland\",\"France\",\"Germany\",\"Ireland\",\"Japan\",\"Mexico\",\"Netherlands\",\"New Zealand\",\"Norway\",\"Portugal\",\"Saudi Arabia\",\"Slovakia\",\"South Korea\",\"Spain\",\"Switzerland\",\"Ukraine\",\"United Kingdom\",\"United States\"],\"disciplines\":[\"Life Science\",\"Genomics\",\"Synthetic Biology\"],\"domains\":[\"Sequence cluster\",\"Gene functional annotation\",\"metabolite\",\"enzyme\",\"pathway\"],\"taxonomies\":[\"Bacteria\",\"Fungi\",\"Plantae\"],\"user_defined_tags\":[],\"legacy_ids\":[\"bsg-000641\",\"bsg-s000641\"],\"created_at\":\"2016-03-03T15:04:58.000Z\",\"updated_at\":\"2025-07-23T09:40:28.118Z\"},{\"id\":\"609\",\"registry\":\"standard\",\"record_type\":\"terminology_artefact\",\"name\":\"Systematized Nomenclature of Medicine-Clinical Terms\",\"abbreviation\":\"SNOMEDCT\",\"description\":\"The Systematized Nomenclature of Medicine Clinical Terms is a reference terminology that can be used to cross-map standardized healthcare languages across healthcare disciplines.\",\"doi\":\"10.25504/FAIRsharing.d88s6e\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.d88s6e\",\"homepage\":\"http://www.snomed.org/snomed-ct/five-step-briefing\",\"countries\":[\"Australia\",\"Belgium\",\"Brunei\",\"Canada\",\"Chile\",\"Czech Republic\",\"Denmark\",\"Estonia\",\"Hong Kong\",\"Iceland\",\"India\",\"Ireland\",\"Israel\",\"Lithuania\",\"Malaysia\",\"Malta\",\"Netherlands\",\"New Zealand\",\"Norway\",\"Poland\",\"Portugal\",\"Singapore\",\"Slovakia\",\"Slovenia\",\"Spain\",\"Sweden\",\"Switzerland\",\"United Kingdom\",\"United States\",\"Uruguay\"],\"disciplines\":[\"Preclinical Studies\",\"Biomedical Science\",\"Health Science\",\"Medicine\"],\"domains\":[],\"taxonomies\":[\"Homo sapiens\"],\"user_defined_tags\":[],\"legacy_ids\":[\"bsg-000098\",\"bsg-s000098\"],\"created_at\":\"2014-11-04T15:23:40.000Z\",\"updated_at\":\"2024-07-08T14:51:32.021Z\"},{\"id\":\"1200\",\"registry\":\"standard\",\"record_type\":\"reporting_guideline\",\"name\":\"MIRAGE reporting guidelines for capillary electrophoresis\",\"abbreviation\":\"MIRAGE CE guideline\",\"description\":\"These guidelines for glyco(proteo)mics analyzed by capillary electrophoresis (CE) aim for standardized and high quality reporting of experimental conditions in the scientific literature. The guidelines cover all aspects of a glyco(proteo)mics CE experiment including sample preparation, CE operation mode (CZE, CGE, CEC, MEKC, cIEF, cITP), instrument configuration, capillary separation conditions, detection, data analysis, and experimental descriptors.\",\"doi\":\"10.25504/FAIRsharing.65cb7e\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.65cb7e\",\"homepage\":\"https://www.beilstein-institut.de/en/projects/mirage/guidelines/#ce_analysis\",\"countries\":[\"Germany\",\"Netherlands\",\"Singapore\",\"United Kingdom\",\"United States\"],\"disciplines\":[\"Glycomics\",\"Proteomics\"],\"domains\":[\"Experimental measurement\",\"electrophoresis\"],\"taxonomies\":[\"All\"],\"user_defined_tags\":[],\"legacy_ids\":[\"bsg-001623\",\"bsg-s001623\"],\"created_at\":\"2021-07-12T14:21:21.000Z\",\"updated_at\":\"2024-06-06T10:34:43.413Z\"}],\"links\":{\"self\":null,\"first\":null,\"prev\":null,\"next\":null,\"last\":null},\"note\":\"Proxied for use in Data Stewardship Wizard (see https://ds-wizard.org for more)\"}","contentType":"application/json","responseType":"SuccessTypeHintResponse","status":200}}},"testVariables":{"changed":false},"variables":{"changed":false}},"createdAt":"2025-11-25T12:16:51Z","entityUuid":"f3520558-707e-415a-8878-c7b8d6ccc2fb","parentUuid":"6f6241d9-136c-4770-9d58-8a3f39607052","uuid":"a9e3b4a4-954e-42a1-b191-4c77c626857c"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2025-11-25T12:16:52Z","entityUuid":"f876a937-c295-4a12-9dfb-6ffc7395c8db","parentUuid":"8d1b07a7-f177-41f5-9532-05536223a8d6","uuid":"6b3227ee-11ac-42e2-9ff2-85a1c84638e1"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["fd4637a2-a117-460a-a7fa-c03760c42629","87bb2042-8e3c-4733-ba1e-84509d7b1cf4","3c7bdc90-8ed3-4b34-90ec-7945d14cc443"]},"text":{"changed":false},"title":{"changed":true,"value":"Are there qualified references to other data sets?"}},"createdAt":"2025-11-25T12:16:53Z","entityUuid":"f876a937-c295-4a12-9dfb-6ffc7395c8db","parentUuid":"8d1b07a7-f177-41f5-9532-05536223a8d6","uuid":"12bda9cf-b963-4486-84ad-c29f6a3f5e25"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2025-11-25T12:16:54Z","entityUuid":"a044bac2-d4ba-4978-9aa7-05a11d97e1fd","parentUuid":"f876a937-c295-4a12-9dfb-6ffc7395c8db","uuid":"2097398b-1711-46f3-a8ea-3364da2db71f"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"No"},"metricMeasures":{"changed":false}},"createdAt":"2025-11-25T12:16:55Z","entityUuid":"a044bac2-d4ba-4978-9aa7-05a11d97e1fd","parentUuid":"f876a937-c295-4a12-9dfb-6ffc7395c8db","uuid":"8aa20abf-9334-43bc-a94d-5cbb20d329d9"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2025-11-25T12:16:56Z","entityUuid":"3699b746-00ca-487f-a301-8c5356e6039d","parentUuid":"f876a937-c295-4a12-9dfb-6ffc7395c8db","uuid":"de4eaba8-aa74-46ed-9563-537e1c58269d"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Yes"},"metricMeasures":{"changed":false}},"createdAt":"2025-11-25T12:16:57Z","entityUuid":"3699b746-00ca-487f-a301-8c5356e6039d","parentUuid":"f876a937-c295-4a12-9dfb-6ffc7395c8db","uuid":"ca122801-9013-4777-8575-6ec46637c35d"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"A qualified reference is a cross-reference that explains its intent. For example, X is regulator of Y is a much more qualified reference than X is associated with Y, or X see also Y. The goal therefore is to create as many meaningful links as possible between (meta)data resources to enrich the contextual knowledge about the data."},"title":{"changed":false}},"createdAt":"2025-11-25T12:16:58Z","entityUuid":"f876a937-c295-4a12-9dfb-6ffc7395c8db","parentUuid":"8d1b07a7-f177-41f5-9532-05536223a8d6","uuid":"159149f6-6b5b-4a48-b6c4-0a09fc7d30e8"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Please list any references to other data sets, e.g. from your project or from earlier research. "},"title":{"changed":false}},"createdAt":"2025-11-25T12:16:59Z","entityUuid":"7828d3a0-29bf-450e-aee9-473457a225fd","parentUuid":"8d1b07a7-f177-41f5-9532-05536223a8d6","uuid":"e267f828-4131-424b-b77d-ef20821f2b9b"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2025-11-25T12:17:00Z","entityUuid":"9ffd693f-25a8-454c-9ffe-fe629ec3ca2c","parentUuid":"f876a937-c295-4a12-9dfb-6ffc7395c8db","uuid":"98164f90-4b7a-4745-92d3-c63959fdde5a"},{"content":{"eventType":"MoveReferenceEvent","targetUuid":"f876a937-c295-4a12-9dfb-6ffc7395c8db"},"createdAt":"2025-11-25T12:17:01Z","entityUuid":"c57507b2-9581-465d-ba9a-7dcd8cfab8c0","parentUuid":"7828d3a0-29bf-450e-aee9-473457a225fd","uuid":"8ed6c122-fb73-4b71-85fc-06677a01cb10"},{"content":{"eventType":"DeleteReferenceEvent"},"createdAt":"2025-11-25T12:17:02Z","entityUuid":"9ffd693f-25a8-454c-9ffe-fe629ec3ca2c","parentUuid":"f876a937-c295-4a1