e,"value":"Will you need terminologies in life sciences?"}},"createdAt":"2022-04-12T10:02:13Z","entityUuid":"884585e3-85f7-4620-bf1e-5f302f9599b8","parentUuid":"a60a6eda-f41f-457a-8911-1a1c5afab9ab","uuid":"e3419573-d261-41ec-93fb-8e3035f70f61"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-04-12T10:02:18Z","entityUuid":"2502fad7-612f-448f-9243-3618ecaa6552","parentUuid":"884585e3-85f7-4620-bf1e-5f302f9599b8","uuid":"7cc9eb4b-ccba-4ad7-ab24-4aa5ebcb399b"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"No"},"metricMeasures":{"changed":false}},"createdAt":"2022-04-12T10:02:19Z","entityUuid":"2502fad7-612f-448f-9243-3618ecaa6552","parentUuid":"884585e3-85f7-4620-bf1e-5f302f9599b8","uuid":"4003f22e-d7b1-4b50-bf75-8751cda5b785"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-04-12T10:02:25Z","entityUuid":"72fa7784-6b46-45a1-8b06-53b325388376","parentUuid":"884585e3-85f7-4620-bf1e-5f302f9599b8","uuid":"d4d4dadb-97b7-4f79-8d62-c739d51ab255"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Yes"},"metricMeasures":{"changed":false}},"createdAt":"2022-04-12T10:02:27Z","entityUuid":"72fa7784-6b46-45a1-8b06-53b325388376","parentUuid":"884585e3-85f7-4620-bf1e-5f302f9599b8","uuid":"a331f000-d838-4fbd-820d-0269cc5fa214"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2022-04-12T10:02:33Z","entityUuid":"49b3ad26-d127-40ae-ab8d-fd256110c23d","parentUuid":"72fa7784-6b46-45a1-8b06-53b325388376","uuid":"14054227-efbe-4943-8209-4e49573b76e5"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Will you need terminologies in toxicology research?"}},"createdAt":"2022-04-12T10:02:45Z","entityUuid":"49b3ad26-d127-40ae-ab8d-fd256110c23d","parentUuid":"72fa7784-6b46-45a1-8b06-53b325388376","uuid":"e1c2fbef-5b08-4b06-830c-17840f838006"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-04-12T10:03:22Z","entityUuid":"f213a96d-43d7-40f3-8caa-1a7b35d4542f","parentUuid":"49b3ad26-d127-40ae-ab8d-fd256110c23d","uuid":"5753bc5d-4567-403e-9d8a-92ddb3712b94"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"No"},"metricMeasures":{"changed":false}},"createdAt":"2022-04-12T10:03:24Z","entityUuid":"f213a96d-43d7-40f3-8caa-1a7b35d4542f","parentUuid":"49b3ad26-d127-40ae-ab8d-fd256110c23d","uuid":"18a5b59e-f383-4666-a0f0-0f492ad07889"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-04-12T10:03:28Z","entityUuid":"e67d2a0d-6119-4c18-b033-d3eaa2106639","parentUuid":"49b3ad26-d127-40ae-ab8d-fd256110c23d","uuid":"5a0adfef-a98b-408e-9ea6-1815075f63c2"},{"content":{"advice":{"changed":true,"value":"You can find information on terminologies for human assays in the [Toxicology page of RDMkit](https://rdmkit.elixir-europe.org/toxicology_data#data-from-human-assays---existing-data-and-vocabularies)\n\nYou can find information on terminologies for animal assays in the [Toxicology page of RDMkit](https://rdmkit.elixir-europe.org/toxicology_data#data-from-animal-assays---existing-data-and-vocabularies)"},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Yes"},"metricMeasures":{"changed":false}},"createdAt":"2022-04-12T10:06:09Z","entityUuid":"e67d2a0d-6119-4c18-b033-d3eaa2106639","parentUuid":"49b3ad26-d127-40ae-ab8d-fd256110c23d","uuid":"aa18dd7c-ce00-4211-9898-fd74a03bbe0b"},{"content":{"annotations":{"changed":false},"eventType":"EditChapterEvent","questionUuids":{"changed":true,"value":["726e4a24-6d81-440b-8a70-5d36fa65c3a9","efc80cc8-8318-4f8c-acb7-dc1c60e491c1"]},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2022-04-12T10:06:41Z","entityUuid":"82fd0cce-2b41-423f-92ad-636d0872045c","parentUuid":"6f6241d9-136c-4770-9d58-8a3f39607052","uuid":"f9144da6-aefc-42eb-baed-02534ce6e951"},{"content":{"advice":{"changed":true,"value":"There are many kinds of metadata, each serving their own purpose.  Some key metadata that you should consider:\n* There is metadata that helps identify where the data is coming from (e.g. who created it, title). For this the [Dublin Core](https://www.dublincore.org) is often used.\n* There are different ways of adding metadata to make the data \"discoverable\" for other researchers. This requires either keywords or ontology terms describing what is in the data.\n* There is metadata describing how the data can be re-used, such as license information and, for data about people, the extent of their consent for data reuse.\n* There is metadata that makes the data understandable, e.g. linking to the exact processes used to collect them (is a *body temperature* measured under the tongue or in the rectum?) and units (is a temperature given in Celsius or Fahrenheit?). \n* There is metadata describing where the data comes from and what it is useful for. For frequently used data types, there are often very well defined metadata standards, in other cases you may need to think about this yourself.\nFor each of these kinds of metadata there are specific standards. There is no single standard that will get you all the metadata needed to make the data as FAIR as possible.\n"},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":false},"metricMeasures":{"changed":false}},"createdAt":"2022-05-13T11:26:37Z","entityUuid":"6d18bfff-0f53-469b-934e-9806dda9d4fb","parentUuid":"8c962e6f-17ee-4b22-8ebb-9f06f779e3b3","uuid":"7e969af5-44ec-414a-a78a-733bf85e187a"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Yes"},"metricMeasures":{"changed":false}},"createdAt":"2022-05-13T11:44:38Z","entityUuid":"8608d3df-7d7f-4893-8f80-e5297167b213","parentUuid":"02b3fed1-0b50-4a80-b8b6-a225a1107022","uuid":"c609083d-0672-4e0c-8701-b29146ab3930"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-05-13T11:44:42Z","entityUuid":"033e0538-5322-49c8-b537-9375eb86fd90","parentUuid":"02b3fed1-0b50-4a80-b8b6-a225a1107022","uuid":"7222eb15-755b-4280-95c5-72d83996c60a"},{"content":{"advice":{"changed":true,"value":"If you are working with multiple people on a complex project, it could be causing problems if changes are made to e.g. sample identifiers half-way the project. If there is no central information keeping, not everyone may be aware of important changes, and updates of partially run workflows could be forgotten."},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"No"},"metricMeasures":{"changed":false}},"createdAt":"2022-05-13T11:46:47Z","entityUuid":"033e0538-5322-49c8-b537-9375eb86fd90","parentUuid":"02b3fed1-0b50-4a80-b8b6-a225a1107022","uuid":"ab00f909-d4b3-4b88-992c-11e77b69a213"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":true,"value":["033e0538-5322-49c8-b537-9375eb86fd90","8608d3df-7d7f-4893-8f80-e5297167b213"]},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2022-05-13T11:47:06Z","entityUuid":"02b3fed1-0b50-4a80-b8b6-a225a1107022","parentUuid":"b1df3c74-0b1f-4574-81c4-4cc2d780c1af","uuid":"9d64b9a9-1c96-4b33-94a1-98530ca299f2"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2022-05-13T11:52:36Z","entityUuid":"6f2248f2-a65a-4ee8-9e87-0b7b6027c139","parentUuid":"b1df3c74-0b1f-4574-81c4-4cc2d780c1af","uuid":"1047b091-94f8-45a9-8945-c4d9cc7ceafd"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Does your project involve large and complex data?"}},"createdAt":"2022-05-13T11:52:56Z","entityUuid":"6f2248f2-a65a-4ee8-9e87-0b7b6027c139","parentUuid":"b1df3c74-0b1f-4574-81c4-4cc2d780c1af","uuid":"f53c6c77-f829-4e3c-bb6f-60fa088239a4"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-05-13T11:53:31Z","entityUuid":"8056699a-a88e-4edd-b1a7-a11e48570a00","parentUuid":"6f2248f2-a65a-4ee8-9e87-0b7b6027c139","uuid":"b558f1bf-64fc-4250-b63e-0c18f7ac1ee7"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"No"},"metricMeasures":{"changed":false}},"createdAt":"2022-05-13T11:53:34Z","entityUuid":"8056699a-a88e-4edd-b1a7-a11e48570a00","parentUuid":"6f2248f2-a65a-4ee8-9e87-0b7b6027c139","uuid":"bbab671c-5224-4296-9e1e-c775fcfd2896"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-05-13T11:53:38Z","entityUuid":"e239965e-5423-4bb7-b7b6-c7d36380f2f7","parentUuid":"6f2248f2-a65a-4ee8-9e87-0b7b6027c139","uuid":"1a44b97b-7311-4b82-abe8-06e23ef63297"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Yes"},"metricMeasures":{"changed":false}},"createdAt":"2022-05-13T11:53:42Z","entityUuid":"e239965e-5423-4bb7-b7b6-c7d36380f2f7","parentUuid":"6f2248f2-a65a-4ee8-9e87-0b7b6027c139","uuid":"2d3c7c00-9d25-496f-919f-00ee4f798af3"},{"content":{"eventType":"DeleteQuestionEvent"},"createdAt":"2022-05-13T11:55:15Z","entityUuid":"6f2248f2-a65a-4ee8-9e87-0b7b6027c139","parentUuid":"b1df3c74-0b1f-4574-81c4-4cc2d780c1af","uuid":"9cadf04d-7206-4e55-b4ea-659a6406b63e"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Working with large amounts of heterogenous data in a larger research group can have implications for the data integrity. How do you make sure every step of the workflow is done with the right version of the data? How do you handle the situation when a mistake is uncovered? Will you be able to redo the strict minimum data handling?"},"title":{"changed":true,"value":"Will you monitor data integrity once it has been collected?"}},"createdAt":"2022-05-13T11:57:19Z","entityUuid":"02b3fed1-0b50-4a80-b8b6-a225a1107022","parentUuid":"b1df3c74-0b1f-4574-81c4-4cc2d780c1af","uuid":"24965874-95ea-41ba-aca3-bbca3eb38b37"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Did you make appointments in the project on ?"}},"createdAt":"2022-05-13T12:10:59Z","entityUuid":"d4fe0b55-4aee-4d05-88d4-a3f4cad2cfa9","parentUuid":"c05f27a2-30ac-44fd-9ac9-cd6f62b16d0c","uuid":"bd145675-6ed5-498c-adfa-e50de61f29fb"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"How do you name files in the project?"},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2022-05-13T12:11:46Z","entityUuid":"9ff389f0-2236-48cf-880c-040ea1bb0d2f","parentUuid":"8b13234e-879b-4221-be12-4df24e6de00e","uuid":"c137f373-5a31-4885-b716-78fe533b6e2b"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-05-13T12:14:04Z","entityUuid":"68dc8368-d1fd-4bd5-8677-abc9ac7aa4b4","parentUuid":"948b5fd8-c1bd-457d-8f81-ea2fd093f541","uuid":"b3b19f3f-69ff-4d71-a617-1bc47cd2ed73"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Our computing workflow system keeps provenance information "},"metricMeasures":{"changed":false}},"createdAt":"2022-05-13T12:14:30Z","entityUuid":"68dc8368-d1fd-4bd5-8677-abc9ac7aa4b4","parentUuid":"948b5fd8-c1bd-457d-8f81-ea2fd093f541","uuid":"49843325-ff74-40c7-b582-2f662598be9b"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":true,"value":["7b450ee7-8783-4adc-9955-fd667fac5a56","a1e67aee-77dd-486f-ab51-e5a6f39a32cc","68dc8368-d1fd-4bd5-8677-abc9ac7aa4b4","ccdb5296-919c-44ac-89df-351fd2e564ae"]},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Data analysis is normally done step-by-step.  It is important that for all data the origin and all processing and filtering steps are documented, otherwise results will not be reproducible. \n\nRe-users of the data also need this information to decide whether the data can be used for their purpose.\n\nIn computing, systems like Galaxy and (Jupyter) notebooks often automatically keep provenance information."},"title":{"changed":false}},"createdAt":"2022-05-13T12:16:31Z","entityUuid":"948b5fd8-c1bd-457d-8f81-ea2fd093f541","parentUuid":"6d18bfff-0f53-469b-934e-9806dda9d4fb","uuid":"7b063a3a-31ab-4364-83d6-f56022f92ce5"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Some \"file\" storage systems do not have a tree structure like we know in a file system, but rather have direct pointers to any file in the system. Such systems are called \"object stores\" or \"document stores\". Examples are Amazon S3 and CEPH, or MongoDB."},"title":{"changed":true,"value":"Will you be storing data in an \"object store\" or a \"document store\" system?"}},"createdAt":"2022-05-13T12:25:07Z","entityUuid":"dc39957e-688a-4f71-a6a8-57f52509e7cf","parentUuid":"f7f2ff16-eee0-42a7-a89a-bd7291cef5fc","uuid":"2952abc0-e696-4f33-88fd-4316f2e58b0b"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Will you use a database system to store project data?"}},"createdAt":"2022-05-13T12:26:40Z","entityUuid":"4539a575-6bdd-4077-a2fd-71b8121e2e06","parentUuid":"f7f2ff16-eee0-42a7-a89a-bd7291cef5fc","uuid":"dfebee37-9c95-4354-bcfc-f383a3010118"},{"content":{"eventType":"DeleteQuestionEvent"},"createdAt":"2022-05-13T12:27:47Z","entityUuid":"d35a8f6d-c60a-4a9b-8645-67901f5bac9d","parentUuid":"f7f2ff16-eee0-42a7-a89a-bd7291cef5fc","uuid":"e1c49c64-9137-4e34-a2b4-21383fb15087"},{"content":{"eventType":"DeleteQuestionEvent"},"createdAt":"2022-05-13T12:27:57Z","entityUuid":"6332d026-3709-421b-ae63-4517dd6bef28","parentUuid":"f7f2ff16-eee0-42a7-a89a-bd7291cef5fc","uuid":"66bafefe-c350-4bd7-a64c-b4b4040743e5"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-05-13T12:37:05Z","entityUuid":"640d232f-69bc-4d4e-89ef-2d94db27f65f","parentUuid":"5c22cf59-89e3-43a1-af10-1af43a97bcb2","uuid":"2756a4b5-8b7f-412f-8023-ebc8be5411d1"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":true,"value":["b93a037a-006a-486f-87e0-6bef5c28879b","48062bc9-0ffb-4509-bec6-e90641a30569","c353f027-823b-4242-9149-37dca26cf4bc","7a1d3b28-5f85-48b8-b052-2448c276d9fc","640d232f-69bc-4d4e-89ef-2d94db27f65f","97236701-7b62-40f8-99a0-3b18d3fe3658"]},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2022-05-13T12:38:56Z","entityUuid":"5c22cf59-89e3-43a1-af10-1af43a97bcb2","parentUuid":"cf727a0a-78c4-45a7-aa9b-cf7650ae873a","uuid":"98772979-ee78-4392-bbfd-fc178f1f1c3b"},{"content":{"advice":{"changed":true,"value":"Please consider how you, one or your colleagues, or a researcher from another lab who has read your publication will be able to find your data, reproduce results and/or continue research on your data. A persistent identifier (following the FAIR principles) is essential for that."},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"We do not assign persistent identifiers to this data"},"metricMeasures":{"changed":true,"value":[{"measure":0,"metricUuid":"8db30660-d4e5-4c0a-bf3e-553f3f0f997a","weight":1}]}},"createdAt":"2022-05-13T12:40:12Z","entityUuid":"640d232f-69bc-4d4e-89ef-2d94db27f65f","parentUuid":"5c22cf59-89e3-43a1-af10-1af43a97bcb2","uuid":"c04c9334-ec11-4e5c-bcca-2043b5963f2e"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2022-06-14T13:26:39Z","entityUuid":"a0d52f2d-6828-42b0-a1f1-cda4ed7dad3b","parentUuid":"ae82cfc8-6b5f-4f06-a969-d430db181ac5","uuid":"04f4f5fd-9b2f-451a-b351-ef6c426b248e"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":true,"value":"1796fa3c-9f53-475f-89ff-c66a0453c42e"},"tagUuids":{"changed":false},"text":{"changed":true,"value":"If you need to perform many similar calculations of different input data (e.g. samples or simulations), these can often be executed at the same time on different nodes in a compute system. This is sometimes called \"trivial parallelism\". Even though it is named \"trivial\", this still requires that the work flow and workflow system support this (e.g. by making sure all file names are unique, and that not many threads are trying to read or write the same file at the same time). \n"},"title":{"changed":true,"value":"Can your work flow and work flow system make use of \"trivial\" parallelism in the computations?"}},"createdAt":"2022-06-14T13:30:40Z","entityUuid":"a0d52f2d-6828-42b0-a1f1-cda4ed7dad3b","parentUuid":"ae82cfc8-6b5f-4f06-a969-d430db181ac5","uuid":"973dc46a-c8d7-4db5-bc61-3374cacdcbef"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-06-14T13:30:51Z","entityUuid":"23967ba0-d1ba-4d78-b46b-c0237a856cda","parentUuid":"a0d52f2d-6828-42b0-a1f1-cda4ed7dad3b","uuid":"65ce8a93-05cc-43c5-bb0e-2152dd47e6f9"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"No"},"metricMeasures":{"changed":false}},"createdAt":"2022-06-14T13:30:53Z","entityUuid":"23967ba0-d1ba-4d78-b46b-c0237a856cda","parentUuid":"a0d52f2d-6828-42b0-a1f1-cda4ed7dad3b","uuid":"03d02dde-ae92-4ee0-9d9f-edd68689dd6b"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-06-14T13:30:57Z","entityUuid":"1e2dd80b-a5c4-4c6b-ae16-7d25588e3db9","parentUuid":"a0d52f2d-6828-42b0-a1f1-cda4ed7dad3b","uuid":"c3537d54-a12a-420b-8251-f01e0001f236"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Yes"},"metricMeasures":{"changed":false}},"createdAt":"2022-06-14T13:31:00Z","entityUuid":"1e2dd80b-a5c4-4c6b-ae16-7d25588e3db9","parentUuid":"a0d52f2d-6828-42b0-a1f1-cda4ed7dad3b","uuid":"36594178-d2c9-4fcc-96ea-ce158d4dca86"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":true,"value":["30027b9a-2077-4c74-9048-f0532ada9b03","dd918787-ffb1-499e-98f8-42050758c7ce","851a72ac-9497-4d8a-ae1a-6509d021a20b","d8150021-19d7-4e92-90c3-d9c3d62d188e","4c71d62c-3184-43d7-bdec-f762c682035e","a0d52f2d-6828-42b0-a1f1-cda4ed7dad3b","410f3709-c283-4974-83c8-6c5d24899a68"]},"label":{"changed":false},"metricMeasures":{"changed":false}},"createdAt":"2022-06-14T13:31:09Z","entityUuid":"ae82cfc8-6b5f-4f06-a969-d430db181ac5","parentUuid":"e87ef779-2c4b-4c0d-a1f1-821290123a3c","uuid":"50a48aa1-3724-4ad2-9165-bf3cb75f693b"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2022-06-14T13:35:44Z","entityUuid":"b6d0922c-6e9c-45f8-b687-79310744601a","parentUuid":"f7f2ff16-eee0-42a7-a89a-bd7291cef5fc","uuid":"5282c6a4-71ce-4f7b-90e2-71ca5e38f744"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"What part of the data will have the largest volume?"}},"createdAt":"2022-06-14T13:36:35Z","entityUuid":"b6d0922c-6e9c-45f8-b687-79310744601a","parentUuid":"f7f2ff16-eee0-42a7-a89a-bd7291cef5fc","uuid":"3d38698f-8fbb-406a-8910-85ea511073ab"},{"content":{"eventType":"MoveQuestionEvent","targetUuid":"ec502175-376d-4bf3-a055-c4f7d7639103"},"createdAt":"2022-06-14T13:36:55Z","entityUuid":"b6d0922c-6e9c-45f8-b687-79310744601a","parentUuid":"f7f2ff16-eee0-42a7-a89a-bd7291cef5fc","uuid":"e1b38b0e-ea3f-4db6-84f1-dbe3f4c4db75"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-06-14T13:37:09Z","entityUuid":"044ef740-c26d-434c-88a9-9a25ef4c719a","parentUuid":"b6d0922c-6e9c-45f8-b687-79310744601a","uuid":"e298679c-9714-4d09-a91b-c3575897b84a"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-06-14T13:37:19Z","entityUuid":"70442fd3-bea2-4e97-81f5-e9b33eec6cac","parentUuid":"b6d0922c-6e9c-45f8-b687-79310744601a","uuid":"3472ae88-61ad-493c-8861-e30a219ecd33"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-06-14T13:37:33Z","entityUuid":"379327e3-485d-4121-a9ec-d790ae6f5bcf","parentUuid":"b6d0922c-6e9c-45f8-b687-79310744601a","uuid":"d8b8583a-db03-40c2-9513-a89cef10743b"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Output data"},"metricMeasures":{"changed":false}},"createdAt":"2022-06-14T13:37:38Z","entityUuid":"379327e3-485d-4121-a9ec-d790ae6f5bcf","parentUuid":"b6d0922c-6e9c-45f8-b687-79310744601a","uuid":"24effeb1-812c-41ed-8802-1d1fbed3e2e1"},{"content":{"advice":{"changed":true,"value":"Note that if the raw data is from a public resource, you may be able to avoid storing it altogether and processing it immediately from the public resource. If you have to download it before using, you can store it on a volume that is not backed up, because you can simply reproduce it.\n\nIf you have a large volume of newly collected raw input data, publishing it as soon as possible into a public resource may reduce the pressure on the storage requirements."},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Raw/Input Data"},"metricMeasures":{"changed":false}},"createdAt":"2022-06-14T13:40:39Z","entityUuid":"044ef740-c26d-434c-88a9-9a25ef4c719a","parentUuid":"b6d0922c-6e9c-45f8-b687-79310744601a","uuid":"c50cc00b-e6d9-4d86-8fa3-f309b61a9323"},{"content":{"advice":{"changed":true,"value":"If the intermediate data is larger than either input or output data, you may consider minimizing the time it is stored. Make the balance between the CPU time needed if you need to re-calculate it versus the storage requirements. Sometimes it is possible to avoid storage at all by immediately running the whole analysis work flow.\n\nIt may also be useful to consider storing the intermediate data on a separate data volume from the rest of the project storage, which may not be backed up. This can not only reduce the storage costs, but also if the backup needs to be used it is better if it strictly contains the data that is needed for a restore, otherwise a restore i case of a problem may take much longer than strictly necessary."},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Intermediate data"},"metricMeasures":{"changed":false}},"createdAt":"2022-06-14T13:44:32Z","entityUuid":"70442fd3-bea2-4e97-81f5-e9b33eec6cac","parentUuid":"b6d0922c-6e9c-45f8-b687-79310744601a","uuid":"e4dcf388-77a3-4972-94a9-136ce6eedc5b"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-06-14T13:44:57Z","entityUuid":"eaedc13a-242b-417d-b084-5ef152c352ab","parentUuid":"b6d0922c-6e9c-45f8-b687-79310744601a","uuid":"8bc7c1dd-341b-4b99-9895-a817e1456fe0"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"There is no significant difference."},"metricMeasures":{"changed":false}},"createdAt":"2022-06-14T13:45:17Z","entityUuid":"eaedc13a-242b-417d-b084-5ef152c352ab","parentUuid":"b6d0922c-6e9c-45f8-b687-79310744601a","uuid":"5fc0601e-1b34-4190-9200-50190b4ea5a9"},{"content":{"advice":{"changed":true,"value":"There are pointers to resources in life sciences at:\n* [ELIXIR Data resources](https://elixir-europe.org/services/tag/data-resources)\n* "},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":false},"metricMeasures":{"changed":false}},"createdAt":"2022-06-15T13:51:06Z","entityUuid":"929cbf88-d270-493f-b821-2b62247ba159","parentUuid":"2130427b-2e5e-4282-b703-ee00f1f735c9","uuid":"8fa7f94c-44ce-48d5-8621-2b43cf4c926c"},{"content":{"advice":{"changed":true,"value":"There are data set search engines that can help you find diverse data on the web, such as:\n* [Google Dataset Search](https://datasetsearch.research.google.com/)\n* [OpenAIRE](https://explore.openaire.eu/search/find/research-outcomes?type=%22datasets%22)\n* [FAIRsharing](https://fairsharing.org/search?fairsharingRegistry=Database)\n\nAlso, many governments run their own \"government data portals\".\n"},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":false},"metricMeasures":{"changed":false}},"createdAt":"2022-06-15T13:51:52Z","entityUuid":"07f599c3-592c-479b-906c-36478ae792b9","parentUuid":"726e4a24-6d81-440b-8a70-5d36fa65c3a9","uuid":"49fa75ec-811b-4a51-8a7d-4b9996b419e8"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2022-06-15T13:54:23Z","entityUuid":"bc7538cd-2b28-446a-a448-2b316c4f36a2","parentUuid":"ea62d905-0751-49ac-b74e-3600280f867d","uuid":"b22abd99-1825-4b68-941b-6e511a429bc6"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2022-06-15T13:54:23Z","entityUuid":"bc7538cd-2b28-446a-a448-2b316c4f36a2","parentUuid":"ea62d905-0751-49ac-b74e-3600280f867d","uuid":"6a74a90d-ae0f-48bf-8fe8-631075f5e741"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Will you need existing data in particle physics?"}},"createdAt":"2022-06