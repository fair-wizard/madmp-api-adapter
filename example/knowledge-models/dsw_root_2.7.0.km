ent":{"eventType":"MoveQuestionEvent","targetUuid":"c3914e43-cca1-4180-8960-228b7022bae6"},"createdAt":"2022-02-28T14:50:21Z","entityUuid":"6cc96576-2535-46b3-8c9b-a12703ee96cc","parentUuid":"d8ecede2-f952-4b08-8a68-20d97849733f","uuid":"0530c006-4cb3-49d8-961f-80b571698746"},{"content":{"eventType":"MoveQuestionEvent","targetUuid":"d8ecede2-f952-4b08-8a68-20d97849733f"},"createdAt":"2022-02-28T14:50:22Z","entityUuid":"c7496ece-4535-4f5d-bcf7-7845989906e9","parentUuid":"7dd7320e-41dd-43b9-b6aa-7622eaa34679","uuid":"c158aa4e-f5c4-42cd-8049-e35a519959d8"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"RDMkit on Data Protection"},"referenceType":"URLReference","url":{"changed":true,"value":"https://rdmkit.elixir-europe.org/data_protection.html"}},"createdAt":"2022-02-28T14:50:23Z","entityUuid":"bcb58c41-7df6-427d-8931-01dc1b0a9316","parentUuid":"6cc96576-2535-46b3-8c9b-a12703ee96cc","uuid":"b39f4c44-4dd7-488b-8a73-6fb5f6d95f99"},{"content":{"eventType":"MoveQuestionEvent","targetUuid":"d8ecede2-f952-4b08-8a68-20d97849733f"},"createdAt":"2022-02-28T14:50:24Z","entityUuid":"04a592b7-6db6-422d-9fa6-15e94077c2e3","parentUuid":"7dd7320e-41dd-43b9-b6aa-7622eaa34679","uuid":"3b99a1d4-fdf1-4d71-9509-0a6355a8c0c9"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"[Article 6](https://gdpr-info.eu/art-6-gdpr/) (1) lists under what conditions the processing is considered lawful. Of these, **Consent** or **Public** interest are relevant when it comes to research. You should determine what legal basis (or bases) you have for processing the personal data in your project. \n\nTraditionally, *consent* has been the basis for processing personal data for research, but under the GDPR there cannot be an imbalance between the processor and the data subject for it to be considered to be freely given. In some countries the use of *consent* as the legal basis for processing by universities for research purposes is therefore not recommended. In those cases, public interest should probably be your legal basis. Note that if your legal basis for processing is consent, [a number of requirements](https://gdpr-info.eu/issues/consent/) exists for the consent to be considered valid under the GDPR. Consents given before the GDPR might not live up to this. \n\nAlso note that even if *public interest* is the legal basis, other laws and research ethics standards might still require you to have consent from the subjects for performing the research.\n\nPlease consult with the Data Protection Officer of your organisation on which legal basis to apply to your data."},"title":{"changed":false}},"createdAt":"2022-02-28T14:50:25Z","entityUuid":"b7997cb8-4e3f-4df2-9996-4e581c7610fb","parentUuid":"7dd7320e-41dd-43b9-b6aa-7622eaa34679","uuid":"8c706f9b-bd05-4178-9c39-19ce78d72fcb"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"[Article 6](https://gdpr-info.eu/art-6-gdpr/) (1) lists under what conditions the processing is considered lawful. Of these, **Consent** or **Public** interest are relevant when it comes to research. You should determine what legal basis (or bases) you have for processing the personal data in your project. \n\nTraditionally, *consent* has been the basis for processing personal data for research, but under the GDPR there cannot be an imbalance between the processor and the data subject for it to be considered to be freely given. In some countries the use of *consent* as the legal basis for processing by universities for research purposes is therefore not recommended. In those cases, public interest should probably be your legal basis. Note that if your legal basis for processing is consent, [a number of requirements](https://gdpr-info.eu/issues/consent/) exists for the consent to be considered valid under the GDPR. Consents given before the GDPR might not live up to this. \n\nAlso note that even if *public interest* is the legal basis, other laws and research ethics standards might still require you to have consent from the subjects for performing the research.\n\nPlease consult with the Data Protection Officer of your organisation on which legal basis to apply to your data.\n"},"title":{"changed":false}},"createdAt":"2022-02-28T14:50:26Z","entityUuid":"be4651c9-9a8c-4e10-a158-61b94ca0e139","parentUuid":"d8ecede2-f952-4b08-8a68-20d97849733f","uuid":"f7f0d392-2283-4315-9d2e-7c3e1a7c182a"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-02-28T14:50:27Z","entityUuid":"2a84c15c-f5ca-4471-b1fe-10f3d1231f24","parentUuid":"be4651c9-9a8c-4e10-a158-61b94ca0e139","uuid":"997d7989-9988-40e6-b320-d01f4d832e22"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2022-02-28T14:50:28Z","entityUuid":"f150278f-6f5c-4fa0-8b37-f2e6134b9e12","parentUuid":"2a84c15c-f5ca-4471-b1fe-10f3d1231f24","uuid":"38b57d5f-6f71-41ba-8fd7-4aa0bc94abbc"},{"content":{"eventType":"DeleteQuestionEvent"},"createdAt":"2022-02-28T14:50:29Z","entityUuid":"f150278f-6f5c-4fa0-8b37-f2e6134b9e12","parentUuid":"2a84c15c-f5ca-4471-b1fe-10f3d1231f24","uuid":"b0fa1f4f-b0b7-42f7-9127-722ef49b5e12"},{"content":{"advice":{"changed":true,"value":"These are less likely"},"annotations":{"changed":true,"value":[{"key":"","value":""}]},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Other"},"metricMeasures":{"changed":false}},"createdAt":"2022-02-28T14:50:30Z","entityUuid":"2a84c15c-f5ca-4471-b1fe-10f3d1231f24","parentUuid":"be4651c9-9a8c-4e10-a158-61b94ca0e139","uuid":"794bf823-b26e-46e6-b83a-13cdbcd26544"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2022-02-28T14:50:31Z","entityUuid":"b307cc44-7896-4383-b9b0-11cf4a58f531","parentUuid":"2a84c15c-f5ca-4471-b1fe-10f3d1231f24","uuid":"32e1d427-bbb5-4f36-9e5b-8bae64e980be"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Which other?"}},"createdAt":"2022-02-28T14:50:32Z","entityUuid":"b307cc44-7896-4383-b9b0-11cf4a58f531","parentUuid":"2a84c15c-f5ca-4471-b1fe-10f3d1231f24","uuid":"6fd30929-8c6d-4109-b370-6b50c0fc6c03"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2022-02-28T14:50:33Z","entityUuid":"d57d0453-93d0-4328-afef-f68a7e82c09e","parentUuid":"b307cc44-7896-4383-b9b0-11cf4a58f531","uuid":"7c43a6c7-f18c-4ca4-b343-94457be94657"},{"content":{"eventType":"DeleteAnswerEvent"},"createdAt":"2022-02-28T14:50:34Z","entityUuid":"d57d0453-93d0-4328-afef-f68a7e82c09e","parentUuid":"b307cc44-7896-4383-b9b0-11cf4a58f531","uuid":"797b729a-c3e8-466c-9efa-21273fdefa37"},{"content":{"eventType":"MoveAnswerEvent","targetUuid":"b307cc44-7896-4383-b9b0-11cf4a58f531"},"createdAt":"2022-02-28T14:50:35Z","entityUuid":"1dfe0a6d-4281-4d5e-bcaa-5e20fa28a591","parentUuid":"be4651c9-9a8c-4e10-a158-61b94ca0e139","uuid":"0e262885-7cf6-4fea-b15c-adfee9f11611"},{"content":{"eventType":"MoveAnswerEvent","targetUuid":"b307cc4