# Every setting is prefixed with MADMP_API_ (unprefixed names are ignored).

# DSW / FAIR Wizard backend (without /wizard-api)
# MADMP_API_WIZARD_DEFAULT_KM accepts a KM package UUID or an org:kmId:version id
MADMP_API_WIZARD_URL=http://localhost:3000
MADMP_API_WIZARD_DEFAULT_KM=dsw:root:2.7.0

# Wizards: "single" (one Wizard, default) or "multi" (several Wizard APIs,
# selected by the request host).
# Nested settings use "__"; lists are JSON. A YAML file can be used instead
# via MADMP_API_CONFIG_PATH (see config.example.yaml).
# MADMP_API_WIZARDS__MODE=multi
# MADMP_API_WIZARDS__ALLOWED_HOSTS=["*.dsw.example.org"]
# MADMP_API_WIZARDS__HOST_HEADERS=["x-forwarded-host", "host"]
# MADMP_API_WIZARDS__WIZARD_URL_TEMPLATE=https://{host}

# Intermediate store (async driver)
MADMP_API_DATABASE_URL=postgresql+asyncpg://madmp:madmp@localhost:5440/madmp
# Prefix of the adapter's tables in the default schema (default: madmp_)
# MADMP_API_TABLE_PREFIX=madmp_

# maDMP synthesis defaults. DMP ids default to <public URL>/dmps/<uuid>,
# derived from the request; set this only to pin them.
MADMP_API_DEFAULT_LANGUAGE=eng
# MADMP_API_DMP_ID_BASE_URL=https://dsw.example.org/madmp-api/dmps

# Behaviour tuning
MADMP_API_LIST_CACHE_TTL_SECONDS=30
MADMP_API_REQUEST_TIMEOUT_SECONDS=60
